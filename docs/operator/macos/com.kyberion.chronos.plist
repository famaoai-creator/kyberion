<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kyberion.chronos</string>
  <key>WorkingDirectory</key>
  <string>__KYBERION_REPOSITORY_ROOT__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PNPM_EXECUTABLE_PATH__</string>
    <string>scheduler</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>KYBERION_CUSTOMER</key>
    <string>customer-slug</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__OPERATOR_HOME__/Library/Logs/kyberion-chronos.log</string>
  <key>StandardErrorPath</key>
  <string>__OPERATOR_HOME__/Library/Logs/kyberion-chronos.err.log</string>
</dict>
</plist>
