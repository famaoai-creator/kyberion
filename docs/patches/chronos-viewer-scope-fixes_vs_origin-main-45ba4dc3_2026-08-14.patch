+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+
+const mocks = vi.hoisted(() => ({
+  listTenantProfileSlugs: vi.fn(),
+  readTenantProfile: vi.fn(),
+  guardRequest: vi.fn(() => null),
+  requireChronosAccess: vi.fn(() => null),
+  resolveViewerContextForRequest: vi.fn(),
+  strictViewerScopeTenantSlugs: vi.fn(),
+  withViewerExecutionContext: vi.fn((_viewer: unknown, operation: () => unknown) => operation()),
+}));
+
+vi.mock('@agent/core', () => ({
+  listTenantProfileSlugs: mocks.listTenantProfileSlugs,
+  readTenantProfile: mocks.readTenantProfile,
+}));
+
+vi.mock('../../../lib/api-guard', () => ({
+  guardRequest: mocks.guardRequest,
+  requireChronosAccess: mocks.requireChronosAccess,
+}));
+
+vi.mock('../../../lib/viewer-context', () => ({
+  resolveViewerContextForRequest: mocks.resolveViewerContextForRequest,
+  strictViewerScopeTenantSlugs: mocks.strictViewerScopeTenantSlugs,
+  withViewerExecutionContext: mocks.withViewerExecutionContext,
+}));
+
+import { GET } from './route.js';
+
+const VIEWER = { role: 'localadmin', tenantSlugs: 'all', source: 'loopback' };
+
+const PROFILES: Record<string, { display_name: string; status: string }> = {
+  acme: { display_name: 'Acme', status: 'active' },
+  globex: { display_name: 'Globex', status: 'active' },
+};
+
+describe('tenant-scope route', () => {
+  beforeEach(() => {
+    for (const mock of Object.values(mocks)) mock.mockReset();
+    mocks.guardRequest.mockReturnValue(null);
+    mocks.requireChronosAccess.mockReturnValue(null);
+    mocks.resolveViewerContextForRequest.mockReturnValue({ context: VIEWER });
+    mocks.strictViewerScopeTenantSlugs.mockReturnValue('all');
+    mocks.listTenantProfileSlugs.mockReturnValue(['acme', 'globex']);
+    mocks.readTenantProfile.mockImplementation((slug: string) => PROFILES[slug] ?? null);
+    mocks.withViewerExecutionContext.mockImplementation(
+      (_viewer: unknown, operation: () => unknown) => operation()
+    );
+  });
+
+  it('returns the registered tenants visible to the viewer', async () => {
+    const response = await GET(new NextRequest('http://localhost/api/tenant-scope'));
+
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({
+      ok: true,
+      tenants: [
+        { slug: 'acme', displayName: 'Acme', status: 'active' },
+        { slug: 'globex', displayName: 'Globex', status: 'active' },
+      ],
+      selected: null,
+      source: 'loopback',
+    });
+  });
+
+  it('reads every tenant profile inside the viewer execution context', () => {
+    // Profiles live in the personal tier. A read that escapes the viewer
+    // context runs as the host process — under `pnpm surfaces:start` that is
+    // surface_runtime, which the tier guard refuses, turning the whole surface
+    // into a 403 even for a fully authorized local operator.
+    let depth = 0;
+    const depthsAtRead: number[] = [];
+    mocks.withViewerExecutionContext.mockImplementation(
+      (_viewer: unknown, operation: () => unknown) => {
+        depth += 1;
+        try {
+          return operation();
+        } finally {
+          depth -= 1;
+        }
+      }
+    );
+    mocks.readTenantProfile.mockImplementation((slug: string) => {
+      depthsAtRead.push(depth);
+      return PROFILES[slug] ?? null;
+    });
+    mocks.listTenantProfileSlugs.mockImplementation(() => {
+      depthsAtRead.push(depth);
+      return ['acme', 'globex'];
+    });
+
+    GET(new NextRequest('http://localhost/api/tenant-scope'));
+
+    expect(depthsAtRead).toHaveLength(3);
+    expect(depthsAtRead.every((entry) => entry > 0)).toBe(true);
+  });
+
+  it('narrows the listing to a scoped viewer and selects its sole tenant', async () => {
+    mocks.strictViewerScopeTenantSlugs.mockReturnValue(['globex']);
+
+    const response = await GET(new NextRequest('http://localhost/api/tenant-scope'));
+
+    expect(await response.json()).toMatchObject({
+      tenants: [{ slug: 'globex' }],
+      selected: 'globex',
+    });
+  });
+
+  it('drops a scoped tenant that has no registered profile', async () => {
+    mocks.strictViewerScopeTenantSlugs.mockReturnValue(['ghost']);
+
+    const response = await GET(new NextRequest('http://localhost/api/tenant-scope'));
+
+    expect(await response.json()).toMatchObject({ tenants: [], selected: null });
+    expect(mocks.readTenantProfile).not.toHaveBeenCalled();
+  });
+
+  it('refuses a tenant outside the viewer grant', async () => {
+    mocks.strictViewerScopeTenantSlugs.mockImplementation(() => {
+      throw new Error('viewer tenant scope denied: globex');
+    });
+
+    const response = await GET(new NextRequest('http://localhost/api/tenant-scope?tenant=globex'));
+
+    expect(response.status).toBe(403);
+    expect(await response.json()).toMatchObject({ ok: false });
+    expect(mocks.listTenantProfileSlugs).not.toHaveBeenCalled();
+  });
+});
