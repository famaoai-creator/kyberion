+ * keep that role and silently discard the role this scope was opened with —
+ * making the whole helper inert exactly where per-request authorization needs
+ * it. The process-level role is restored on exit; only the scope is narrowed.
+ */
+function enterExecutionEnv(role: string, persona?: Persona): PreviousExecutionEnv {
+  const previous: PreviousExecutionEnv = {
+    role: process.env.MISSION_ROLE,
+    systemRole: process.env.SYSTEM_ROLE,
+    persona: process.env.KYBERION_PERSONA,
+  };
   process.env.MISSION_ROLE = role;
+  delete process.env.SYSTEM_ROLE;
