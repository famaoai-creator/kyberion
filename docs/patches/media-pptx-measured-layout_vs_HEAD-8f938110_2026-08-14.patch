diff --git a/scripts/html-to-pptx/measure-deck.ts b/scripts/html-to-pptx/measure-deck.ts
new file mode 100644
index 00000000..c15f7e4f
--- /dev/null
+++ b/scripts/html-to-pptx/measure-deck.ts
@@ -0,0 +1,251 @@
+/**
+ * measure-deck — ブラウザの実レイアウトを計測して PptxDesignProtocol に転写する（試作）。
+ *
+ * 既存の `deck_from_html` は HTML を読んで**自前で再レイアウト**する。行数は
+ * charsPerLine による推定で、hardWrap で改行を焼き込む一発勝負のため、
+ * 列幅の破綻・語中改行・枠外へのはみ出しが生成時に検出できなかった。
+ *
+ * ここでは逆にする。HTML は既にブラウザで正しく組めているのだから、
+ * **Chrome に組ませて確定した幾何を読み出し、EMU に線形変換して転写する**。
+ * 推定が要らなくなり、折返し位置も実測値になる。
+ *
+ * 制約と対処:
+ *  - `file:` は browser-actuator のナビゲーション制御でブロックされるため、
+ *    127.0.0.1 で静的配信して `allow_private_network` で通す（外部通信はしない）。
+ *  - レポート HTML は画面向けの文字サイズ（13px 前後）で、そのまま転写すると
+ *    スライドでは 7〜9pt になり読めない。計測前に deck 用スタイルを注入して
+ *    「スライドで読めるサイズ」に組み替えてから測る。
+ *
+ * Run:
+ *   KYBERION_PERSONA=sovereign node_modules/.bin/tsx scripts/html-to-pptx/measure-deck.ts \
+ *     <report.html> <out.json> [--aspect 4:3|16:9] [--port 7401]
+ */
+import http from 'node:http';
+import path from 'node:path';
+import { safeExistsSync, safeReadFile, safeWriteFile } from '@agent/core/secure-io';
+import { handleAction } from '../../libs/actuators/browser-actuator/src/index.js';
+
+const argv = process.argv.slice(2);
+const pos = argv.filter((a) => !a.startsWith('--'));
+const flag = (name: string, dflt: string): string => {
+  const i = argv.indexOf(`--${name}`);
+  return i >= 0 ? argv[i + 1] : dflt;
+};
+const [inputHtml, outJson] = pos;
+if (!inputHtml || !outJson) {
+  throw new Error('usage: measure-deck.ts <report.html> <out.json> [--aspect 4:3] [--port 7401]');
+}
+if (!safeExistsSync(inputHtml)) throw new Error(`not found: ${inputHtml}`);
+
+const ASPECT = flag('aspect', '4:3');
+const PORT = Number(flag('port', '7401'));
+const SLIDE = ASPECT === '16:9' ? { w: 13.333, h: 7.5 } : { w: 10, h: 7.5 };
+/** 計測 viewport 幅(px)。狭いほど 1px あたりのインチが大きく＝文字が大きく転写される。 */
+const VIEW_W = Number(flag('viewport', '1000'));
+const PX_PER_IN = VIEW_W / SLIDE.w;
+/** 計測と出力で同一にするフォント。macOS 同梱かつ Windows 10 1809+ 標準。 */
+const DECK_FONT = 'BIZ UDPGothic';
+
+// ── 127.0.0.1 の一時静的配信（このプロセス内に閉じる）
+const html = safeReadFile(inputHtml, { encoding: 'utf8' }) as string;
+const server = http.createServer((_req, res) => {
+  res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+  res.end(html);
+});
+await new Promise<void>((r) => server.listen(PORT, '127.0.0.1', () => r()));
+
+/**
+ * ページ内で走らせる計測スクリプト。
+ * deck 用スタイルを流し込んでから、背景を持つ箱とテキストの葉ノードを実測する。
+ */
+const SCRIPT = `(() => {
+  const VIEW_W = ${VIEW_W};
+  document.documentElement.style.width = VIEW_W + 'px';
+  const st = document.createElement('style');
+  // スライドで読めるサイズへ組み替える（画面用の 13px 系はスライドでは 8pt 前後になる）
+  st.textContent = \`
+    /* 出力 pptx と同一フォントで測る。別フォントで測ると幅がずれてチップ内が割れる。
+       BIZ UDPGothic は macOS 同梱かつ Windows 10 1809+ 標準なので、計測側と
+       PowerPoint 側で同じ字形・同じ幅になる（Yu Gothic は macOS に無く fallback する）。 */
+    * { font-family: "BIZ UDPGothic", sans-serif !important; }
+    body { width: \${VIEW_W}px; margin:0; padding:22px; font-size:17px; line-height:1.5; }
+    h1 { font-size:30px } h2 { font-size:21px } .kicker,.meta,.legend { font-size:13px }
+    table { font-size:15px } th { font-size:14px } .chip { font-size:13px }
+    .kpi .big { font-size:34px } .kpi .lbl { font-size:13px }
+    li, p, .callout { font-size:16px }
+  \`;
+  document.head.appendChild(st);
+
+  const px = (v) => parseFloat(v) || 0;
+  const vis = (cs) => cs.display !== 'none' && cs.visibility !== 'hidden' && px(cs.opacity) > 0;
+  const solid = (c) => c && c !== 'rgba(0, 0, 0, 0)' && c !== 'transparent';
+  const hasOwnText = (el) => Array.from(el.childNodes)
+    .some((n) => n.nodeType === 3 && n.textContent.trim().length > 0);
+
+  const boxes = [], texts = [];
+  for (const el of document.querySelectorAll('body *')) {
+    const cs = getComputedStyle(el);
+    if (!vis(cs)) continue;
+    const r = el.getBoundingClientRect();
+    if (r.width <= 0 || r.height <= 0) continue;
+    const radius = px(cs.borderTopLeftRadius);
+    const bl = px(cs.borderLeftWidth);
+    // 背景 or 左アクセント罫を持つ箱は図形として転写
+    if (solid(cs.backgroundColor)) {
+      boxes.push({ x:r.x, y:r.y, w:r.width, h:r.height, fill:cs.backgroundColor, radius,
+        borderLeft: bl > 1 ? { w: bl, color: cs.borderLeftColor } : null,
+        tag: el.tagName.toLowerCase() });
+    } else if (bl > 1 && solid(cs.borderLeftColor)) {
+      boxes.push({ x:r.x, y:r.y, w:r.width, h:r.height, fill:null, radius:0,
+        borderLeft: { w: bl, color: cs.borderLeftColor }, tag: el.tagName.toLowerCase() });
+    }
+    // テキストは「自分で直接テキストを持つ」要素だけを葉として拾う（二重転写を避ける）
+    if (hasOwnText(el)) {
+      const range = document.createRange();
+      range.selectNodeContents(el);
+      const rects = Array.from(range.getClientRects());
+      // 外形をそのまま渡し、padding は pptx のテキストインセットに写す。
+      // padding を引いて「文字ぴったりの箱」にすると、pptx 既定インセット(左右0.1in)が
+      // 内側を削るため、+105% のような短い文字列がチップ内で折り返す。
+      texts.push({
+        x:r.x, y:r.y, w:r.width, h:r.height,
+        pad: [px(cs.paddingTop), px(cs.paddingRight), px(cs.paddingBottom), px(cs.paddingLeft)],
+        inkW: rects.length ? Math.max(...rects.map((q) => q.width)) : 0,
+        text: el.textContent.replace(/\\s+/g,' ').trim(),
+        fontSize: px(cs.fontSize), bold: (parseInt(cs.fontWeight,10) || 400) >= 600,
+        color: cs.color, align: cs.textAlign, lines: rects.length,
+        tag: el.tagName.toLowerCase(), cls: el.className || '',
+      });
+    }
+  }
+  // 章の切れ目（h2）と全体高さ
+  const cuts = Array.from(document.querySelectorAll('h2')).map((h) => h.getBoundingClientRect().y);
+  return { boxes, texts, cuts, pageH: document.body.scrollHeight, viewW: VIEW_W };
+})()`;
+
+const res = (await handleAction({
+  action: 'pipeline',
+  session_id: 'measure-deck',
+  steps: [
+    { type: 'apply', op: 'goto', params: { url: `http://127.0.0.1:${PORT}/` } },
+    { type: 'capture', op: 'evaluate', params: { script: SCRIPT, export_as: 'geom' } },
+  ],
+  options: {
+    headless: true,
+    browser_channel: 'chrome',
+    navigation_policy: { allow_private_network: true },
+  },
+} as never)) as { status?: string; context?: Record<string, unknown> };
+server.close();
+
+const geom = res.context?.geom as
+  | {
+      boxes: Array<Record<string, unknown>>;
+      texts: Array<Record<string, unknown>>;
+      cuts: number[];
+      pageH: number;
+    }
+  | undefined;
+if (!geom) throw new Error(`measurement failed (status=${res.status})`);
+
+// ── px → inch。スライド幅に合わせた線形変換だけで、レイアウトの再解釈はしない
+const IN = (v: number): number => Number((v / PX_PER_IN).toFixed(3));
+const rgb = (c: string): string => {
+  const m = /rgba?\((\d+),\s*(\d+),\s*(\d+)/.exec(c || '');
+  if (!m) return '#000000';
+  return (
+    '#' +
+    [1, 2, 3].map((i) => Number(m[i]).toString(16).padStart(2, '0')).join('').toUpperCase()
+  );
+};
+
+/** h2 の位置でスライドに切る。1枚に収まらない章は高さで追加分割する。 */
+const cuts = [0, ...geom.cuts.filter((c) => c > 1), geom.pageH];
+const spans: Array<{ top: number; bottom: number }> = [];
+for (let i = 0; i < cuts.length - 1; i += 1) {
+  const top = cuts[i];
+  const bottom = cuts[i + 1];
+  const maxPx = SLIDE.h * PX_PER_IN - 0.5 * PX_PER_IN; // 上下余白ぶん
+  let y = top;
+  while (bottom - y > maxPx) {
+    spans.push({ top: y, bottom: y + maxPx });
+    y += maxPx;
+  }
+  if (bottom - y > 4) spans.push({ top: y, bottom });
+}
+
+const slides = spans.map((s, i) => {
+  const off = s.top - 0.25 * PX_PER_IN;
+  const within = (y: number, h: number): boolean => y >= s.top - 2 && y + h <= s.bottom + 2;
+  const elements: Array<Record<string, unknown>> = [];
+  for (const b of geom.boxes as Array<Record<string, number & string>>) {
+    if (!within(b.y as number, b.h as number)) continue;
+    const bl = b.borderLeft as { w: number; color: string } | null;
+    if (b.fill)
+      elements.push({
+        type: 'shape',
+        shapeType: (b.radius as number) > 2 ? 'roundRect' : 'rect',
+        pos: { x: IN(b.x as number), y: IN((b.y as number) - off), w: IN(b.w as number), h: IN(b.h as number) },
+        text: '',
+        style: {
+          fill: rgb(b.fill as string),
+          ...((b.radius as number) > 2 ? { cornerRadius: 0.06 } : {}),
+        },
+      });
+    if (bl)
+      elements.push({
+        type: 'shape',
+        shapeType: 'rect',
+        pos: { x: IN(b.x as number), y: IN((b.y as number) - off), w: IN(bl.w), h: IN(b.h as number) },
+        text: '',
+        style: { fill: rgb(bl.color) },
+      });
+  }
+  for (const t of geom.texts as Array<Record<string, number & string>>) {
+    if (!within(t.y as number, t.h as number)) continue;
+    if (!String(t.text).trim()) continue;
+    const pad = (t.pad as unknown as number[]) ?? [0, 0, 0, 0];
+    // インク実幅＋左右インセットが箱に収まらない場合だけ箱を広げる（折返し事故の防止）
+    const needW = (t.inkW as number) + pad[1] + pad[3] + 2;
+    const boxW = Math.max(t.w as number, needW);
+    elements.push({
+      type: 'text',
+      pos: { x: IN(t.x as number), y: IN((t.y as number) - off), w: IN(boxW), h: IN(t.h as number) },
+      text: String(t.text),
+      style: {
+        margin: [IN(pad[0]), IN(pad[1]), IN(pad[2]), IN(pad[3])],
+        fontFamily: DECK_FONT,
+        fontSize: Number((((t.fontSize as number) / PX_PER_IN) * 72).toFixed(1)),
+        bold: Boolean(t.bold),
+        color: rgb(t.color as string),
+        align: String(t.align).includes('center')
+          ? 'center'
+          : String(t.align).includes('right')
+            ? 'right'
+            : 'left',
+      },
+    });
+  }
+  return { id: `slide${i + 1}.xml`, backgroundFill: '#FFFFFF', elements };
+});
+
+const protocol = {
+  version: '3.0.0',
+  canvas: { w: SLIDE.w, h: SLIDE.h },
+  designDefaults: { fontFamily: DECK_FONT },
+  // 転写方式では見た目は全てスライド側の要素で表現するため、マスタは空で持つ
+  // （デザインカスケードが master.elements を必須で参照する）。
+  master: { elements: [] as Array<Record<string, unknown>> },
+  slides,
+  metadata: {
+    source: 'measure-deck(browser)',
+    slideCount: slides.length,
+    measurement: { engine: 'chrome', viewportPx: VIEW_W, pxPerInch: Number(PX_PER_IN.toFixed(2)) },
+  },
+};
+safeWriteFile(outJson, JSON.stringify(protocol, null, 2), { mkdir: true, encoding: 'utf8' });
+console.log(
+  `[measure-deck] ${path.basename(inputHtml)} → ${outJson}\n` +
+    `  計測: ${geom.boxes.length}箱 / ${geom.texts.length}テキスト / ページ高 ${geom.pageH}px\n` +
+    `  スライド ${slides.length}枚 (${ASPECT}, ${PX_PER_IN.toFixed(0)}px/in)`
+);
