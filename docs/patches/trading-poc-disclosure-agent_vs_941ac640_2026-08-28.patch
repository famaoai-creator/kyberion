+{
+  "$comment": "Acquisition sources for the disclosure trading PoC. Only hosts listed here are reachable, and only from the acquisition plane. The default is the bundled sample corpus: the right to retrieve a disclosure service mechanically is a separate question from the right to analyse disclosure content, and until the retrieval route is contracted the PoC runs on samples.",
+  "version": "1.0.0",
+  "default_disclosure_source": "sample-disclosures",
+  "default_market_data_source": "sample-market-data",
+  "sources": [
+    {
+      "source_id": "sample-disclosures",
+      "kind": "sample",
+      "sample_file": "disclosures.json",
+      "note": "Bundled corpus with the same shape as a real disclosure feed. Deterministic, and the only source that needs no licence review."
+    },
+    {
+      "source_id": "sample-market-data",
+      "kind": "sample",
+      "sample_file": "market-data.json",
+      "note": "Bundled price, volume, market cap and free-float figures for the sample corpus."
+    },
+    {
+      "source_id": "operator-supplied-disclosure-list",
+      "kind": "local-export",
+      "export_path": "active/shared/tmp/trading-poc-imports/disclosure-list-20260827.html",
+      "export_format": "tdnet-list-html",
+      "note": "A disclosure-list page a person obtained and placed here. The service refuses automated retrieval for every user agent in its robots.txt, so this route exists to run real titles through the pipeline without the system fetching anything. A list page carries headlines, not documents: the disclosures it yields are marked evidence_depth title_only and the policy check refuses them under R012."
+    },
+    {
+      "source_id": "jpx-licensed-feed",
+      "kind": "https",
+      "base_url": "https://example-licensed-feed.invalid/disclosures",
+      "allowlist_hosts": [
+        "example-licensed-feed.invalid"
+      ],
+      "note": "Placeholder for a contracted disclosure feed. Replace base_url and allowlist_hosts with the real endpoint once the retrieval route and AI-use terms are agreed; the host must also be added to the Network Firewall allowlist in infra/trading-poc."
+    },
+    {
+      "source_id": "vendor-market-data",
+      "kind": "https",
+      "base_url": "https://example-market-vendor.invalid/quotes",
+      "allowlist_hosts": [
+        "example-market-vendor.invalid"
+      ],
+      "note": "Placeholder for a contracted market-data vendor."
+    }
+  ]
+}
