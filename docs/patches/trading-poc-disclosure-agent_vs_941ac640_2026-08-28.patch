diff --git a/libs/actuators/trading-actuator/src/mock-execution.ts b/libs/actuators/trading-actuator/src/mock-execution.ts
new file mode 100644
index 00000000..d9da7202
--- /dev/null
+++ b/libs/actuators/trading-actuator/src/mock-execution.ts
@@ -0,0 +1,166 @@
+import { auditChain } from '@agent/core/audit-chain';
+import { loadApprovalRequest } from '@agent/core/governance';
+import { assertNoLiveOrderRoute } from './plane-guard.js';
+import type { MarketData, MockFill, RuleVerificationResult } from './types.js';
+
+/**
+ * J4 — record mock fills.
+ *
+ * This is the only place in the PoC that produces something resembling an
+ * order, and it is the narrowest gate in the system on purpose. Three things
+ * must hold before a single fill is recorded: the deterministic policy check
+ * passed for the name, a human approval exists and is still valid, and that
+ * approval is bound by hash to the exact payload the check produced. If any of
+ * them is missing the step fails; there is no path from a model's output to a
+ * fill that goes around this function.
+ */
+
+export interface ApprovalBinding {
+  request_id: string;
+  channel: string;
+  decided_by: string;
+  payload_hash: string;
+}
+
+export interface RecordMockFillsInput {
+  runDate: string;
+  verification: RuleVerificationResult;
+  marketData: MarketData[];
+  targetNotionalJpy: number;
+  approvalChannel: string;
+  approvalRequestId: string;
+}
+
+export interface RecordMockFillsOutput {
+  run_date: string;
+  fills: MockFill[];
+  /** Names that cleared the policy check but still recorded no fill, and why. */
+  skipped: Array<{ ticker: string; reason: string }>;
+  approval: ApprovalBinding;
+}
+
+/**
+ * Load the approval and prove it admits this exact payload.
+ *
+ * The hash binding is what makes the gate meaningful. An approval that merely
+ * says "yes" could be reused against a different, later proposal; an approval
+ * bound to a payload hash cannot.
+ */
+export async function resolveApprovalBinding(
+  channel: string,
+  requestId: string,
+  expectedPayloadHash: string
+): Promise<ApprovalBinding> {
+  const record = await loadApprovalRequest(channel, requestId);
+  if (!record) {
+    throw new Error(
+      `[EXECUTION_GATE_DENIED] approval request '${requestId}' does not exist in channel '${channel}'`
+    );
+  }
+  if (record.status !== 'approved') {
+    throw new Error(
+      `[EXECUTION_GATE_DENIED] approval request '${requestId}' is '${record.status}', not 'approved'`
+    );
+  }
+  if (!record.decidedBy) {
+    throw new Error(
+      `[EXECUTION_GATE_DENIED] approval request '${requestId}' records no decider; accountability is held by a human principal`
+    );
+  }
+  if (record.expiresAt && Date.parse(record.expiresAt) < Date.now()) {
+    throw new Error(
+      `[EXECUTION_GATE_DENIED] approval request '${requestId}' expired at ${record.expiresAt}; an expired approval is not reusable`
+    );
+  }
+  const boundHash = record.accountability?.payloadHash;
+  if (!boundHash) {
+    throw new Error(
+      `[EXECUTION_GATE_DENIED] approval request '${requestId}' is not bound to a payload hash, so it cannot admit a specific proposal`
+    );
+  }
+  if (boundHash !== expectedPayloadHash) {
+    throw new Error(
+      `[EXECUTION_GATE_DENIED] approval request '${requestId}' is bound to payload ${boundHash} but the verified proposal hashes to ${expectedPayloadHash}`
+    );
+  }
+  return {
+    request_id: record.id,
+    channel: record.channel,
+    decided_by: record.decidedBy,
+    payload_hash: boundHash,
+  };
+}
+
+export async function recordMockFills(
+  input: RecordMockFillsInput
+): Promise<RecordMockFillsOutput> {
+  assertNoLiveOrderRoute();
+  const approval = await resolveApprovalBinding(
+    input.approvalChannel,
+    input.approvalRequestId,
+    input.verification.payload_hash
+  );
+
+  const marketIndex = new Map(input.marketData.map((entry) => [entry.ticker, entry]));
+  const fills: MockFill[] = [];
+  const skipped: RecordMockFillsOutput['skipped'] = [];
+
+  for (const verdict of input.verification.verdicts) {
+    if (!verdict.passed) {
+      const failed = verdict.evaluations
+        .filter((entry) => entry.result === 'fail')
+        .map((entry) => `${entry.rule_id} ${entry.detail}`);
+      skipped.push({
+        ticker: verdict.ticker,
+        reason: `rejected by the policy check: ${failed.join(' | ')}`,
+      });
+      continue;
+    }
+    const market = marketIndex.get(verdict.ticker);
+    if (!market) {
+      skipped.push({ ticker: verdict.ticker, reason: 'no market-data snapshot to price a fill' });
+      continue;
+    }
+    const quantity = Math.floor(input.targetNotionalJpy / market.open);
+    if (quantity <= 0) {
+      skipped.push({
+        ticker: verdict.ticker,
+        reason: `target notional ${input.targetNotionalJpy} buys no whole shares at ${market.open}`,
+      });
+      continue;
+    }
+    fills.push({
+      ticker: verdict.ticker,
+      side: 'buy',
+      quantity,
+      price: market.open,
+      notional_jpy: Math.round(quantity * market.open),
+      recorded_at: new Date().toISOString(),
+      approval_ref: {
+        request_id: approval.request_id,
+        decided_by: approval.decided_by,
+        payload_hash: approval.payload_hash,
+      },
+    });
+  }
+
+  auditChain.record({
+    agentId: 'trading-actuator',
+    action: 'trading:record_mock_fills',
+    operation: `mock-execution:${input.runDate}`,
+    result: 'completed',
+    reason: `${fills.length} mock fills recorded, ${skipped.length} names skipped`,
+    correlationId: approval.request_id,
+    metadata: {
+      run_date: input.runDate,
+      payload_hash: input.verification.payload_hash,
+      approval_request_id: approval.request_id,
+      decided_by: approval.decided_by,
+      tickers: fills.map((fill) => fill.ticker),
+      live_order_placed: false,
+    },
+    compliance: { framework: 'internal-trading-poc', control: 'human-approval-gate' },
+  });
+
+  return { run_date: input.runDate, fills, skipped, approval };
+}
