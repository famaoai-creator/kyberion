+  value       = aws_iam_role.agent_runtime.arn
+}
+
+output "rule_engine_role_arn" {
+  description = "Role the deterministic policy check assumes. Bedrock is denied to it."
+  value       = aws_iam_role.rule_engine.arn
+}
+
+output "allowlisted_domains" {
+  description = "Keep identical to allowlist_hosts in knowledge/product/governance/trading-poc-sources.json."
+  value       = var.allowed_acquisition_domains
+}
diff --git a/infra/trading-poc/policies/README.md b/infra/trading-poc/policies/README.md
new file mode 100644
index 00000000..7870ea79
--- /dev/null
+++ b/infra/trading-poc/policies/README.md
@@ -0,0 +1,41 @@
+# Cedar policies
+
+`tool-invocation.cedar` is the delegation the agent runtime operates under. It
+is kept as a file rather than inline in Terraform for one reason: the compliance
+function reads it, and a policy nobody outside the delivery team can read is not
+an auditable control.
+
+Load it into AgentCore Policy as part of the runtime provisioning step. It is
+not applied by `terraform apply` in this directory — the AgentCore resource
+surface should be confirmed against the region availability answer (see the
+repository's `infra/trading-poc/README.md`) before it is written as Terraform,
+and a resource block that does not match the real API is worse than an explicit
+gap.
+
+## What each policy is for
+
+| Policy | The property it holds |
+| --- | --- |
+| Snapshot read permit | The nodes read stored bytes, scoped to their own run date, and nothing else. |
+| Write forbid | No conclusion reaches storage without passing the rule engine and the gate. |
+| Mock-fill forbid / permit | Execution is unreachable from a reasoning node, and reachable by the execution job only with a hash-bound human approval. |
+| Order-route forbid | The PoC's exclusion of real orders survives a plausibly-named tool being registered. |
+| Egress forbid / permit | Fetching belongs to the acquisition jobs, over https, to declared hosts. |
+| Expiry forbid | A stale delegation stops working, which is what makes short tokens worth issuing. |
+| Reviewer-independence forbid | The review node cannot run on the model it is reviewing. |
+
+## Testing them
+
+Cedar policies are testable, and these should be tested before the Phase 0 gate
+rather than after: the authority-containment criterion is measured by the
+rejection log, and a policy set that was never exercised produces an empty log
+that reads like a pass.
+
+```bash
+cedar authorize --policies tool-invocation.cedar --entities entities.json --request-json request.json
+```
+
+The `entities.json` and per-request fixtures belong with the runtime
+provisioning work, alongside the red-team scenarios in
+`libs/actuators/trading-actuator/src/redteam.ts` — every scenario there has a
+matching authorization request worth asserting.
diff --git a/infra/trading-poc/policies/tool-invocation.cedar b/infra/trading-poc/policies/tool-invocation.cedar
new file mode 100644
index 00000000..c1d10fbb
--- /dev/null
+++ b/infra/trading-poc/policies/tool-invocation.cedar
@@ -0,0 +1,120 @@
+// Cedar policies for the agent runtime's tool calls.
+//
+// Written to be read by the compliance function, not only by the runtime: each
+// policy states one rule of the delegation in a form a reviewer can check
+// against the design document line by line.
+//
+// The order of reasoning is forbid-wins. A permit here widens nothing that a
+// forbid below closes, which is why the read-only permit can be stated plainly.
+
+// The reasoning nodes may read stored snapshots, and that is the whole of their
+// read surface. Naming the tools explicitly means a tool added later is denied
+// until someone amends this file.
+permit (
+  principal in Role::"trading-poc-agent-runtime",
+  action in [
+    Action::"tool:read_disclosure_snapshot",
+    Action::"tool:list_disclosure_snapshots",
+    Action::"tool:read_market_data_snapshot"
+  ],
+  resource in Bucket::"trading-poc-input-snapshots"
+)
+when {
+  // Only the run the node was dispatched for. A node that can read any date's
+  // snapshots can be steered into citing a document from another session.
+  resource.run_date == context.run_date
+};
+
+// No write reaches storage from a reasoning node. Its conclusions travel
+// onward through the rule engine and the approval gate, which is the only
+// ordering the audit trail can defend.
+forbid (
+  principal in Role::"trading-poc-agent-runtime",
+  action in [
+    Action::"tool:write_snapshot",
+    Action::"tool:delete_snapshot",
+    Action::"tool:write_audit_record"
+  ],
+  resource
+);
+
+// Mock execution is reachable only by the execution job, never by a reasoning
+// node — regardless of what a node's output asks for.
+forbid (
+  principal in Role::"trading-poc-agent-runtime",
+  action == Action::"tool:record_mock_fill",
+  resource
+);
+
+// And when the execution job does reach it, the approval must be bound to the
+// exact verified payload. An approval that merely says "yes" could be replayed
+// against a later, different proposal.
+permit (
+  principal in Role::"trading-poc-execution-job",
+  action == Action::"tool:record_mock_fill",
+  resource
+)
+when {
+  context has approval &&
+  context.approval.status == "approved" &&
+  context.approval.decided_by_type == "human" &&
+  context.approval.payload_hash == context.verified_payload_hash &&
+  context.approval.effect_binding == "trading:record_mock_fills:" + context.run_date
+};
+
+// A real order route is out of scope for the PoC. Stated as a forbid rather
+// than left absent, so a tool registered under a plausible name is refused
+// rather than admitted by default.
+forbid (
+  principal,
+  action in [
+    Action::"tool:place_order",
+    Action::"tool:cancel_order",
+    Action::"tool:amend_order",
+    Action::"tool:transfer_funds"
+  ],
+  resource
+);
+
+// Egress belongs to the acquisition jobs alone, and only to declared hosts.
+forbid (
+  principal in Role::"trading-poc-agent-runtime",
+  action == Action::"tool:http_fetch",
+  resource
+);
+
+permit (
+  principal in Role::"trading-poc-acquisition-job",
+  action == Action::"tool:http_fetch",
+  resource
+)
+when {
+  resource.host in context.allowlisted_hosts &&
+  resource.scheme == "https"
+};
+
+// Short-lived delegation. An expired token that still works turns every other
+// control here into a formality, so expiry is checked at the tool call rather
+// than only at issue.
+forbid (
+  principal,
+  action,
+  resource
+)
+when {
+  context has delegation &&
+  context.delegation.expires_at <= context.now
+};
+
+// The reviewer must not be the model it reviews. Enforced at the runtime too,
+// because a roster edit is easier to make than an IAM change.
+forbid (
+  principal in Role::"trading-poc-agent-runtime",
+  action == Action::"tool:submit_review",
+  resource
+)
+when {
+  context has selector_model &&
+  context has reviewer_model &&
+  context.selector_model == context.reviewer_model
+};
diff --git a/infra/trading-poc/scp.tf b/infra/trading-poc/scp.tf
new file mode 100644
index 00000000..9c5acd79
--- /dev/null
+++ b/infra/trading-poc/scp.tf
@@ -0,0 +1,143 @@
+# The Service Control Policy, attached to an OU that holds only this account.
+#
+# The attachment target matters as much as the statements. Attached to a shared
+# OU these denials would break unrelated workloads; attached to a PoC-only OU
+# they are the reason the isolation claim is an organisational control rather
+# than an operational habit. If the OU cannot be created, that claim degrades to
+# "we agreed not to" — which is worth knowing before Phase 0 starts, not after.
+
+data "aws_iam_policy_document" "poc_guardrails" {
+  # No real order route, no payment surface, and no way to reach a production
+  # network from here.
+  statement {
+    sid    = "DenyVpcPeeringAndTransitAttachment"
+    effect = "Deny"
+    actions = [
+      "ec2:CreateVpcPeeringConnection",
+      "ec2:AcceptVpcPeeringConnection",
+      "ec2:CreateTransitGatewayVpcAttachment",
+      "ec2:AcceptTransitGatewayVpcAttachment",
+      "ec2:CreateVpnConnection",
+      "ec2:CreateVpnGateway",
+      "directconnect:CreateConnection",
+      "directconnect:CreatePrivateVirtualInterface",
+    ]
+    resources = ["*"]
+  }
+
+  # Object Lock is the audit trail's foundation; a principal that can bypass
+  # retention can rewrite history after the fact.
+  statement {
+    sid    = "DenyObjectLockBypass"
+    effect = "Deny"
+    actions = [
+      "s3:BypassGovernanceRetention",
+      "s3:PutBucketObjectLockConfiguration",
+      "s3:PutBucketVersioning",
+    ]
+    resources = ["*"]
+  }
+
+  statement {
+    sid    = "DenyCloudTrailTampering"
+    effect = "Deny"
+    actions = [
+      "cloudtrail:StopLogging",
+      "cloudtrail:DeleteTrail",
+      "cloudtrail:UpdateTrail",
+      "cloudtrail:PutEventSelectors",
+    ]
+    resources = ["*"]
+  }
+
+  # The agent surfaces the PoC scope excludes. Code Interpreter would hand the
+  # agent arbitrary code execution; a browser tool would hand it an egress path
+  # and an injection entry point in one. Excluding them in the SCP means the
+  # exclusion holds even if someone enables the feature in a console.
+  statement {
+    sid    = "DenyExcludedAgentSurfaces"
+    effect = "Deny"
+    actions = [
+      "bedrock:CreateAgentActionGroup",
+      "bedrock:UpdateAgentActionGroup",
+      "bedrock-agentcore:CreateCodeInterpreter",
+      "bedrock-agentcore:StartCodeInterpreterSession",
+      "bedrock-agentcore:CreateBrowser",
+      "bedrock-agentcore:StartBrowserSession",
+    ]
+    resources = ["*"]
+  }
+
+  # No payment or funds-movement surface is in scope for a PoC that records
+  # mock fills.
+  statement {
+    sid    = "DenyPaymentAndFundsMovement"
+    effect = "Deny"
+    actions = [
+      "payments:*",
+      "billingconductor:*",
+    ]
+    resources = ["*"]
+  }
+
+  statement {
+    sid       = "DenyLeavingTheOrganization"
+    effect    = "Deny"
+    actions   = ["organizations:LeaveOrganization"]
+    resources = ["*"]
+  }
+
+  # Confine the PoC to the agreed region. A resource quietly created elsewhere
+  # would sit outside the firewall, the endpoints and the trail's data events.
+  statement {
+    sid    = "DenyOutsideApprovedRegions"
+    effect = "Deny"
+    not_actions = [
+      "iam:*",
+      "organizations:*",
+      "sts:*",
+      "cloudfront:*",
+      "route53:*",
+      "support:*",
+      "budgets:*",
+      "s3:ListAllMyBuckets",
+    ]
+    resources = ["*"]
+    condition {
+      test     = "StringNotEquals"
+      variable = "aws:RequestedRegion"
+      values   = [var.region]
+    }
+  }
+
+  dynamic "statement" {
+    for_each = length(var.production_vpc_cidrs) > 0 ? [1] : []
+    content {
+      sid       = "DenyRoutesToProduction"
+      effect    = "Deny"
+      actions   = ["ec2:CreateRoute", "ec2:ReplaceRoute"]
+      resources = ["*"]
+      condition {
+        test     = "StringEquals"
+        variable = "ec2:DestinationCidrBlock"
+        values   = var.production_vpc_cidrs
+      }
+    }
+  }
+}
+
+resource "aws_organizations_policy" "poc_guardrails" {
+  count = var.poc_organizational_unit_id == "" ? 0 : 1
+
+  name        = "${var.name_prefix}-guardrails"
+  description = "Isolation guardrails for the disclosure trading PoC account"
+  type        = "SERVICE_CONTROL_POLICY"
+  content     = data.aws_iam_policy_document.poc_guardrails.json
+}
+
+resource "aws_organizations_policy_attachment" "poc_guardrails" {
+  count = var.poc_organizational_unit_id == "" ? 0 : 1
+
+  policy_id = aws_organizations_policy.poc_guardrails[0].id
+  target_id = var.poc_organizational_unit_id
+}
diff --git a/infra/trading-poc/storage.tf b/infra/trading-poc/storage.tf
new file mode 100644
index 00000000..74c0fa78
--- /dev/null
+++ b/infra/trading-poc/storage.tf
@@ -0,0 +1,148 @@
+# Immutable snapshots and audit logs.
+#
+# Object Lock in COMPLIANCE mode means no principal — including the account root
+# — can shorten a retention period or delete an object inside it. That is the
+# property the audit trail rests on: if a snapshot could be edited after the
+# fact, "this input produced this conclusion" would be an assertion rather than
+# something a reviewer can verify.
+
+resource "aws_s3_bucket" "snapshots" {
+  bucket              = "${var.name_prefix}-input-snapshots-${data.aws_caller_identity.current.account_id}"
+  object_lock_enabled = true
+  tags                = { Name = "${var.name_prefix}-input-snapshots" }
+}
+
+resource "aws_s3_bucket_versioning" "snapshots" {
+  bucket = aws_s3_bucket.snapshots.id
+  versioning_configuration {
+    status = "Enabled"
+  }
+}
+
+resource "aws_s3_bucket_object_lock_configuration" "snapshots" {
+  bucket = aws_s3_bucket.snapshots.id
+
+  rule {
+    default_retention {
+      mode = "COMPLIANCE"
+      days = var.snapshot_retention_days
+    }
+  }
+}
+
+resource "aws_s3_bucket_server_side_encryption_configuration" "snapshots" {
+  bucket = aws_s3_bucket.snapshots.id
+
+  rule {
+    apply_server_side_encryption_by_default {
+      sse_algorithm     = "aws:kms"
+      kms_master_key_id = aws_kms_key.poc.arn
+    }
+    bucket_key_enabled = true
+  }
+}
+
+resource "aws_s3_bucket_public_access_block" "snapshots" {
+  bucket                  = aws_s3_bucket.snapshots.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket" "audit" {
+  bucket              = "${var.name_prefix}-audit-logs-${data.aws_caller_identity.current.account_id}"
+  object_lock_enabled = true
+  tags                = { Name = "${var.name_prefix}-audit-logs" }
+}
+
+resource "aws_s3_bucket_versioning" "audit" {
+  bucket = aws_s3_bucket.audit.id
+  versioning_configuration {
+    status = "Enabled"
+  }
+}
+
+resource "aws_s3_bucket_object_lock_configuration" "audit" {
+  bucket = aws_s3_bucket.audit.id
+
+  rule {
+    default_retention {
+      mode = "COMPLIANCE"
+      days = var.audit_log_retention_days
+    }
+  }
+}
+
+resource "aws_s3_bucket_server_side_encryption_configuration" "audit" {
+  bucket = aws_s3_bucket.audit.id
+
+  rule {
+    apply_server_side_encryption_by_default {
+      sse_algorithm     = "aws:kms"
+      kms_master_key_id = aws_kms_key.poc.arn
+    }
+    bucket_key_enabled = true
+  }
+}
+
+resource "aws_s3_bucket_public_access_block" "audit" {
+  bucket                  = aws_s3_bucket.audit.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+# The execution plane reads snapshots and writes nothing to that bucket. Denying
+# writes at the bucket policy as well as in the task role means a mistake in one
+# does not become an incident.
+resource "aws_s3_bucket_policy" "snapshots_read_only_for_execution" {
+  bucket = aws_s3_bucket.snapshots.id
+
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Sid       = "DenyExecutionPlaneWrites"
+        Effect    = "Deny"
+        Principal = "*"
+        Action    = ["s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion"]
+        Resource  = "${aws_s3_bucket.snapshots.arn}/*"
+        Condition = {
+          ArnEquals = {
+            "aws:PrincipalArn" = aws_iam_role.agent_runtime.arn
+          }
+        }
+      },
+      {
+        Sid       = "DenyUnencryptedTransport"
+        Effect    = "Deny"
+        Principal = "*"
+        Action    = "s3:*"
+        Resource = [
+          aws_s3_bucket.snapshots.arn,
+          "${aws_s3_bucket.snapshots.arn}/*",
+        ]
+        Condition = {
+          Bool = { "aws:SecureTransport" = "false" }
+        }
+      },
+    ]
+  })
+}
+
+resource "aws_kms_key" "poc" {
+  description             = "${var.name_prefix} snapshots and audit logs"
+  enable_key_rotation     = true
+  deletion_window_in_days = 30
+  tags                    = { Name = "${var.name_prefix}-kms" }
+}
+
+resource "aws_kms_alias" "poc" {
+  name          = "alias/${var.name_prefix}"
+  target_key_id = aws_kms_key.poc.key_id
+}
+
+data "aws_caller_identity" "current" {}
+data "aws_region" "current" {}
diff --git a/infra/trading-poc/variables.tf b/infra/trading-poc/variables.tf
new file mode 100644
index 00000000..90b6f87f
--- /dev/null
+++ b/infra/trading-poc/variables.tf
@@ -0,0 +1,74 @@
+variable "region" {
+  description = "Primary region. Every AgentCore component the design depends on must be available here; verify per component before applying."
+  type        = string
+  default     = "ap-northeast-1"
+}
+
+variable "name_prefix" {
+  description = "Prefix for every resource name, so a PoC resource is never mistaken for a production one."
+  type        = string
+  default     = "trading-poc"
+}
+
+variable "vpc_cidr" {
+  type    = string
+  default = "10.60.0.0/16"
+}
+
+variable "acquisition_subnet_cidrs" {
+  description = "Subnets that may reach the internet, through the NAT gateway and behind the firewall."
+  type        = list(string)
+  default     = ["10.60.0.0/24", "10.60.1.0/24"]
+}
+
+variable "execution_subnet_cidrs" {
+  description = "Subnets with no route to the internet at all. The agents run here."
+  type        = list(string)
+  default     = ["10.60.10.0/24", "10.60.11.0/24"]
+}
+
+variable "availability_zones" {
+  type    = list(string)
+  default = ["ap-northeast-1a", "ap-northeast-1c"]
+}
+
+variable "allowed_acquisition_domains" {
+  description = <<-EOT
+    The only domains the acquisition jobs may reach. Keep this list identical to
+    the allowlist_hosts entries in knowledge/product/governance/trading-poc-sources.json:
+    an allowlist that disagrees with the application's own source registry means
+    one of the two is not the control it appears to be.
+  EOT
+  type        = list(string)
+  default     = ["example-licensed-feed.invalid", "example-market-vendor.invalid"]
+}
+
+variable "snapshot_retention_days" {
+  description = "Object Lock retention for input snapshots. Agree the figure with the audit function before applying — it cannot be shortened afterwards."
+  type        = number
+  default     = 400
+}
+
+variable "audit_log_retention_days" {
+  description = "Object Lock retention for audit logs."
+  type        = number
+  default     = 2557
+}
+
+variable "existing_idp_issuer_url" {
+  description = "OIDC issuer of the existing corporate identity provider. Authorisation lifecycle stays with the IdP; the runtime is not given its own user store."
+  type        = string
+  default     = ""
+}
+
+variable "poc_organizational_unit_id" {
+  description = "OU that holds only this PoC account. The SCP is attached here, never to a shared OU."
+  type        = string
+  default     = ""
+}
+
+variable "production_vpc_cidrs" {
+  description = "Production CIDRs the PoC must never peer with or route to."
+  type        = list(string)
+  default     = []
+}
diff --git a/infra/trading-poc/versions.tf b/infra/trading-poc/versions.tf
new file mode 100644
index 00000000..98d6e20e
--- /dev/null
+++ b/infra/trading-poc/versions.tf
@@ -0,0 +1,27 @@
+terraform {
+  required_version = ">= 1.5.0"
+
+  required_providers {
+    aws = {
+      source  = "hashicorp/aws"
+      version = "~> 5.60"
+    }
+  }
+}
+
+provider "aws" {
+  region = var.region
+
+  default_tags {
+    tags = {
+      Project     = "disclosure-trading-poc"
+      Environment = "poc"
+      # The PoC never touches customer assets or a real order route; the tag
+      # makes that claim visible to anyone auditing the account rather than
+      # leaving it in a design document.
+      DataClass      = "internal-no-customer-data"
+      LiveOrderRoute = "none"
+      ManagedBy      = "terraform"
+    }
+  }
+}
