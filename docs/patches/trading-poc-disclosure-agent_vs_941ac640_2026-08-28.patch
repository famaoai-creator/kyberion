+++ b/knowledge/product/governance/trading-poc-investment-policy.json
@@ -0,0 +1,27 @@
+{
+  "$comment": "Deterministic investment policy for the disclosure trading PoC. Every rule here is machine-checkable on purpose: the point of the PoC is that policy compliance is decided by code, not by a model's judgement. Reference figures — replace with the real policy before any run whose result is treated as evidence.",
+  "version": "1.0.0",
+  "universe": {
+    "allowed_markets": ["TSE_PRIME", "TSE_STANDARD"]
+  },
+  "liquidity": {
+    "min_avg_daily_volume_20d": 500000,
+    "min_market_cap_jpy": 100000000000,
+    "min_free_float_ratio": 0.3
+  },
+  "position_limits": {
+    "max_names_per_proposal": 5,
+    "target_notional_per_name_jpy": 50000000,
+    "max_participation_ratio_of_adv": 0.05
+  },
+  "restricted": {
+    "prohibited_tickers": ["9999"],
+    "prohibited_sectors": ["gambling"],
+    "note": "Names under a group-wide restriction — an advisory mandate, an ongoing transaction, or an insider-list entry. The PoC needs at least one so the rejection path is exercised on every run."
+  },
+  "evidence": {
+    "min_citations_per_name": 1,
+    "require_quote_present_in_snapshot": true,
+    "max_disclosure_age_hours": 26
+  }
+}
