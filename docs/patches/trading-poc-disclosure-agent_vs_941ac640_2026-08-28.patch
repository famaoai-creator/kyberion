diff --git a/knowledge/product/pipeline-templates/trading-poc-execute.json b/knowledge/product/pipeline-templates/trading-poc-execute.json
new file mode 100644
index 00000000..489e21cf
--- /dev/null
+++ b/knowledge/product/pipeline-templates/trading-poc-execute.json
@@ -0,0 +1,49 @@
+{
+  "action": "pipeline",
+  "name": "trading-poc-execute",
+  "version": "1.0.0",
+  "description": "Post-approval half of the disclosure trading PoC. Records mock fills for the names the deterministic policy check admitted, but only against an approval that is approved, unexpired and bound by hash to that exact verified payload — then aggregates the day and evaluates the phase gate. No real order route is contacted; the run fails outright if one is configured.",
+  "context": {
+    "run_date": "",
+    "approval_channel": "terminal",
+    "approval_request_id": "",
+    "business_value_note": ""
+  },
+  "steps": [
+    {
+      "id": "j4_mock_fills",
+      "role": "sink",
+      "op": "trading:record_mock_fills",
+      "produces": { "channel": "mock_fills", "type": "MockFillSet" },
+      "params": {
+        "run_date": "{{run_date}}",
+        "approval_channel": "{{approval_channel}}",
+        "approval_request_id": "{{approval_request_id}}"
+      }
+    },
+    {
+      "id": "j5_evaluate_day",
+      "role": "transform",
+      "op": "trading:evaluate_day",
+      "consumes": "mock_fills",
+      "produces": { "channel": "daily_evaluation", "type": "DailyEvaluation" },
+      "params": { "run_date": "{{run_date}}" }
+    },
+    {
+      "id": "evaluate_gate",
+      "role": "transform",
+      "op": "trading:evaluate_gate",
+      "consumes": "daily_evaluation",
+      "produces": { "channel": "gate_report", "type": "GateReport" },
+      "params": { "run_date": "{{run_date}}", "business_value_note": "{{business_value_note}}" }
+    },
+    {
+      "role": "sink",
+      "op": "system:log",
+      "consumes": "gate_report",
+      "params": {
+        "message": "Phase gate for {{run_date}}: {{gate_report.report.overall}} — {{gate_report.report.reason}}"
+      }
+    }
+  ]
+}
diff --git a/knowledge/product/pipeline-templates/trading-poc-list-rehearsal.json b/knowledge/product/pipeline-templates/trading-poc-list-rehearsal.json
new file mode 100644
index 00000000..524164ad
--- /dev/null
+++ b/knowledge/product/pipeline-templates/trading-poc-list-rehearsal.json
@@ -0,0 +1,75 @@
+{
+  "action": "pipeline",
+  "name": "trading-poc-list-rehearsal",
+  "version": "1.0.0",
+  "description": "Rehearsal against a disclosure list a person obtained and placed in the repository — the route for a source whose operator refuses automated retrieval. It runs the four reasoning nodes over real headlines and then the deterministic policy check, and it deliberately has no market-data step: the point of the run is to see what the policy check refuses when the inputs it needs are absent. It stops before the approval gate, because a run this thin must never reach mock execution.",
+  "context": {
+    "run_date": "",
+    "disclosure_source": "operator-supplied-disclosure-list"
+  },
+  "steps": [
+    {
+      "id": "j1_ingest_list_export",
+      "role": "source",
+      "op": "trading:fetch_disclosures",
+      "produces": { "channel": "disclosure_snapshots", "type": "SnapshotSummary" },
+      "params": { "run_date": "{{run_date}}", "source_id": "{{disclosure_source}}" }
+    },
+    {
+      "id": "a1_classify",
+      "role": "transform",
+      "op": "trading:classify_disclosures",
+      "consumes": "disclosure_snapshots",
+      "produces": { "channel": "classifications", "type": "ClassificationSet" },
+      "params": { "run_date": "{{run_date}}" }
+    },
+    {
+      "id": "a2_summarize",
+      "role": "transform",
+      "op": "trading:summarize_disclosures",
+      "consumes": "classifications",
+      "produces": { "channel": "summaries", "type": "SummarySet" },
+      "params": { "run_date": "{{run_date}}" }
+    },
+    {
+      "id": "a3_select",
+      "role": "transform",
+      "op": "trading:select_candidates",
+      "consumes": "summaries",
+      "produces": { "channel": "proposal", "type": "SelectionProposal" },
+      "params": { "run_date": "{{run_date}}" }
+    },
+    {
+      "id": "a4_review",
+      "role": "transform",
+      "op": "trading:review_selection",
+      "consumes": "proposal",
+      "produces": { "channel": "review", "type": "SelectionReview" },
+      "params": { "run_date": "{{run_date}}" }
+    },
+    {
+      "id": "j3_verify_rules",
+      "role": "transform",
+      "op": "trading:verify_rules",
+      "consumes": "review",
+      "produces": { "channel": "verification", "type": "RuleVerificationResult" },
+      "params": { "run_date": "{{run_date}}" }
+    },
+    {
+      "id": "verify_traceability",
+      "role": "transform",
+      "op": "trading:verify_traceability",
+      "consumes": "verification",
+      "produces": { "channel": "traceability", "type": "TraceabilityResult" },
+      "params": { "run_date": "{{run_date}}" }
+    },
+    {
+      "role": "sink",
+      "op": "system:log",
+      "consumes": "verification",
+      "params": {
+        "message": "Rehearsal only. The policy check admitted {{verification.admitted}} and rejected {{verification.rejected}}. No approval was requested and mock execution is unreachable from this pipeline."
+      }
+    }
+  ]
+}
