diff --git a/libs/actuators/trading-actuator/src/agent-nodes.ts b/libs/actuators/trading-actuator/src/agent-nodes.ts
new file mode 100644
index 00000000..04bd54a4
--- /dev/null
+++ b/libs/actuators/trading-actuator/src/agent-nodes.ts
@@ -0,0 +1,461 @@
+import { checkCitations, enumerateLocators } from './citations.js';
+import {
+  asUntrustedData,
+  callNode,
+  parseJsonResponse,
+  reasoningIsStubbed,
+  stubMetric,
+} from './agent-runtime.js';
+import type {
+  Citation,
+  ClassifiedDisclosure,
+  Disclosure,
+  DisclosureSummary,
+  MarketData,
+  ReasoningCallMetric,
+  SelectedName,
+  SelectionProposal,
+  SelectionReview,
+} from './types.js';
+
+/**
+ * A1–A4: the reasoning nodes.
+ *
+ * Each node reads only what the acquisition plane stored, returns strict JSON,
+ * and produces nothing that can act on its own — the deterministic policy
+ * check and the human approval gate stand between every output here and mock
+ * execution.
+ */
+
+export interface NodeOutcome<T> {
+  value: T;
+  metrics: ReasoningCallMetric[];
+}
+
+/** Titles that are routine by construction; used by the stub path and as a prior. */
+const ROUTINE_TITLE_PATTERNS = [
+  /自己株式取得状況/u,
+  /自己株券買付状況報告書/u,
+  /月次売上高/u,
+  /変更報告書/u,
+  /大量保有報告書/u,
+  /定款の一部変更/u,
+  /代表電話番号/u,
+];
+
+const MATERIAL_TITLE_PATTERNS: Array<{ pattern: RegExp; weight: number; label: string }> = [
+  { pattern: /業績予想の(修正|下方修正|上方修正)/u, weight: 55, label: 'guidance revision' },
+  { pattern: /(減損損失|特別損失)/u, weight: 40, label: 'impairment or extraordinary loss' },
+  { pattern: /(製造販売承認申請|承認取得|治験)/u, weight: 38, label: 'regulatory filing' },
+  { pattern: /(株式譲渡|連結子会社の異動|吸収合併|株式取得)/u, weight: 36, label: 'portfolio change' },
+  { pattern: /第三者割当/u, weight: 34, label: 'equity issuance and dilution' },
+  { pattern: /(休止|稼働停止|生産停止)/u, weight: 30, label: 'capacity disruption' },
+  { pattern: /(新工場|設備投資)/u, weight: 26, label: 'capacity investment' },
+  { pattern: /価格改定/u, weight: 24, label: 'pricing action' },
+  { pattern: /システム障害/u, weight: 18, label: 'operational incident' },
+  { pattern: /受注/u, weight: 14, label: 'order intake' },
+];
+
+function looksRoutine(disclosure: Disclosure): boolean {
+  return ROUTINE_TITLE_PATTERNS.some((pattern) => pattern.test(disclosure.title));
+}
+
+function materialityScore(disclosure: Disclosure): { score: number; labels: string[] } {
+  const labels: string[] = [];
+  let score = 0;
+  for (const entry of MATERIAL_TITLE_PATTERNS) {
+    if (entry.pattern.test(disclosure.title)) {
+      score += entry.weight;
+      labels.push(entry.label);
+    }
+  }
+  // A paragraph carrying a concrete figure is more analysable than prose.
+  const quantified = disclosure.paragraphs.filter((text) => /[0-9０-９]/u.test(text)).length;
+  return { score: score + quantified, labels };
+}
+
+/** The paragraph with the most substance behind it — used as the stub's citation. */
+function bestQuote(disclosure: Disclosure): Citation {
+  const candidates = enumerateLocators(disclosure);
+  const quantified = candidates.filter((entry) => /[0-9０-９]/u.test(entry.text));
+  const chosen = (quantified.length > 0 ? quantified : candidates)[0];
+  return {
+    disclosure_id: disclosure.disclosure_id,
+    locator: chosen.locator,
+    // A short window, so the quote stays a quote rather than the whole paragraph.
+    quote: chosen.text.slice(0, 60),
+  };
+}
+
+// ---------------------------------------------------------------------------
+// A1 — classification
+// ---------------------------------------------------------------------------
+
+export async function classifyDisclosures(
+  disclosures: Disclosure[]
+): Promise<NodeOutcome<ClassifiedDisclosure[]>> {
+  if (reasoningIsStubbed()) {
+    const startedAt = Date.now();
+    const value = disclosures.map((disclosure) => {
+      const routine = looksRoutine(disclosure);
+      return {
+        disclosure_id: disclosure.disclosure_id,
+        ticker: disclosure.ticker,
+        category: routine ? 'routine_filing' : materialityScore(disclosure).labels[0] || 'other',
+        routine,
+        reason: routine
+          ? 'title matches a routine filing pattern'
+          : 'title indicates a potentially price-relevant event',
+      };
+    });
+    return { value, metrics: [stubMetric('A1', startedAt)] };
+  }
+
+  const catalogue = disclosures
+    .map(
+      (disclosure) =>
+        `- id: ${disclosure.disclosure_id} | ticker: ${disclosure.ticker} | title: ${disclosure.title}`
+    )
+    .join('\n');
+  const prompt = [
+    'You classify Japanese timely-disclosure filings for an investment research workflow.',
+    '',
+    'For each filing decide its category and whether it is routine — a periodic or administrative',
+    'filing that cannot plausibly move the share price on its own (buyback progress reports,',
+    'monthly sales figures, large-shareholding amendment reports, articles-of-incorporation edits).',
+    '',
+    'Return ONLY a JSON array, one object per filing:',
+    '[{"disclosure_id":"...","ticker":"...","category":"...","routine":true,"reason":"..."}]',
+    '',
+    asUntrustedData('Filing titles', catalogue),
+  ].join('\n');
+  const { text, metric } = await callNode('A1', prompt);
+  const parsed = parseJsonResponse<ClassifiedDisclosure[]>('A1', text);
+  // Anything the node dropped or invented is discarded — the snapshot set, not
+  // the response, decides which filings exist.
+  const byId = new Map(parsed.map((entry) => [entry.disclosure_id, entry]));
+  const value = disclosures.map((disclosure) => {
+    const entry = byId.get(disclosure.disclosure_id);
+    return {
+      disclosure_id: disclosure.disclosure_id,
+      ticker: disclosure.ticker,
+      category: entry?.category || 'unclassified',
+      routine: Boolean(entry?.routine),
+      reason: entry?.reason || 'node returned no classification for this filing',
+    };
+  });
+  return { value, metrics: [metric] };
+}
+
+// ---------------------------------------------------------------------------
+// A2 — summarisation with locator-preserving citations
+// ---------------------------------------------------------------------------
+
+const SEGMENT_HINTS: Array<{ pattern: RegExp; segment: string }> = [
+  { pattern: /オートメーション/u, segment: 'industrial automation' },
+  { pattern: /家電/u, segment: 'consumer appliances' },
+  { pattern: /呼吸器|線維症/u, segment: 'respiratory therapeutics' },
+  { pattern: /四輪|車体/u, segment: 'automotive production' },
+  { pattern: /決済/u, segment: 'payments' },
+  { pattern: /インターネットバンキング/u, segment: 'retail banking channels' },
+  { pattern: /SaaS/u, segment: 'saas' },
+  { pattern: /入園|パスポート/u, segment: 'theme park operations' },
+  { pattern: /高炉|粗鋼/u, segment: 'steel production' },
+  { pattern: /フォトレジスト|半導体/u, segment: 'semiconductor materials' },
+  { pattern: /新株式|希薄化/u, segment: 'capital structure' },
+];
+
+function renderDisclosure(disclosure: Disclosure): string {
+  const body = disclosure.paragraphs
+    .map((text, index) => `[para:${index}] ${text}`)
+    .join('\n');
+  const attachments = disclosure.attachments
+    .flatMap((attachment) =>
+      attachment.paragraphs.map(
+        (text, index) => `[attach:${attachment.name}:${index}] ${text}`
+      )
+    )
+    .join('\n');
+  return [
+    `disclosure_id: ${disclosure.disclosure_id}`,
+    `ticker: ${disclosure.ticker} (${disclosure.company_name})`,
+    `disclosed_at: ${disclosure.disclosed_at}`,
+    `title: ${disclosure.title}`,
+    body,
+    attachments,
+  ]
+    .filter((part) => part.length > 0)
+    .join('\n');
+}
+
+export async function summarizeDisclosures(
+  disclosures: Disclosure[]
+): Promise<NodeOutcome<DisclosureSummary[]>> {
+  if (reasoningIsStubbed()) {
+    const startedAt = Date.now();
+    const value = disclosures.map((disclosure) => {
+      const text = [...disclosure.paragraphs, ...disclosure.attachments.flatMap((a) => a.paragraphs)].join(
+        '\n'
+      );
+      return {
+        disclosure_id: disclosure.disclosure_id,
+        ticker: disclosure.ticker,
+        summary: disclosure.paragraphs[1] || disclosure.paragraphs[0] || disclosure.title,
+        affected_segments: SEGMENT_HINTS.filter((hint) => hint.pattern.test(text)).map(
+          (hint) => hint.segment
+        ),
+        citations: [bestQuote(disclosure)],
+      };
+    });
+    return { value, metrics: [stubMetric('A2', startedAt)] };
+  }
+
+  const rendered = disclosures.map((disclosure) => renderDisclosure(disclosure)).join('\n\n---\n\n');
+  const prompt = [
+    'You summarise Japanese timely-disclosure filings for an investment research workflow.',
+    '',
+    'For each filing produce a two-sentence factual summary, the business segments it affects, and',
+    'at least one citation. A citation is the locator tag shown in brackets plus a short verbatim',
+    'quote copied character-for-character from that paragraph. Never paraphrase inside a quote and',
+    'never cite a locator you were not shown — a downstream check compares every quote against the',
+    'stored document and a mismatch fails the run.',
+    '',
+    'Return ONLY a JSON array:',
+    '[{"disclosure_id":"...","ticker":"...","summary":"...","affected_segments":["..."],',
+    '  "citations":[{"disclosure_id":"...","locator":"para:2","quote":"..."}]}]',
+    '',
+    asUntrustedData('Filings', rendered),
+  ].join('\n');
+  const { text, metric } = await callNode('A2', prompt);
+  const parsed = parseJsonResponse<DisclosureSummary[]>('A2', text);
+  const byId = new Map(parsed.map((entry) => [entry.disclosure_id, entry]));
+  const value = disclosures
+    .map((disclosure) => byId.get(disclosure.disclosure_id))
+    .filter((entry): entry is DisclosureSummary => Boolean(entry))
+    .map((entry) => ({
+      ...entry,
+      affected_segments: Array.isArray(entry.affected_segments) ? entry.affected_segments : [],
+      citations: Array.isArray(entry.citations) ? entry.citations : [],
+    }));
+  return { value, metrics: [metric] };
+}
+
+/**
+ * Market data for a prompt, in units a reader would actually use.
+ *
+ * Market cap goes out in 億円 rather than raw yen for a reason beyond
+ * readability: a bare 13-digit integer is indistinguishable from a payment card
+ * number, and the governed egress gate blocks outbound text containing one —
+ * correctly, since it cannot know which 13-digit numbers are innocent. Two of
+ * the sample corpus's market caps happen to pass a Luhn check. Sending the
+ * figure in its natural unit removes the ambiguity instead of arguing with the
+ * guard, and loses no precision the selection node can use.
+ */
+export function renderMarketData(marketData: MarketData[]): string {
+  return marketData
+    .map((entry) => {
+      const capOku = Math.round(entry.market_cap_jpy / 100_000_000);
+      const advThousands = Math.round(entry.avg_daily_volume_20d / 1000);
+      return `- ${entry.ticker}: open ${entry.open} JPY, ADV20 ${advThousands}k shares, market cap ${capOku} oku JPY (100M units), free float ${entry.free_float_ratio}`;
+    })
+    .join('\n');
+}
+
+// ---------------------------------------------------------------------------
+// A3 — selection
+// ---------------------------------------------------------------------------
+
+export interface SelectCandidatesInput {
+  runDate: string;
+  disclosures: Disclosure[];
+  classifications: ClassifiedDisclosure[];
+  summaries: DisclosureSummary[];
+  marketData: MarketData[];
+  maxNames: number;
+}
+
+export async function selectCandidates(
+  input: SelectCandidatesInput
+): Promise<NodeOutcome<SelectionProposal>> {
+  const routine = new Set(
+    input.classifications.filter((entry) => entry.routine).map((entry) => entry.disclosure_id)
+  );
+  const eligible = input.disclosures.filter((entry) => !routine.has(entry.disclosure_id));
+  const dropped = input.disclosures
+    .filter((entry) => routine.has(entry.disclosure_id))
+    .map((entry) => ({
+      ticker: entry.ticker,
+      reason: `classified as a routine filing (${entry.title})`,
+    }));
+
+  if (reasoningIsStubbed()) {
+    const startedAt = Date.now();
+    const ranked = [...eligible]
+      .map((disclosure) => ({ disclosure, ...materialityScore(disclosure) }))
+      .sort((left, right) =>
+        right.score - left.score || left.disclosure.disclosure_id.localeCompare(right.disclosure.disclosure_id)
+      );
+    const summaryById = new Map(input.summaries.map((entry) => [entry.disclosure_id, entry]));
+    const selected = ranked.slice(0, input.maxNames).map((entry) => ({
+      ticker: entry.disclosure.ticker,
+      company_name: entry.disclosure.company_name,
+      rationale: `${entry.labels.join(', ') || 'quantified disclosure'} — worth attention against the policy, not a price forecast`,
+      citations: summaryById.get(entry.disclosure.disclosure_id)?.citations || [
+        bestQuote(entry.disclosure),
+      ],
+    }));
+    const overflow = ranked.slice(input.maxNames).map((entry) => ({
+      ticker: entry.disclosure.ticker,
+      reason: `ranked below the top ${input.maxNames} on disclosure materiality`,
+    }));
+    return {
+      value: { run_date: input.runDate, selected, considered_and_dropped: [...dropped, ...overflow] },
+      metrics: [stubMetric('A3', startedAt)],
+    };
+  }
+
+  const summaryText = input.summaries
+    .map(
+      (entry) =>
+        `- ${entry.disclosure_id} (${entry.ticker}): ${entry.summary} | segments: ${entry.affected_segments.join(', ') || 'n/a'} | citations: ${entry.citations
+          .map((citation) => `${citation.locator}="${citation.quote}"`)
+          .join(' ; ')}`
+    )
+    .join('\n');
+  const marketText = renderMarketData(input.marketData);
+  const prompt = [
+    `You select the names worth attention from ${input.runDate}'s timely disclosures.`,
+    '',
+    `Choose at most ${input.maxNames} names. The question is which disclosures deserve an analyst's`,
+    'attention today under the investment policy — NOT which share prices will rise. Never state or',
+    'imply a price direction, target or probability of gain.',
+    '',
+    'Every selected name needs at least one citation: a locator plus a verbatim quote from the',
+    'summarised filings below. A quote that does not appear in the stored document fails the run.',
+    'Also list the names you considered and dropped, with the reason.',
+    '',
+    'Return ONLY a JSON object:',
+    '{"selected":[{"ticker":"...","company_name":"...","rationale":"...",',
+    '  "citations":[{"disclosure_id":"...","locator":"para:2","quote":"..."}]}],',
+    ' "considered_and_dropped":[{"ticker":"...","reason":"..."}]}',
+    '',
+    asUntrustedData('Disclosure summaries', summaryText),
+    '',
+    `Market data (internal, trusted):\n${marketText}`,
+  ].join('\n');
+  const { text, metric } = await callNode('A3', prompt);
+  const parsed = parseJsonResponse<Partial<SelectionProposal>>('A3', text);
+  const selected = (Array.isArray(parsed.selected) ? parsed.selected : []).map(
+    (entry): SelectedName => ({
+      ticker: String(entry.ticker || ''),
+      company_name: String(entry.company_name || ''),
+      rationale: String(entry.rationale || ''),
+      citations: Array.isArray(entry.citations) ? entry.citations : [],
+    })
+  );
+  return {
+    value: {
+      run_date: input.runDate,
+      selected,
+      considered_and_dropped: [
+        ...dropped,
+        ...(Array.isArray(parsed.considered_and_dropped) ? parsed.considered_and_dropped : []),
+      ],
+    },
+    metrics: [metric],
+  };
+}
+
+// ---------------------------------------------------------------------------
+// A4 — independent review
+// ---------------------------------------------------------------------------
+
+export interface ReviewSelectionInput {
+  runDate: string;
+  proposal: SelectionProposal;
+  disclosures: Disclosure[];
+}
+
+export async function reviewSelection(
+  input: ReviewSelectionInput
+): Promise<NodeOutcome<SelectionReview>> {
+  const disclosureIndex = new Map(input.disclosures.map((entry) => [entry.disclosure_id, entry]));
+
+  if (reasoningIsStubbed()) {
+    const startedAt = Date.now();
+    const findings: SelectionReview['findings'] = [];
+    const rejected = new Set<string>();
+    for (const name of input.proposal.selected) {
+      for (const check of checkCitations(name.citations, disclosureIndex)) {
+        findings.push({
+          ticker: name.ticker,
+          citation_locator: check.citation.locator,
+          verdict: check.verdict,
+          note: check.detail,
+        });
+        if (check.verdict !== 'grounded') rejected.add(name.ticker);
+      }
+      if (name.citations.length === 0) {
+        findings.push({
+          ticker: name.ticker,
+          citation_locator: '(none)',
+          verdict: 'unverifiable',
+          note: 'the selection carries no citation at all',
+        });
+        rejected.add(name.ticker);
+      }
+    }
+    return {
+      value: { run_date: input.runDate, findings, rejected_tickers: [...rejected] },
+      metrics: [stubMetric('A4', startedAt)],
+    };
+  }
+
+  const cited = new Set(
+    input.proposal.selected.flatMap((name) =>
+      name.citations.map((citation) => citation.disclosure_id)
+    )
+  );
+  const evidence = input.disclosures
+    .filter((disclosure) => cited.has(disclosure.disclosure_id))
+    .map((disclosure) => renderDisclosure(disclosure))
+    .join('\n\n---\n\n');
+  const claims = input.proposal.selected
+    .map(
+      (name) =>
+        `- ${name.ticker} (${name.company_name}): ${name.rationale}\n  citations: ${name.citations
+          .map((citation) => `${citation.disclosure_id}#${citation.locator}="${citation.quote}"`)
+          .join(' ; ')}`
+    )
+    .join('\n');
+  const prompt = [
+    'You are the review node. Another model produced the selection below. Your job is to find what',
+    'it got wrong, not to agree with it.',
+    '',
+    'For every citation decide: "grounded" if the quote appears verbatim at that locator in the',
+    'documents supplied; "fabricated" if the quote does not appear in that document at all;',
+    '"unverifiable" if the locator is wrong or the quote cannot be checked from what you were given.',
+    'Also flag a rationale that asserts something the documents do not support, or that predicts a',
+    'price move.',
+    '',
+    'List the tickers that should be dropped.',
+    '',
+    'Return ONLY a JSON object:',
+    '{"findings":[{"ticker":"...","citation_locator":"...","verdict":"grounded","note":"..."}],',
+    ' "rejected_tickers":["..."]}',
+    '',
+    `Selection under review:\n${claims}`,
+    '',
+    asUntrustedData('Source documents', evidence),
+  ].join('\n');
+  const { text, metric } = await callNode('A4', prompt);
+  const parsed = parseJsonResponse<Partial<SelectionReview>>('A4', text);
+  return {
+    value: {
+      run_date: input.runDate,
+      findings: Array.isArray(parsed.findings) ? parsed.findings : [],
+      rejected_tickers: Array.isArray(parsed.rejected_tickers) ? parsed.rejected_tickers : [],
+    },
+    metrics: [metric],
+  };
+}
