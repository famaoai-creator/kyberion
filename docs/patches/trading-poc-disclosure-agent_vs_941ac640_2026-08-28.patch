@@ -0,0 +1,173 @@
+/**
+ * Domain types for the disclosure-driven trading PoC.
+ *
+ * Two planes, and the type system carries the distinction: everything the
+ * acquisition plane produces is a {@link SnapshotRef} — an immutable,
+ * hash-addressed byte range on disk. The execution plane reads snapshots and
+ * never a live source, so a citation can always be re-resolved to the exact
+ * bytes a conclusion was drawn from.
+ */
+
+/** Snapshot kinds the acquisition jobs may write. */
+export type SnapshotKind = 'disclosure' | 'market-data';
+
+/** One manifest row: the audit trail's anchor for a set of bytes. */
+export interface SnapshotRecord {
+  kind: SnapshotKind;
+  key: string;
+  /** Repo-relative path of the stored bytes. */
+  path: string;
+  sha256: string;
+  bytes: number;
+  fetched_at: string;
+  /** Where the bytes came from — a source id, plus a URL when one applies. */
+  source: { source_id: string; url?: string };
+}
+
+/** A disclosure as the acquisition plane stored it. */
+export interface Disclosure {
+  disclosure_id: string;
+  ticker: string;
+  company_name: string;
+  market: string;
+  sector: string;
+  disclosed_at: string;
+  title: string;
+  /** Paragraphs, in document order. Locators address these by index. */
+  paragraphs: string[];
+  /** Attachments and notes — the places body-only scanning misses. */
+  attachments: Array<{ name: string; paragraphs: string[] }>;
+  /**
+   * How much of the document was actually captured.
+   *
+   * `full_text` means the paragraphs are the document. `title_only` means the
+   * source was a list page and the sole paragraph is a headline — traceable,
+   * but not the paragraph-level evidence the audit criterion asks for, so the
+   * policy check refuses to admit it (rule R012). Absent means `full_text`,
+   * which keeps existing snapshots valid.
+   */
+  evidence_depth?: 'full_text' | 'title_only';
+  /** Where the full document lives, when the source names it but did not fetch it. */
+  document_url?: string;
+}
+
+/** Market data for one name, as the acquisition plane stored it. */
+export interface MarketData {
+  ticker: string;
+  as_of: string;
+  open: number;
+  close: number;
+  avg_daily_volume_20d: number;
+  market_cap_jpy: number;
+  free_float_ratio: number;
+}
+
+/**
+ * A pointer into a snapshot: which disclosure, which paragraph, and the exact
+ * quote. Deterministic verification resolves all three — a quote that is not
+ * present at that locator is a fabricated citation, no model opinion needed.
+ */
+export interface Citation {
+  disclosure_id: string;
+  /** `para:<n>` for the body, `attach:<name>:<n>` for an attachment. */
+  locator: string;
+  quote: string;
+}
+
+/** A1 output. */
+export interface ClassifiedDisclosure {
+  disclosure_id: string;
+  ticker: string;
+  category: string;
+  /** True when the disclosure is routine and cannot plausibly move a price. */
+  routine: boolean;
+  reason: string;
+}
+
+/** A2 output. */
+export interface DisclosureSummary {
+  disclosure_id: string;
+  ticker: string;
+  summary: string;
+  affected_segments: string[];
+  citations: Citation[];
+}
+
+/** A3 output: one selected name. */
+export interface SelectedName {
+  ticker: string;
+  company_name: string;
+  /** Why this name is worth attention — never a price prediction. */
+  rationale: string;
+  citations: Citation[];
+}
+
+/** A3 output. */
+export interface SelectionProposal {
+  run_date: string;
+  selected: SelectedName[];
+  /** Names considered and dropped, with the reason, so the trail is complete. */
+  considered_and_dropped: Array<{ ticker: string; reason: string }>;
+}
+
+/** A4 output: the independent review of A3. */
+export interface SelectionReview {
+  run_date: string;
+  findings: Array<{
+    ticker: string;
+    citation_locator: string;
+    verdict: 'grounded' | 'fabricated' | 'unverifiable';
+    note: string;
+  }>;
+  /** Tickers A4 asks to drop. */
+  rejected_tickers: string[];
+}
+
+/** One deterministic rule evaluation. */
+export interface RuleEvaluation {
+  rule_id: string;
+  title: string;
+  result: 'pass' | 'fail' | 'not_applicable';
+  detail: string;
+}
+
+/** J3 output for one name. */
+export interface RuleVerdict {
+  ticker: string;
+  passed: boolean;
+  evaluations: RuleEvaluation[];
+}
+
+/** J3 output. */
+export interface RuleVerificationResult {
+  run_date: string;
+  policy_version: string;
+  verdicts: RuleVerdict[];
+  /** Names the engine rejected, every one with its failing rules. */
+  rejected: RuleVerdict[];
+  /** Hash of the verified payload — the approval gate binds to this. */
+  payload_hash: string;
+}
+
+/** J4 output: a fill that was recorded, never placed. */
+export interface MockFill {
+  ticker: string;
+  side: 'buy';
+  quantity: number;
+  /** Opening price — the PoC's fill convention. */
+  price: number;
+  notional_jpy: number;
+  recorded_at: string;
+  /** The approval that admitted this fill. */
+  approval_ref: { request_id: string; decided_by: string; payload_hash: string };
+}
+
+/** Per-call reasoning telemetry, aggregated by J5 into cost and latency. */
+export interface ReasoningCallMetric {
+  node: 'A1' | 'A2' | 'A3' | 'A4';
+  model: string;
+  latency_ms: number;
+  prompt_chars: number;
+  completion_chars: number;
+  mode: 'reasoning' | 'deterministic-stub';
+}
