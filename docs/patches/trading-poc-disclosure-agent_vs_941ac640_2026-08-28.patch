diff --git a/knowledge/product/governance/trading-poc-agent-roster.json b/knowledge/product/governance/trading-poc-agent-roster.json
new file mode 100644
index 00000000..eac60747
--- /dev/null
+++ b/knowledge/product/governance/trading-poc-agent-roster.json
@@ -0,0 +1,27 @@
+{
+  "$comment": "Reasoning nodes for the disclosure trading PoC. A4 reviews A3's work and must therefore run on a different model — a model asked to check itself reproduces its own blind spots, which is exactly the failure the review node exists to catch. The roster is validated on every run, not just documented.",
+  "version": "1.0.0",
+  "nodes": {
+    "A1": {
+      "purpose": "Classify disclosure type and drop routine filings that cannot move a price.",
+      "role": "trading_poc_classifier",
+      "model_tier": "fast"
+    },
+    "A2": {
+      "purpose": "Summarise each disclosure and name the affected business segments, keeping the exact paragraph each claim came from.",
+      "role": "trading_poc_summarizer",
+      "model_tier": "standard"
+    },
+    "A3": {
+      "purpose": "Select the names worth attention and state why, citing the disclosure paragraphs.",
+      "role": "trading_poc_selector",
+      "model_tier": "deep"
+    },
+    "A4": {
+      "purpose": "Independently review A3's selection and flag any claim not grounded in the snapshots.",
+      "role": "trading_poc_reviewer",
+      "model_tier": "deep",
+      "must_differ_from": "A3"
+    }
+  }
+}
