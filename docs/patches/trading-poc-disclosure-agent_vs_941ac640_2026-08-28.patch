diff --git a/infra/trading-poc/README.md b/infra/trading-poc/README.md
new file mode 100644
index 00000000..2cd8680c
--- /dev/null
+++ b/infra/trading-poc/README.md
@@ -0,0 +1,68 @@
+# Disclosure trading PoC — infrastructure
+
+Terraform for the two-plane architecture the PoC depends on: an acquisition
+plane that may reach declared hosts and uses no model, and an execution plane
+that runs the reasoning nodes with no route to the internet at all.
+
+The application side lives in `libs/actuators/trading-actuator/` and runs the
+same flow locally against the same controls, so the design can be exercised
+before any of this is applied.
+
+## Layout
+
+| File | Contents |
+| --- | --- |
+| `network.tf` | VPC, the two planes, and the routing that keeps them apart |
+| `firewall.tf` | Network Firewall, the domain allowlist, drop-by-default, alert and flow logs |
+| `storage.tf` | Snapshot and audit buckets under Object Lock in COMPLIANCE mode, KMS |
+| `endpoints.tf` | The execution plane's only routes: PrivateLink endpoints and the S3 gateway |
+| `iam.tf` | One role per job, with the cross-plane denials stated explicitly |
+| `compute.tf` | Fargate acquisition jobs and their 07:30 / 07:45 JST schedules |
+| `observability.tf` | CloudTrail with snapshot data events, and the alarms worth waking someone for |
+| `scp.tf` | Isolation guardrails, attached to a PoC-only OU |
+| `checks.tf` | Assertions that fail `terraform plan` when a load-bearing property is eroded |
+| `policies/` | Cedar policies for the agent runtime's tool calls |
+
+## Applying it
+
+```bash
+cd infra/trading-poc
+terraform init
+terraform plan -var="poc_organizational_unit_id=ou-xxxx-xxxxxxxx"
+```
+
+`terraform plan` fails while the PoC-only OU is unset. That is deliberate: with
+no OU the guardrails attach to nothing and the isolation claim rests on
+operational care, which is worth discovering before Phase 0 rather than during
+the production decision.
+
+## What is deliberately not here, and why
+
+**The AgentCore resource blocks.** Region availability per component is an open
+question the proposal lists as a Phase 0 entry condition, and a Terraform
+resource written against an assumed API surface is worse than an explicit gap —
+it looks finished. The Cedar policies the runtime needs are written and ready in
+`policies/`; wire them in once the availability answer is in writing.
+
+**A production container image.** `compute.tf` references a public Node image
+and a command that only prints a version, so a deploy against the placeholder
+fails visibly instead of running an empty task on a schedule.
+
+**A second region.** The proposal's own open question is whether every AgentCore
+component is available in Osaka. Until that is answered, adding a standby region
+would encode an assumption rather than a decision.
+
+## Two things to keep in step
+
+The allowlist appears twice on purpose — in `var.allowed_acquisition_domains`
+here, and in `allowlist_hosts` in
+`knowledge/product/governance/trading-poc-sources.json`. The application refuses
+a host absent from its own registry and the firewall refuses a host absent from
+this one; a host permitted by only one of them is refused, which is the failure
+direction to want. Still, a divergence means one of the two has stopped
+describing reality, so change them together.
+
+The retention figures in `snapshot_retention_days` and
+`audit_log_retention_days` cannot be shortened after apply. COMPLIANCE mode is
+what makes the audit trail worth relying on, and it is also what makes a wrong
+number expensive — agree them with the audit function first.
diff --git a/infra/trading-poc/checks.tf b/infra/trading-poc/checks.tf
new file mode 100644
index 00000000..626524a0
--- /dev/null
+++ b/infra/trading-poc/checks.tf
@@ -0,0 +1,40 @@
+# Assertions that fail the plan rather than the audit.
+#
+# Each one restates a property the design depends on. They exist because these
+# are exactly the properties a later, well-meaning change erodes: adding a route
+# "just for the build", widening the allowlist during debugging, dropping Object
+# Lock because a test bucket was inconvenient.
+
+check "execution_plane_has_no_default_route" {
+  assert {
+    condition = length([
+      for route in aws_route_table.execution.route :
+      route if route.cidr_block == "0.0.0.0/0"
+    ]) == 0
+    error_message = "The execution route table has a default route. The reasoning nodes must have no path to the internet; remove it rather than relaxing this check."
+  }
+}
+
+check "acquisition_allowlist_is_not_empty_or_wildcarded" {
+  assert {
+    condition = length(var.allowed_acquisition_domains) > 0 && length([
+      for domain in var.allowed_acquisition_domains :
+      domain if can(regex("^\\*$|^\\.$", domain))
+    ]) == 0
+    error_message = "The acquisition allowlist is empty or contains a bare wildcard. An allowlist that permits everything is not an allowlist."
+  }
+}
+
+check "snapshot_retention_is_meaningful" {
+  assert {
+    condition     = var.snapshot_retention_days >= 90
+    error_message = "Input snapshots must be retained long enough to reproduce an audited run. Agree the figure with the audit function; it cannot be shortened after apply."
+  }
+}
+
+check "poc_ou_is_set" {
+  assert {
+    condition     = var.poc_organizational_unit_id != ""
+    error_message = "No PoC-only organizational unit was supplied, so the isolation guardrails are not attached to anything. Without the SCP the isolation claim rests on operational care alone — resolve this before Phase 0 rather than during it."
+  }
+}
diff --git a/infra/trading-poc/compute.tf b/infra/trading-poc/compute.tf
new file mode 100644
index 00000000..4607f467
--- /dev/null
+++ b/infra/trading-poc/compute.tf
@@ -0,0 +1,145 @@
+# The acquisition jobs, and their schedule.
+#
+# The jobs run on Fargate in the acquisition subnets; nothing else does. Their
+# only outputs are snapshots, and the schedule places them ahead of the
+# reasoning nodes so the execution plane always has stored bytes to read rather
+# than a live source to fetch.
+
+resource "aws_ecs_cluster" "poc" {
+  name = "${var.name_prefix}-cluster"
+
+  setting {
+    name  = "containerInsights"
+    value = "enabled"
+  }
+}
+
+resource "aws_cloudwatch_log_group" "jobs" {
+  name              = "/${var.name_prefix}/jobs"
+  retention_in_days = 90
+}
+
+resource "aws_cloudwatch_log_group" "agents" {
+  name              = "/${var.name_prefix}/agents"
+  retention_in_days = 90
+}
+
+resource "aws_security_group" "acquisition_job" {
+  name        = "${var.name_prefix}-acquisition-job"
+  description = "Acquisition jobs: outbound HTTPS only, and only through the firewall"
+  vpc_id      = aws_vpc.poc.id
+
+  egress {
+    description = "HTTPS, which the Network Firewall then narrows to the allowlist"
+    from_port   = 443
+    to_port     = 443
+    protocol    = "tcp"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+
+  tags = { Name = "${var.name_prefix}-acquisition-job" }
+}
+
+resource "aws_ecs_task_definition" "acquisition" {
+  family                   = "${var.name_prefix}-acquisition"
+  requires_compatibilities = ["FARGATE"]
+  network_mode             = "awsvpc"
+  cpu                      = "512"
+  memory                   = "1024"
+  execution_role_arn       = aws_iam_role.task_execution.arn
+  task_role_arn            = aws_iam_role.acquisition_job.arn
+
+  container_definitions = jsonencode([
+    {
+      name      = "acquisition"
+      image     = "public.ecr.aws/docker/library/node:22-alpine"
+      essential = true
+      # Replace with the built acquisition image. The command is left explicit
+      # so a deploy against the placeholder image fails visibly instead of
+      # starting a container that silently does nothing.
+      command = ["node", "--version"]
+      environment = [
+        { name = "SNAPSHOT_BUCKET", value = aws_s3_bucket.snapshots.id },
+        { name = "AWS_REGION", value = data.aws_region.current.name },
+      ]
+      logConfiguration = {
+        logDriver = "awslogs"
+        options = {
+          "awslogs-group"         = aws_cloudwatch_log_group.jobs.name
+          "awslogs-region"        = data.aws_region.current.name
+          "awslogs-stream-prefix" = "acquisition"
+        }
+      }
+    },
+  ])
+}
+
+# 07:30 JST — the disclosures released since the prior close.
+resource "aws_scheduler_schedule" "fetch_disclosures" {
+  name                         = "${var.name_prefix}-j1-fetch-disclosures"
+  schedule_expression          = "cron(30 7 ? * MON-FRI *)"
+  schedule_expression_timezone = "Asia/Tokyo"
+  flexible_time_window {
+    mode = "OFF"
+  }
+
+  target {
+    arn      = aws_ecs_cluster.poc.arn
+    role_arn = aws_iam_role.scheduler.arn
+
+    ecs_parameters {
+      task_definition_arn = aws_ecs_task_definition.acquisition.arn
+      launch_type         = "FARGATE"
+
+      network_configuration {
+        subnets          = aws_subnet.acquisition[*].id
+        security_groups  = [aws_security_group.acquisition_job.id]
+        assign_public_ip = false
+      }
+    }
+
+    input = jsonencode({
+      containerOverrides = [
+        {
+          name        = "acquisition"
+          environment = [{ name = "JOB", value = "J1_FETCH_DISCLOSURES" }]
+        },
+      ]
+    })
+  }
+}
+
+# 07:45 JST — prices, volume, market cap and free float.
+resource "aws_scheduler_schedule" "fetch_market_data" {
+  name                         = "${var.name_prefix}-j2-fetch-market-data"
+  schedule_expression          = "cron(45 7 ? * MON-FRI *)"
+  schedule_expression_timezone = "Asia/Tokyo"
+  flexible_time_window {
+    mode = "OFF"
+  }
+
+  target {
+    arn      = aws_ecs_cluster.poc.arn
+    role_arn = aws_iam_role.scheduler.arn
+
+    ecs_parameters {
+      task_definition_arn = aws_ecs_task_definition.acquisition.arn
+      launch_type         = "FARGATE"
+
+      network_configuration {
+        subnets          = aws_subnet.acquisition[*].id
+        security_groups  = [aws_security_group.acquisition_job.id]
+        assign_public_ip = false
+      }
+    }
+
+    input = jsonencode({
+      containerOverrides = [
+        {
+          name        = "acquisition"
+          environment = [{ name = "JOB", value = "J2_FETCH_MARKET_DATA" }]
+        },
+      ]
+    })
+  }
+}
diff --git a/infra/trading-poc/endpoints.tf b/infra/trading-poc/endpoints.tf
new file mode 100644
index 00000000..2d1eba8d
--- /dev/null
+++ b/infra/trading-poc/endpoints.tf
@@ -0,0 +1,98 @@
+# VPC endpoints: the execution plane's only routes anywhere.
+#
+# Interface endpoints for Bedrock, logs and secrets, plus a gateway endpoint for
+# S3. Every endpoint policy is scoped to this account's resources, so even an
+# endpoint the agents can reach cannot be used to read someone else's bucket.
+
+resource "aws_security_group" "endpoints" {
+  name        = "${var.name_prefix}-endpoints"
+  description = "Inbound HTTPS from the execution plane only"
+  vpc_id      = aws_vpc.poc.id
+
+  ingress {
+    description = "HTTPS from the execution subnets"
+    from_port   = 443
+    to_port     = 443
+    protocol    = "tcp"
+    cidr_blocks = var.execution_subnet_cidrs
+  }
+
+  # No egress rule at all: an interface endpoint terminates the connection, so
+  # the security group needs no outbound path and giving it one would only widen
+  # the surface.
+
+  tags = { Name = "${var.name_prefix}-endpoints" }
+}
+
+locals {
+  interface_endpoint_services = {
+    bedrock_runtime = "bedrock-runtime"
+    bedrock_agent   = "bedrock-agent-runtime"
+    logs            = "logs"
+    monitoring      = "monitoring"
+    secretsmanager  = "secretsmanager"
+    kms             = "kms"
+    sts             = "sts"
+  }
+}
+
+resource "aws_vpc_endpoint" "interface" {
+  for_each = local.interface_endpoint_services
+
+  vpc_id              = aws_vpc.poc.id
+  service_name        = "com.amazonaws.${data.aws_region.current.name}.${each.value}"
+  vpc_endpoint_type   = "Interface"
+  subnet_ids          = aws_subnet.execution[*].id
+  security_group_ids  = [aws_security_group.endpoints.id]
+  private_dns_enabled = true
+
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Effect    = "Allow"
+        Principal = "*"
+        Action    = "*"
+        Resource  = "*"
+        Condition = {
+          StringEquals = {
+            "aws:PrincipalAccount" = data.aws_caller_identity.current.account_id
+          }
+        }
+      },
+    ]
+  })
+
+  tags = { Name = "${var.name_prefix}-endpoint-${each.key}" }
+}
+
+resource "aws_vpc_endpoint" "s3" {
+  vpc_id            = aws_vpc.poc.id
+  service_name      = "com.amazonaws.${data.aws_region.current.name}.s3"
+  vpc_endpoint_type = "Gateway"
+
+  route_table_ids = concat(
+    [aws_route_table.execution.id],
+    aws_route_table.acquisition[*].id,
+  )
+
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Sid       = "OnlyThisPocBuckets"
+        Effect    = "Allow"
+        Principal = "*"
+        Action    = ["s3:GetObject", "s3:PutObject", "s3:ListBucket", "s3:GetObjectVersion"]
+        Resource = [
+          aws_s3_bucket.snapshots.arn,
+          "${aws_s3_bucket.snapshots.arn}/*",
+          aws_s3_bucket.audit.arn,
+          "${aws_s3_bucket.audit.arn}/*",
+        ]
+      },
+    ]
+  })
+
+  tags = { Name = "${var.name_prefix}-endpoint-s3" }
+}
diff --git a/infra/trading-poc/firewall.tf b/infra/trading-poc/firewall.tf
new file mode 100644
index 00000000..ef481534
--- /dev/null
+++ b/infra/trading-poc/firewall.tf
@@ -0,0 +1,112 @@
+# Network Firewall: the domain allowlist, enforced.
+#
+# The stateless rule group sends everything to stateful inspection, and the
+# stateful group permits TLS only to the declared domains and drops the rest.
+# The default action is drop, so a domain that was never declared is refused
+# rather than reaching the internet because nobody wrote a rule about it.
+
+resource "aws_networkfirewall_rule_group" "allowlist" {
+  name     = "${var.name_prefix}-domain-allowlist"
+  capacity = 100
+  type     = "STATEFUL"
+
+  rule_group {
+    rule_variables {
+      ip_sets {
+        key = "HOME_NET"
+        ip_set {
+          definition = var.acquisition_subnet_cidrs
+        }
+      }
+    }
+
+    rules_source {
+      rules_source_list {
+        generated_rules_type = "ALLOWLIST"
+        target_types         = ["TLS_SNI", "HTTP_HOST"]
+        targets              = var.allowed_acquisition_domains
+      }
+    }
+  }
+
+  tags = { Name = "${var.name_prefix}-domain-allowlist" }
+}
+
+resource "aws_networkfirewall_firewall_policy" "poc" {
+  name = "${var.name_prefix}-policy"
+
+  firewall_policy {
+    # Anything not matched by a stateful rule is dropped. Combined with the
+    # ALLOWLIST group above, an undeclared destination has no path out.
+    stateless_default_actions          = ["aws:forward_to_sfe"]
+    stateless_fragment_default_actions = ["aws:forward_to_sfe"]
+    stateful_default_actions           = ["aws:drop_strict", "aws:alert_strict"]
+
+    stateful_engine_options {
+      rule_order = "STRICT_ORDER"
+    }
+
+    stateful_rule_group_reference {
+      priority     = 100
+      resource_arn = aws_networkfirewall_rule_group.allowlist.arn
+    }
+  }
+
+  tags = { Name = "${var.name_prefix}-policy" }
+}
+
+resource "aws_networkfirewall_firewall" "poc" {
+  name                = "${var.name_prefix}-firewall"
+  firewall_policy_arn = aws_networkfirewall_firewall_policy.poc.arn
+  vpc_id              = aws_vpc.poc.id
+
+  # Deletion protection on by default: an accidental destroy would leave the
+  # acquisition subnets routing to a firewall endpoint that no longer exists,
+  # which fails closed but takes the PoC down with it.
+  delete_protection = true
+
+  dynamic "subnet_mapping" {
+    for_each = aws_subnet.firewall
+    content {
+      subnet_id = subnet_mapping.value.id
+    }
+  }
+
+  tags = { Name = "${var.name_prefix}-firewall" }
+}
+
+resource "aws_cloudwatch_log_group" "firewall_alerts" {
+  name              = "/aws/networkfirewall/${var.name_prefix}/alert"
+  retention_in_days = 90
+  tags              = { Name = "${var.name_prefix}-firewall-alert" }
+}
+
+resource "aws_cloudwatch_log_group" "firewall_flows" {
+  name              = "/aws/networkfirewall/${var.name_prefix}/flow"
+  retention_in_days = 90
+  tags              = { Name = "${var.name_prefix}-firewall-flow" }
+}
+
+# Both alert and flow logs are kept: the red-team exercise needs to show what a
+# blocked attempt looked like, not only that the count was zero.
+resource "aws_networkfirewall_logging_configuration" "poc" {
+  firewall_arn = aws_networkfirewall_firewall.poc.arn
+
+  logging_configuration {
+    log_destination_config {
+      log_destination_type = "CloudWatchLogs"
+      log_type             = "ALERT"
+      log_destination = {
+        logGroup = aws_cloudwatch_log_group.firewall_alerts.name
+      }
+    }
+
+    log_destination_config {
+      log_destination_type = "CloudWatchLogs"
+      log_type             = "FLOW"
+      log_destination = {
+        logGroup = aws_cloudwatch_log_group.firewall_flows.name
+      }
+    }
+  }
+}
diff --git a/infra/trading-poc/iam.tf b/infra/trading-poc/iam.tf
new file mode 100644
index 00000000..36d42819
--- /dev/null
+++ b/infra/trading-poc/iam.tf
@@ -0,0 +1,259 @@
+# Roles, one per job in the flow.
+#
+# The split matters more than the individual permissions: the role that can
+# reach the internet cannot invoke a model, and the role that invokes models
+# cannot write a snapshot. A single role holding both would make the plane
+# separation a networking detail rather than an authorisation boundary.
+
+data "aws_iam_policy_document" "ecs_assume" {
+  statement {
+    effect  = "Allow"
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    effect  = "Allow"
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+
+data "aws_iam_policy_document" "bedrock_assume" {
+  statement {
+    effect  = "Allow"
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["bedrock.amazonaws.com"]
+    }
+    condition {
+      test     = "StringEquals"
+      variable = "aws:SourceAccount"
+      values   = [data.aws_caller_identity.current.account_id]
+    }
+  }
+}
+
+# --- J1 / J2: acquisition jobs ----------------------------------------------
+
+resource "aws_iam_role" "acquisition_job" {
+  name               = "${var.name_prefix}-acquisition-job"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+  tags               = { Plane = "acquisition" }
+}
+
+data "aws_iam_policy_document" "acquisition_job" {
+  statement {
+    sid    = "WriteSnapshotsOnly"
+    effect = "Allow"
+    actions = [
+      "s3:PutObject",
+      "s3:PutObjectRetention",
+      "s3:GetObject",
+      "s3:ListBucket",
+    ]
+    resources = [aws_s3_bucket.snapshots.arn, "${aws_s3_bucket.snapshots.arn}/*"]
+  }
+
+  statement {
+    sid       = "EncryptWithPocKey"
+    effect    = "Allow"
+    actions   = ["kms:GenerateDataKey", "kms:Decrypt"]
+    resources = [aws_kms_key.poc.arn]
+  }
+
+  statement {
+    sid       = "Logs"
+    effect    = "Allow"
+    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
+    resources = ["${aws_cloudwatch_log_group.jobs.arn}:*"]
+  }
+
+  # The acquisition jobs use no model. Denying Bedrock outright means an
+  # "improvement" that puts a summarisation call inside the fetch job fails at
+  # deploy time rather than quietly reintroducing a model on the plane that can
+  # reach the internet.
+  statement {
+    sid       = "NoModelInvocationOnTheAcquisitionPlane"
+    effect    = "Deny"
+    actions   = ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"]
+    resources = ["*"]
+  }
+}
+
+resource "aws_iam_role_policy" "acquisition_job" {
+  name   = "${var.name_prefix}-acquisition-job"
+  role   = aws_iam_role.acquisition_job.id
+  policy = data.aws_iam_policy_document.acquisition_job.json
+}
+
+# --- A1–A4: the agent runtime -----------------------------------------------
+
+resource "aws_iam_role" "agent_runtime" {
+  name               = "${var.name_prefix}-agent-runtime"
+  assume_role_policy = data.aws_iam_policy_document.bedrock_assume.json
+  tags               = { Plane = "execution" }
+}
+
+data "aws_iam_policy_document" "agent_runtime" {
+  statement {
+    sid       = "ReadSnapshotsOnly"
+    effect    = "Allow"
+    actions   = ["s3:GetObject", "s3:GetObjectVersion", "s3:ListBucket"]
+    resources = [aws_s3_bucket.snapshots.arn, "${aws_s3_bucket.snapshots.arn}/*"]
+  }
+
+  statement {
+    sid       = "DecryptSnapshots"
+    effect    = "Allow"
+    actions   = ["kms:Decrypt"]
+    resources = [aws_kms_key.poc.arn]
+  }
+
+  statement {
+    sid       = "InvokeModels"
+    effect    = "Allow"
+    actions   = ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"]
+    resources = ["*"]
+  }
+
+  statement {
+    sid       = "Logs"
+    effect    = "Allow"
+    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
+    resources = ["${aws_cloudwatch_log_group.agents.arn}:*"]
+  }
+
+  # The reasoning nodes never write a snapshot and never touch the audit bucket
+  # directly. Their output reaches storage through the rule engine and the
+  # approval gate, which is the only ordering the audit trail can defend.
+  statement {
+    sid    = "NoWritesFromTheReasoningPlane"
+    effect = "Deny"
+    actions = [
+      "s3:PutObject",
+      "s3:DeleteObject",
+      "s3:DeleteObjectVersion",
+      "s3:PutObjectRetention",
+      "s3:BypassGovernanceRetention",
+    ]
+    resources = ["*"]
+  }
+}
+
+resource "aws_iam_role_policy" "agent_runtime" {
+  name   = "${var.name_prefix}-agent-runtime"
+  role   = aws_iam_role.agent_runtime.id
+  policy = data.aws_iam_policy_document.agent_runtime.json
+}
+
+# --- J3: the deterministic rule engine --------------------------------------
+
+resource "aws_iam_role" "rule_engine" {
+  name               = "${var.name_prefix}-rule-engine"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+  tags               = { Plane = "execution" }
+}
+
+data "aws_iam_policy_document" "rule_engine" {
+  statement {
+    sid       = "ReadSnapshots"
+    effect    = "Allow"
+    actions   = ["s3:GetObject", "s3:ListBucket"]
+    resources = [aws_s3_bucket.snapshots.arn, "${aws_s3_bucket.snapshots.arn}/*"]
+  }
+
+  statement {
+    sid       = "WriteVerdictsToAudit"
+    effect    = "Allow"
+    actions   = ["s3:PutObject"]
+    resources = ["${aws_s3_bucket.audit.arn}/*"]
+  }
+
+  statement {
+    sid       = "PocKey"
+    effect    = "Allow"
+    actions   = ["kms:Decrypt", "kms:GenerateDataKey"]
+    resources = [aws_kms_key.poc.arn]
+  }
+
+  statement {
+    sid       = "Logs"
+    effect    = "Allow"
+    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
+    resources = ["${aws_cloudwatch_log_group.jobs.arn}:*"]
+  }
+
+  # The policy check is deterministic by requirement. A model call from inside
+  # it would move investment-policy compliance back into inference, which is
+  # the one thing the design is built to prevent.
+  statement {
+    sid       = "NoModelInvocationInTheRuleEngine"
+    effect    = "Deny"
+    actions   = ["bedrock:*"]
+    resources = ["*"]
+  }
+}
+
+resource "aws_iam_role_policy" "rule_engine" {
+  name   = "${var.name_prefix}-rule-engine"
+  role   = aws_iam_role.rule_engine.id
+  policy = data.aws_iam_policy_document.rule_engine.json
+}
+
+resource "aws_iam_role" "scheduler" {
+  name = "${var.name_prefix}-scheduler"
+
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Effect    = "Allow"
+        Action    = "sts:AssumeRole"
+        Principal = { Service = "scheduler.amazonaws.com" }
+        Condition = {
+          StringEquals = { "aws:SourceAccount" = data.aws_caller_identity.current.account_id }
+        }
+      },
+    ]
+  })
+}
+
+data "aws_iam_policy_document" "scheduler" {
+  statement {
+    effect    = "Allow"
+    actions   = ["ecs:RunTask"]
+    resources = ["${aws_ecs_task_definition.acquisition.arn_without_revision}:*"]
+  }
+
+  statement {
+    effect    = "Allow"
+    actions   = ["iam:PassRole"]
+    resources = [aws_iam_role.acquisition_job.arn, aws_iam_role.task_execution.arn]
+  }
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  name   = "${var.name_prefix}-scheduler"
+  role   = aws_iam_role.scheduler.id
+  policy = data.aws_iam_policy_document.scheduler.json
+}
+
+resource "aws_iam_role" "task_execution" {
+  name               = "${var.name_prefix}-task-execution"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "task_execution" {
+  role       = aws_iam_role.task_execution.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
diff --git a/infra/trading-poc/network.tf b/infra/trading-poc/network.tf
new file mode 100644
index 00000000..7e5f1b51
--- /dev/null
+++ b/infra/trading-poc/network.tf
@@ -0,0 +1,180 @@
+# Two planes in one VPC.
+#
+# The acquisition subnets have a default route to a NAT gateway, and everything
+# leaving through it passes a Network Firewall that permits only the declared
+# domains. The execution subnets have no default route at all: the agents reach
+# Bedrock, S3 and CloudWatch through VPC endpoints and reach nothing else.
+#
+# Why NAT rather than a fully sealed VPC: sealing egress completely means
+# standing up private mirrors for container images and packages before any of
+# the actual work starts. Confining the internet to the acquisition plane buys
+# the containment property that matters — the agents cannot fetch — without
+# that cost.
+
+resource "aws_vpc" "poc" {
+  cidr_block           = var.vpc_cidr
+  enable_dns_support   = true
+  enable_dns_hostnames = true
+
+  tags = { Name = "${var.name_prefix}-vpc" }
+}
+
+resource "aws_internet_gateway" "poc" {
+  vpc_id = aws_vpc.poc.id
+  tags   = { Name = "${var.name_prefix}-igw" }
+}
+
+# --- Acquisition plane -------------------------------------------------------
+
+resource "aws_subnet" "acquisition" {
+  count             = length(var.acquisition_subnet_cidrs)
+  vpc_id            = aws_vpc.poc.id
+  cidr_block        = var.acquisition_subnet_cidrs[count.index]
+  availability_zone = var.availability_zones[count.index]
+
+  tags = {
+    Name  = "${var.name_prefix}-acquisition-${count.index}"
+    Plane = "acquisition"
+  }
+}
+
+# Public subnets exist only to hold the NAT and firewall endpoints; no workload
+# is ever placed in them.
+resource "aws_subnet" "edge" {
+  count                   = length(var.availability_zones)
+  vpc_id                  = aws_vpc.poc.id
+  cidr_block              = cidrsubnet(var.vpc_cidr, 8, 200 + count.index)
+  availability_zone       = var.availability_zones[count.index]
+  map_public_ip_on_launch = false
+
+  tags = {
+    Name  = "${var.name_prefix}-edge-${count.index}"
+    Plane = "edge"
+  }
+}
+
+resource "aws_subnet" "firewall" {
+  count             = length(var.availability_zones)
+  vpc_id            = aws_vpc.poc.id
+  cidr_block        = cidrsubnet(var.vpc_cidr, 8, 210 + count.index)
+  availability_zone = var.availability_zones[count.index]
+
+  tags = {
+    Name  = "${var.name_prefix}-firewall-${count.index}"
+    Plane = "edge"
+  }
+}
+
+resource "aws_eip" "nat" {
+  count  = length(var.availability_zones)
+  domain = "vpc"
+  tags   = { Name = "${var.name_prefix}-nat-${count.index}" }
+}
+
+resource "aws_nat_gateway" "poc" {
+  count         = length(var.availability_zones)
+  allocation_id = aws_eip.nat[count.index].id
+  subnet_id     = aws_subnet.edge[count.index].id
+
+  tags = { Name = "${var.name_prefix}-nat-${count.index}" }
+
+  depends_on = [aws_internet_gateway.poc]
+}
+
+# --- Execution plane ---------------------------------------------------------
+
+resource "aws_subnet" "execution" {
+  count             = length(var.execution_subnet_cidrs)
+  vpc_id            = aws_vpc.poc.id
+  cidr_block        = var.execution_subnet_cidrs[count.index]
+  availability_zone = var.availability_zones[count.index]
+
+  tags = {
+    Name  = "${var.name_prefix}-execution-${count.index}"
+    Plane = "execution"
+  }
+}
+
+# --- Routing -----------------------------------------------------------------
+
+# Acquisition traffic goes to the firewall endpoint, which forwards what it
+# permits to the NAT. Routing through the firewall rather than straight to NAT
+# is what makes the allowlist unavoidable instead of advisory.
+resource "aws_route_table" "acquisition" {
+  count  = length(var.availability_zones)
+  vpc_id = aws_vpc.poc.id
+  tags   = { Name = "${var.name_prefix}-rt-acquisition-${count.index}" }
+}
+
+resource "aws_route" "acquisition_to_firewall" {
+  count                  = length(var.availability_zones)
+  route_table_id         = aws_route_table.acquisition[count.index].id
+  destination_cidr_block = "0.0.0.0/0"
+
+  vpc_endpoint_id = [
+    for sync_state in tolist(aws_networkfirewall_firewall.poc.firewall_status[0].sync_states) :
+    sync_state.attachment[0].endpoint_id
+    if sync_state.availability_zone == var.availability_zones[count.index]
+  ][0]
+}
+
+resource "aws_route_table_association" "acquisition" {
+  count          = length(aws_subnet.acquisition)
+  subnet_id      = aws_subnet.acquisition[count.index].id
+  route_table_id = aws_route_table.acquisition[count.index].id
+}
+
+resource "aws_route_table" "edge" {
+  count  = length(var.availability_zones)
+  vpc_id = aws_vpc.poc.id
+  tags   = { Name = "${var.name_prefix}-rt-edge-${count.index}" }
+}
+
+resource "aws_route" "edge_to_igw" {
+  count                  = length(var.availability_zones)
+  route_table_id         = aws_route_table.edge[count.index].id
+  destination_cidr_block = "0.0.0.0/0"
+  gateway_id             = aws_internet_gateway.poc.id
+}
+
+resource "aws_route_table_association" "edge" {
+  count          = length(aws_subnet.edge)
+  subnet_id      = aws_subnet.edge[count.index].id
+  route_table_id = aws_route_table.edge[count.index].id
+}
+
+resource "aws_route_table" "firewall" {
+  count  = length(var.availability_zones)
+  vpc_id = aws_vpc.poc.id
+  tags   = { Name = "${var.name_prefix}-rt-firewall-${count.index}" }
+}
+
+resource "aws_route" "firewall_to_nat" {
+  count                  = length(var.availability_zones)
+  route_table_id         = aws_route_table.firewall[count.index].id
+  destination_cidr_block = "0.0.0.0/0"
+  nat_gateway_id         = aws_nat_gateway.poc[count.index].id
+}
+
+resource "aws_route_table_association" "firewall" {
+  count          = length(aws_subnet.firewall)
+  subnet_id      = aws_subnet.firewall[count.index].id
+  route_table_id = aws_route_table.firewall[count.index].id
+}
+
+# The execution route table deliberately carries no 0.0.0.0/0 entry. Adding one
+# would silently undo the plane separation, so the absence is asserted by the
+# conformance check in checks.tf rather than left to review.
+resource "aws_route_table" "execution" {
+  vpc_id = aws_vpc.poc.id
+  tags = {
+    Name = "${var.name_prefix}-rt-execution"
+    Note = "no default route: the execution plane has no path to the internet"
+  }
+}
+
+resource "aws_route_table_association" "execution" {
+  count          = length(aws_subnet.execution)
+  subnet_id      = aws_subnet.execution[count.index].id
+  route_table_id = aws_route_table.execution.id
+}
diff --git a/infra/trading-poc/observability.tf b/infra/trading-poc/observability.tf
new file mode 100644
index 00000000..d4f77988
--- /dev/null
+++ b/infra/trading-poc/observability.tf
@@ -0,0 +1,97 @@
+# CloudTrail and the alarms that make a containment failure loud.
+#
+# Two alarms are worth more than a dashboard: a firewall drop is how an egress
+# attempt from the acquisition plane shows up, and an unexpected Bedrock call
+# from an acquisition role is how a model creeping onto the wrong plane shows up.
+
+resource "aws_cloudtrail" "poc" {
+  name                          = "${var.name_prefix}-trail"
+  s3_bucket_name                = aws_s3_bucket.audit.id
+  s3_key_prefix                 = "cloudtrail"
+  include_global_service_events = true
+  is_multi_region_trail         = true
+  enable_log_file_validation    = true
+  kms_key_id                    = aws_kms_key.poc.arn
+
+  # Data events on the snapshot bucket: knowing which object a run read is part
+  # of the same trail as knowing what it concluded.
+  advanced_event_selector {
+    name = "snapshot-object-access"
+
+    field_selector {
+      field  = "eventCategory"
+      equals = ["Data"]
+    }
+    field_selector {
+      field  = "resources.type"
+      equals = ["AWS::S3::Object"]
+    }
+    field_selector {
+      field       = "resources.ARN"
+      starts_with = ["${aws_s3_bucket.snapshots.arn}/"]
+    }
+  }
+
+  depends_on = [aws_s3_bucket_policy.audit_trail]
+}
+
+resource "aws_s3_bucket_policy" "audit_trail" {
+  bucket = aws_s3_bucket.audit.id
+
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Sid       = "AWSCloudTrailAclCheck"
+        Effect    = "Allow"
+        Principal = { Service = "cloudtrail.amazonaws.com" }
+        Action    = "s3:GetBucketAcl"
+        Resource  = aws_s3_bucket.audit.arn
+      },
+      {
+        Sid       = "AWSCloudTrailWrite"
+        Effect    = "Allow"
+        Principal = { Service = "cloudtrail.amazonaws.com" }
+        Action    = "s3:PutObject"
+        Resource  = "${aws_s3_bucket.audit.arn}/cloudtrail/AWSLogs/${data.aws_caller_identity.current.account_id}/*"
+        Condition = {
+          StringEquals = { "s3:x-amz-acl" = "bucket-owner-full-control" }
+        }
+      },
+    ]
+  })
+}
+
+resource "aws_sns_topic" "alerts" {
+  name              = "${var.name_prefix}-alerts"
+  kms_master_key_id = aws_kms_key.poc.id
+}
+
+resource "aws_cloudwatch_log_metric_filter" "firewall_blocked" {
+  name           = "${var.name_prefix}-firewall-blocked"
+  log_group_name = aws_cloudwatch_log_group.firewall_alerts.name
+  pattern        = "{ $.event.alert.action = \"blocked\" }"
+
+  metric_transformation {
+    name      = "FirewallBlockedRequests"
+    namespace = "${var.name_prefix}/network"
+    value     = "1"
+  }
+}
+
+# Threshold 0, so the first blocked request alarms. During the red-team exercise
+# these are expected and are the evidence; outside it, one means a job tried to
+# reach somewhere it was never declared to reach.
+resource "aws_cloudwatch_metric_alarm" "firewall_blocked" {
+  alarm_name          = "${var.name_prefix}-egress-attempt-blocked"
+  comparison_operator = "GreaterThanThreshold"
+  evaluation_periods  = 1
+  threshold           = 0
+  period              = 300
+  statistic           = "Sum"
+  metric_name         = aws_cloudwatch_log_metric_filter.firewall_blocked.metric_transformation[0].name
+  namespace           = aws_cloudwatch_log_metric_filter.firewall_blocked.metric_transformation[0].namespace
+  treat_missing_data  = "notBreaching"
+  alarm_description   = "An acquisition job tried to reach a host outside the allowlist."
+  alarm_actions       = [aws_sns_topic.alerts.arn]
+}
diff --git a/infra/trading-poc/outputs.tf b/infra/trading-poc/outputs.tf
new file mode 100644
index 00000000..25f18a9b
--- /dev/null
+++ b/infra/trading-poc/outputs.tf
@@ -0,0 +1,34 @@
+output "snapshot_bucket" {
+  description = "Immutable input snapshots. The start of the audit trail."
+  value       = aws_s3_bucket.snapshots.id
+}
+
+output "audit_bucket" {
+  description = "Audit logs and CloudTrail, under Object Lock."
+  value       = aws_s3_bucket.audit.id
+}
+
+output "execution_subnet_ids" {
+  description = "Subnets for the agent runtime and rule engine. No internet route."
+  value       = aws_subnet.execution[*].id
+}
+
+output "acquisition_subnet_ids" {
+  description = "Subnets for the acquisition jobs. Internet only via the firewall."
+  value       = aws_subnet.acquisition[*].id
+}
+
+output "agent_runtime_role_arn" {
