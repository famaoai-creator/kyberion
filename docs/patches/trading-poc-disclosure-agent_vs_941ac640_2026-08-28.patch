+    '<td class="evennew-M kjTitle" align="left"><a href="https://example.invalid/b.pdf">資本金の額の減少に関するお知らせ</a></td>',
+    '<td class="evennew-M kjXbrl"> </td><td class="evennew-M kjPlace">東  </td><td class="evennew-R kjHistroy">　</td></tr>',
+    '</tbody></table></body></html>',
+  ].join('\n');
+
+  it('parses rows and normalises the five-digit listing code', async () => {
+    const { parseDisclosureListHtml, toDisclosures } = await import('./tdnet-list-export.js');
+    const rows = parseDisclosureListHtml(listHtml);
+    expect(rows).toHaveLength(2);
+    const disclosures = toDisclosures({ listDate: '2026-08-27', rows });
+    expect(disclosures[0].ticker).toBe('4813');
+    expect(disclosures[0].disclosed_at).toBe('2026-08-27T19:00:00+09:00');
+    expect(disclosures[0].document_url).toBe('https://example.invalid/a.pdf');
+  });
+
+  it('marks list rows as headline-only and never guesses the market', async () => {
+    const { parseDisclosureListHtml, toDisclosures } = await import('./tdnet-list-export.js');
+    const disclosures = toDisclosures({
+      listDate: '2026-08-27',
+      rows: parseDisclosureListHtml(listHtml),
+    });
+    expect(disclosures.every((entry) => entry.evidence_depth === 'title_only')).toBe(true);
+    // The list states the market only through the growth-market name prefix;
+    // anything else stays UNKNOWN so the policy check refuses it rather than
+    // admitting a name whose universe was assumed.
+    expect(disclosures[0].market).toBe('UNKNOWN');
+    expect(disclosures[1].market).toBe('TSE_GROWTH');
+    expect(disclosures.every((entry) => entry.sector === 'UNKNOWN')).toBe(true);
+  });
+
+  it('refuses a headline-only citation under R012, even though the quote resolves', async () => {
+    const { parseDisclosureListHtml, toDisclosures } = await import('./tdnet-list-export.js');
+    const { verifyAgainstPolicy } = await import('./rule-engine.js');
+    const disclosures = toDisclosures({
+      listDate: '2026-08-27',
+      rows: parseDisclosureListHtml(listHtml),
+    });
+    const { verdicts } = verifyAgainstPolicy({
+      runDate: '2026-08-28',
+      selected: [
+        {
+          ticker: '4813',
+          company_name: 'ＡＣＣＥＳＳ',
+          rationale: 'headline-only rehearsal',
+          citations: [
+            {
+              disclosure_id: disclosures[0].disclosure_id,
+              locator: 'para:0',
+              quote: '内部管理体制の整備',
+            },
+          ],
+        },
+      ],
+      disclosures,
+      marketData: [],
+    });
+    const results = new Map(verdicts[0].evaluations.map((entry) => [entry.rule_id, entry.result]));
+    // The quote genuinely resolves, so the evidence rule passes...
+    expect(results.get('R009')).toBe('pass');
+    // ...and the capture-depth rule is what refuses it.
+    expect(results.get('R012')).toBe('fail');
+    expect(verdicts[0].passed).toBe(false);
+  });
+
+  it('refuses to pretend a list export carries market data', async () => {
+    const { fetchMarketData } = await import('./sources.js');
+    await expect(fetchMarketData('operator-supplied-disclosure-list', '2026-08-28')).rejects.toThrow(
+      /TRADING_SOURCE_CONFIG/u
+    );
+  });
+});
+
+describe('outbound prompt hygiene', () => {
+  it('emits no payment-card-shaped digit run in the market data it sends out', async () => {
+    const { renderMarketData } = await import('./agent-nodes.js');
+    // Raw yen market caps are 12-14 digits, and the governed egress gate blocks
+    // outbound text carrying a Luhn-valid run that long — two of the sample
+    // corpus's figures do. Assert on the rendering rather than trusting that a
+    // future figure will not trip it.
+    const rendered = renderMarketData([
+      {
+        ticker: '2914',
+        as_of: '2099-01-04',
+        open: 4128,
+        close: 4110,
+        avg_daily_volume_20d: 2_040_000,
+        market_cap_jpy: 3_310_000_000_000,
+        free_float_ratio: 0.24,
+      },
+      {
+        ticker: '7011',
+        as_of: '2099-01-04',
+        open: 2210,
+        close: 2195,
+        avg_daily_volume_20d: 5_900_000,
+        market_cap_jpy: 2_240_000_000_000,
+        free_float_ratio: 0.69,
+      },
+    ]);
+    const longDigitRuns = rendered.match(/(?<![0-9])[0-9]{12,19}(?![0-9])/gu) || [];
+    expect(
+      longDigitRuns,
+      `rendering carries card-shaped digit runs: ${longDigitRuns.join(', ')}`
+    ).toEqual([]);
+    expect(rendered).toMatch(/33100 oku JPY/u);
+    expect(rendered).toMatch(/22400 oku JPY/u);
+  });
+});
+
+describe('reviewer independence', () => {
+  it('refuses a run where the reviewer is pinned to the selector model', async () => {
+    const { assertReviewerIndependence } = await import('./agent-runtime.js');
+    process.env.KYBERION_TRADING_MODEL_A3 = 'same-model';
+    process.env.KYBERION_TRADING_MODEL_A4 = 'same-model';
+    try {
+      expect(() => assertReviewerIndependence()).toThrow(/REVIEWER_NOT_INDEPENDENT/u);
+    } finally {
+      delete process.env.KYBERION_TRADING_MODEL_A3;
+      delete process.env.KYBERION_TRADING_MODEL_A4;
+    }
+    expect(() => assertReviewerIndependence()).not.toThrow();
+  });
+});
