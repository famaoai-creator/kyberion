@@ -0,0 +1,40 @@
+// Self-described op surface. The governed op registry and the discovery index
+// are generated from this file; `check:op-registry` fails on drift between it
+// and the committed registry, so keep it in step with the dispatch switch in
+// trading-actuator-helpers.ts.
+
+type OpSpecKind = 'capture' | 'transform' | 'apply' | 'control';
+
+/** Acquisition-plane reads and snapshot loads. */
+export const TRADING_ACTUATOR_CAPTURE_OPS = [
+  'fetch_disclosures',
+  'fetch_market_data',
+  'load_snapshot',
+] as const;
+
+/** Execution-plane reasoning, deterministic verification and reporting. */
+export const TRADING_ACTUATOR_TRANSFORM_OPS = [
+  'classify_disclosures',
+  'summarize_disclosures',
+  'select_candidates',
+  'review_selection',
+  'verify_rules',
+  'verify_traceability',
+  'evaluate_day',
+  'evaluate_gate',
+] as const;
+
+/** Effects: recording fills, and the adversarial exercise that probes them. */
+export const TRADING_ACTUATOR_APPLY_OPS = ['record_mock_fills', 'run_redteam'] as const;
+
+function toSpec(op: string, kind: OpSpecKind) {
+  return { op, kind };
+}
+
+export function describeOps() {
+  return [
+    ...TRADING_ACTUATOR_CAPTURE_OPS.map((op) => toSpec(op, 'capture')),
+    ...TRADING_ACTUATOR_TRANSFORM_OPS.map((op) => toSpec(op, 'transform')),
+    ...TRADING_ACTUATOR_APPLY_OPS.map((op) => toSpec(op, 'apply')),
+  ];
+}
diff --git a/libs/actuators/trading-actuator/src/plane-guard.ts b/libs/actuators/trading-actuator/src/plane-guard.ts
new file mode 100644
index 00000000..d563c0e9
--- /dev/null
+++ b/libs/actuators/trading-actuator/src/plane-guard.ts
@@ -0,0 +1,155 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { safeReadFile, pathResolver, safeExistsSync } from '@agent/core';
+
+/**
+ * The architectural claim this file enforces in code.
+ *
+ * The acquisition plane may reach the internet, but only hosts on the governed
+ * allowlist. The execution plane — every reasoning node, the rule engine, the
+ * approval gate, mock execution — may not reach the internet at all. That is
+ * what makes injection containment and audit reproduction possible: an agent
+ * that cannot fetch cannot be steered to an attacker's URL, and a conclusion
+ * drawn only from stored bytes can be re-derived later.
+ *
+ * A guard that lives only in a diagram is not a guard, so any network call
+ * made under `withExecutionPlane` throws rather than being merely discouraged.
+ */
+
+export type Plane = 'acquisition' | 'execution';
+
+interface PlaneState {
+  plane: Plane;
+  /** Hosts this plane may reach. Empty in the execution plane, always. */
+  allowedHosts: string[];
+}
+
+const planeStore = new AsyncLocalStorage<PlaneState>();
+
+const SOURCE_CONFIG_PATH = 'product/governance/trading-poc-sources.json';
+
+export interface SourceDefinition {
+  source_id: string;
+  /**
+   * `sample` reads the bundled corpus, `https` fetches from an allowlisted host,
+   * and `local-export` reads a file a person obtained and placed in the repo —
+   * the route for a source whose operator refuses automated retrieval.
+   */
+  kind: 'sample' | 'https' | 'local-export';
+  /** Sample corpus file, relative to the actuator's `samples/` directory. */
+  sample_file?: string;
+  /** Repo-relative path of the human-supplied export, for `local-export`. */
+  export_path?: string;
+  /** Parser to apply to the export. */
+  export_format?: 'tdnet-list-html';
+  base_url?: string;
+  allowlist_hosts?: string[];
+  note?: string;
+}
+
+export interface SourceConfig {
+  version: string;
+  default_disclosure_source: string;
+  default_market_data_source: string;
+  sources: SourceDefinition[];
+}
+
+let cachedConfig: SourceConfig | null = null;
+
+export function loadSourceConfig(): SourceConfig {
+  if (cachedConfig) return cachedConfig;
+  const filePath = pathResolver.knowledge(SOURCE_CONFIG_PATH);
+  if (!safeExistsSync(filePath)) {
+    throw new Error(
+      `[TRADING_SOURCE_CONFIG] missing source configuration at knowledge/${SOURCE_CONFIG_PATH}`
+    );
+  }
+  cachedConfig = JSON.parse(safeReadFile(filePath, { encoding: 'utf8' }) as string) as SourceConfig;
+  return cachedConfig;
+}
+
+export function resetSourceConfigCacheForTests(): void {
+  cachedConfig = null;
+}
+
+export function resolveSource(sourceId: string): SourceDefinition {
+  const config = loadSourceConfig();
+  const found = config.sources.find((entry) => entry.source_id === sourceId);
+  if (!found) {
+    throw new Error(
+      `[TRADING_SOURCE_UNKNOWN] source '${sourceId}' is not declared in knowledge/${SOURCE_CONFIG_PATH}`
+    );
+  }
+  return found;
+}
+
+/**
+ * Run `fn` in the acquisition plane. Only hosts declared by the resolved
+ * source are reachable; anything else is refused by {@link assertEgressAllowed}
+ * exactly as the Network Firewall allowlist refuses it in the deployed shape.
+ */
+export function withAcquisitionPlane<T>(allowedHosts: string[], fn: () => T): T {
+  return planeStore.run({ plane: 'acquisition', allowedHosts: [...allowedHosts] }, fn);
+}
+
+/** Run `fn` in the execution plane: snapshot reads only, no egress. */
+export function withExecutionPlane<T>(fn: () => T): T {
+  return planeStore.run({ plane: 'execution', allowedHosts: [] }, fn);
+}
+
+export function currentPlane(): Plane | null {
+  return planeStore.getStore()?.plane ?? null;
+}
+
+/**
+ * Gate every outbound request. Called by the source adapters before any fetch.
+ *
+ * Refuses when there is no plane at all: an unscoped call means the caller
+ * bypassed `withAcquisitionPlane`, and defaulting to "allow" there would let
+ * the whole separation leak away one convenience call at a time.
+ */
+export function assertEgressAllowed(url: string): URL {
+  const state = planeStore.getStore();
+  if (!state) {
+    throw new Error(
+      '[EGRESS_DENIED] network access attempted outside any plane scope; wrap acquisition work in withAcquisitionPlane()'
+    );
+  }
+  if (state.plane === 'execution') {
+    throw new Error(
+      `[EGRESS_DENIED] the execution plane has no route to the internet; read the snapshot store instead (attempted: ${url})`
+    );
+  }
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    throw new Error(`[EGRESS_DENIED] not a valid absolute URL: ${url}`);
+  }
+  if (parsed.protocol !== 'https:') {
+    throw new Error(`[EGRESS_DENIED] only https is allowed in the acquisition plane: ${url}`);
+  }
+  if (!state.allowedHosts.includes(parsed.host)) {
+    throw new Error(
+      `[EGRESS_DENIED] host '${parsed.host}' is not on the acquisition allowlist (${state.allowedHosts.join(', ') || 'empty'})`
+    );
+  }
+  return parsed;
+}
+
+/**
+ * Refuse to run when a live order route is configured.
+ *
+ * The PoC's scope excludes real orders, and the way that exclusion survives
+ * contact with a hurried change is a check that fails loudly rather than a
+ * line in a scope document.
+ */
+export function assertNoLiveOrderRoute(): void {
+  const configured = ['KYBERION_TRADING_ORDER_ENDPOINT', 'KYBERION_TRADING_BROKER_API_KEY'].filter(
+    (name) => (process.env[name] || '').trim().length > 0
+  );
+  if (configured.length > 0) {
+    throw new Error(
+      `[LIVE_ORDER_ROUTE_PRESENT] this PoC never places a real order, but ${configured.join(', ')} is set; unset it before running mock execution`
+    );
+  }
+}
