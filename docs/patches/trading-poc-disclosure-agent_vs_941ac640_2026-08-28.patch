@@ -0,0 +1,123 @@
+import type { Citation, Disclosure } from './types.js';
+
+/**
+ * Citation resolution — the deterministic ground truth for "is this evidence
+ * real?".
+ *
+ * A model reviewing another model is a useful second opinion, but it is not
+ * proof. A quote either appears at the locator it claims or it does not, and
+ * that question is settled here by string comparison against the stored bytes.
+ * The reviewer node's score is then measured against this answer rather than
+ * being trusted as the answer.
+ */
+
+export type CitationVerdict = 'grounded' | 'fabricated' | 'unverifiable';
+
+export interface CitationCheck {
+  citation: Citation;
+  verdict: CitationVerdict;
+  detail: string;
+}
+
+/** Parse `para:<n>` / `attach:<name>:<n>` into the addressed paragraph. */
+export function resolveLocator(disclosure: Disclosure, locator: string): string | null {
+  const trimmed = locator.trim();
+  const bodyMatch = /^para:(\d+)$/u.exec(trimmed);
+  if (bodyMatch) {
+    return disclosure.paragraphs[Number(bodyMatch[1])] ?? null;
+  }
+  const attachMatch = /^attach:(.+):(\d+)$/u.exec(trimmed);
+  if (attachMatch) {
+    const attachment = disclosure.attachments.find((entry) => entry.name === attachMatch[1]);
+    if (!attachment) return null;
+    return attachment.paragraphs[Number(attachMatch[2])] ?? null;
+  }
+  return null;
+}
+
+/** Every addressable locator in a disclosure, body and attachments alike. */
+export function enumerateLocators(disclosure: Disclosure): Array<{ locator: string; text: string }> {
+  const entries = disclosure.paragraphs.map((text, index) => ({
+    locator: `para:${index}`,
+    text,
+  }));
+  for (const attachment of disclosure.attachments) {
+    for (const [index, text] of attachment.paragraphs.entries()) {
+      entries.push({ locator: `attach:${attachment.name}:${index}`, text });
+    }
+  }
+  return entries;
+}
+
+/**
+ * Compare the quoted text against the snapshot.
+ *
+ * Normalisation is deliberately narrow — whitespace only. Loosening it further
+ * (stripping punctuation, matching loosely) would start accepting quotes that
+ * were never in the document, which is precisely the failure mode being
+ * measured.
+ */
+function normalize(text: string): string {
+  return text.replace(/[\s　]+/gu, '');
+}
+
+export function checkCitation(
+  citation: Citation,
+  disclosures: Map<string, Disclosure>
+): CitationCheck {
+  const disclosure = disclosures.get(citation.disclosure_id);
+  if (!disclosure) {
+    return {
+      citation,
+      verdict: 'fabricated',
+      detail: `no disclosure '${citation.disclosure_id}' exists in the snapshot set for this run`,
+    };
+  }
+  const quote = (citation.quote || '').trim();
+  if (quote.length === 0) {
+    return { citation, verdict: 'unverifiable', detail: 'citation carries no quote' };
+  }
+  const target = resolveLocator(disclosure, citation.locator);
+  if (target === null) {
+    // The locator is wrong, but the quote may still be genuine — distinguish a
+    // misfiled citation from an invented one, because the remedies differ.
+    const found = enumerateLocators(disclosure).find((entry) =>
+      normalize(entry.text).includes(normalize(quote))
+    );
+    return found
+      ? {
+          citation,
+          verdict: 'unverifiable',
+          detail: `locator '${citation.locator}' does not exist; the quote appears at '${found.locator}'`,
+        }
+      : {
+          citation,
+          verdict: 'fabricated',
+          detail: `locator '${citation.locator}' does not exist and the quote appears nowhere in the disclosure`,
+        };
+  }
+  if (normalize(target).includes(normalize(quote))) {
+    return { citation, verdict: 'grounded', detail: `quote present at ${citation.locator}` };
+  }
+  const elsewhere = enumerateLocators(disclosure).find((entry) =>
+    normalize(entry.text).includes(normalize(quote))
+  );
+  return elsewhere
+    ? {
+        citation,
+        verdict: 'unverifiable',
+        detail: `quote is not at '${citation.locator}' but appears at '${elsewhere.locator}'`,
+      }
+    : {
+        citation,
+        verdict: 'fabricated',
+        detail: `quote does not appear anywhere in disclosure ${citation.disclosure_id}`,
+      };
+}
+
+export function checkCitations(
+  citations: Citation[],
+  disclosures: Map<string, Disclosure>
+): CitationCheck[] {
+  return citations.map((citation) => checkCitation(citation, disclosures));
+}
