new file mode 100644
index 00000000..53142026
--- /dev/null
+++ b/schemas/trading-action.schema.json
@@ -0,0 +1,67 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "title": "Trading PoC Actuator Request",
+  "type": "object",
+  "required": ["action"],
+  "properties": {
+    "action": {
+      "enum": [
+        "fetch_disclosures",
+        "fetch_market_data",
+        "load_snapshot",
+        "classify_disclosures",
+        "summarize_disclosures",
+        "select_candidates",
+        "review_selection",
+        "verify_rules",
+        "verify_traceability",
+        "evaluate_day",
+        "evaluate_gate",
+        "record_mock_fills",
+        "run_redteam",
+        "pipeline"
+      ]
+    },
+    "params": {
+      "type": "object",
+      "properties": {
+        "run_date": {
+          "type": "string",
+          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
+          "description": "Trading date the run belongs to. Every snapshot, artifact and audit entry is filed under it."
+        },
+        "source_id": {
+          "type": "string",
+          "description": "Acquisition source declared in knowledge/product/governance/trading-poc-sources.json. Defaults to the bundled sample corpus."
+        },
+        "max_names": {
+          "type": "integer",
+          "minimum": 1,
+          "description": "Overrides the policy's maximum names per proposal."
+        },
+        "target_notional_jpy": {
+          "type": "number",
+          "exclusiveMinimum": 0,
+          "description": "Per-name notional used to size a mock fill."
+        },
+        "approval_channel": {
+          "type": "string",
+          "description": "Channel holding the human approval that admits mock execution."
+        },
+        "approval_request_id": {
+          "type": "string",
+          "description": "Approval request id. Mock execution refuses to run unless this approval is approved, unexpired, and bound to the verified payload's hash."
+        },
+        "business_value_note": {
+          "type": "string",
+          "description": "Operator assessment for the reference-only business-value row of the gate report."
+        },
+        "export_as": { "type": "string" }
+      },
+      "additionalProperties": true
+    },
+    "steps": { "type": "array" },
+    "context": { "type": "object" },
+    "options": { "type": "object" }
+  }
+}
