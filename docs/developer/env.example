# Kyberion environment variables (generated from knowledge/product/governance/env-registry.json).
# Regenerate with: pnpm generate:env-registry — do not edit by hand.
# All variables are optional unless marked required. Never commit secret values.

# [secret/string] Shared secret used to sign and verify A2A envelopes; values stay in the secret store.
# KYBERION_A2A_SECRET=

# [runtime/enum] A2A envelope signature policy: warn audits missing signatures while enforce rejects unsigned or unknown-sender messages.
#   values: warn | enforce
# KYBERION_A2A_SIGNATURE=

# [provider/string] Optional A2UI rendering bridge endpoint used by the presence actuator; keep it on an approved local or trusted surface and do not treat it as an authorization boundary.
# KYBERION_A2UI_BRIDGE_URL=

# [tuning/number] Milliseconds an agent adapter waits for a newly started runtime to become ready before failing the boot request.
# KYBERION_AGENT_BOOT_READY_TIMEOUT_MS=

# [runtime/string] Logical agent identity attached to runtime, task, and audit records; use a stable non-secret identifier.
# KYBERION_AGENT_ID=

# [tuning/number] Milliseconds an inactive agent runtime may remain before lifecycle cleanup; the default is 20 minutes.
# KYBERION_AGENT_IDLE_TIMEOUT_MS=

# [tuning/number] Maximum concurrent requests admitted for one agent runtime; excess work receives a bounded busy response.
# KYBERION_AGENT_INFLIGHT_LIMIT=

# [tuning/number] Numeric policy ring supplied to operation-policy evaluation; higher rings may have stricter execution rules.
# KYBERION_AGENT_RING=

# [provider/string] Bind host for the agent runtime supervisor daemon; the default is loopback so the local control endpoint is not exposed remotely by omission.
# KYBERION_AGENT_RUNTIME_SUPERVISOR_HOST=

# [path/path] Lock-file path used to prevent duplicate agent runtime supervisor daemons; keep it in the governed runtime area.
# KYBERION_AGENT_RUNTIME_SUPERVISOR_LOCK_PATH=

# [tuning/number] TCP port for the agent runtime supervisor when transport is tcp; zero permits the operating system to select a port.
# KYBERION_AGENT_RUNTIME_SUPERVISOR_PORT=

# [path/path] Unix-domain socket path for local agent runtime supervisor RPC; keep it under the governed runtime area.
# KYBERION_AGENT_RUNTIME_SUPERVISOR_SOCKET_PATH=

# [secret/string] Shared token for newline-JSON agent runtime supervisor RPC.
# KYBERION_AGENT_RUNTIME_SUPERVISOR_TOKEN=

# [runtime/enum] Transport used by the agent runtime supervisor; unix is the local default, while tcp requires an explicitly controlled host and port.
#   values: unix | tcp
# KYBERION_AGENT_RUNTIME_SUPERVISOR_TRANSPORT=

# [runtime/string] Execution authority tier propagated to secure-io and policy checks; child processes may downgrade but must not use it to bypass governed access.
# KYBERION_AGENT_TIER=

# [tuning/number] Maximum milliseconds allowed for one agent conversation turn before the mediator returns a timeout.
# KYBERION_AGENT_TURN_TIMEOUT_MS=

# [provider/string] Generated AGY workspace agent name selected for CLI sessions, for example kyberion-reviewer.
# KYBERION_AGY_AGENT=

# [path/path] Optional path override for agy cli bin; keep it inside governed repository or runtime storage.
# KYBERION_AGY_CLI_BIN=

# [path/path] Optional path override for agy cli log file; keep it inside governed repository or runtime storage.
# KYBERION_AGY_CLI_LOG_FILE=

# [provider/string] Model name passed to the AGY CLI backend.
# KYBERION_AGY_CLI_MODEL=

# [tuning/number] Optional numeric tuning value for agy cli timeout ms; leave unset to use the governed default.
# KYBERION_AGY_CLI_TIMEOUT_MS=

# [runtime/string] Optional runtime setting for agy sandbox; leave unset to use the built-in configuration.
# KYBERION_AGY_SANDBOX=

# [secret/string] Internal bridge transport for the Antigravity SDK API key; prefer GEMINI_API_KEY or GOOGLE_API_KEY in the parent environment.
# KYBERION_AGY_SDK_API_KEY=

# [runtime/string] Working directory passed from the AGY SDK adapter to its Python bridge.
# KYBERION_AGY_SDK_CWD=

# [path/path] Python 3.10+ interpreter used by the official google-antigravity SDK bridge.
# KYBERION_AGY_SDK_PYTHON=

# [flag/boolean] Acknowledge the plaintext file-secret fallback when the OS keychain is unavailable (warn-phase; see AC-05).
# KYBERION_ALLOW_FILE_SECRETS=

# [flag/boolean] Allow explicitly opted-in development flows to reach local or private network addresses; disabled by default.
# KYBERION_ALLOW_LOCAL_NETWORK=

# [flag/boolean] Keep the reasoning stub fallback when the configured provider chain is unavailable; disabled by default.
# KYBERION_ALLOW_STUB_FALLBACK=

# [flag/boolean] Allow operator notification delivery during tests; test-only opt-in.
# KYBERION_ALLOW_TEST_NOTIFICATIONS=

# [flag/boolean] Allow unauthenticated remote Chronos readonly access only when no API or localadmin token is configured; disabled by default.
# KYBERION_ALLOW_UNAUTH_REMOTE=

# [flag/boolean] Allow the service actuator to execute CLI commands; disabled by default.
# KYBERION_ALLOW_UNSAFE_CLI=

# [flag/boolean] Allow code or system actuators to evaluate JavaScript; disabled by default.
# KYBERION_ALLOW_UNSAFE_JS=

# [flag/boolean] Allow shell execution by code, system, or network actuators; disabled by default.
# KYBERION_ALLOW_UNSAFE_SHELL=

# [provider/string] Fast model override for the Anthropic API route.
# KYBERION_ANTHROPIC_FAST_MODEL=

# [provider/string] Model override for the Anthropic API route.
# KYBERION_ANTHROPIC_MODEL=

# [runtime/string] Optional runtime setting for anthropic native deferred tools; leave unset to use the built-in configuration.
# KYBERION_ANTHROPIC_NATIVE_DEFERRED_TOOLS=

# [path/path] Optional path override for antigravity cli bin; keep it inside governed repository or runtime storage.
# KYBERION_ANTIGRAVITY_CLI_BIN=

# [secret/string] Bearer token for authenticated surface/API requests.
# KYBERION_API_TOKEN=

# [runtime/string] Optional runtime setting for apple fm; leave unset to use the built-in configuration.
# KYBERION_APPLE_FM=

# [runtime/string] Optional runtime setting for apple fm sample audio; leave unset to use the built-in configuration.
# KYBERION_APPLE_FM_SAMPLE_AUDIO=

# [runtime/string] Optional runtime setting for audio bus; leave unset to use the built-in configuration.
# KYBERION_AUDIO_BUS=

# [runtime/string] Optional runtime setting for audio device uid; leave unset to use the built-in configuration.
# KYBERION_AUDIO_DEVICE_UID=

# [runtime/string] Operator acknowledgement that the meeting preflight microphone permission was confirmed for this session; use 1 only after the OS permission check succeeds.
# KYBERION_AUDIO_PERMISSION_CONFIRMED=

# [provider/string] Local microphone capture command used by the voice sample recorder; it receives governed template values such as output and duration and is not a general-purpose user command entrypoint.
# KYBERION_AUDIO_RECORD_COMMAND=

# [secret/string] HMAC key used to authenticate the append-only audit chain; values stay in the secret store.
# KYBERION_AUDIT_CHAIN_KEY=

# [runtime/string] Optional runtime setting for audit continuity enforce; leave unset to use the built-in configuration.
# KYBERION_AUDIT_CONTINUITY_ENFORCE=

# [provider/string] Optional shell sink for forwarding audit events after the governed audit sink records them locally; use an explicitly approved command.
# KYBERION_AUDIT_FORWARDER_COMMAND=

# [runtime/string] Optional runtime setting for audit forwarder headers; leave unset to use the built-in configuration.
# KYBERION_AUDIT_FORWARDER_HEADERS=

# [tuning/number] Optional numeric tuning value for audit forwarder timeout ms; leave unset to use the governed default.
# KYBERION_AUDIT_FORWARDER_TIMEOUT_MS=

# [provider/string] Optional HTTP destination for forwarding audit events; outbound delivery remains subject to the egress policy and local audit persistence is authoritative.
# KYBERION_AUDIT_FORWARDER_URL=

# [runtime/boolean] Automatically seal completed personal-tier missions.
# KYBERION_AUTO_SEAL=

# [path/path] Optional path override for the autonomous-operations policy catalog; the selected catalog remains schema-validated before an operation is admitted.
# KYBERION_AUTONOMOUS_OPS_POLICY_PATH=

# [secret/string] Passphrase used to encrypt and restore backup archives; keep it in an external secret manager and never store it in the archive or registry.
# KYBERION_BACKUP_PASSPHRASE=

# [runtime/string] Optional runtime setting for best of n; leave unset to use the built-in configuration.
# KYBERION_BEST_OF_N=

# [runtime/string] Optional runtime setting for best of providers live; leave unset to use the built-in configuration.
# KYBERION_BEST_OF_PROVIDERS_LIVE=

# [runtime/string] Optional runtime setting for blackhole device label; leave unset to use the built-in configuration.
# KYBERION_BLACKHOLE_DEVICE_LABEL=

# [runtime/string] Optional runtime setting for blackhole input uid; leave unset to use the built-in configuration.
# KYBERION_BLACKHOLE_INPUT_UID=

# [runtime/string] Optional runtime setting for blackhole output uid; leave unset to use the built-in configuration.
# KYBERION_BLACKHOLE_OUTPUT_UID=

# [runtime/string] Optional runtime setting for blackhole script; leave unset to use the built-in configuration.
# KYBERION_BLACKHOLE_SCRIPT=

# [secret/string] Password used to authenticate requests to the BlueBubbles server.
# KYBERION_BLUEBUBBLES_PASSWORD=

# [runtime/string] Optional runtime setting for bluebubbles send method; leave unset to use the built-in configuration.
# KYBERION_BLUEBUBBLES_SEND_METHOD=

# [provider/string] Base URL of the local or approved BlueBubbles bridge used for iMessage operations; it configures transport only and does not grant tenant access.
# KYBERION_BLUEBUBBLES_URL=

# [secret/string] Shared secret used to authenticate inbound BlueBubbles webhook requests.
# KYBERION_BLUEBUBBLES_WEBHOOK_SECRET=

# [runtime/string] Optional runtime setting for brand font stack; leave unset to use the built-in configuration.
# KYBERION_BRAND_FONT_STACK=

# [runtime/string] Optional runtime setting for brand mono stack; leave unset to use the built-in configuration.
# KYBERION_BRAND_MONO_STACK=

# [tuning/number] Optional numeric tuning value for chronos idle timeout ms; leave unset to use the governed default.
# KYBERION_CHRONOS_IDLE_TIMEOUT_MS=

# [runtime/string] Optional runtime setting for claude agent tools; leave unset to use the built-in configuration.
# KYBERION_CLAUDE_AGENT_TOOLS=

# [path/path] Path override for the claude CLI binary.
# KYBERION_CLAUDE_CLI_BIN=

# [runtime/string] Optional runtime setting for claude cli extra args; leave unset to use the built-in configuration.
# KYBERION_CLAUDE_CLI_EXTRA_ARGS=

# [provider/string] Model name passed to the Claude CLI backend.
# KYBERION_CLAUDE_CLI_MODEL=

# [tuning/number] Optional numeric tuning value for claude cli timeout ms; leave unset to use the governed default.
# KYBERION_CLAUDE_CLI_TIMEOUT_MS=

# [provider/string] Compatibility-alias fast model override for Claude routes.
# KYBERION_CLAUDE_FAST_MODEL=

# [provider/string] Compatibility-alias model override for Claude routes.
# KYBERION_CLAUDE_MODEL=

# [flag/boolean] Set to 1 to delegate through Claude's provider-native sub-agents (one shared stream-json CLI session / SDK `agents`) instead of spawning `claude -p` per task. Fails closed with subagent_unavailable when a delegation cannot be observed.
# KYBERION_CLAUDE_NATIVE_SUBAGENT=

# [runtime/enum] Approval mode for the Codex app-server adapter; strict keeps the governed approval path and relaxed permits provider-side relaxed approvals.
#   values: strict | relaxed
# KYBERION_CODEX_APPROVAL=strict

# [path/path] Explicit executable path for the Codex CLI query backend; when unset, the backend resolves an acceptable Codex binary from the host.
# KYBERION_CODEX_CLI_BIN=

# [runtime/string] Whitespace-separated extra arguments appended to Codex CLI query invocations.
# KYBERION_CODEX_CLI_EXTRA_ARGS=

# [provider/string] Model name passed to the Codex CLI backend.
# KYBERION_CODEX_CLI_MODEL=

# [tuning/number] Timeout in milliseconds for a Codex CLI query; unset keeps the adapter default.
# KYBERION_CODEX_CLI_TIMEOUT_MS=

# [runtime/string] Comma-separated Codex instance identifiers used by provider-health routing to track independent quotas and demotions.
# KYBERION_CODEX_INSTANCES=

# [runtime/enum] Codex transport mode; app-server uses the JSON-RPC adapter, while exec and legacy select the CLI adapter.
#   values: app-server | exec | legacy
# KYBERION_CODEX_MODE=app-server

# [provider/string] Model identifier used by the Codex agent and intent compiler routes.
# KYBERION_CODEX_MODEL=

# [provider/string] Provider hint paired with the Codex model identifier for app-server execution.
# KYBERION_CODEX_MODEL_PROVIDER=

# [provider/string] Base URL for the ComfyUI image or video generation provider; requests must remain within the governed provider and egress boundaries.
# KYBERION_COMFY_BASE_URL=

# [path/path] Optional path override for comfy output dir; keep it inside governed repository or runtime storage.
# KYBERION_COMFY_OUTPUT_DIR=

# [runtime/string] Optional runtime setting for computer surface principal; leave unset to use the built-in configuration.
# KYBERION_COMPUTER_SURFACE_PRINCIPAL=

# [path/path] Optional path override for confidential operator learning dispatch registry path; keep it inside governed repository or runtime storage.
# KYBERION_CONFIDENTIAL_OPERATOR_LEARNING_DISPATCH_REGISTRY_PATH=

# [tuning/number] Optional numeric tuning value for context buffer tokens; leave unset to use the governed default.
# KYBERION_CONTEXT_BUFFER_TOKENS=

# [runtime/string] Optional runtime setting for context pack id; leave unset to use the built-in configuration.
# KYBERION_CONTEXT_PACK_ID=

# [tuning/number] Optional numeric tuning value for context reserve tokens; leave unset to use the governed default.
# KYBERION_CONTEXT_RESERVE_TOKENS=

# [tuning/number] Optional numeric tuning value for context window tokens; leave unset to use the governed default.
# KYBERION_CONTEXT_WINDOW_TOKENS=

# [path/path] Optional path override for contextual intent learning path; keep it inside governed repository or runtime storage.
# KYBERION_CONTEXTUAL_INTENT_LEARNING_PATH=

# [path/path] Optional path override for contextual intent memory path; keep it inside governed repository or runtime storage.
# KYBERION_CONTEXTUAL_INTENT_MEMORY_PATH=

# [path/path] Optional path override for copilot cli bin; keep it inside governed repository or runtime storage.
# KYBERION_COPILOT_CLI_BIN=

# [provider/string] Model name requested from the Copilot ACP backend.
# KYBERION_COPILOT_MODEL=

# [path/path] Optional path override for curation archive history path; keep it inside governed repository or runtime storage.
# KYBERION_CURATION_ARCHIVE_HISTORY_PATH=

# [path/path] Optional output path for the knowledge curation report; use a governed shared runtime or report location rather than a tenant-unscoped data directory.
# KYBERION_CURATION_REPORT_PATH=

# [runtime/string] Optional runtime setting for curation scan roots; leave unset to use the built-in configuration.
# KYBERION_CURATION_SCAN_ROOTS=

# [path/path] Optional path override for curation slo config path; keep it inside governed repository or runtime storage.
# KYBERION_CURATION_SLO_CONFIG_PATH=

# [path/path] Optional path override for curation taxonomy path; keep it inside governed repository or runtime storage.
# KYBERION_CURATION_TAXONOMY_PATH=

# [runtime/string] Test and controlled-operation root override for tenant curation ledger discovery; it is resolved through the governed root resolver and must not be used to widen tenant scope.
# KYBERION_CURATION_TENANT_ROOTDIR=

# [runtime/string] Active customer profile slug used to resolve the profile root.
# KYBERION_CUSTOMER=

# [tuning/number] Delegation hop depth propagated to child processes for policy limits; operator-started roots default to zero.
# KYBERION_DELEGATION_DEPTH=

# [tuning/number] Milliseconds between SIGTERM and SIGKILL when a delegated child exceeds its wall-clock budget; the default is 5 seconds.
# KYBERION_DELEGATION_KILL_GRACE_MS=

# [tuning/number] Global maximum number of concurrent delegated tasks admitted by the process semaphore; the default is 4.
# KYBERION_DELEGATION_MAX_CONCURRENCY=

# [path/path] Override path for durable delegation notifications; keep it inside the governed shared runtime area.
# KYBERION_DELEGATION_NOTIFICATIONS_PATH=

# [runtime/string] Optional JSON object mapping provider ids to positive concurrency caps, for example {"claude":3}; invalid JSON is ignored.
# KYBERION_DELEGATION_PROVIDER_CAPS=

# [tuning/number] Default maximum concurrent delegated tasks per provider when no provider-specific cap is configured; the default is 2.
# KYBERION_DELEGATION_PROVIDER_MAX_CONCURRENCY=

# [path/path] Directory for durable delegation task records; keep it within governed shared runtime storage.
# KYBERION_DELEGATION_STORE_DIR=

# [flag/boolean] Enables the continuation retry when a delegated final summary is too brief; set false, 0, or off only for controlled compatibility runs.
# KYBERION_DELEGATION_SUMMARY_RETRY=

# [path/path] Override path for delegated-task trace records used for observability and replay; keep it in governed runtime storage.
# KYBERION_DELEGATION_TRACE_PATH=

# [tuning/number] Wall-clock budget per delegated task before timeout and child termination; the default is 10 minutes.
# KYBERION_DELEGATION_WALL_CLOCK_MS=

# [provider/string] Optional shell deployment adapter command for CI/CD dispatch; real deployment remains behind the deployment approval gate and explicit configuration.
# KYBERION_DEPLOY_COMMAND=

# [path/path] Optional path override for deploy config path; keep it inside governed repository or runtime storage.
# KYBERION_DEPLOY_CONFIG_PATH=

# [runtime/string] Optional runtime setting for deploy project; leave unset to use the built-in configuration.
# KYBERION_DEPLOY_PROJECT=

# [tuning/number] Optional numeric tuning value for deploy timeout ms; leave unset to use the governed default.
# KYBERION_DEPLOY_TIMEOUT_MS=

# [runtime/string] Optional runtime setting for deployment project; leave unset to use the built-in configuration.
# KYBERION_DEPLOYMENT_PROJECT=

# [flag/boolean] Disable the agent runtime supervisor daemon for controlled local or test runs.
# KYBERION_DISABLE_AGENT_RUNTIME_SUPERVISOR_DAEMON=

# [flag/boolean] Disable embedding generation and use the non-semantic retrieval path.
# KYBERION_DISABLE_EMBEDDINGS=

# [runtime/string] Optional runtime setting for dispatch max rounds; leave unset to use the built-in configuration.
# KYBERION_DISPATCH_MAX_ROUNDS=

# [runtime/string] Optional runtime setting for draft refine; leave unset to use the built-in configuration.
# KYBERION_DRAFT_REFINE=

# [runtime/string] Network egress policy override; use warn to observe or enforce to reject destinations outside the governed allowlist. The policy file remains authoritative for domains.
# KYBERION_EGRESS_POLICY=

# [path/path] Optional path to the governed egress-policy catalog; keep it in an approved knowledge or deployment configuration location.
# KYBERION_EGRESS_POLICY_PATH=

# [runtime/string] Optional runtime setting for email from; leave unset to use the built-in configuration.
# KYBERION_EMAIL_FROM=

# [flag/boolean] Enable the service-actuate tool for trusted operators after capability approval.
# KYBERION_ENABLE_SERVICE_ACTUATE_TOOL=

# [runtime/string] Optional runtime setting for entity governance; leave unset to use the built-in configuration.
# KYBERION_ENTITY_GOVERNANCE=

# [flag/boolean] Fail check:entity-governance when observed warnings exist.
# KYBERION_ENTITY_GOVERNANCE_STRICT_WARNINGS=

# [flag/boolean] Strict startup validation of KYBERION_* variables; on by default. Set to 0/false to downgrade unregistered or mistyped variables to warnings. Register new names in env-registry.json via pnpm generate:env-registry.
# KYBERION_ENV_REGISTRY_STRICT=1

# [flag/boolean] Generator-only strictness: when enabled, the env-registry drift check also fails while any registry entry remains undocumented. Off by default; independent of KYBERION_ENV_REGISTRY_STRICT (CLI startup validation).
# KYBERION_ENV_REGISTRY_STRICT_DOCS=0

# [runtime/string] Optional runtime setting for first win live; leave unset to use the built-in configuration.
# KYBERION_FIRST_WIN_LIVE=

# [provider/string] Local FluidAudio/Parakeet JSON bridge command for speech-to-text; the bridge receives a governed audio path and returns structured transcription output.
# KYBERION_FLUID_AUDIO_STT_COMMAND=

# [tuning/number] Optional timeout in milliseconds for the FluidAudio/Parakeet batch STT bridge; unset uses the shell bridge default of five minutes.
# KYBERION_FLUID_AUDIO_STT_TIMEOUT_MS=300000

# [runtime/string] Optional runtime setting for format; leave unset to use the built-in configuration.
# KYBERION_FORMAT=

# [runtime/enum] Human-override signature policy: warn observes missing or invalid gate signatures while enforce rejects them.
#   values: warn | enforce
# KYBERION_GATE_OVERRIDE_SIGNATURE=

# [path/path] Optional path override for gemini cli bin; keep it inside governed repository or runtime storage.
# KYBERION_GEMINI_CLI_BIN=

# [provider/string] Model name passed to the Gemini CLI backend.
# KYBERION_GEMINI_CLI_MODEL=

# [tuning/number] Optional numeric tuning value for gemini cli timeout; leave unset to use the governed default.
# KYBERION_GEMINI_CLI_TIMEOUT=

# [provider/string] Fast model override for the Gemini route.
# KYBERION_GEMINI_FAST_MODEL=

# [provider/string] Model identifier used by the Gemini API and routing fallback.
# KYBERION_GEMINI_MODEL=

# [runtime/string] Optional runtime setting for gemini tts voice; leave unset to use the built-in configuration.
# KYBERION_GEMINI_TTS_VOICE=

# [provider/string] Optional Gemini API base URL override; leave unset for the provider default and use only an endpoint permitted by the egress policy.
# KYBERION_GEMINI_URL=

# [secret/string] API key used by the explicit Google Veo video-generation backend.
# KYBERION_GEMINI_VIDEO_API_KEY=

# [provider/string] Optional base URL override for the Google Veo video-generation API.
# KYBERION_GEMINI_VIDEO_URL=

# [tuning/number] Optional numeric tuning value for generation schedule interval ms; leave unset to use the governed default.
# KYBERION_GENERATION_SCHEDULE_INTERVAL_MS=

# [tuning/number] Optional numeric tuning value for global inflight limit; leave unset to use the governed default.
# KYBERION_GLOBAL_INFLIGHT_LIMIT=

# [runtime/string] Optional runtime setting for goal loop max rounds; leave unset to use the built-in configuration.
# KYBERION_GOAL_LOOP_MAX_ROUNDS=

# [secret/string] xAI Grok API key for the grok-api reasoning backend. `XAI_API_KEY` is also accepted for compatibility.
# KYBERION_GROK_API_KEY=

# [provider/string] xAI Grok API model id. Defaults to grok-4.6 when omitted.
# KYBERION_GROK_API_MODEL=

# [provider/string] Optional xAI-compatible API base URL; defaults to https://api.x.ai/v1.
# KYBERION_GROK_API_URL=

# [path/path] Optional path override for grok cli bin; keep it inside governed repository or runtime storage.
# KYBERION_GROK_CLI_BIN=

# [runtime/string] Optional runtime setting for grok cli extra args; leave unset to use the built-in configuration.
# KYBERION_GROK_CLI_EXTRA_ARGS=

# [provider/string] Model name passed to the Grok Build CLI backend.
# KYBERION_GROK_CLI_MODEL=

# [tuning/number] Optional numeric tuning value for grok cli timeout ms; leave unset to use the governed default.
# KYBERION_GROK_CLI_TIMEOUT_MS=

# [runtime/string] Optional runtime setting for harness subagent; leave unset to use the built-in configuration.
# KYBERION_HARNESS_SUBAGENT=

# [path/path] Optional path override for hints archive dir; keep it inside governed repository or runtime storage.
# KYBERION_HINTS_ARCHIVE_DIR=

# [path/path] Optional path override for hints path; keep it inside governed repository or runtime storage.
# KYBERION_HINTS_PATH=

# [runtime/string] Optional runtime setting for history search db; leave unset to use the built-in configuration.
# KYBERION_HISTORY_SEARCH_DB=

# [runtime/string] Optional runtime setting for host agent active; leave unset to use the built-in configuration.
# KYBERION_HOST_AGENT_ACTIVE=

# [runtime/string] Optional runtime setting for imessage wake word; leave unset to use the built-in configuration.
# KYBERION_IMESSAGE_WAKE_WORD=

# [runtime/string] Optional runtime setting for in session subagent; leave unset to use the built-in configuration.
# KYBERION_IN_SESSION_SUBAGENT=

# [runtime/string] Optional runtime setting for ingest quota test; leave unset to use the built-in configuration.
# KYBERION_INGEST_QUOTA_TEST=

# [runtime/string] Optional runtime setting for injection scope; leave unset to use the built-in configuration.
# KYBERION_INJECTION_SCOPE=

# [runtime/string] Optional runtime setting for injection suspected; leave unset to use the built-in configuration.
# KYBERION_INJECTION_SUSPECTED=

# [provider/string] Explicit model override for intent contract compilation.
# KYBERION_INTENT_COMPILER_MODEL=

# [provider/string] Provider hint paired with the intent compiler model override.
# KYBERION_INTENT_COMPILER_MODEL_PROVIDER=

# [provider/string] Provider route selected for intent contract compilation.
# KYBERION_INTENT_COMPILER_PROVIDER=

# [path/path] Override for exported intent-contract memory artifacts; the global default is active/shared/exports/intent-contract-memory and tenant runs remain physically scoped.
# KYBERION_INTENT_CONTRACT_MEMORY_EXPORT_DIR=

# [path/path] Override for the intent-contract memory sync report; the global default is active/shared/runtime/reports/intent-contract-memory-sync-latest.json.
# KYBERION_INTENT_CONTRACT_MEMORY_REPORT_PATH=

# [path/path] Override for the global intent-contract memory runtime file; relative values resolve from the repository root and tenant-scoped runs use their physical scope path.
# KYBERION_INTENT_CONTRACT_MEMORY_RUNTIME_PATH=

# [path/path] Override for the intent-contract memory schema used by the sync command; the default is knowledge/product/schemas/intent-contract-memory.schema.json.
# KYBERION_INTENT_CONTRACT_MEMORY_SCHEMA_PATH=

# [path/path] Override for the governance seed used by intent-contract memory sync; tenant-scoped memory cannot be promoted into the global seed without the governed brokered path.
# KYBERION_INTENT_CONTRACT_MEMORY_SEED_PATH=

# [path/path] Optional path override for ki cache dir; keep it inside governed repository or runtime storage.
# KYBERION_KI_CACHE_DIR=

# [runtime/string] Optional runtime setting for ki cache max mb; leave unset to use the built-in configuration.
# KYBERION_KI_CACHE_MAX_MB=

# [tuning/number] Optional numeric tuning value for kill switch interval ms; leave unset to use the governed default.
# KYBERION_KILL_SWITCH_INTERVAL_MS=

# [path/path] Override for knowledge feedback delivery logs; the default is active/shared/runtime/feedback-loop/knowledge-delivery and scoped runs append under their tenant or mission path.
# KYBERION_KNOWLEDGE_DELIVERY_DIR=

# [path/path] Override for scoped human-feedback and knowledge-gap JSONL storage (default active/shared/runtime/feedback-loop).
# KYBERION_KNOWLEDGE_FEEDBACK_DIR=

# [path/path] Override for the knowledge feedback policy catalog; unsafe paths are rejected and the canonical product governance policy remains the fallback.
# KYBERION_KNOWLEDGE_FEEDBACK_POLICY_PATH=

# [runtime/string] Comma-separated knowledge references attached to ambient reasoning visibility for the active mission context.
# KYBERION_KNOWLEDGE_REFS=

# [path/path] Override for the knowledge-scope health history report; the default is active/shared/runtime/feedback-loop/knowledge-scope-health.json.
# KYBERION_KNOWLEDGE_SCOPE_HEALTH_HISTORY_PATH=

# [path/path] Override for the knowledge-scope reconciliation report; the default is active/shared/runtime/reports/knowledge-scope-reconciliation-latest.json.
# KYBERION_KNOWLEDGE_SCOPE_RECONCILIATION_PATH=

# [runtime/string] Knowledge tier hint propagated into pipeline facet resolution; accepted values are public, confidential, and personal, with invalid values falling back to public.
# KYBERION_KNOWLEDGE_TIER=

# [path/path] Override for aggregated knowledge usage and yield data; the default is active/shared/runtime/feedback-loop/knowledge-usage/usage.json and scoped reads preserve tenant containment.
# KYBERION_KNOWLEDGE_USAGE_PATH=

# [runtime/string] Optional runtime setting for live blackhole test; leave unset to use the built-in configuration.
# KYBERION_LIVE_BLACKHOLE_TEST=

# [secret/string] API key for the llama.cpp OpenAI-compatible backend, when authentication is enabled.
# KYBERION_LLAMACPP_KEY=

# [provider/string] Model identifier sent to the llama.cpp OpenAI-compatible endpoint.
# KYBERION_LLAMACPP_MODEL=

# [provider/string] Base URL for the llama.cpp OpenAI-compatible endpoint.
# KYBERION_LLAMACPP_URL=

# [runtime/string] Optional runtime setting for llm concurrency; leave unset to use the built-in configuration.
# KYBERION_LLM_CONCURRENCY=

# [provider/string] Compatibility-alias model identifier sent to the LM Studio endpoint.
# KYBERION_LM_STUDIO_MODEL=

# [provider/string] Compatibility-alias base URL for the LM Studio OpenAI-compatible endpoint.
# KYBERION_LM_STUDIO_URL=

# [secret/string] API key for the LM Studio OpenAI-compatible backend, when authentication is enabled.
# KYBERION_LMSTUDIO_KEY=

# [provider/string] Model identifier sent to the LM Studio OpenAI-compatible endpoint.
# KYBERION_LMSTUDIO_MODEL=

# [provider/string] Base URL for the LM Studio OpenAI-compatible endpoint.
# KYBERION_LMSTUDIO_URL=

# [secret/string] API key for the local LLM endpoint.
# KYBERION_LOCAL_LLM_KEY=

# [provider/string] Model id for the local LLM endpoint.
# KYBERION_LOCAL_LLM_MODEL=

# [provider/string] Base URL of a local OpenAI-compatible LLM endpoint.
# KYBERION_LOCAL_LLM_URL=

# [secret/string] Bearer token for the chronos localadmin control surface.
# KYBERION_LOCALADMIN_TOKEN=

# [secret/string] API key for the LocalAI OpenAI-compatible backend, when authentication is enabled.
# KYBERION_LOCALAI_KEY=

# [provider/string] Model identifier sent to the LocalAI OpenAI-compatible endpoint.
# KYBERION_LOCALAI_MODEL=

# [provider/string] Base URL for the LocalAI OpenAI-compatible endpoint.
# KYBERION_LOCALAI_URL=

# [runtime/string] Optional runtime setting for locale; leave unset to use the built-in configuration.
# KYBERION_LOCALE=

# [runtime/string] Allow loopback Chronos requests to use the compatibility localadmin principal when true or unset.
# KYBERION_LOCALHOST_AUTOADMIN=

# [runtime/string] Optional runtime setting for managed python version; leave unset to use the built-in configuration.
# KYBERION_MANAGED_PYTHON_VERSION=

# [secret/string] HMAC-SHA256 key for environment manifest signatures. When set, loadEnvironmentManifest enforces valid signatures fail-closed; sign manifests with pnpm manifests:sign.
# KYBERION_MANIFEST_SIGNING_KEY=

# [runtime/string] Server-bound MCP caller role checked against mcp-tool-catalog.json; client arguments cannot elevate it.
# KYBERION_MCP_CALLER_ROLE=

# [runtime/string] Server-bound NHI used to bind MCP event and approval scope.
# KYBERION_MCP_NHI=

# [runtime/string] Server-bound principal name recorded for MCP request attribution.
# KYBERION_MCP_PRINCIPAL=

# [runtime/string] Server-bound tenant slug; a client-supplied tenant may only narrow this binding.
# KYBERION_MCP_TENANT=

# [tuning/number] Optional numeric tuning value for media backend probe ttl ms; leave unset to use the governed default.
# KYBERION_MEDIA_BACKEND_PROBE_TTL_MS=

# [path/path] Optional path override for media backend registry path; keep it inside governed repository or runtime storage.
# KYBERION_MEDIA_BACKEND_REGISTRY_PATH=

# [secret/string] Pre-shared token used to authenticate the Chrome meeting extension bridge.
# KYBERION_MEET_EXTENSION_TOKEN=

# [runtime/string] Optional runtime setting for memory autopromote; leave unset to use the built-in configuration.
# KYBERION_MEMORY_AUTOPROMOTE=

# [path/path] Optional path override for memory queue path; keep it inside governed repository or runtime storage.
# KYBERION_MEMORY_QUEUE_PATH=

# [path/path] Optional path override for mesh hub observability root; keep it inside governed repository or runtime storage.
# KYBERION_MESH_HUB_OBSERVABILITY_ROOT=

# [path/path] Optional path override for mesh hub runtime root; keep it inside governed repository or runtime storage.
# KYBERION_MESH_HUB_RUNTIME_ROOT=

# [runtime/string] Optional runtime setting for mesh namespace; leave unset to use the built-in configuration.
# KYBERION_MESH_NAMESPACE=

# [runtime/string] Optional runtime setting for mesh peer id; leave unset to use the built-in configuration.
# KYBERION_MESH_PEER_ID=

# [secret/string] Shared secret used to authenticate mesh delivery and peer coordination.
# KYBERION_MESH_SHARED_SECRET=

# [provider/string] Model identifier passed to the local mflux image-generation backend; it selects the model and does not configure a remote provider endpoint.
# KYBERION_MFLUX_MODEL=

# [runtime/string] Package specification supplied to the local mflux runner; use this to select a pinned or locally available package build.
# KYBERION_MFLUX_PACKAGE=mflux

# [runtime/number] Positive quantization level passed to the local mflux image-generation runner; defaults to 8.
# KYBERION_MFLUX_QUANTIZE=8

# [runtime/string] Optional deterministic seed passed to the local mflux image-generation runner.
# KYBERION_MFLUX_SEED=

# [runtime/number] Positive diffusion step count for local mflux generation; the default is mode-dependent (4 for schnell and 20 for dev).
# KYBERION_MFLUX_STEPS=

# [tuning/number] Maximum local mflux generation time in milliseconds; defaults to 30 minutes.
# KYBERION_MFLUX_TIMEOUT_MS=1800000

# [secret/string] API key used by the explicit MiniMax Hailuo video-generation backend.
# KYBERION_MINIMAX_VIDEO_API_KEY=

# [provider/string] Optional base URL override for the MiniMax Hailuo video-generation API.
# KYBERION_MINIMAX_VIDEO_URL=

# [path/path] Optional path override for mission task trace dir; keep it inside governed repository or runtime storage.
# KYBERION_MISSION_TASK_TRACE_DIR=

# [provider/string] Hugging Face model identifier used by the MLX embedding backend.
# KYBERION_MLX_EMBED_MODEL=

# [secret/string] API key for the MLX OpenAI-compatible backend, when authentication is enabled.
# KYBERION_MLX_KEY=

# [provider/string] Model identifier sent to the MLX-LM OpenAI-compatible endpoint.
# KYBERION_MLX_MODEL=

# [provider/string] Base URL for the MLX-LM OpenAI-compatible endpoint.
# KYBERION_MLX_URL=

# [provider/string] Model identifier used by the managed MLX Whisper streaming adapter.
# KYBERION_MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# [runtime/string] Optional runtime setting for mos principal; leave unset to use the built-in configuration.
# KYBERION_MOS_PRINCIPAL=

# [secret/string] API key for the Nemotron OpenAI-compatible backend, when authentication is enabled.
# KYBERION_NEMOTRON_KEY=

# [provider/string] Model identifier sent to the Nemotron OpenAI-compatible endpoint.
# KYBERION_NEMOTRON_MODEL=

# [provider/string] Base URL for the Nemotron OpenAI-compatible endpoint.
# KYBERION_NEMOTRON_URL=

# [runtime/string] Non-human identity actor verification mode: off disables checks, warn audits violations, and enforce rejects unregistered, suspended, or retired actors; the default is warn.
# KYBERION_NHI_ACTOR=

# [runtime/string] Optional runtime setting for nhi id; leave unset to use the built-in configuration.
# KYBERION_NHI_ID=

# [runtime/string] Optional runtime setting for non interactive; leave unset to use the built-in configuration.
# KYBERION_NON_INTERACTIVE=

# [provider/string] Bind host for the local OAuth callback surface; the default is loopback and a remote host should be used only with an explicitly secured deployment.
# KYBERION_OAUTH_CALLBACK_HOST=

# [path/path] Optional path override for oauth callback path; keep it inside governed repository or runtime storage.
# KYBERION_OAUTH_CALLBACK_PATH=

# [tuning/number] Local TCP port for the OAuth callback surface; the default is 8787 and remote binding still requires the callback host and deployment security controls.
# KYBERION_OAUTH_CALLBACK_PORT=

# [runtime/string] Optional runtime setting for oauth service id; leave unset to use the built-in configuration.
# KYBERION_OAUTH_SERVICE_ID=

# [secret/string] API key for the Ollama OpenAI-compatible backend, when authentication is enabled.
# KYBERION_OLLAMA_KEY=

# [provider/string] Model name sent to the Ollama OpenAI-compatible endpoint.
# KYBERION_OLLAMA_MODEL=

# [provider/string] Base URL for the Ollama OpenAI-compatible endpoint.
# KYBERION_OLLAMA_URL=

# [runtime/string] Optional runtime setting for onboarding non interactive ok; leave unset to use the built-in configuration.
# KYBERION_ONBOARDING_NON_INTERACTIVE_OK=

# [provider/string] Model identifier used as the OpenAI vision route fallback.
# KYBERION_OPENAI_MODEL=

# [secret/string] API key used by the explicit OpenAI Sora video-generation backend.
# KYBERION_OPENAI_VIDEO_API_KEY=

# [provider/string] Optional base URL override for the OpenAI Videos API.
# KYBERION_OPENAI_VIDEO_URL=

# [provider/string] Model identifier used for OpenAI-compatible vision requests.
# KYBERION_OPENAI_VISION_MODEL=

# [provider/enum] OpenRouter cost guard. `free-only` is the safe default; `paid-allowed` explicitly opts into paid inference.
#   values: free-only | paid-allowed
# KYBERION_OPENROUTER_COST_POLICY=free-only

# [secret/string] OpenRouter API key. `OPENROUTER_API_KEY` is also accepted for compatibility.
# KYBERION_OPENROUTER_KEY=

# [provider/string] OpenRouter model id sent to the chat completions endpoint. Defaults to the free model router when omitted.
# KYBERION_OPENROUTER_MODEL=

# [provider/enum] OpenRouter model selection profile: free-router, pinned :free model, or explicit model.
#   values: free-router | free-pinned | explicit
# KYBERION_OPENROUTER_PROFILE=free-router

# [provider/string] Comma-separated OpenRouter supported parameters required by the selected model.
# KYBERION_OPENROUTER_REQUIRED_PARAMETERS=tools,tool_choice

# [provider/string] Optional OpenRouter-compatible API base URL; defaults to https://openrouter.ai/api/v1.
# KYBERION_OPENROUTER_URL=

# [path/path] Optional path override for operator learning dispatch registry path; keep it inside governed repository or runtime storage.
# KYBERION_OPERATOR_LEARNING_DISPATCH_REGISTRY_PATH=

# [provider/string] Optional webhook destination for operational alerts; delivery is attempted only when configured and remains subject to egress policy, while the local alert ledger remains the source of record.
# KYBERION_OPS_ALERT_WEBHOOK_URL=

# [runtime/string] Optional runtime setting for organization id; leave unset to use the built-in configuration.
# KYBERION_ORGANIZATION_ID=

# [provider/string] URL of the guarded OS decision surface shown to a human when an operating-system action is held; it is a presentation link, not an authorization input.
# KYBERION_OS_GUARDED_SURFACE_URL=

# [provider/string] Bind host for the peer messaging and peer conversation servers; the default is loopback and remote binding requires the mesh transport security configuration.
# KYBERION_PEER_HOST=

# [secret/string] Secret reference recorded in peer enrollment; it identifies the secret without storing its value.
# KYBERION_PEER_KEY_REF=

# [runtime/string] Optional runtime setting for peer network catalog; leave unset to use the built-in configuration.
# KYBERION_PEER_NETWORK_CATALOG=

# [tuning/number] Optional numeric tuning value for peer port; leave unset to use the governed default.
# KYBERION_PEER_PORT=

# [secret/string] HMAC shared secret used to authenticate peer messaging.
# KYBERION_PEER_SHARED_SECRET=

# [runtime/string] Active persona for the policy engine (set by withExecutionContext; rarely set manually).
# KYBERION_PERSONA=

# [path/path] Optional path override for personal operator learning dispatch registry path; keep it inside governed repository or runtime storage.
# KYBERION_PERSONAL_OPERATOR_LEARNING_DISPATCH_REGISTRY_PATH=

# [path/path] Optional path override for personal presentation preference registry path; keep it inside governed repository or runtime storage.
# KYBERION_PERSONAL_PRESENTATION_PREFERENCE_REGISTRY_PATH=

# [path/path] Optional path override for personal surface query config path; keep it inside governed repository or runtime storage.
# KYBERION_PERSONAL_SURFACE_QUERY_CONFIG_PATH=

# [path/path] Optional path override for personal voice profile registry path; keep it inside governed repository or runtime storage.
# KYBERION_PERSONAL_VOICE_PROFILE_REGISTRY_PATH=

# [runtime/string] Optional runtime setting for phase gate mode; leave unset to use the built-in configuration.
# KYBERION_PHASE_GATE_MODE=

# [runtime/string] Optional runtime setting for pipeline fallback active; leave unset to use the built-in configuration.
# KYBERION_PIPELINE_FALLBACK_ACTIVE=

# [runtime/string] Optional runtime setting for prefix; leave unset to use the built-in configuration.
# KYBERION_PREFIX=

# [path/path] Optional path override for presence avatar profiles path; keep it inside governed repository or runtime storage.
# KYBERION_PRESENCE_AVATAR_PROFILES_PATH=

# [path/path] Optional path override for presentation preference registry path; keep it inside governed repository or runtime storage.
# KYBERION_PRESENTATION_PREFERENCE_REGISTRY_PATH=

# [runtime/string] Optional runtime setting for project id; leave unset to use the built-in configuration.
# KYBERION_PROJECT_ID=

# [runtime/string] Optional runtime setting for project name; leave unset to use the built-in configuration.
# KYBERION_PROJECT_NAME=

# [path/path] Optional path override for project root; keep it inside governed repository or runtime storage.
# KYBERION_PROJECT_ROOT=

# [runtime/string] Optional runtime setting for provider capability probe; leave unset to use the built-in configuration.
# KYBERION_PROVIDER_CAPABILITY_PROBE=

# [runtime/string] Force a provider capability re-probe and reasoning backend re-selection
# KYBERION_PROVIDER_CAPABILITY_REFRESH=

# [runtime/string] Optional runtime setting for provider capability routing; leave unset to use the built-in configuration.
# KYBERION_PROVIDER_CAPABILITY_ROUTING=

# [tuning/number] Optional numeric tuning value for provider demotion ttl ms; leave unset to use the governed default.
# KYBERION_PROVIDER_DEMOTION_TTL_MS=

# [runtime/string] Optional runtime setting for provider discovery refresh; leave unset to use the built-in configuration.
# KYBERION_PROVIDER_DISCOVERY_REFRESH=

# [path/path] Optional path override for provider egress policy path; keep it inside governed repository or runtime storage.
# KYBERION_PROVIDER_EGRESS_POLICY_PATH=

# [runtime/string] Provider child-process environment policy; allowlisting is enabled by default, while 0 is an explicit diagnostic escape hatch that passes through the parent environment.
# KYBERION_PROVIDER_ENV_ALLOWLIST=

# [path/path] Override for the persisted provider-health state file (default active/shared/runtime/provider-health.json). Mainly for tests.
# KYBERION_PROVIDER_HEALTH_STATE_PATH=

# [runtime/string] Optional runtime setting for provider priority; leave unset to use the built-in configuration.
# KYBERION_PROVIDER_PRIORITY=

# [runtime/string] Optional runtime setting for ptc child; leave unset to use the built-in configuration.
# KYBERION_PTC_CHILD=

# [tuning/number] Optional numeric tuning value for pty idle timeout ms; leave unset to use the governed default.
# KYBERION_PTY_IDLE_TIMEOUT_MS=

# [path/path] Python interpreter override for python-backed bridges.
# KYBERION_PYTHON=

# [path/path] Python interpreter path override (legacy alias of KYBERION_PYTHON call sites).
# KYBERION_PYTHON_BIN=

# [runtime/string] Explicitly enables the shell_exec tool for reasoning profiles that request it; only the literal true enables the capability and the shell policy still applies.
# KYBERION_REASONING_ALLOW_SHELL_TOOL=

# [provider/string] Reasoning backend selector. Common values: claude-cli (local claude CLI, no API key), anthropic (ANTHROPIC_API_KEY), codex-cli, agy-cli (Antigravity CLI), grok-cli (Grok Build CLI), grok-api (XAI_API_KEY or KYBERION_GROK_API_KEY), openrouter (OPENROUTER_API_KEY or KYBERION_OPENROUTER_KEY), stub (offline/deterministic tests). gemini-cli remains available for explicit Enterprise configurations.
# KYBERION_REASONING_BACKEND=

# [tuning/number] Optional numeric tuning value for reasoning in place retries; leave unset to use the governed default.
# KYBERION_REASONING_IN_PLACE_RETRIES=

# [provider/string] Global fallback model override for reasoning routes.
# KYBERION_REASONING_MODEL=

# [runtime/string] Optional runtime setting for reasoning profile; leave unset to use the built-in configuration.
# KYBERION_REASONING_PROFILE=

# [tuning/number] Optional numeric tuning value for reasoning retry base ms; leave unset to use the governed default.
# KYBERION_REASONING_RETRY_BASE_MS=

# [runtime/string] Optional runtime setting for reminder cc after n; leave unset to use the built-in configuration.
# KYBERION_REMINDER_CC_AFTER_N=

# [runtime/string] Optional runtime setting for restricted actions policy; leave unset to use the built-in configuration.
# KYBERION_RESTRICTED_ACTIONS_POLICY=

# [runtime/string] Optional runtime setting for restricted approved items; leave unset to use the built-in configuration.
# KYBERION_RESTRICTED_APPROVED_ITEMS=

# [path/path] Repository root override for path resolution (defaults to the detected repo root).
# KYBERION_ROOT=

# [tuning/number] Optional numeric tuning value for runtime sweep interval ms; leave unset to use the governed default.
# KYBERION_RUNTIME_SWEEP_INTERVAL_MS=

# [secret/string] API key used by the explicit Runway video-generation backends.
# KYBERION_RUNWAY_API_KEY=

# [provider/string] Optional base URL override for the Runway video-generation API.
# KYBERION_RUNWAY_VIDEO_URL=

# [path/path] Override for the persisted operator scope binding file (default active/shared/runtime/scope.env).
# KYBERION_SCOPE_ENV_PATH=

# [flag/enum] At-rest encryption mode for connection documents (AC-05). none=plaintext (default, compatible); keychain=AES-256-GCM with a macOS-keychain-held key. Migrate with pnpm secrets:encrypt (--decrypt exports back to plaintext).
#   values: none | keychain
# KYBERION_SECRET_ENCRYPTION=

# [provider/string] Command used by the secret resolver to obtain named secrets.
# KYBERION_SECRET_RESOLVER_COMMAND=

# [tuning/number] Timeout in milliseconds for the external secret resolver command.
# KYBERION_SECRET_RESOLVER_TIMEOUT_MS=

# [runtime/string] Security-screen posture override; accepted values are dangerous, auto, and strict. Invalid values are ignored and the schema-validated posture catalog is used.
# KYBERION_SECURITY_POSTURE=

# [path/path] Optional path override for security quarantine dir; keep it inside governed repository or runtime storage.
# KYBERION_SECURITY_QUARANTINE_DIR=

# [runtime/string] Optional runtime setting for security quarantine max bytes; leave unset to use the built-in configuration.
# KYBERION_SECURITY_QUARANTINE_MAX_BYTES=

# [path/path] Optional path override for service endpoints dir; keep it inside governed repository or runtime storage.
# KYBERION_SERVICE_ENDPOINTS_DIR=

# [path/path] Optional path override for service endpoints path; keep it inside governed repository or runtime storage.
# KYBERION_SERVICE_ENDPOINTS_PATH=

# [path/path] Optional path override for service presets dir; keep it inside governed repository or runtime storage.
# KYBERION_SERVICE_PRESETS_DIR=

# [path/path] Optional path override for service runtime policy path; keep it inside governed repository or runtime storage.
# KYBERION_SERVICE_RUNTIME_POLICY_PATH=

# [path/path] Optional path override for service runtime registry path; keep it inside governed repository or runtime storage.
# KYBERION_SERVICE_RUNTIME_REGISTRY_PATH=

# [secret/string] HMAC key used to sign and verify share-grant records.
# KYBERION_SHARE_GRANTS_HMAC_KEY=

# [path/path] Optional path override for share grants path; keep it inside governed repository or runtime storage.
# KYBERION_SHARE_GRANTS_PATH=

# [path/path] Optional path to the shell-command policy catalog used for command admission and injection-suspected restrictions; the policy is loaded through the governed catalog boundary.
# KYBERION_SHELL_COMMAND_POLICY_PATH=

# [provider/string] Filesystem path to the Silero VAD ONNX model used by the local realtime voice bridge; when unset, the voice loop uses its configured fallback VAD path.
# KYBERION_SILERO_VAD_MODEL=

# [runtime/string] Optional Python executable for the Silero VAD bridge; fallback order is the managed silero runtime, then KYBERION_PYTHON_BIN, then python3.
# KYBERION_SILERO_VAD_PYTHON=

# [flag/boolean] Skip type-ratchet validation for controlled image or context build runs; CI still enforces the ratchet.
# KYBERION_SKIP_TYPE_RATCHET=

# [provider/string] SMTP host that activates the email actuator SMTP mode; pair it with the separately managed SMTP credentials and keep outbound delivery within the approved egress boundary.
# KYBERION_SMTP_HOST=

# [secret/string] SMTP password or app token used by the email actuator; provide it through the secret store and keep it out of logs and configuration artifacts.
# KYBERION_SMTP_PASS=

# [tuning/number] TCP port used by the email actuator SMTP backend; use the port required by the approved mail service, commonly 465 or 587.
# KYBERION_SMTP_PORT=

# [runtime/string] SMTP username used by the email actuator; keep account identity configuration aligned with the approved outbound mail service.
# KYBERION_SMTP_USER=

# [secret/string] Secret used by the sovereign pulse guard to sign and verify control payloads.
# KYBERION_SOVEREIGN_SECRET=

# [runtime/string] Optional runtime setting for speaker fairness must threshold; leave unset to use the built-in configuration.
# KYBERION_SPEAKER_FAIRNESS_MUST_THRESHOLD=

# [runtime/string] Optional runtime setting for speaker fairness total threshold; leave unset to use the built-in configuration.
# KYBERION_SPEAKER_FAIRNESS_TOTAL_THRESHOLD=

# [flag/boolean] Test-only opt-in: lets vitest exercise the reasoning-path spend guard against real history/policy (normally disabled under VITEST).
# KYBERION_SPEND_GUARD_TEST=

# [runtime/string] Streaming speech-to-text bridge id selected by the realtime loop; unset uses the deterministic stub, while installed shell or managed bridges may be selected explicitly.
# KYBERION_STREAMING_STT_BRIDGE=stub

# [runtime/string] Streaming text-to-speech bridge id selected by the realtime loop; unset uses the PCM stub and an installed shell or provider bridge can be selected explicitly.
# KYBERION_STREAMING_TTS_BRIDGE=stub

# [runtime/string] Optional comma-separated arguments appended to the shell streaming STT command; values are trimmed and empty items are ignored.
# KYBERION_STT_ARGS=

# [runtime/string] Optional JSON object describing shell STT capabilities, such as timestamps, granularity, and local_only; invalid or unsafe shapes are ignored at the bridge boundary.
# KYBERION_STT_CAPABILITIES=

# [provider/string] Speech-to-text bridge command override.
# KYBERION_STT_COMMAND=

# [runtime/string] Compute type passed to faster-whisper; CPU defaults to int8 and non-CPU devices default to float16.
# KYBERION_STT_COMPUTE_TYPE=

# [runtime/string] Device selected by the faster-whisper speech-to-text bridge, such as cpu or cuda.
# KYBERION_STT_DEVICE=cpu

# [runtime/string] Language hint for local Whisper speech-to-text adapters; managed streaming adapters default to ja when unset.
# KYBERION_STT_LANGUAGE=

# [provider/string] Model identifier or size used by faster-whisper when STT_MODEL_DIR is not set.
# KYBERION_STT_MODEL=small

# [path/path] Optional repository-safe model directory used by local STT adapter selection, including faster-whisper and Whisper model availability checks.
# KYBERION_STT_MODEL_DIR=

# [runtime/enum] Output format expected from the explicit shell STT command; `json` enables structured text/capabilities/segments parsing, while text keeps stdout as the transcript.
#   values: text | json
# KYBERION_STT_OUTPUT_FORMAT=text

# [tuning/number] Numeric priority assigned to the explicit shell STT bridge when multiple speech-to-text bridges are registered; higher-level selection may use this value for ordering.
# KYBERION_STT_PRIORITY=

# [tuning/number] Optional timeout in milliseconds for the explicit shell batch STT bridge; unset uses the bridge default of five minutes.
# KYBERION_STT_TIMEOUT_MS=300000

# [tuning/number] Audio window length in seconds for streaming Whisper adapters; defaults are adapter-specific.
# KYBERION_STT_WINDOW_SEC=

# [runtime/string] Optional runtime setting for style keys; leave unset to use the built-in configuration.
# KYBERION_STYLE_KEYS=

# [runtime/string] Authority escalation switch consumed by the policy engine; use only for explicitly approved operations.
# KYBERION_SUDO=

# [secret/string] Key used by the system prelude for privileged sudo coordination; values stay in the secret store.
# KYBERION_SUDO_KEY=

# [runtime/string] Path scope restriction for KYBERION_SUDO escalation.
# KYBERION_SUDO_SCOPE=

# [runtime/string] JSON actor allowlist keyed by surface (for example {"telegram":["actor-id"]}); an invalid configured value fails closed for the affected surface.
# KYBERION_SURFACE_ALLOWLISTS=

# [path/path] Optional path override for surface query config path; keep it inside governed repository or runtime storage.
# KYBERION_SURFACE_QUERY_CONFIG_PATH=

# [runtime/string] Optional runtime setting for surface query phase; leave unset to use the built-in configuration.
# KYBERION_SURFACE_QUERY_PHASE=

# [runtime/string] Fallback role selector for surface-query provider resolution; a request or server-resolved context role takes precedence and this value does not grant authorization.
# KYBERION_SURFACE_QUERY_ROLE=

# [path/path] Optional path override for task grants path; keep it inside governed repository or runtime storage.
# KYBERION_TASK_GRANTS_PATH=

# [runtime/string] Optional runtime setting for task id; leave unset to use the built-in configuration.
# KYBERION_TASK_ID=

# [runtime/string] Task model-hint policy: advisory records routing hints without changing the manifest choice, while enforce applies a validated task model hint when present.
# KYBERION_TASK_MODEL_ROUTING=

# [path/path] Optional path override for task scenario dir; keep it inside governed repository or runtime storage.
# KYBERION_TASK_SCENARIO_DIR=

# [runtime/string] Optional runtime setting for telemetry; leave unset to use the built-in configuration.
# KYBERION_TELEMETRY=

# [runtime/string] Optional Python executable for the TEN VAD bridge; unset uses KYBERION_PYTHON_BIN when available and otherwise python3.
# KYBERION_TEN_VAD_PYTHON=

# [runtime/string] Active tenant slug for tenant-scoped writes and branding.
# KYBERION_TENANT=

# [path/path] Optional governed root for tenant design assets used by the Chronos tenant-design route; viewer-resolved tenant scope still controls which customer data is selected.
# KYBERION_TENANT_DESIGN_ROOT=

# [runtime/string] Legacy tenant identifier fallback used by peer and surface entrypoints; prefer the canonical KYBERION_TENANT slug and server-resolved viewer scope where available.
# KYBERION_TENANT_ID=

# [runtime/string] Tenant binding policy for confidential work; strict (or the boolean value 1/true where supported) rejects an unbound tenant, while warn records the migration warning.
# KYBERION_TENANT_SCOPE_REQUIRED=

# [tuning/number] Optional numeric tuning value for terminal disconnect timeout ms; leave unset to use the governed default.
# KYBERION_TERMINAL_DISCONNECT_TIMEOUT_MS=

# [provider/string] Bind host for the terminal bridge; the default is loopback so terminal control is not exposed remotely by default.
# KYBERION_TERMINAL_HOST=

# [runtime/string] Optional runtime setting for terminal restore runtime; leave unset to use the built-in configuration.
# KYBERION_TERMINAL_RESTORE_RUNTIME=

# [tuning/number] Optional numeric tuning value for terminal session retention ms; leave unset to use the governed default.
# KYBERION_TERMINAL_SESSION_RETENTION_MS=

# [secret/string] Bearer token used to authenticate the terminal bridge.
# KYBERION_TERMINAL_TOKEN=

# [path/path] Optional path override for test observability dir; keep it inside governed repository or runtime storage.
# KYBERION_TEST_OBSERVABILITY_DIR=

# [runtime/string] Optional runtime setting for tier; leave unset to use the built-in configuration.
# KYBERION_TIER=

# [runtime/string] Optional runtime setting for timezone; leave unset to use the built-in configuration.
# KYBERION_TIMEZONE=

# [path/path] Optional path override for tool actuator routing policy path; keep it inside governed repository or runtime storage.
# KYBERION_TOOL_ACTUATOR_ROUTING_POLICY_PATH=

# [path/path] Optional path override for tool runtime policy path; keep it inside governed repository or runtime storage.
# KYBERION_TOOL_RUNTIME_POLICY_PATH=

# [path/path] Optional path override for tool runtime registry path; keep it inside governed repository or runtime storage.
# KYBERION_TOOL_RUNTIME_REGISTRY_PATH=

# [flag/boolean] Trust x-forwarded-for and x-real-ip as the client peer for local-surface detection. Keep disabled unless a trusted reverse proxy overwrites these headers.
# KYBERION_TRUST_PROXY=

# [runtime/string] Optional comma-separated arguments appended to the shell streaming TTS command; values are trimmed and empty items are ignored.
# KYBERION_TTS_ARGS=

# [provider/string] Optional streaming text-to-speech executable for realtime voice and meeting flows; it reads newline-delimited UTF-8 text and emits PCM audio through the governed bridge.
# KYBERION_TTS_COMMAND=

# [provider/string] Optional PCM playback command used by the streaming TTS bridge; it overrides the platform default player and remains a local runtime configuration.
# KYBERION_TTS_PLAY_COMMAND=

# [runtime/string] Optional runtime setting for tui disable audit; leave unset to use the built-in configuration.
# KYBERION_TUI_DISABLE_AUDIT=

# [runtime/string] Optional runtime setting for ui locale; leave unset to use the built-in configuration.
# KYBERION_UI_LOCALE=

# [runtime/string] VAD backend id used by the voice loop; `energy` is built in and unavailable or unknown neural backends degrade to energy with a surfaced reason.
# KYBERION_VAD=energy

# [path/path] Optional path override for video composition template registry path; keep it inside governed repository or runtime storage.
# KYBERION_VIDEO_COMPOSITION_TEMPLATE_REGISTRY_PATH=

# [runtime/string] Optional runtime setting for video render run mode; leave unset to use the built-in configuration.
# KYBERION_VIDEO_RENDER_RUN_MODE=

# [path/path] Optional path override for video render runtime policy path; keep it inside governed repository or runtime storage.
# KYBERION_VIDEO_RENDER_RUNTIME_POLICY_PATH=

# [runtime/string] Optional runtime setting for viewer principal; leave unset to use the built-in configuration.
# KYBERION_VIEWER_PRINCIPAL=

# [runtime/string] Chronos viewer tenant audit mode: off, warn, or enforce. Unregistered tenant expansion is denied in every mode; warn records the attempt first. Defaults to warn.
# KYBERION_VIEWER_SCOPE=

# [secret/string] API key for the vLLM OpenAI-compatible backend, when authentication is enabled.
# KYBERION_VLLM_KEY=

# [provider/string] Model identifier sent to the vLLM OpenAI-compatible endpoint.
# KYBERION_VLLM_MODEL=

# [provider/string] Base URL for the vLLM OpenAI-compatible endpoint.
# KYBERION_VLLM_URL=

# [path/path] Optional path to the Python voice-learning bridge; when unset, the bundled voice-actuator bridge is used.
# KYBERION_VOICE_BRIDGE_PATH=

# [path/path] Directory override for the split voice-engine registry files; used with the canonical registry path when present.
# KYBERION_VOICE_ENGINE_REGISTRY_DIR=

# [path/path] Explicit voice-engine registry path; the selected file is validated against the voice-engine schema before use.
# KYBERION_VOICE_ENGINE_REGISTRY_PATH=

# [path/path] Override for the voice-hub text-to-speech language configuration; the default is knowledge/product/presence/voice-hub-tts.json.
# KYBERION_VOICE_HUB_TTS_CONFIG_PATH=

# [runtime/string] Language hint passed to the Python voice bridge; when unset, the unified locale resolver supplies the language.
# KYBERION_VOICE_LANGUAGE=

# [path/path] Directory for generated Python voice artifacts; the default is active/shared/tmp/voice-out under the current repository.
# KYBERION_VOICE_OUTPUT_DIR=

# [runtime/boolean] Set to 1 to send Python voice output through the configured BlackHole playback bridge; it has no effect without KYBERION_BLACKHOLE_SCRIPT.
# KYBERION_VOICE_PLAY_BLACKHOLE=

# [runtime/string] Voice profile identifier forwarded to the Python/TTS bridge; the Python bridge is not installed unless this value is present.
# KYBERION_VOICE_PROFILE_ID=

# [path/path] Directory override for split voice-profile registry files; canonical overlays remain enabled when no explicit registry file is selected.
# KYBERION_VOICE_PROFILE_REGISTRY_DIR=

# [path/path] Explicit base voice-profile registry path; selecting it disables the automatic personal and customer overlay lookup.
# KYBERION_VOICE_PROFILE_REGISTRY_PATH=

# [path/path] Override for the voice runtime policy catalog; the default is knowledge/product/governance/voice-runtime-policy.json and invalid input falls back conservatively.
# KYBERION_VOICE_RUNTIME_POLICY_PATH=

# [path/path] Override for the voice sample-ingestion policy catalog; the selected file is schema-validated before profile registration.
# KYBERION_VOICE_SAMPLE_INGESTION_POLICY_PATH=

# [runtime/enum] Compatibility alias for the voice upgrade target; cloud selects tier 1 and local selects tier 2 when no explicit CLI target is supplied.
#   values: cloud | local
# KYBERION_VOICE_UPGRADE_ALIAS=

# [runtime/string] Optional runtime setting for windows ai; leave unset to use the built-in configuration.
# KYBERION_WINDOWS_AI=

# [provider/string] Foundry Local or other approved Windows local AI endpoint used by the Windows assistance bridge; keep the endpoint local or explicitly allowlisted.
# KYBERION_WINDOWS_AI_ENDPOINT=

# [provider/string] Model identifier selected by the Windows local AI bridge; it is paired with KYBERION_WINDOWS_AI_ENDPOINT and does not itself grant external access.
# KYBERION_WINDOWS_AI_MODEL=

# [runtime/string] Optional runtime setting for windows aumid; leave unset to use the built-in configuration.
# KYBERION_WINDOWS_AUMID=

# [runtime/string] Optional runtime setting for windows image generator; leave unset to use the built-in configuration.
# KYBERION_WINDOWS_IMAGE_GENERATOR=

# [provider/string] Selects the Windows speech-to-text backend, such as faster_whisper, for the local voice actuator; the selected backend must be installed and available in the governed runtime.
# KYBERION_WINDOWS_STT_BACKEND=

# [runtime/string] Optional runtime setting for wisdom llm profile; leave unset to use the built-in configuration.
# KYBERION_WISDOM_LLM_PROFILE=

# [runtime/string] Optional runtime setting for work coordination namespace; leave unset to use the built-in configuration.
# KYBERION_WORK_COORDINATION_NAMESPACE=

# [tuning/number] Maximum milliseconds a mission work item waits for one provider response before recording a blocked result.
# KYBERION_WORKITEM_RESPONSE_TIMEOUT_MS=
