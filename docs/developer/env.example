# [flag/boolean] Acknowledge the plaintext file-secret fallback when the OS keychain is unavailable (warn-phase; see AC-05).
# KYBERION_ALLOW_FILE_SECRETS=

# [flag/boolean] Allow explicitly opted-in development flows to reach local or private network addresses; disabled by default.
# KYBERION_ALLOW_LOCAL_NETWORK=

# [flag/boolean] Keep the reasoning stub fallback when the configured provider chain is unavailable; disabled by default.
# KYBERION_ALLOW_STUB_FALLBACK=

# [flag/boolean] Allow operator notification delivery during tests; test-only opt-in.
# KYBERION_ALLOW_TEST_NOTIFICATIONS=

# [flag/boolean] Allow unauthenticated remote Chronos readonly access only when no API or localadmin token is configured; disabled by default.
# KYBERION_ALLOW_UNAUTH_REMOTE=

# [flag/boolean] Allow the service actuator to execute CLI commands; disabled by default.
# KYBERION_ALLOW_UNSAFE_CLI=

# [flag/boolean] Allow code or system actuators to evaluate JavaScript; disabled by default.
# KYBERION_ALLOW_UNSAFE_JS=

# [flag/boolean] Allow shell execution by code, system, or network actuators; disabled by default.
# KYBERION_ALLOW_UNSAFE_SHELL=

