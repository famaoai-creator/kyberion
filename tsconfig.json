{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@actuator/service": ["./libs/actuators/service-actuator/src/index.ts"],
      "@actuator/system": ["./libs/actuators/system-actuator/src/index.ts"],
      "@actuator/meeting-browser-driver": ["./libs/actuators/meeting-browser-driver/src/index.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "presence/**/*.ts",
    "satellites/**/*.ts",
    "libs/actuators/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test-results",
    "presence/displays/chronos-mirror-v2/",
    "presence/displays/terminal-hud/",
    "presence/displays/operator-surface/",
    "presence/displays/concierge/",
    "libs/actuators/**/*.test.ts",
    "scripts/clean.ts",
    "scripts/clean_entrypoint.ts",
    "scripts/build_repository.ts"
  ],
  "extends": "./tsconfig.base.json",
  "references": [
    {
      "path": "./libs/core"
    },
    {
      "path": "./libs/shared-ui"
    },
    {
      "path": "./libs/shared-media"
    },
    {
      "path": "./libs/shared-nerve"
    },
    {
      "path": "./libs/shared-network"
    },
    {
      "path": "./libs/shared-vision"
    },
    {
      "path": "./presence/displays/terminal-hud"
    }
  ]
}
