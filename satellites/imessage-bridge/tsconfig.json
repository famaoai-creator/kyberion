{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "noEmit": true,
    "incremental": false
  },
  "references": [
    {
      "path": "../../libs/core"
    }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "extends": "../../tsconfig.base.json"
}
