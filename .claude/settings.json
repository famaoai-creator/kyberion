{
  "permissions": {
    "allow": [
      "Bash(pnpm vitest run *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(npx vitest run *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(node dist/scripts/check_catalog_integrity.js)",
      "Bash(pnpm check:catalogs)",
      "Bash(npx tsc --noEmit *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
