{
  "permissions": {
    "allow": [
      "Bash(pnpm vitest run *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(npx vitest run *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(node dist/scripts/check_catalog_integrity.js)",
      "Bash(pnpm check:catalogs)",
      "Bash(npx tsc --noEmit *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/dist/scripts/claude_code_hook.js\" SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/dist/scripts/claude_code_hook.js\" UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|write|edit|apply_patch|notebook_edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/dist/scripts/claude_code_hook.js\" PreToolUse"
          }
        ]
      },
      {
        "matcher": "^(Bash|exec)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/dist/scripts/claude_code_hook.js\" PreToolUseShellDeny"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|write|edit|apply_patch|notebook_edit|exec|write_to_process)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/dist/scripts/claude_code_hook.js\" PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/dist/scripts/claude_code_hook.js\" Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/dist/scripts/claude_code_hook.js\" SessionEnd"
          }
        ]
      }
    ],
    "PostCompaction": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/provider_hook_entry.mjs\" claude PostCompaction"
          }
        ]
      }
    ]
  }
}
