{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/work-item.schema.json",
  "title": "Governed Work Item",
  "type": "object",
  "required": [
    "item_id",
    "title",
    "description",
    "status",
    "priority",
    "source",
    "source_ref",
    "project_id",
    "labels",
    "dependencies",
    "version",
    "created_at",
    "updated_at",
    "context"
  ],
  "properties": {
    "item_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["backlog", "ready", "in_progress", "blocked", "review", "done", "archived"]
    },
    "priority": { "enum": ["low", "normal", "high", "urgent"] },
    "source": { "enum": ["local", "github", "jira", "peer"] },
    "source_ref": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "labels": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "context": {
      "type": "object",
      "required": ["project_id", "work_shape"],
      "properties": {
        "organization_id": { "type": "string", "minLength": 1 },
        "tenant_slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,30}$",
          "not": { "enum": ["public", "confidential", "personal", "shared"] }
        },
        "mission_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "work_shape": {
          "enum": [
            "solution_project",
            "service_operation",
            "routine_operation",
            "incident_response",
            "governance_cadence",
            "improvement_experiment"
          ]
        }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
