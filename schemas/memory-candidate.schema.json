{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/memory-candidate.schema.json",
  "title": "Memory Promotion Candidate",
  "type": "object",
  "required": [
    "candidate_id",
    "source_type",
    "source_ref",
    "proposed_memory_kind",
    "summary",
    "evidence_refs",
    "sensitivity_tier",
    "ratification_required",
    "status",
    "queued_at"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["mission", "task_session", "artifact", "incident"]
    },
    "source_ref": { "type": "string", "minLength": 1 },
    "proposed_memory_kind": {
      "type": "string",
      "enum": ["sop", "template", "heuristic", "risk_rule", "clarification_prompt"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "sensitivity_tier": {
      "type": "string",
      "enum": ["public", "confidential", "personal"]
    },
    "ratification_required": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["queued", "approved", "rejected", "promoted"]
    },
    "queued_at": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "minLength": 1 },
    "occurrences": { "type": "integer", "minimum": 1 },
    "last_seen": { "type": "string", "minLength": 1 },
    "ratified_at": { "type": "string", "minLength": 1 },
    "ratification_note": { "type": "string", "minLength": 1 },
    "promoted_ref": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier"],
      "properties": {
        "tenant_slug": { "type": "string", "minLength": 1 },
        "customer_stance": { "type": "string", "minLength": 1 },
        "organization_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "mission_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "work_shape": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["personal", "confidential", "public"] },
        "viewer_principal": { "type": "string", "minLength": 1 },
        "nhi_id": { "type": "string", "minLength": 1 },
        "owner_nhi": { "type": "string", "minLength": 1 },
        "retention_policy": { "type": "string", "minLength": 1 },
        "allowed_audience": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "promotion_policy": { "enum": ["same_scope", "brokered", "human_review"] },
        "provenance_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "redacted": { "type": "boolean" }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_tenant_slug", "target_tier", "redacted"],
      "properties": {
        "source_tenant_slug": { "type": "string", "minLength": 1 },
        "target_tier": { "enum": ["public", "confidential", "personal"] },
        "redacted": { "type": "boolean" },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "object",
            "properties": { "tier": { "const": "confidential" } }
          }
        }
      },
      "then": {
        "properties": {
          "scope": { "type": "object", "required": ["tenant_slug"] }
        }
      }
    }
  ]
}
