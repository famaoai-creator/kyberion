.gemini/
.venv/
.env.local

# Provider state directories (XP-04 multi-provider-coexecution-contract):
# gitignored, reproduced via generation ceremonies. Exception: .claude/agents/
# is generated-and-tracked under CT-01's drift check.
.codex/
.agy/
/.claude/*
!/.claude/agents/
*.skill
tmp/
.DS_Store
**/node_modules/
*.traineddata
active/
dist/

# Confidential Knowledge
knowledge/confidential/

# Individual/Personal Knowledge (Non-Git)
knowledge/personal/
# Tracked, intentionally public operator fixtures. Keep the broad personal
# boundary while making these exceptions explicit for EG-12.
!knowledge/personal/
knowledge/personal/*
!knowledge/personal/README.md
!knowledge/personal/voice/
knowledge/personal/voice/*
!knowledge/personal/voice/config.json
!knowledge/personal/voice/profile-registry.json

# Per-user experimental / confidential project scaffolds
projects/

# Customer aggregation: per-customer dirs are gitignored, but README and _template/ are committed.
/customer/*
!/customer/README.md
!/customer/_template/

# Auto-generated audit reports (regenerate via pnpm license:audit / pnpm find:dead-code)
/docs/legal/third-party-licenses.json
/docs/legal/dead-code-candidates.json

# Next.js build output
.next/
/presence/displays/concierge/next-env.d.ts

# Runtime artifacts
cache/
outputs/
/archive/
work/
temp_ppt/
tests/_tmp/
tests/_tmp_integration/
evidence/benchmarks/
evidence/performance/

# Auto-generated knowledge indices and context
knowledge/orchestration/knowledge_index.json
knowledge/orchestration/active_context.json
tools/chronos-mirror/public/knowledge_index.json
presence/displays/chronos-mirror/public/stimuli_feed.json

# libs/core compiled output (in-place build)
libs/core/**/*.js
libs/core/**/*.js.map
libs/core/**/*.d.ts
libs/core/**/*.d.ts.map
libs/core/tsconfig.tsbuildinfo
# Workspace package build artifacts (TypeScript incremental build info)
libs/shared-*/tsconfig.tsbuildinfo
presence/displays/*/tsconfig.tsbuildinfo
satellites/*/tsconfig.tsbuildinfo
# Hand-written JS (no .ts source)
!libs/core/finance.js
!libs/core/mcp-client-engine.js
!libs/core/vision-judge.js
!libs/core/types/excel-protocol.js
!libs/core/types/pptx-protocol.js

# Plugin runtime data
# Runtime JSONL is ignored by declared runtime scopes, not by a repository-wide
# pattern that can silently hide tracked audit/execution ledgers.
/active/shared/logs/**/*.jsonl
/active/shared/runtime/**/*.jsonl
/active/missions/**/*.jsonl
/active/projects/**/*.jsonl
vault/
!vault/
vault/*
!vault/mounts/
vault/mounts/*
!vault/mounts/.gitkeep
last_session_diff.patch

# Local coverage output
coverage/
test-results/

# In-place build output accidentally emitted in actuator source trees
libs/actuators/presence-actuator/src/*.js
libs/actuators/presence-actuator/src/*.js.map
libs/actuators/presence-actuator/src/*.d.ts
libs/actuators/presence-actuator/src/*.d.ts.map
libs/actuators/media-generation-actuator/src/*.js
libs/actuators/media-generation-actuator/src/*.js.map
libs/actuators/media-generation-actuator/src/*.d.ts
libs/actuators/media-generation-actuator/src/*.d.ts.map

# Repo-local generated notes that should not be committed
vision/famaocloud.md
evidence/lifecycle-smoke-summary.md

# Native messaging host: machine-local pinned node path (written by install.sh)
tools/adf-replay-extension/native-host/.node-path

# Parallel-session / external-tool debris (never scan, never commit)
.worktrees/
.tmp-mulmoclaude/
.tmp-agency-agents/
.pnpm-store/

# WinAppSDK helper build output
tools/windows-native-image-generator/bin/
tools/windows-native-image-generator/obj/
tools/windows-native-image-generator/AppPackages/
tools/windows-native-image-generator/.vs/
tools/windows-native-image-generator/*.pfx
tools/windows-native-image-generator/*.cer
