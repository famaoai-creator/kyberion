{
  "schema_version": "kyberion-scenario.v1",
  "id": "trace-span-and-artifact",
  "title": "Trace spans and run artifacts are recorded",
  "description": "Each executed op leaves a trace span, and the run root holds the seeded input and the turn's context artifact.",
  "tier": 1,
  "lane": "pr-deterministic",
  "executionProfile": "simulated",
  "modelFixtures": "model-free",
  "requires": {},
  "seed": {
    "files": [{ "path": "input/brief.md", "content": "# Weekly report brief\n" }],
    "clock": { "start_iso": "2026-01-05T09:00:00.000Z" }
  },
  "fixtures": {
    "ops": {
      "service:publish_report": { "ctx_patch": { "published": true } }
    }
  },
  "turns": [
    {
      "kind": "pipeline",
      "pipeline": "fixtures/publish-report.pipeline.json",
      "checks": { "expectedOps": ["system:log", "service:publish_report"] }
    }
  ],
  "finalChecks": [
    { "type": "traceSpanExists", "name": "scenario.turn" },
    { "type": "traceSpanExists", "name": "system:log" },
    { "type": "traceSpanExists", "name": "service:publish_report" },
    { "type": "artifactExists", "path": "input/brief.md" },
    { "type": "artifactExists", "path": "turns/0.context.json" }
  ]
}
