{
  "schema_version": "kyberion-scenario.v1",
  "id": "pipeline-stubbed-apply",
  "title": "Stubbed apply op receives the resolved params",
  "description": "A fetch -> log -> apply pipeline runs against fixtures; the apply op is called once with the ticket id resolved from the fetch result.",
  "tier": 1,
  "lane": "pr-deterministic",
  "executionProfile": "simulated",
  "modelFixtures": "model-free",
  "requires": {},
  "seed": { "clock": { "start_iso": "2026-01-05T09:00:00.000Z" } },
  "fixtures": {
    "ops": {
      "service:fetch_ticket": { "result": { "id": "T-100", "title": "Printer on fire" } },
      "service:update_ticket": { "ctx_patch": { "ticket_closed": true } }
    }
  },
  "turns": [
    {
      "kind": "pipeline",
      "pipeline": "fixtures/stubbed-apply.pipeline.json",
      "checks": {
        "expectedOps": ["service:fetch_ticket", "service:update_ticket"],
        "forbiddenOps": ["system:exec"],
        "responseMatchers": [{ "path": "ticket_closed", "equals": true }]
      }
    }
  ],
  "finalChecks": [
    { "type": "opCalled", "op": "service:update_ticket", "times": 1 },
    {
      "type": "opArgs",
      "op": "service:update_ticket",
      "match": { "ticket_id": "T-100", "status": "closed" }
    }
  ]
}
