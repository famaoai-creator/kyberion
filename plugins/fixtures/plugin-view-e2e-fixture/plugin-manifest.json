{
  "plugin_id": "plugin-view-e2e-fixture",
  "version": "1.0.0",
  "description": "PE-01 end-to-end fixture: a third-party plugin with one sandboxed-iframe view that requests one agent-authority and one human-authority action through the host postMessage channel. Installed from outside the plugins/ tree of a hermetic root by scripts/check_plugin_views_e2e.ts.",
  "provides": {
    "ops": ["viewe2e:ping", "viewe2e:stamp"],
    "views": [
      {
        "id": "panel",
        "titleKey": "plugin:fixture_status_view_title",
        "document": "views/panel.html",
        "isolation": "sandboxed-iframe",
        "capabilities": ["action.request"],
        "roleGate": {
          "minRole": "readonly",
          "tiers": ["public"]
        },
        "actions": [
          {
            "id": "ping",
            "authority": "agent",
            "op": "viewe2e:ping",
            "paramsSchema": {
              "type": "object",
              "properties": {
                "note": { "type": "string", "maxLength": 64 }
              },
              "required": ["note"],
              "additionalProperties": false
            }
          },
          {
            "id": "stamp",
            "authority": "human",
            "op": "viewe2e:stamp",
            "paramsSchema": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "maxLength": 64 }
              },
              "required": ["label"],
              "additionalProperties": false
            }
          }
        ]
      }
    ]
  },
  "permissions": {
    "network": { "mode": "none" },
    "fs": { "mode": "none" }
  }
}
