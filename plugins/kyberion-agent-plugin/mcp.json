{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kyberion": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/bin/kyberion-mcp.mjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "KYBERION_PERSONA": "sovereign_concierge",
        "NODE_ENV": "production"
      }
    }
  }
}
