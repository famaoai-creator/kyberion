{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kyberion": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/bin/kyberion-mcp.mjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "KYBERION_BASE_ROLE": "sovereign_concierge",
        "SYSTEM_ROLE": "mcp_server_cowork",
        "KYBERION_MCP_CALLER_ROLE": "operator",
        "NODE_ENV": "production"
      }
    }
  }
}
