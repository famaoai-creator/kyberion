{
  "version": 1,
  "catalog": "kyberion-base",
  "sample_screen": {
    "title": "Sample screen",
    "description": "An example screen that combines the main components in an app-shell.",
    "root": "shell",
    "components": [
      {
        "id": "shell",
        "type": "ui:app-shell",
        "props": {
          "role": "presence-studio"
        },
        "children": ["nav", "header", "hero", "metrics", "body"]
      },
      {
        "id": "nav",
        "type": "ui:nav-rail",
        "props": {
          "label": "Main menu",
          "items": [
            {
              "id": "home",
              "label": "Home",
              "hint": "Today at a glance",
              "href": "#home",
              "icon": "home"
            },
            {
              "id": "ask",
              "label": "Ask",
              "hint": "Talk or type",
              "href": "#ask",
              "icon": "chat"
            },
            {
              "id": "decide",
              "label": "Decide",
              "hint": "Approvals and exceptions",
              "href": "#decide",
              "icon": "approval",
              "active": true
            },
            {
              "id": "progress",
              "label": "Progress",
              "hint": "In progress and delivered",
              "href": "#progress",
              "icon": "mission"
            },
            {
              "id": "help",
              "label": "Learn how",
              "hint": "Practice and guides",
              "href": "#help",
              "icon": "help"
            }
          ],
          "footer_items": [
            {
              "id": "settings",
              "label": "Settings",
              "href": "#settings",
              "icon": "settings"
            }
          ]
        }
      },
      {
        "id": "header",
        "type": "ui:page-header",
        "props": {
          "title": "Decide",
          "subtitle": "Requests waiting for your decision, and work that has stalled.",
          "role_badge": {
            "label": "Partner",
            "role": "presence-studio"
          },
          "actions": [
            {
              "label": "View history",
              "href": "#history",
              "variant": "ghost"
            },
            {
              "label": "Refresh",
              "action": {
                "id": "gallery.refresh"
              },
              "variant": "secondary"
            }
          ]
        }
      },
      {
        "id": "hero",
        "type": "ui:next-action",
        "props": {
          "eyebrow": "Up next",
          "title": "Approve the October contractor quote (¥480,000)",
          "reason": "Due today at 17:00. Approving lets the purchase-order mission continue.",
          "primary": {
            "label": "Review and approve",
            "action": {
              "id": "gallery.approve",
              "payload": {
                "request": "APR-2026-0412"
              }
            }
          },
          "secondary": {
            "label": "Later",
            "action": {
              "id": "gallery.snooze"
            }
          },
          "state": "ready"
        }
      },
      {
        "id": "metrics",
        "type": "ui:grid",
        "props": {
          "gap": "md",
          "min_column_width": "xs"
        },
        "children": ["m1", "m2", "m3", "m4"]
      },
      {
        "id": "m1",
        "type": "ui:metric",
        "props": {
          "label": "Awaiting approval",
          "value": 4,
          "unit": "items",
          "delta": "+2 since yesterday",
          "trend": "up",
          "tone": "warning"
        }
      },
      {
        "id": "m2",
        "type": "ui:metric",
        "props": {
          "label": "Missions in progress",
          "value": 12,
          "unit": "items",
          "delta": "No change",
          "trend": "flat",
          "tone": "info"
        }
      },
      {
        "id": "m3",
        "type": "ui:metric",
        "props": {
          "label": "Completed this week",
          "value": 27,
          "unit": "items",
          "delta": "+5 vs last week",
          "trend": "up",
          "tone": "success"
        }
      },
      {
        "id": "m4",
        "type": "ui:metric",
        "props": {
          "label": "Exceptions to handle",
          "value": 1,
          "unit": "items",
          "delta": "-3 vs last week",
          "trend": "down",
          "tone": "danger"
        }
      },
      {
        "id": "body",
        "type": "ui:stack",
        "props": {
          "gap": "lg"
        },
        "children": ["side-callout", "approvals", "side"]
