      {
        "id": "approvals",
        "type": "ui:section",
        "props": {
          "title": "Requests awaiting approval",
          "description": "Sorted by nearest due date.",
          "actions": [
            {
              "label": "View all",
              "href": "#all",
              "variant": "ghost"
            }
          ]
        },
        "children": ["approvals-table"]
      },
      {
        "id": "approvals-table",
        "type": "ui:table",
        "props": {
          "columns": [
            {
              "key": "id",
              "label": "Request ID",
              "mono": true,
              "width": "14ch"
            },
            {
              "key": "title",
              "label": "Summary"
            },
            {
              "key": "requester",
              "label": "Requester"
            },
            {
              "key": "due",
              "label": "Due",
              "align": "end"
            },
            {
              "key": "status",
              "label": "Status"
            }
          ],
          "rows": [
            {
              "id": "APR-2026-0412",
              "title": "Approve contractor quote (October)",
              "requester": "Finance team",
              "due": "Today 17:00",
              "status": "pending"
            },
            {
              "id": "APR-2026-0409",
              "title": "Credit check for a new vendor",
              "requester": "Sales planning",
              "due": "Tomorrow",
              "status": "needs_clarification"
            },
            {
              "id": "APR-2026-0405",
              "title": "Publish the weekly report",
              "requester": "PR agent",
              "due": "9/26",
              "status": "review"
            },
            {
              "id": "APR-2026-0398",
              "title": "Run the server update",
              "requester": "Operations agent",
              "due": "9/24",
              "status": "blocked"
            },
            {
              "id": "APR-2026-0391",
              "title": "Distribute meeting minutes",
              "requester": "Secretary agent",
              "due": "Done",
              "status": "completed"
            }
          ]
        }
      },
      {
        "id": "side",
        "type": "ui:grid",
        "props": {
          "gap": "lg",
          "min_column_width": "lg"
        },
        "children": ["side-timeline", "side-empty"]
