      {
        "id": "side-callout",
        "type": "ui:callout",
        "props": {
          "tone": "warning",
          "title": "Email connection needs re-authentication",
          "body": "Inbox triage stops unless you re-authenticate within 48 hours.",
          "action": {
            "label": "Re-authenticate",
            "action": {
              "id": "gallery.reauth"
            }
          }
