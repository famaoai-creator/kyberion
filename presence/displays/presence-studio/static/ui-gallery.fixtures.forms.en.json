{
  "version": 1,
  "catalog": "kyberion-base",
  "sections": [
    {
      "id": "form-settings",
      "title": "Settings ui:settings-group ui:setting-row ui:switch ui:segmented",
      "description": "A titled group of rows: label and description on the left, one control on the right. Rows stack on narrow screens.",
      "components": [
        {
          "id": "fs-group",
          "type": "ui:settings-group",
          "props": {
            "title": "Notifications",
            "description": "Choose when Kyberion should reach you."
          },
          "children": [
            "fs-row-email",
            "fs-row-digest",
            "fs-row-density",
            "fs-row-volume",
            "fs-row-reset"
          ]
        },
        {
          "id": "fs-row-email",
          "type": "ui:setting-row",
          "props": {
            "label": "Email me about approvals",
            "description": "One email per request that is waiting for you."
          },
          "children": ["fs-email"]
        },
        {
          "id": "fs-email",
          "type": "ui:switch",
          "props": {
            "name": "notify.email",
            "label": "Email me about approvals",
            "hide_label": true,
            "value": true
          }
        },
        {
          "id": "fs-row-digest",
          "type": "ui:setting-row",
          "props": {
            "label": "Daily summary",
            "description": "Sent at the time you choose."
          },
          "children": ["fs-digest"]
        },
        {
          "id": "fs-digest",
          "type": "ui:select",
          "props": {
            "name": "notify.digest_time",
            "label": "Daily summary",
            "hide_label": true,
            "value": "08:00",
            "options": [
              {
                "value": "off",
                "label": "Off"
              },
              {
                "value": "08:00",
                "label": "8:00 AM"
              },
              {
                "value": "18:00",
                "label": "6:00 PM"
              }
            ]
          }
        },
        {
          "id": "fs-row-density",
          "type": "ui:setting-row",
          "props": {
            "label": "Display density"
          },
          "children": ["fs-density"]
        },
        {
          "id": "fs-density",
          "type": "ui:segmented",
          "props": {
            "name": "display.density",
            "label": "Display density",
            "hide_label": true,
            "value": "comfortable",
            "options": [
              {
                "value": "comfortable",
                "label": "Comfortable"
              },
              {
                "value": "compact",
                "label": "Compact"
              }
            ]
          }
        },
        {
          "id": "fs-row-volume",
          "type": "ui:setting-row",
          "props": {
            "label": "Voice volume",
            "description": "Used when the companion speaks."
          },
          "children": ["fs-volume"]
        },
        {
          "id": "fs-volume",
          "type": "ui:slider",
          "props": {
            "name": "voice.volume",
            "label": "Voice volume",
            "hide_label": true,
            "value": 60,
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "%"
          }
        },
        {
          "id": "fs-row-reset",
          "type": "ui:setting-row",
          "props": {
            "label": "Reset preferences",
            "description": "Your missions and knowledge are not affected.",
            "tone": "danger"
          },
          "children": ["fs-reset"]
        },
        {
          "id": "fs-reset",
          "type": "ui:button",
          "props": {
            "label": "Reset",
            "variant": "danger",
            "action": {
              "id": "settings.reset"
            }
          }
        }
      ]
    },
    {
      "id": "form-inputs",
      "title": "Inputs ui:text-field ui:textarea ui:select ui:radio-group ui:checkbox",
      "description": "Labels sit above the control; help and errors are linked with aria-describedby. Every edit dispatches field.change {name, value}.",
      "components": [
        {
          "id": "fi-grid",
          "type": "ui:grid",
          "props": {
            "columns": 2,
            "gap": "lg"
          },
          "children": ["fi-col1", "fi-col2"]
        },
        {
          "id": "fi-col1",
          "type": "ui:stack",
          "props": {
            "gap": "md"
          },
          "children": ["fi-name", "fi-email", "fi-count", "fi-notes"]
        },
        {
          "id": "fi-col2",
          "type": "ui:stack",
          "props": {
            "gap": "md"
          },
          "children": ["fi-lang", "fi-plan", "fi-terms", "fi-disabled"]
        },
        {
          "id": "fi-name",
          "type": "ui:text-field",
          "props": {
            "name": "profile.name",
            "label": "Display name",
            "value": "Ada Lovelace",
            "required": true,
            "maxlength": 60,
            "help": "Shown to your team."
          }
        },
        {
          "id": "fi-email",
          "type": "ui:text-field",
          "props": {
            "name": "profile.email",
            "label": "Work email",
            "type": "email",
            "value": "ada@example",
            "required": true,
            "error": "Enter an address like name@company.com."
          }
        },
        {
          "id": "fi-count",
          "type": "ui:text-field",
          "props": {
            "name": "limits.daily_missions",
            "label": "Missions per day",
            "type": "number",
            "value": 5,
            "min": 1,
            "max": 20,
            "step": 1
          }
        },
        {
          "id": "fi-notes",
          "type": "ui:textarea",
          "props": {
            "name": "profile.notes",
            "label": "Notes for the concierge",
            "placeholder": "Anything it should keep in mind",
            "rows": 3,
            "maxlength": 280,
            "value": "Prefer mornings for reviews."
          }
        },
        {
          "id": "fi-lang",
          "type": "ui:select",
          "props": {
            "name": "profile.language",
            "label": "Language",
            "value": "en",
            "options": [
              {
                "value": "en",
                "label": "English"
              },
              {
                "value": "ja",
                "label": "Japanese"
              }
            ]
          }
        },
        {
          "id": "fi-plan",
          "type": "ui:radio-group",
          "props": {
            "name": "approval.mode",
            "label": "Approval mode",
            "value": "review",
            "options": [
              {
                "value": "review",
                "label": "Review every step",
                "description": "Safest; slower."
              },
              {
                "value": "batch",
                "label": "Review in batches",
                "description": "Once a day."
              },
              {
                "value": "auto",
                "label": "Only risky steps",
                "disabled": true,
                "description": "Needs an admin."
              }
            ]
          }
        },
        {
          "id": "fi-terms",
          "type": "ui:checkbox",
          "props": {
            "name": "terms.accepted",
            "label": "I have read the data handling policy",
            "value": false,
            "required": true
          }
        },
        {
          "id": "fi-disabled",
          "type": "ui:text-field",
          "props": {
            "name": "tenant.slug",
            "label": "Tenant",
            "value": "acme",
            "disabled": true,
            "help": "Set by your administrator."
          }
        }
      ]
    },
    {
      "id": "form-integrations",
      "title": "Integrations ui:integration-item",
      "description": "Connection state is an icon + text pill, never color alone. Actions go to onAction (e.g. the existing OAuth begin route).",
      "components": [
        {
          "id": "fn-stack",
          "type": "ui:stack",
          "props": {
            "gap": "sm"
          },
          "children": ["fn-google", "fn-slack", "fn-github", "fn-voice"]
        },
        {
          "id": "fn-google",
          "type": "ui:integration-item",
          "props": {
            "title": "Google Workspace",
            "state": "connected",
            "icon": "inbox",
            "detail": "ada@example.com",
            "actions": [
              {
                "label": "Disconnect",
                "variant": "ghost",
                "action": {
                  "id": "integration.disconnect",
                  "payload": {
                    "service_id": "google-workspace"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "fn-slack",
          "type": "ui:integration-item",
          "props": {
            "title": "Slack",
            "state": "needs_reauth",
            "icon": "chat",
            "description": "Access expired on Sep 20. Reconnect to keep receiving messages.",
            "actions": [
              {
                "label": "Reconnect",
                "variant": "primary",
                "action": {
                  "id": "oauth.begin",
                  "payload": {
                    "service_id": "slack"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "fn-github",
          "type": "ui:integration-item",
          "props": {
            "title": "GitHub",
            "state": "disconnected",
            "description": "Let missions open pull requests.",
            "actions": [
              {
                "label": "Connect",
                "action": {
                  "id": "oauth.begin",
                  "payload": {
                    "service_id": "github"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "fn-voice",
          "type": "ui:integration-item",
          "props": {
            "title": "Voice hub",
            "state": "error",
            "icon": "bell",
            "detail": "Last seen 2 hours ago",
            "actions": [
              {
                "label": "Retry",
                "action": {
                  "id": "integration.retry",
                  "payload": {
                    "service_id": "voice-hub"
                  }
                }
              },
              {
                "label": "Help",
                "variant": "ghost",
                "href": "/help"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "form-save-bar",
      "title": "Save bar ui:save-bar",
      "description": "Sticky while there are unsaved changes; save and discard stay disabled until something changes.",
      "components": [
        {
          "id": "fb-stack",
          "type": "ui:stack",
          "props": {
            "gap": "sm"
          },
          "children": ["fb-dirty", "fb-saving", "fb-error", "fb-saved"]
        },
        {
          "id": "fb-dirty",
          "type": "ui:save-bar",
          "props": {
            "state": "dirty",
            "save_action": {
              "id": "settings.save"
            },
            "discard_action": {
              "id": "settings.discard"
            }
          }
        },
        {
          "id": "fb-saving",
          "type": "ui:save-bar",
          "props": {
            "state": "saving",
            "save_action": {
              "id": "settings.save"
            },
            "discard_action": {
              "id": "settings.discard"
            }
          }
        },
        {
          "id": "fb-error",
          "type": "ui:save-bar",
          "props": {
            "state": "error",
            "message": "Couldn't reach the server. Your changes are still here.",
            "save_action": {
              "id": "settings.save"
            },
            "save_label": "Try again",
            "discard_action": {
              "id": "settings.discard"
            }
          }
        },
        {
          "id": "fb-saved",
          "type": "ui:save-bar",
          "props": {
            "state": "saved",
            "save_action": {
              "id": "settings.save"
            }
          }
        }
      ]
    },
    {
      "id": "form-files",
      "title": "File upload ui:file-drop",
      "description": "Drag & drop, click or paste. Files are screened (type, size, count) and handed to onAction only; the list shows metadata the host reports.",
      "components": [
        {
          "id": "ff-grid",
          "type": "ui:grid",
          "props": {
            "columns": 2,
            "gap": "lg"
          },
          "children": ["ff-docs", "ff-single"]
        },
        {
          "id": "ff-docs",
          "type": "ui:file-drop",
          "props": {
            "name": "ingest.documents",
            "label": "Documents to ingest",
            "description": "They are checked for personal data before they are stored.",
            "accept": ".pdf,.docx,.xlsx,.md,.txt",
            "multiple": true,
            "max_bytes": 26214400,
            "max_files": 5,
            "action": {
              "id": "ingest.upload"
            },
            "files": [
              {
                "id": "ff-1",
                "name": "quarterly-report.pdf",
                "size": 2411724,
                "status": "done"
              },
              {
                "id": "ff-2",
                "name": "meeting-notes.docx",
                "size": 482113,
                "status": "uploading",
                "progress": 64
              },
              {
                "id": "ff-3",
                "name": "budget-2026.xlsx",
                "size": 90211,
                "status": "queued"
              },
              {
                "id": "ff-5",
                "name": "photo.jpg",
                "size": 1048576,
                "status": "ready"
              },
              {
                "id": "ff-4",
                "name": "scan.pdf",
                "size": 31457280,
                "status": "error",
                "error": "Larger than 25 MB."
              }
            ]
          }
        },
        {
          "id": "ff-single",
          "type": "ui:file-drop",
          "props": {
            "name": "voice.sample",
            "label": "Voice sample",
            "accept": "audio/*",
            "max_bytes": 10485760,
            "help": "About 10 seconds of you reading aloud."
          }
        }
      ]
    },
    {
      "id": "form-camera",
      "title": "Camera & picture ui:camera-capture ui:avatar-picker",
      "description": "The camera starts only when you press the button, and stops on confirm, cancel or leaving the page. Without a camera a photo can be chosen instead.",
      "components": [
        {
          "id": "fc-grid",
          "type": "ui:grid",
          "props": {
            "columns": 2,
            "gap": "lg"
          },
          "children": ["fc-camera", "fc-avatars"]
        },
        {
          "id": "fc-camera",
          "type": "ui:camera-capture",
          "props": {
            "name": "receipt.photo",
            "label": "Photo of the receipt",
            "description": "Hold the receipt flat, inside the frame.",
            "facing": "environment",
            "aspect": "landscape"
          }
        },
        {
          "id": "fc-avatars",
          "type": "ui:stack",
          "props": {
            "gap": "lg"
          },
          "children": ["fc-avatar", "fc-avatar-empty"]
        },
        {
          "id": "fc-avatar",
          "type": "ui:avatar-picker",
          "props": {
            "name": "profile.avatar",
            "label": "Companion avatar",
            "image_url": "/assets/kyberion-avatar.svg",
            "removable": true,
            "help": "Cropped to a square."
          }
        },
        {
          "id": "fc-avatar-empty",
          "type": "ui:avatar-picker",
          "props": {
            "name": "member.avatar",
            "label": "Your picture",
            "initials": "AL",
            "shape": "square",
            "allow_camera": false
          }
        }
      ]
    },
    {
      "id": "form-secrets",
      "title": "Secrets ui:secret-field",
      "description": "Masked by default. A stored token is never sent back: only \"set\" and its last four characters. The typed value goes to onAction once and the input is cleared.",
      "components": [
        {
          "id": "fk-stack",
          "type": "ui:stack",
          "props": {
            "gap": "lg"
          },
          "children": ["fk-new", "fk-set", "fk-error"]
        },
        {
          "id": "fk-new",
          "type": "ui:secret-field",
          "props": {
            "name": "secrets.openai",
            "label": "OpenAI API key",
            "placeholder": "sk-…",
            "service_id": "openai",
            "secret_key": "api_key",
            "required": true,
            "help": "Stored through the approved secret registration; never shown again.",
            "action": {
              "id": "secret.introduce"
            }
          }
        },
        {
          "id": "fk-set",
          "type": "ui:secret-field",
          "props": {
            "name": "secrets.slack",
            "label": "Slack bot token",
            "configured": true,
            "last4": "Q7xk",
            "service_id": "slack",
            "secret_key": "bot_token",
            "action": {
              "id": "secret.introduce"
            },
            "remove_action": {
              "id": "secret.remove"
            }
          }
        },
        {
          "id": "fk-error",
          "type": "ui:secret-field",
          "props": {
            "name": "secrets.github",
            "label": "GitHub token",
            "service_id": "github",
            "secret_key": "token",
            "error": "That token was rejected. Create a new one with repo scope.",
            "action": {
              "id": "secret.introduce"
            }
          }
        }
      ]
    }
  ]
}
