{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../",
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "paths": {
      "@agent/core": ["../../../libs/core/dist/index.d.ts"],
      "@agent/core/*": ["../../../libs/core/dist/*"]
    }
  },
  "include": ["server.ts"]
}
