{
  "actuator_id": "build-actuator",
  "version": "1.0.0",
  "description": "iOS/Android build, test, archive and app scaffolding — the build stage of the mobile AI-DLC/SDLC loop",
  "contract_schema": "knowledge/product/schemas/build-pipeline.schema.json",
  "resilience_tier": "fail_fast",
  "recovery_policy": {
    "fallback_strategy": "report_error_summary",
    "retry_profile": "build-actuator"
  },
  "capabilities": [
    {
      "op": "scaffold_app",
      "schema_ref": "knowledge/product/schemas/build-pipeline.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "write"
    },
    {
      "op": "ios_generate_project",
      "schema_ref": "knowledge/product/schemas/build-pipeline.schema.json",
      "platforms": ["darwin"],
      "prerequisites": {
        "binaries": ["xcodegen"],
        "platforms": ["darwin"],
        "install": {
          "darwin": "brew install xcodegen"
        }
      },
      "effect": "write"
    },
    {
      "op": "ios_build",
      "schema_ref": "knowledge/product/schemas/build-pipeline.schema.json",
      "platforms": ["darwin"],
      "prerequisites": {
        "binaries": ["xcodebuild"],
        "platforms": ["darwin"],
        "install": {
          "darwin": "Xcode を App Store から導入し xcode-select を設定"
        }
      },
      "effect": "write"
    },
    {
      "op": "ios_test",
      "schema_ref": "knowledge/product/schemas/build-pipeline.schema.json",
      "platforms": ["darwin"],
      "prerequisites": {
        "binaries": ["xcodebuild", "xcrun"],
        "platforms": ["darwin"],
        "install": {
          "darwin": "Xcode を App Store から導入し xcode-select を設定"
        }
      },
      "effect": "write"
    },
    {
      "op": "ios_archive",
      "schema_ref": "knowledge/product/schemas/build-pipeline.schema.json",
      "platforms": ["darwin"],
      "prerequisites": {
        "binaries": ["xcodebuild"],
        "platforms": ["darwin"],
        "install": {
          "darwin": "Xcode を App Store から導入し xcode-select を設定"
        }
      },
      "effect": "write"
    },
    {
      "op": "android_build",
      "schema_ref": "knowledge/product/schemas/build-pipeline.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "prerequisites": {
        "env": ["ANDROID_HOME"],
        "platforms": ["darwin", "linux", "win32"],
        "install": {
          "darwin": "Android Studio / cmdline-tools を導入し ANDROID_HOME を設定"
        }
      },
      "effect": "write"
    },
    {
      "op": "android_test",
      "schema_ref": "knowledge/product/schemas/build-pipeline.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "prerequisites": {
        "env": ["ANDROID_HOME"],
        "platforms": ["darwin", "linux", "win32"],
        "install": {
          "darwin": "Android Studio / cmdline-tools を導入し ANDROID_HOME を設定"
        }
      },
      "effect": "write"
    },
    {
      "op": "android_bundle",
      "schema_ref": "knowledge/product/schemas/build-pipeline.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "prerequisites": {
        "env": ["ANDROID_HOME"],
        "platforms": ["darwin", "linux", "win32"],
        "install": {
          "darwin": "Android Studio / cmdline-tools を導入し ANDROID_HOME を設定"
        }
      },
      "effect": "write"
    }
  ]
}
