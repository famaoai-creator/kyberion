{
  "action": "pipeline",
  "context": {
    "context_path": "active/shared/tmp/ios/ios-interactive-flow-template.context.json"
  },
  "steps": [
    {
      "type": "capture",
      "op": "simctl_health_check",
      "params": { "export_as": "ios_health" }
    },
    {
      "type": "apply",
      "op": "boot_simulator",
      "params": {}
    },
    {
      "type": "capture",
      "op": "describe_ui",
      "params": { "export_as": "ui_tree" }
    },
    {
      "type": "apply",
      "op": "tap_ui_node",
      "params": { "text": "Settings", "dry_run": true, "export_as": "tap_target" }
    },
    {
      "type": "apply",
      "op": "capture_screen",
      "params": { "path": "active/shared/tmp/ios/ios-interactive-flow-template.png" }
    }
  ]
}
