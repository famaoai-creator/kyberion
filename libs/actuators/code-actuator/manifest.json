{
  "actuator_id": "code-actuator",
  "version": "2.2.0",
  "description": "ADF-driven code analysis and refactoring pipeline engine",
  "contract_schema": "knowledge/product/schemas/code-pipeline.schema.json",
  "resilience_tier": "adaptive_retry",
  "recovery_policy": {
    "fallback_strategy": "code_io_retry",
    "retry_profile": "code-actuator"
  },
  "capabilities": [
    {
      "op": "pipeline",
      "schema_ref": "knowledge/product/schemas/code-pipeline.schema.json",
      "platforms": ["darwin", "linux", "win32"]
    },
    {
      "op": "semgrep_scan",
      "platforms": ["darwin", "linux"],
      "prerequisites": {
        "binaries": ["semgrep"],
        "platforms": ["darwin", "linux"],
        "install": {
          "darwin": "brew install semgrep",
          "linux": "python -m pip install semgrep"
        }
      }
    },
    { "op": "reconcile", "platforms": ["darwin", "linux", "win32"] },
    {
      "op": "impact_analysis",
      "schema_ref": "knowledge/product/schemas/impact-analysis.schema.json",
      "platforms": ["darwin", "linux", "win32"]
    }
  ]
}
