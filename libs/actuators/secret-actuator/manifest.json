{
  "actuator_id": "secret-actuator",
  "version": "1.1.0",
  "description": "OS Native Secret Manager Bridge",
  "contract_schema": "knowledge/product/schemas/secret-action.schema.json",
  "resilience_tier": "adaptive_retry",
  "recovery_policy": {
    "fallback_strategy": "os_native_keychain",
    "retry": {
      "maxRetries": 2,
      "initialDelayMs": 500,
      "maxDelayMs": 5000,
      "factor": 2,
      "jitter": true
    },
    "retryable_categories": ["network", "timeout", "resource_unavailable"]
  },
  "capabilities": [
    {
      "op": "get",
      "platforms": ["darwin", "win32", "linux"],
      "requirements": {
        "env": ["KYBERION_ALLOW_FILE_SECRETS"],
        "env_platforms": ["linux"]
      }
    },
    {
      "op": "set",
      "platforms": ["darwin", "win32", "linux"],
      "requirements": {
        "env": ["KYBERION_ALLOW_FILE_SECRETS"],
        "env_platforms": ["linux"]
      }
    },
    {
      "op": "delete",
      "platforms": ["darwin", "win32", "linux"],
      "requirements": {
        "env": ["KYBERION_ALLOW_FILE_SECRETS"],
        "env_platforms": ["linux"]
      }
    },
    {
      "op": "list",
      "platforms": ["darwin", "win32", "linux"],
      "requirements": {
        "env": ["KYBERION_ALLOW_FILE_SECRETS"],
        "env_platforms": ["linux"]
      }
    }
  ]
}
