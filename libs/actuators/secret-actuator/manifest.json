{
  "actuator_id": "secret-actuator",
  "version": "1.2.0",
  "description": "OS Native Secret Manager Bridge. Prefer kyberion secret introduce / Concierge for value collection.",
  "contract_schema": "knowledge/product/schemas/secret-action.schema.json",
  "resilience_tier": "adaptive_retry",
  "recovery_policy": {
    "fallback_strategy": "os_native_keychain",
    "retry_profile": "secret-actuator"
  },
  "capabilities": [
    {
      "op": "get",
      "platforms": ["darwin", "win32", "linux"],
      "requirements": {
        "env": ["KYBERION_ALLOW_FILE_SECRETS"],
        "env_platforms": ["linux"]
      },
      "effect": "read"
    },
    {
      "op": "set",
      "platforms": ["darwin", "win32", "linux"],
      "requirements": {
        "env": ["KYBERION_ALLOW_FILE_SECRETS"],
        "env_platforms": ["linux"]
      },
      "effect": "write"
    },
    {
      "op": "delete",
      "platforms": ["darwin", "win32", "linux"],
      "requirements": {
        "env": ["KYBERION_ALLOW_FILE_SECRETS"],
        "env_platforms": ["linux"]
      },
      "effect": "write"
    },
    {
      "op": "list",
      "platforms": ["darwin", "win32", "linux"],
      "requirements": {
        "env": ["KYBERION_ALLOW_FILE_SECRETS"],
        "env_platforms": ["linux"]
      },
      "effect": "read"
    }
  ]
}
