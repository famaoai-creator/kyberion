{
  "actuator_id": "browser-actuator",
  "version": "1.2.0",
  "description": "Pipeline-driven Playwright browser execution and session artifact actuator",
  "contract_schema": "knowledge/product/schemas/browser-automation-pipeline.schema.json",
  "resilience_tier": "adaptive_retry",
  "recovery_policy": {
    "fallback_strategy": "selector_self_heal",
    "retry_profile": "browser-actuator"
  },
  "capabilities": [
    {
      "op": "pipeline",
      "schema_ref": "knowledge/product/schemas/browser-automation-pipeline.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "egress",
      "step_ops": {
        "goto": {
          "effect": "egress",
          "egress_destination_from": "url"
        },
        "open_tab": {
          "effect": "egress",
          "egress_destination_from": "url"
        },
        "snapshot": {
          "effect": "read"
        }
      }
    },
    {
      "op": "computer_interaction",
      "schema_ref": "knowledge/product/schemas/computer-interaction.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "write"
    }
  ]
}
