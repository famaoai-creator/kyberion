{
  "actuator_id": "service-actuator",
  "version": "1.3.0",
  "description": "Unified External SaaS/API/MCP Reachability Layer",
  "contract_schema": "knowledge/product/schemas/service-action.schema.json",
  "resilience_tier": "adaptive_retry",
  "recovery_policy": {
    "fallback_strategy": "sequential_alternatives",
    "retry_profile": "service-actuator"
  },
  "capabilities": [
    {
      "op": "pipeline",
      "schema_ref": "knowledge/product/schemas/service-action.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "write"
    },
    {
      "op": "api",
      "schema_ref": "knowledge/product/schemas/service-action.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "egress",
      "effect_from": "method",
      "resource_ref_from": "resource_ref"
    },
    {
      "op": "cli",
      "schema_ref": "knowledge/product/schemas/service-action.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "egress",
      "resource_ref_from": "resource_ref"
    },
    {
      "op": "preset",
      "schema_ref": "knowledge/product/schemas/service-action.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "egress",
      "resource_ref_from": "resource_ref"
    },
    {
      "op": "mcp",
      "schema_ref": "knowledge/product/schemas/service-action.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "egress"
    },
    {
      "op": "reconcile",
      "schema_ref": "knowledge/product/schemas/service-action.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "write"
    },
    {
      "op": "oauth",
      "schema_ref": "knowledge/product/schemas/service-action.schema.json",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "egress"
    }
  ]
}
