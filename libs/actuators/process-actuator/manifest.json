{
  "actuator_id": "process-actuator",
  "version": "1.0.0",
  "description": "Managed process lifecycle actuator backed by the runtime supervisor",
  "contract_schema": "knowledge/product/schemas/process-action.schema.json",
  "resilience_tier": "adaptive_retry",
  "recovery_policy": {
    "fallback_strategy": "process_retry",
    "retry_profile": "process-actuator"
  },
  "capabilities": [
    {
      "op": "spawn",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "write"
    },
    {
      "op": "stop",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "write"
    },
    {
      "op": "list",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "read"
    },
    {
      "op": "status",
      "platforms": ["darwin", "linux", "win32"],
      "effect": "read"
    }
  ]
}
