# S2: block a push whose committed generated files are stale — the same
# drift the CI freshness gates (op-registry, vocabulary-types, pseudo-locale,
# pii-rules, env-registry, catalogs, ...) would report one CI round later.
# Read-only and fast (~20s): it runs only `pnpm kyberion resolve generated
# --check --fast`, which skips the ~100s role-assumption reachability analysis
# (its CI gate still runs).
#
# Skip for one push (e.g. pushing a WIP branch on purpose):
#   KYBERION_SKIP_PRE_PUSH=1 git push
[ "${KYBERION_SKIP_PRE_PUSH:-}" = "1" ] && exit 0
# Without a build (fresh clone) the CLI cannot run; CI still enforces drift.
if [ ! -f dist/scripts/kyberion.js ]; then
  echo "kyberion pre-push: dist/ missing — skipped the generated-file check (run 'pnpm build' to enable it)."
  exit 0
fi
if ! pnpm kyberion resolve generated --check --fast --quiet; then
  echo ""
  echo "kyberion pre-push: generated files are out of date (drifted files listed above)."
  echo "  fix:  pnpm kyberion resolve generated && git commit -m 'chore: regenerate generated files'"
  echo "  skip: KYBERION_SKIP_PRE_PUSH=1 git push"
  exit 1
fi
