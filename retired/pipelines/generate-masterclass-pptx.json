{
  "id": "generate-masterclass-pptx",
  "version": "1.1.0",
  "description": "Generate premium masterclass PPTX via media-actuator pipeline",
  "steps": [
    {
      "id": "read-design-protocol",
      "role": "source",
      "op": "system:read_json",
      "produces": {
        "channel": "last_pptx_design",
        "type": "PptxDesignProtocol"
      },
      "params": {
        "path": "pipelines/fragments/masterclass_design_protocol.json"
      }
    },
    {
      "id": "render-pptx",
      "role": "sink",
      "op": "media:pptx_render",
      "consumes": "last_pptx_design",
      "params": {
        "path": "active/shared/tmp/all_objects_layout_sample.pptx"
      }
    },
    {
      "id": "export",
      "role": "sink",
      "op": "system:shell",
      "params": {
        "cmd": "mkdir -p active/shared/exports && cp active/shared/tmp/all_objects_layout_sample.pptx active/shared/exports/all_objects_layout_sample.pptx"
      }
    }
  ]
}
