{
  "$schema": "../knowledge/product/schemas/dot-charter.schema.json",
  "kind": "dot-charter",
  "dot_id": "repo-guardian",
  "version": "1.0.0",
  "title": "Repository guardian",
  "purpose": "Hold standing responsibility for repository health: watch scheduled-pipeline and CI signals, classify failures, dispatch bounded repair work, and keep the operator informed through digests and approvals.",
  "status": "active",
  "scope": {
    "tier": "public"
  },
  "goal": {
    "statement": "Keep this repository's autonomous operations healthy: scheduled pipelines run green, daemons heartbeat on time, and failures are classified and either repaired in scope or escalated with evidence.",
    "success_signals": [
      "Scheduled pipeline runs in the last 24h are predominantly 'succeeded'",
      "daemon-watchdog reports ok=true on every 300s tick",
      "No unacknowledged ops-alert older than 24h"
    ],
    "signal_probes": [
      {
        "signal": "daemon watchdog reports no unhealthy daemons",
        "probe": {
          "type": "file",
          "path": "active/shared/runtime/heartbeats/watchdog-runs/last-run.json",
          "expect": "matches",
          "regex": "\"unhealthy\"\\s*:\\s*\\{\\s*\\}"
        },
        "every_s": 900
      },
      {
        "signal": "scheduled pipelines have no consecutive failures",
        "probe": {
          "type": "file",
          "path": "active/shared/runtime/pipeline-schedules.json",
          "expect": "matches",
          "regex": "\"version\":\\s*\"1\\.0\"(?:(?!\"consecutiveFailures\":\\s*[1-9])[\\s\\S])*(?![\\s\\S])"
        },
        "every_s": 900
      }
    ],
    "key_results": [
      {
        "kr_id": "daemon_health_ratio",
        "title": "Daemon watchdog clean-tick ratio",
        "metric": {
          "source": "signal_ratio",
          "signal": "daemon watchdog reports no unhealthy daemons",
          "window_hours": 24
        },
        "target": 95,
        "direction": "increase",
        "unit": "%",
        "every_s": 900
      },
      {
        "kr_id": "pipeline_failure_free_ratio",
        "title": "Scheduled-pipeline failure-free ratio",
        "metric": {
          "source": "signal_ratio",
          "signal": "scheduled pipelines have no consecutive failures",
          "window_hours": 24
        },
        "target": 80,
        "direction": "increase",
        "unit": "%",
        "every_s": 900
      }
    ],
    "budget": {
      "max_turns_per_wake": 4,
      "wall_clock_ms_per_wake": 1800000,
      "token_cap_per_day": 1500000
    }
  },
  "attention": {
    "triggers": [
      {
        "kind": "cron",
        "cron": "0 * * * *",
        "timezone": "Asia/Tokyo"
      },
      {
        "kind": "watch",
        "paths": ["active/shared/observability/ops-alerts.jsonl"],
        "ignore_jsonl_kinds": ["operator_notification_undelivered"],
        "min_severity": "critical",
        "min_interval_seconds": 600
      },
      {
        "kind": "wake",
        "channels": ["slack", "inbox"]
      },
      {
        "kind": "event",
        "sources": ["github"],
        "types": ["workflow_run", "check_suite", "pull_request", "issues"]
      }
    ]
  },
  "authority": {
    "authority_role": "infrastructure_sentinel",
    "allowed_execution_shapes": ["direct_reply", "mission", "pipeline"],
    "max_concurrent_delegations": 100
  },
  "decisions": {
    "default_decision": "notify",
    "veto_window_minutes": 60,
    "escalate_channel": "slack"
  },
  "autonomy": {
    "min_level": "L3"
  },
  "notification": {
    "delivery_mode": "inbox",
    "deliver_to": {
      "surface": "surface",
      "channel": "inbox"
    },
    "digest_cron": "0 9,18 * * *",
    "quiet_hours": {
      "start": "23:00",
      "end": "07:00",
      "timezone": "Asia/Tokyo"
    }
  },
  "team": {
    "responsibilities": ["repository.health"],
    "accepts_handoffs_from": ["org-operations"],
    "goal_ref": "Kyberion runs its own operations autonomously and safely"
  },
  "runtime": {
    "heartbeat_id": "dot-repo-guardian",
    "max_idle_wake_ms": 4500000,
    "force_wake_every_ms": 21600000
  }
}
