{
  "$schema": "../knowledge/product/schemas/dot-charter.schema.json",
  "kind": "dot-charter",
  "dot_id": "org-operations",
  "version": "1.0.0",
  "title": "Organization Operations Sentinel",
  "purpose": "組織運営ループ（Operation tick、意思決定の進捗監視、サービスヘルス、プロジェクト進捗）を常駐監視し、自律的な定常業務遂行とオーナーへの判断要請を担う。",
  "status": "active",
  "scope": {
    "tier": "confidential",
    "tenant_slug": "kyberion-service-studio",
    "organization_id": "kyberion-development-team"
  },
  "goal": {
    "statement": "組織 kyberion-development-team の定常運用ループを滞りなく回す。期限を迎えたオペレーションを tick し、未観測サービスを検知し、判断待ちの意思決定を整理してオーナーへ提示する。",
    "success_signals": [
      "未実行（overdue）のオペレーションが 0 件",
      "全サービスのヘルス状態が 24時間以内に観測済み（healthy）",
      "未解決インシデントおよび判断遅延の意思決定が放置されていないこと"
    ],
    "budget": {
      "max_turns_per_wake": 5,
      "wall_clock_ms_per_wake": 600000,
      "token_cap_per_day": 200000
    }
  },
  "attention": {
    "triggers": [
      {
        "kind": "cron",
        "cron": "0 9 * * 1-5",
        "timezone": "Asia/Tokyo"
      },
      {
        "kind": "probe",
        "probe": {
          "type": "file",
          "path": "active/organizations/confidential/kyberion-service-studio/kyberion-development-team/state/organization-state.json",
          "expect": "changed"
        }
      },
      {
        "kind": "wake",
        "channels": ["slack", "inbox"]
      }
    ]
  },
  "authority": {
    "authority_role": "organization_operator",
    "allowed_work_shapes": ["direct_reply", "pipeline", "mission"],
    "max_concurrent_delegations": 1
  },
  "decisions": {
    "default_decision": "notify",
    "veto_window_minutes": 60,
    "escalate_channel": "slack"
  },
  "notification": {
    "deliver_to": {
      "surface": "slack",
      "channel": "kyberion-executive"
    },
    "digest_cron": "0 9,18 * * 1-5",
    "quiet_hours": {
      "start": "22:00",
      "end": "08:00",
      "timezone": "Asia/Tokyo"
    }
  },
  "team": {
    "responsibilities": ["organization.operations-loop"],
    "accepts_handoffs_from": ["repo-guardian"],
    "goal_ref": "Kyberion runs its own operations autonomously and safely"
  },
  "runtime": {
    "heartbeat_id": "dot-org-operations"
  }
}
