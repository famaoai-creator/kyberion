{
  "action": "pipeline",
  "name": "create-my-avatar",
  "version": "3.0.0",
  "description": "Avatar onboarding template: capture a reference photo, generate a stylised expression set from it (per-run consent required for cloud / host-bridge providers), and register it into the personal profile.",
  "_migration_note": "v2: Typed Flow format (role/produces/consumes).",
  "context": {
    "capture_output_path": "active/shared/tmp/avatar-onboarding/{{profile_slug}}/user_face.jpg",
    "identity_path": "knowledge/personal/my-identity.json",
    "profile_slug": "user",
    "profile_name": "user",
    "profile_language": "Japanese",
    "interaction_style": "Concierge",
    "bridge_preference": "host",
    "avatar_output_dir": "knowledge/personal/avatar",
    "avatar_style": "friendly stylised illustration, soft cel shading, clean plain light background, head-and-shoulders portrait, centred, facing the viewer",
    "consent_provider": "",
    "consent_granted_by": ""
  },
  "steps": [
    {
      "id": "preflight",
      "role": "gate",
      "op": "core:include",
      "params": {
        "fragment": "fragments/avatar-runtime-preflight.json"
      }
    },
    {
      "role": "gate",
      "op": "core:include",
      "params": {
        "fragment": "fragments/avatar-onboarding.json",
        "context": {
          "capture_output_path": "{{capture_output_path}}",
          "identity_path": "{{identity_path}}",
          "profile_name": "{{profile_name}}",
          "profile_language": "{{profile_language}}",
          "interaction_style": "{{interaction_style}}",
          "bridge_preference": "{{bridge_preference}}",
          "avatar_output_dir": "{{avatar_output_dir}}",
          "avatar_style": "{{avatar_style}}",
          "consent_provider": "{{consent_provider}}",
          "consent_granted_by": "{{consent_granted_by}}"
        }
      }
    }
  ]
}
