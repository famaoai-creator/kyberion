{
  "action": "pipeline",
  "pipeline_id": "media-docx-roundtrip",
  "version": "1.0.0",
  "name": "DOCX Roundtrip Reproduction",
  "description": "Reproduce a DOCX from its extracted design: docx_extract distills the file into a DocxDesignProtocol (paragraphs, tables, borders, styles, theme, plus passthrough parts such as footnotes/endnotes/comments/settings/customXml), persists it as JSON, and docx_render writes it back to a new .docx. Use this for reproduction/round-trip fidelity — authoring new documents goes through media:generate_document with a semantic brief instead. Override paths via --context: {\"source_docx_path\": \"...\", \"roundtrip_docx_path\": \"...\", \"design_path\": \"...\"}.",
  "_usage_note": "Set embed_images on the extract step params when a self-contained design (inline base64 pictures) is needed; default writes pictures to a per-document image dir.",
  "context": {
    "mission_id": "MSN-DOCX-ROUNDTRIP",
    "preflight_cmd": "pnpm --version",
    "source_docx_path": "active/shared/tmp/docx-roundtrip/input.docx",
    "design_path": "active/shared/tmp/docx-roundtrip/design.json",
    "roundtrip_docx_path": "active/shared/tmp/docx-roundtrip/roundtrip.docx"
  },
  "steps": [
    {
      "id": "preflight",
      "role": "gate",
      "op": "core:include",
      "params": { "fragment": "fragments/runtime-preflight.json" }
    },
    {
      "id": "extract_docx_design",
      "role": "source",
      "op": "media:docx_extract",
      "produces": {
        "channel": "source_docx_design",
        "type": "DocxDesign"
      },
      "params": {
        "path": "{{source_docx_path}}",
        "export_as": "source_docx_design"
      }
    },
    {
      "id": "persist_design",
      "role": "sink",
      "op": "system:write_file",
      "consumes": "source_docx_design",
      "produces": {
        "channel": "design_path",
        "type": "FilePath"
      },
      "params": {
        "path": "{{design_path}}",
        "format": "json",
        "content": "{{source_docx_design}}"
      }
    },
    {
      "id": "render_roundtrip_docx",
      "role": "sink",
      "op": "media:docx_render",
      "consumes": "source_docx_design",
      "produces": {
        "channel": "roundtrip_docx_path",
        "type": "FilePath"
      },
      "params": {
        "design_from": "source_docx_design",
        "path": "{{roundtrip_docx_path}}"
      }
    },
    {
      "id": "log_done",
      "role": "sink",
      "op": "system:log",
      "params": {
        "message": "DOCX roundtrip completed: {{source_docx_path}} -> {{roundtrip_docx_path}} (design: {{design_path}})"
      }
    }
  ]
}
