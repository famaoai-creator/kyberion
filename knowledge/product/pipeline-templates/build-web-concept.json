{
  "pipeline_id": "build-web-concept",
  "version": "2.0.0",
  "description": "Generate and preview a web site prototype from a conceptual brief.",
  "_migration_note": "v3: Delegates the HTML generation/open flow to the reusable html-web-preview fragment.",
  "action": "pipeline",
  "context": {
    "concept_brief": "Describe the site, audience, and main message here.",
    "design_theme": "",
    "output_path": "active/shared/tmp/preview/index.html",
    "preview_label": "Web concept preview"
  },
  "steps": [
    {
      "id": "render_preview",
      "role": "gate",
      "op": "core:include",
      "params": {
        "fragment": "fragments/html-web-preview.json",
        "context": {
          "html_brief": "{{concept_brief}}",
          "design_system_brief": "{{design_theme}}",
          "output_path": "{{output_path}}",
          "preview_label": "{{preview_label}}"
        }
      }
    }
  ]
}
