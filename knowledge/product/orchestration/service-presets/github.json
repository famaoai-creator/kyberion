{
  "service_id": "github",
  "name": "GitHub REST API Presets",
  "base_url": "https://api.github.com",
  "auth_strategy": "Bearer",
  "operations": {
    "create_issue": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/issues",
      "method": "POST",
      "description": "Creates a new issue in a repository.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "title": { "required": true, "type": "string" },
        "body": { "required": false, "type": "string" }
      },
      "output_mapping": { "id": "number", "url": "html_url" }
    },
    "update_issue": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/issues/{{issue_number}}",
      "method": "PATCH",
      "description": "Updates a GitHub issue.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "issue_number": { "required": true, "type": "number" },
        "title": { "required": false, "type": "string" },
        "body": { "required": false, "type": "string" },
        "state": { "required": false, "type": "string" }
      }
    },
    "add_comment": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/issues/{{issue_number}}/comments",
      "method": "POST",
      "description": "Adds a comment to a GitHub issue.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "issue_number": { "required": true, "type": "number" },
        "body": { "required": true, "type": "string" }
      }
    },
    "close_issue": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/issues/{{issue_number}}",
      "method": "PATCH",
      "description": "Closes a GitHub issue.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "issue_number": { "required": true, "type": "number" }
      },
      "payload_template": {
        "state": "closed"
      }
    },
    "list_repos": {
      "type": "api",
      "path": "user/repos",
      "method": "GET",
      "description": "Lists repositories for the authenticated user.",
      "parameters": {
        "sort": { "default": "updated" },
        "per_page": { "default": 30 }
      }
    },
    "actions_list_runs": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/actions/runs",
      "method": "GET",
      "description": "Lists workflow runs for a repository.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "branch": { "required": false, "type": "string" },
        "event": { "required": false, "type": "string" },
        "status": { "required": false, "type": "string" },
        "per_page": { "required": false, "type": "number" }
      }
    },
    "actions_get_run": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/actions/runs/{{run_id}}",
      "method": "GET",
      "description": "Gets a single workflow run and its status metadata.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "run_id": { "required": true, "type": "number" }
      },
      "output_mapping": {
        "run_id": "id",
        "status": "status",
        "conclusion": "conclusion",
        "html_url": "html_url",
        "name": "name",
        "head_branch": "head_branch",
        "head_sha": "head_sha"
      }
    },
    "actions_dispatch_workflow": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/actions/workflows/{{workflow_id}}/dispatches",
      "method": "POST",
      "description": "Dispatches a GitHub Actions workflow run.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "workflow_id": { "required": true, "type": "string" },
        "ref": { "required": true, "type": "string" },
        "inputs": { "required": false, "type": "object" }
      },
      "payload_template": {
        "ref": "{{ref}}",
        "inputs": "{{inputs}}"
      }
    },
    "create_pull_request": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/pulls",
      "method": "POST",
      "description": "Creates a pull request.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "title": { "required": true, "type": "string" },
        "head": { "required": true, "type": "string" },
        "base": { "required": true, "type": "string" }
      },
      "output_mapping": { "number": "number", "url": "html_url" }
    },
    "merge_pull_request": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/pulls/{{pull_number}}/merge",
      "method": "PUT",
      "description": "Merges a pull request.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "pull_number": { "required": true, "type": "number" }
      }
    },
    "list_issues": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/issues",
      "method": "GET",
      "kind": "capture",
      "risk": "read",
      "description": "Lists issues in a repository. GitHub also includes pull requests in this collection; use list_pulls for PR-only results.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "state": { "required": false, "type": "string", "description": "open, closed, or all" },
        "labels": { "required": false, "type": "string" },
        "assignee": { "required": false, "type": "string" },
        "per_page": { "required": false, "type": "number", "default": 30 }
      }
    },
    "get_issue": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/issues/{{issue_number}}",
      "method": "GET",
      "kind": "capture",
      "risk": "read",
      "description": "Gets a single issue (or a pull request presented as an issue).",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "issue_number": { "required": true, "type": "number" }
      },
      "output_mapping": { "id": "number", "url": "html_url", "state": "state", "title": "title" }
    },
    "list_pulls": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/pulls",
      "method": "GET",
      "kind": "capture",
      "risk": "read",
      "description": "Lists pull requests in a repository.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "state": { "required": false, "type": "string", "description": "open, closed, or all" },
        "head": { "required": false, "type": "string" },
        "base": { "required": false, "type": "string" },
        "per_page": { "required": false, "type": "number", "default": 30 }
      }
    },
    "get_pull": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/pulls/{{pull_number}}",
      "method": "GET",
      "kind": "capture",
      "risk": "read",
      "description": "Gets a single pull request, including mergeability metadata.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "pull_number": { "required": true, "type": "number" }
      },
      "output_mapping": {
        "number": "number",
        "url": "html_url",
        "state": "state",
        "title": "title",
        "head_sha": "head.sha"
      }
    },
    "list_reviews": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/pulls/{{pull_number}}/reviews",
      "method": "GET",
      "kind": "capture",
      "risk": "read",
      "description": "Lists submitted reviews on a pull request.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "pull_number": { "required": true, "type": "number" },
        "per_page": { "required": false, "type": "number", "default": 30 }
      }
    },
    "list_review_comments": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/pulls/{{pull_number}}/comments",
      "method": "GET",
      "kind": "capture",
      "risk": "read",
      "description": "Lists review comments (line comments) on a pull request.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "pull_number": { "required": true, "type": "number" },
        "per_page": { "required": false, "type": "number", "default": 30 }
      }
    },
    "list_pr_files": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/pulls/{{pull_number}}/files",
      "method": "GET",
      "kind": "capture",
      "risk": "read",
      "description": "Lists files changed in a pull request.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "pull_number": { "required": true, "type": "number" },
        "per_page": { "required": false, "type": "number", "default": 30 }
      }
    },
    "create_review": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/pulls/{{pull_number}}/reviews",
      "method": "POST",
      "kind": "apply",
      "risk": "write",
      "description": "Submits a pull request review (COMMENT, APPROVE, or REQUEST_CHANGES). Write-gated; approval is required.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "pull_number": { "required": true, "type": "number" },
        "event": {
          "required": true,
          "type": "string",
          "description": "COMMENT, APPROVE, or REQUEST_CHANGES"
        },
        "body": { "required": false, "type": "string" },
        "commit_id": { "required": false, "type": "string" }
      },
      "payload_template": {
        "event": "{{event}}",
        "body": "{{body}}",
        "commit_id": "{{commit_id}}"
      },
      "output_mapping": { "id": "id", "url": "html_url", "state": "state" }
    },
    "create_review_comment": {
      "type": "api",
      "path": "repos/{{owner}}/{{repo}}/pulls/{{pull_number}}/comments",
      "method": "POST",
      "kind": "apply",
      "risk": "write",
      "description": "Creates a line-level review comment on a pull request. Write-gated; approval is required.",
      "parameters": {
        "owner": { "required": true, "type": "string" },
        "repo": { "required": true, "type": "string" },
        "pull_number": { "required": true, "type": "number" },
        "body": { "required": true, "type": "string" },
        "commit_id": { "required": true, "type": "string" },
        "path": { "required": true, "type": "string" },
        "line": { "required": false, "type": "number" },
        "side": { "required": false, "type": "string", "description": "LEFT or RIGHT" }
      },
      "payload_template": {
        "body": "{{body}}",
        "commit_id": "{{commit_id}}",
        "path": "{{path}}",
        "line": "{{line}}",
        "side": "{{side}}"
      },
      "output_mapping": { "id": "id", "url": "html_url" }
    }
  }
}
