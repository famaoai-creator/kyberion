{
  "service_id": "telegram",
  "name": "Telegram Bot API Presets",
  "base_url": "https://api.telegram.org",
  "auth_strategy": "none",
  "operations": {
    "get_me": {
      "type": "api",
      "kind": "capture",
      "risk": "read",
      "approval_required": false,
      "path": "bot{{accessToken}}/getMe",
      "method": "GET",
      "description": "Fetch the bot's identity; serves as the identity probe."
    },
    "post_message": {
      "path": "bot{{accessToken}}/sendMessage",
      "method": "POST",
      "description": "Sends a message to a Telegram chat/channel.",
      "parameters": {
        "chat_id": { "required": true, "type": "string" },
        "text": { "required": true, "type": "string" }
      },
      "payload_template": {
        "chat_id": "{{chat_id}}",
        "text": "{{text}}"
      }
    },
    "get_updates": {
      "path": "bot{{accessToken}}/getUpdates",
      "method": "GET",
      "description": "Gets incoming updates/messages for the bot."
    }
  }
}
