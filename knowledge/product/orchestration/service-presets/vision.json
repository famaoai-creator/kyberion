{
  "service_id": "vision",
  "name": "Kyberion Visual Generation Compatibility Alias",
  "alias_of": "media-generation",
  "operations": {
    "generate_image": {
      "type": "auto",
      "alternatives": [
        {
          "type": "api",
          "base_url": "http://127.0.0.1:8188",
          "path": "prompt",
          "method": "POST",
          "description": "Local ComfyUI via HTTP API"
        },
        {
          "type": "cli",
          "command": "{{@shared:runtime/service-runtimes/comfyui/bin/comfy}}",
          "args": ["run", "--workflow", "active/shared/tmp/temp_vision_workflow.json", "--wait"],
          "description": "Local ComfyUI via CLI"
        }
      ]
    }
  }
}
