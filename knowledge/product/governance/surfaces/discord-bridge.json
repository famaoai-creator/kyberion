{
  "version": 1,
  "surfaces": [
    {
      "id": "discord-bridge",
      "kind": "gateway",
      "description": "Discord Bot ingress gateway and surface-agent host",
      "service_id": "discord",
      "preset_path": "knowledge/product/orchestration/service-presets/discord.json",
      "command": "node",
      "args": ["dist/satellites/discord-bridge/src/index.js"],
      "env": {
        "MISSION_ID": "MSN-SYSTEM-SENSORY-HUB",
        "KYBERION_BASE_ROLE": "sovereign",
        "MISSION_ROLE": "surface_runtime"
      },
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "enabled": false
    }
  ]
}
