{
  "version": 1,
  "surfaces": [
    {
      "id": "mcp-server-cowork",
      "kind": "gateway",
      "description": "Kyberion MCP Server facade \u2014 exposes Kyberion capabilities to Claude Cowork and other MCP clients via stdio transport.",
      "command": "node",
      "args": ["dist/scripts/mcp_server.js"],
      "env": {
        "KYBERION_PERSONA": "sovereign",
        "MISSION_ROLE": "mcp_server",
        "KYBERION_MCP_CALLER_ROLE": "cowork"
      },
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "on-demand",
      "ownerType": "surface-runtime-manifest",
      "enabled": true,
      "operatorNotesKey": "surface:surface_notes_mcp_server_cowork",
      "bestForKey": "surface:surface_best_for_mcp_server_cowork"
    }
  ]
}
