{
  "$schema": "../schemas/intent-phrase-lexicon.schema.json",
  "version": "1.0.0",
  "description": "Locale-keyed phrase lexicon for heuristic intent classification. Each concept lists literal phrases (escaped) and/or regex source patterns per locale; the matcher checks every configured locale because the input language may differ from the UI locale. Add a locale by adding a key under `locales` — no code change is required.",
  "default_flags": "i",
  "prefix_word_suffixes": {
    "ja": [
      "してください",
      "して下さい",
      "してくれ",
      "して",
      "します",
      "ください",
      "下さい",
      "お願いします",
      "お願い"
    ]
  },
