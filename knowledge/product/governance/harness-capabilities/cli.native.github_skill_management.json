        "requires_pre_approval": false,
        "approval_scope": "none"
      },
      "preferred_usage": {
        "workflow_shapes": ["task_session"],
        "intents": ["skill-management", "install-skill"]
      },
      "fallback_path": {
        "mode": "kyberion_local_actuator",
        "target": "orchestrator-actuator"
      },
      "status": "experimental",
      "notes": "GitHub CLI skills are preview features; keep them clearly marked in the registry."
    }
  ]
}
