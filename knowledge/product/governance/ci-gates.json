{
  "$schema": "../schemas/ci-gates.schema.json",
  "version": 1,
  "gates": [
    {
      "id": "pinned-deps",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_pinned_deps.ts"],
      "owner": "release",
      "rationale": "Keeps the package manager, overrides, and lockfile dependency policy pinned."
    },
    {
      "id": "install-script-allowlist",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_install_script_allowlist.ts"],
      "owner": "release",
      "rationale": "Keeps native install scripts limited to the reviewed workspace allowlist."
    },
    {
      "id": "lockfile-commit-gate",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_lockfile_commit_gate.ts"],
      "owner": "release",
      "rationale": "Requires explicit review evidence before a lockfile change is accepted."
    },
    {
      "id": "ci-workflow-contract",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_ci_workflow_contract.ts"],
      "owner": "release",
      "rationale": "Keeps every workflow job time-boxed, pull_request workflows cancel superseded runs, actions on Node24 majors, and no redundant core build (operations-hygiene runbook §CI)."
    },
    {
      "id": "golden",
      "scope": "pr",
      "executable": "node",
      "args": ["dist/scripts/check_golden_output.js"],
      "owner": "quality",
      "rationale": "Keeps deterministic pipeline output snapshots stable in every validation scope."
    },
    {
      "id": "scenario-pr-deterministic",
      "scope": "pr",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/scenario_runner.ts",
        "run",
        "eval/scenarios",
        "--lane",
        "pr-deterministic"
      ],
      "owner": "quality",
      "rationale": "Runs the pr-deterministic scenario suite (eval/scenarios, simulated and model-free) so fixture-served pipelines, approval gates and fail-closed unstubbed ops keep their contract; same as pnpm scenario run eval/scenarios --lane pr-deterministic."
    },
    {
      "id": "memory-benchmark",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/benchmark_memory.ts"],
      "owner": "quality",
      "rationale": "Runs the deterministic QM-03 V-layer notebook fold and consolidation benchmark in the governed check lane."
    },
    {
      "id": "foundation-adoption",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_foundation_adoption.ts"],
      "owner": "architecture",
      "rationale": "Prevents shared JSON and schema construction helpers from regressing into local implementations."
    },
    {
      "id": "config-fallbacks",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_config_fallbacks.ts"],
      "owner": "governance",
      "rationale": "Fails closed when a governed catalog silently falls back instead of loading its validated source."
    },
    {
      "id": "type-ratchet",
      "scope": "pr",
      "executable": "node",
      "args": ["dist/scripts/check_type_ratchet.js"],
      "baseline": "scripts/check_type_ratchet.baseline.json",
      "owner": "quality",
      "rationale": "Prevents type-safety debt from increasing."
    },
    {
      "id": "module-boundaries",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_module_boundaries.ts"],
      "baseline": "scripts/check_module_boundaries.baseline.json",
      "owner": "architecture",
      "rationale": "Prevents import cycles and layer direction debt from increasing."
    },
    {
      "id": "max-file-lines",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_max_file_lines.ts"],
      "owner": "architecture",
      "rationale": "Prevents new production modules from exceeding the 1,500-line simplicity boundary."
    },
    {
      "id": "first-win-docs",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_first_win_docs.ts"],
      "owner": "experience",
      "rationale": "Keeps the first-win command contract and documentation fences aligned."
    },
    {
      "id": "wire-error-boundary",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_wire_error_boundary.ts"],
      "owner": "security",
      "rationale": "Prevents internal exception details from being projected onto network-facing responses."
    },
    {
      "id": "cli-manifest",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_cli_manifest.ts"],
      "owner": "operations",
      "rationale": "Keeps the single CLI entrypoint and command ownership map valid."
    },
    {
      "id": "ux-contract-docs",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_ux_contract_docs.ts"],
      "owner": "experience",
      "rationale": "Keeps the public entry documents understandable without internal runtime terms."
    },
    {
      "id": "improvement-plan-metadata",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_improvement_plan_metadata.ts"],
      "owner": "governance",
      "rationale": "Keeps improvement plans searchable and prevents a second undocumented status source."
    },
    {
      "id": "documentation-source-map",
      "scope": "pr",
      "executable": "node",
      "args": ["dist/scripts/check_documentation_source_map.js"],
      "owner": "documentation",
      "rationale": "Keeps status, concept, and onboarding documentation anchored to one explicit source map."
    },
    {
      "id": "documentation-links",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_documentation_links.ts"],
      "owner": "documentation",
      "rationale": "Rejects broken relative Markdown links before they become unreachable documentation."
    },
    {
      "id": "docs-drift",
      "scope": "pr",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/check_docs_drift.ts",
        "--skip-links"
      ],
      "owner": "documentation",
      "rationale": "Rejects documented pnpm/kyberion commands that do not exist, unlisted pipelines, a stale COMPONENT_MAP, and a stale generated docs/CLI_REFERENCE.md (links are covered by documentation-links)."
    },
    {
      "id": "channel-adapter-adoption",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_channel_adapter_adoption.ts"],
      "owner": "experience",
      "rationale": "Keeps all text bridges on the shared turn/thread/typing lifecycle."
    },
    {
      "id": "runtime-store-retention",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_runtime_store_retention.ts"],
      "owner": "operations",
      "rationale": "Fails when source references an active/shared/runtime/<name> store with no storage-retention-catalog entry, so new ledgers and runtime dirs cannot grow unbounded and invisible to the janitor."
    },
    {
      "id": "ci-gate-parity",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_ci_gate_parity.ts"],
      "owner": "operations",
      "rationale": "Keeps manifest scopes connected to the PR, full, and release workflow entrypoints."
    },
    {
      "id": "op-preflight-coverage",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_op_preflight_coverage.ts"],
      "owner": "quality",
      "rationale": "Keeps actuator operations covered by preflight contracts."
    },
    {
      "id": "op-input-contract-coverage",
      "scope": "pr",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/check_op_input_contract_coverage.ts"
      ],
      "baseline": "scripts/check_op_input_contract_coverage.baseline.json",
      "owner": "quality",
      "rationale": "Requires every discovered actuator operation to publish an input schema and example."
    },
    {
      "id": "pipeline-op-schemas",
      "scope": "pr",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/check_pipeline_op_schema_coverage.ts"
      ],
      "owner": "quality",
      "rationale": "Checks every schema-bound pipeline invocation after template resolution and keeps inferred legacy operations open during migration."
    },
    {
      "id": "extension-order",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_extension_order.ts"],
      "owner": "architecture",
      "rationale": "Keeps extension registration deterministic and dependency-safe."
    },
    {
      "id": "module-invariants",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_module_invariants.ts"],
      "owner": "architecture",
      "rationale": "Checks declared module invariants after the build."
    },
    {
      "id": "seam-multiplicity",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_seam_multiplicity.ts"],
      "owner": "architecture",
      "rationale": "Prevents new duplicate capability seams."
    },
    {
      "id": "capability-seams",
      "scope": "pr",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/generate_capability_seams.ts",
        "--check"
      ],
      "owner": "architecture",
      "rationale": "Checks capability seam registry coverage."
    },
    {
      "id": "capability-seams-ast",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_capability_seams_ast.ts"],
      "owner": "architecture",
      "rationale": "Checks capability seam adoption at the AST boundary."
    },
    {
      "id": "role-assumption-reachability",
      "scope": "pr",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/analyze_role_assumptions.ts",
        "--check"
      ],
      "timeout_ms": 240000,
      "owner": "security",
      "rationale": "Keeps the call-level role assumption reachability report (docs/developer/role-assumption-reachability.json) current; role-assumption-policy.json must grant every reachable role (RN-02/RN-03). Budget: it type-checks scripts/, libs/core/ and libs/actuators/ as one TypeScript program (about 32s CPU, 40-50s wall alone on a loaded 4-vCPU host, 2-3x that while `pnpm check` runs 6 gates at once), so the 120s default timed out on busy runs."
    },
    {
      "id": "reasoning-provider-registry",
      "scope": "pr",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/check_reasoning_provider_registry.ts"
      ],
      "owner": "operations",
      "rationale": "Keeps reasoning provider declarations aligned with the runtime registry."
    },
    {
      "id": "packaging-contract",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_packaging_contract.ts"],
      "owner": "quality",
      "rationale": "Checks package and artifact contracts after the build."
    },
    {
      "id": "script-integrity",
      "scope": "pr",
      "executable": "node",
      "args": ["dist/scripts/check_script_integrity.js"],
      "owner": "operations",
      "rationale": "Ensures declared script and pipeline references resolve on every built PR and full validation run."
    },
    {
      "id": "esm",
      "scope": "pr",
      "executable": "node",
      "args": ["dist/scripts/check_esm_integrity.js"],
      "owner": "quality",
      "rationale": "Checks runtime ESM integrity."
    },
    {
      "id": "dist-workspace-imports",
      "scope": "pr",
      "executable": "node",
      "args": ["dist/scripts/check_dist_workspace_imports.js"],
      "owner": "quality",
      "rationale": "Catches dist/presence, dist/satellites, and dist/scripts entry points whose bare imports resolve fine at typecheck time (via tsconfig paths, or a source package's own local node_modules) but are never linked into the shared root node_modules the compiled flat dist tree actually resolves from, so `node <entry>` fails with ERR_MODULE_NOT_FOUND at process startup. Covers both workspace-package imports (e.g. nexus-daemon and @actuator/service) and third-party imports declared as a real dependency somewhere in the repo (e.g. discord-bridge and discord.js)."
    },
    {
      "id": "catalogs",
      "scope": "full",
      "executable": "node",
      "args": ["dist/scripts/check_catalog_integrity.js"],
      "paths": [
        "knowledge/**",
        "libs/core/**",
        "presence/displays/**",
        "scripts/lib/pad-ui/**",
        "scripts/cli.ts",
        "scripts/check_catalog_integrity.ts",
        "scripts/generate_knowledge_index.ts",
        "scripts/design-token-utils.ts"
      ],
      "owner": "governance",
      "rationale": "Checks catalog and knowledge index integrity."
    },
    {
      "id": "facet-purity",
      "scope": "full",
      "executable": "node",
      "args": ["dist/scripts/check_facet_purity.js"],
      "paths": [
        "knowledge/product/facets/**",
        "libs/core/**/facet*",
        "scripts/check_facet_purity.ts"
      ],
      "owner": "quality",
      "rationale": "Checks facet purity boundaries."
    },
    {
      "id": "op-registry",
      "scope": "full",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/generate_op_registry.ts", "--check"],
      "paths": [
        "libs/actuators/**",
        "libs/core/actuator/**",
        "libs/core/actuator-manifest-index.ts",
        "libs/core/pipeline/op-input-contract*",
        "libs/core/pipeline/pipeline-contract.ts",
        "knowledge/product/governance/actuator-op-registry.json",
        "knowledge/product/orchestration/actuator-op-discovery.json",
        "knowledge/product/schemas/actuator-manifest.schema.json",
        "knowledge/product/schemas/actuator-op-registry.schema.json",
        "scripts/generate_op_registry.ts",
        ".prettierrc*"
      ],
      "owner": "operations",
      "rationale": "Checks actuator operation registry freshness."
    },
    {
      "id": "vocabulary-types",
      "scope": "full",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/generate_vocabulary_types.ts",
        "--check"
      ],
      "paths": [
        "knowledge/product/orchestration/user-facing-vocabulary.json",
        "knowledge/product/schemas/user-facing-vocabulary.schema.json",
        "libs/core/locale-normalize.ts",
        "libs/core/knowledge/vocabulary-*",
        "libs/shared-ui/vanilla/kyberion-ui-vocabulary.js",
        "scripts/generate_vocabulary_types.ts",
        ".prettierrc*"
      ],
      "owner": "experience",
      "rationale": "Checks generated vocabulary types."
    },
    {
      "id": "pseudo-locale",
      "scope": "full",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/generate_pseudo_locale.ts",
        "--check"
      ],
      "paths": [
        "knowledge/product/orchestration/user-facing-vocabulary.json",
        "knowledge/product/schemas/user-facing-vocabulary.schema.json",
        "libs/core/message-format.ts",
        "libs/core/knowledge/vocabulary-*",
        "scripts/generate_pseudo_locale.ts"
      ],
      "owner": "experience",
      "rationale": "Checks generated pseudo-locale output."
    },
    {
      "id": "deprecated-wisdom-ops",
      "scope": "full",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_deprecated_wisdom_ops.ts"],
      "paths": [
        "libs/actuators/wisdom-actuator/**",
        "pipelines/**",
        "knowledge/product/pipeline-templates/**",
        "scripts/check_deprecated_wisdom_ops.ts"
      ],
      "owner": "governance",
      "rationale": "Prevents retired Wisdom aliases in pipeline catalogs."
    },
    {
      "id": "wisdom-forwarders",
      "scope": "full",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_wisdom_forwarders.ts"],
      "paths": [
        "libs/actuators/wisdom-actuator/**",
        "libs/core/actuator/actuator-op-registry.ts",
        "knowledge/product/governance/actuator-op-registry.json",
        "knowledge/product/pipeline-templates/**",
        "scripts/check_wisdom_forwarders.ts"
      ],
      "owner": "operations",
      "rationale": "Checks Wisdom forwarder targets."
    },
    {
      "id": "changelog-fragments",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/assemble_changelog.ts", "--check"],
      "owner": "release",
      "rationale": "Validates changelog.d/ fragment format (category front-matter, list-item body) so PRs record user-visible changes without editing CHANGELOG.md (GF-02)."
    },
    {
      "id": "env-registry",
      "scope": "pr",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/generate_env_registry.ts",
        "--check"
      ],
      "owner": "operations",
      "rationale": "Checks environment registry freshness on every PR so new KYBERION_* names cannot land unregistered."
    },
    {
      "id": "knowledge-scope",
      "scope": "pr",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/check_knowledge_scope_boundaries.ts"
      ],
      "owner": "security",
      "rationale": "Checks tenant and knowledge scope boundaries."
    },
    {
      "id": "governance-rules",
      "scope": "full",
      "executable": "node",
      "args": ["dist/scripts/check_governance_rules.js"],
      "paths": ["knowledge/**", "libs/**", "scripts/**", "pipelines/**"],
      "owner": "governance",
      "rationale": "Checks governed catalog rules."
    },
    {
      "id": "work-scope-policy",
      "scope": "full",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_work_scope_policy.ts"],
      "paths": [
        "knowledge/product/governance/work-scope-policy.json",
        "knowledge/product/schemas/work-scope-policy.schema.json",
        "libs/core/workforce/work-scope-*",
        "scripts/check_work_scope_policy.ts"
      ],
      "owner": "governance",
      "rationale": "Checks mandatory work-scope policy emitters."
    },
    {
      "id": "mission-gate-docs",
      "scope": "full",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_mission_gate_docs.ts"],
      "paths": ["knowledge/**", "docs/**", "AGENTS.md", "scripts/check_mission_gate_docs.ts"],
      "owner": "governance",
      "rationale": "Checks canonical mission-gate documentation."
    },
    {
      "id": "design-contrast",
      "scope": "full",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_design_contrast.ts"],
      "paths": [
        "knowledge/public/design-patterns/**",
        "libs/core/**",
        "scripts/check_design_contrast.ts"
      ],
      "owner": "experience",
      "rationale": "Checks design contrast contracts."
    },
    {
      "id": "design-ledger",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_design_ledger.ts"],
      "owner": "experience",
      "rationale": "Checks design decision ledger integrity."
    },
    {
      "id": "chronos-dom-contrast",
      "scope": "full",
      "executable": "node",
      "args": [
        "--import",
        "./scripts/ts-loader.mjs",
        "scripts/check_chronos_dom_contrast.ts",
        "--start"
      ],
      "timeout_ms": 120000,
      "owner": "experience",
      "rationale": "Checks Chronos light, dark, and reduced-motion DOM contrast."
    },
    {
      "id": "ui-ux",
      "scope": "full",
      "executable": "node",
      "args": ["dist/scripts/check_ui_ux_governance.js"],
      "paths": [
        "presence/displays/**",
        "libs/shared-ui/**",
        "scripts/lib/pad-ui/**",
        "scripts/sovereign_dashboard.ts",
        "knowledge/public/design-patterns/**",
        "scripts/check_ui_ux_governance.ts"
      ],
      "owner": "experience",
      "rationale": "Checks shared UI and UX governance."
    },
    {
      "id": "i18n",
      "scope": "pr",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/check_i18n_hardcoding.ts"],
      "baseline": "knowledge/product/governance/i18n-baseline.json",
      "owner": "experience",
      "rationale": "Checks internationalization hardcoding ratchets: Japanese literals, Japanese intent regexes, ad-hoc locale comparisons and tags, and raw colour literals in artifact engines."
    },
    {
      "id": "intent-domain-coverage",
      "scope": "full",
      "executable": "node",
      "args": ["dist/scripts/check_intent_domain_coverage.js"],
      "paths": [
        "libs/core/**",
        "libs/actuators/*/manifest.json",
        "knowledge/product/governance/**",
        "knowledge/product/orchestration/**",
        "scripts/check_intent_domain_coverage.ts"
      ],
      "owner": "intent",
      "rationale": "Checks intent domain coverage."
    },
    {
      "id": "contract-schemas",
      "scope": "full",
      "executable": "node",
      "args": ["dist/scripts/check_contract_schemas.js"],
      "paths": [
        "knowledge/**",
        "pipelines/**",
        "docs/operator/**",
        "libs/core/**",
        "scripts/check_contract_schemas*.ts",
        "scripts/deny-secret-hook.js"
      ],
      "owner": "quality",
      "rationale": "Checks contract schema coverage and validity."
    },
    {
      "id": "pii-rules",
      "scope": "full",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/generate_pii_rules.ts", "--check"],
      "paths": [
        "knowledge/product/governance/knowledge-sync-rules.json",
        "knowledge/product/schemas/knowledge-sync-rules.schema.json",
        "libs/core/pii-scrubber.ts",
        "tools/*/pii-rules.generated.js",
        "scripts/generate_pii_rules.ts"
      ],
      "owner": "security",
      "rationale": "Checks generated PII rules."
    },
    {
      "id": "eval-distill",
      "scope": "full",
      "executable": "node",
      "args": ["--import", "./scripts/ts-loader.mjs", "scripts/eval_distill.ts"],
      "paths": ["libs/core/**", "eval/**", "scripts/eval_distill.ts"],
      "owner": "quality",
      "rationale": "Runs the deterministic distill evaluation."
    },
    {
      "id": "contract-semver",
      "scope": "pr",
      "executable": "node",
      "args": ["dist/scripts/check_contract_semver.js"],
      "baseline": "scripts/contract-baseline.json",
      "owner": "quality",
      "rationale": "Checks actuator contract semver compatibility on every PR so manifest/schema bumps cannot skip rebaseline."
    },
    {
      "id": "pipeline-shell-independence",
      "scope": "full",
