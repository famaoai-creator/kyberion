{
  "$schema": "../schemas/event-intake-policy.schema.json",
  "version": "1.0.0",
  "description": "DL-08 inbound event sources for scripts/event_intake_surface.ts. Every source is disabled by default; enabling one requires the HMAC secret under secret_key in the secret store. tenant_slug binds a source to one tenant (events land under the tenant namespace and only that tenant's dots see them).",
  "sources": {
    "github": {
      "enabled": false,
      "description": "GitHub webhooks (X-Hub-Signature-256).",
      "signature_header": "x-hub-signature-256",
      "prefix": "sha256=",
      "secret_key": "EVENT_INTAKE_GITHUB_SECRET",
      "event_type_header": "x-github-event",
      "delivery_id_header": "x-github-delivery",
      "max_body_bytes": 262144
    },
    "ci": {
      "enabled": false,
      "description": "Generic CI notifier signing the raw body with HMAC-SHA256.",
      "signature_header": "x-kyberion-signature",
      "prefix": "sha256=",
      "secret_key": "EVENT_INTAKE_CI_SECRET",
      "event_type_header": "x-kyberion-event",
      "delivery_id_header": "x-kyberion-delivery",
      "max_body_bytes": 65536
    },
    "email": {
      "enabled": false,
      "description": "Inbound-mail relay webhook (parsed message JSON).",
      "signature_header": "x-kyberion-signature",
      "prefix": "sha256=",
      "secret_key": "EVENT_INTAKE_EMAIL_SECRET",
      "event_type_header": "x-kyberion-event",
      "delivery_id_header": "x-kyberion-delivery",
      "max_body_bytes": 131072
    },
    "custom": {
      "enabled": false,
      "description": "Operator-defined sender using the Kyberion signature headers.",
      "signature_header": "x-kyberion-signature",
      "prefix": "sha256=",
      "secret_key": "EVENT_INTAKE_CUSTOM_SECRET",
      "event_type_header": "x-kyberion-event",
      "delivery_id_header": "x-kyberion-delivery",
      "max_body_bytes": 65536
    }
  }
}
