{
  "$schema": "../../schemas/seam-provider-selection-policy.schema.json",
  "version": "1.0.0",
  "seams": [
    {
      "seam_id": "secret-provider",
      "default_provider": "mac_keychain",
      "fallback_purpose": "protect",
      "traits": {
        "protection": "Strength of the at-rest store (OS keychain > file with private modes > env).",
        "zero_config": "Works with no operator opt-in or extra configuration.",
        "portability": "Works across platforms and in headless environments."
      },
      "providers": {
        "hashicorp_vault": {
          "traits": {
            "protection": 1,
            "zero_config": 0,
            "portability": 1
          },
          "trait_basis": {
            "protection": "declared",
            "zero_config": "declared",
            "portability": "declared"
          },
          "evidence": [
            "libs/core/secret/external-secret-providers.ts (HashiCorpVaultSecretProvider: KV v2 over governed secureFetch, check-and-set writes; opt-in via KYBERION_VAULT_ADDR + KYBERION_VAULT_TOKEN)"
          ]
        },
        "aws_secrets_manager": {
          "traits": {
            "protection": 1,
            "zero_config": 0,
            "portability": 0.8
          },
          "trait_basis": {
            "protection": "declared",
            "zero_config": "declared",
            "portability": "declared"
          },
          "evidence": [
            "libs/core/secret/external-secret-providers.ts (CliSecretProvider over `aws secretsmanager get-secret-value`, read-only; opt-in via KYBERION_AWS_SECRETS_PREFIX)"
          ]
        },
        "gcp_secret_manager": {
          "traits": {
            "protection": 1,
            "zero_config": 0,
            "portability": 0.8
          },
          "trait_basis": {
            "protection": "declared",
            "zero_config": "declared",
            "portability": "declared"
          },
          "evidence": [
            "libs/core/secret/external-secret-providers.ts (CliSecretProvider over `gcloud secrets versions access`, read-only; opt-in via KYBERION_GCP_SECRETS_PROJECT)"
          ]
        },
        "onepassword": {
          "traits": {
            "protection": 1,
            "zero_config": 0,
            "portability": 0.8
          },
          "trait_basis": {
            "protection": "declared",
            "zero_config": "declared",
            "portability": "declared"
          },
          "evidence": [
            "libs/core/secret/external-secret-providers.ts (CliSecretProvider over `op read`, read-only; opt-in via KYBERION_1PASSWORD_VAULT)"
          ]
        },
        "mac_keychain": {
          "traits": {
            "protection": 1,
            "zero_config": 1,
            "portability": 0.3
          },
          "trait_basis": {
            "protection": "declared",
            "zero_config": "declared",
            "portability": "declared"
          },
          "evidence": [
            "libs/core/secret/secret-bridge.ts (MacKeychainSecretProvider: macOS `security` CLI + Swift SecItem writes, trusted-reader ACL)"
          ]
        },
        "windows_credential_manager": {
          "traits": {
            "protection": 1,
            "zero_config": 1,
            "portability": 0.3
          },
          "trait_basis": {
            "protection": "declared",
            "zero_config": "declared",
            "portability": "declared"
          },
          "evidence": [
            "libs/core/secret/secret-bridge.ts (WindowsCredentialManagerSecretProvider: Win32 CredRead/CredWrite via PowerShell, stdin transport)"
          ]
        },
        "file_secrets": {
          "traits": {
            "protection": 0.4,
            "zero_config": 0.2,
            "portability": 1
          },
          "trait_basis": {
            "protection": "declared",
            "zero_config": "declared",
            "portability": "declared"
          },
          "evidence": [
            "libs/core/secret/secret-bridge.ts (FileSecretProvider: opt-in via KYBERION_ALLOW_FILE_SECRETS, 0700 dir / 0600 file modes, symlink refusal)"
          ]
        },
        "env_secrets": {
          "traits": {
            "protection": 0.2,
            "zero_config": 1,
            "portability": 1
          },
          "trait_basis": {
            "protection": "declared",
            "zero_config": "declared",
            "portability": "declared"
          },
          "evidence": [
            "libs/core/secret/secret-bridge.ts (EnvSecretProvider: SECRET_<SERVICE>_<ACCOUNT> process env, always available)"
          ]
        }
      },
      "default_chains": {
        "default": [
          "hashicorp_vault",
          "aws_secrets_manager",
          "gcp_secret_manager",
          "onepassword",
          "mac_keychain",
          "windows_credential_manager",
          "file_secrets",
          "env_secrets"
        ]
      },
      "purposes": {
        "protect": {
          "description": "Strongest at-rest protection first — OS keychain before file/env fallbacks.",
          "weights": {
            "protection": 0.8,
            "zero_config": 0.2
          }
        },
        "portable": {
          "description": "Headless / cross-platform resolution where OS keychains may be absent.",
          "weights": {
            "portability": 0.7,
            "zero_config": 0.3
          }
        }
      }
    }
  ]
}
