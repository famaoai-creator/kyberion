{
  "$schema": "../schemas/approval-policy.schema.json",
  "version": "1.2.0",
  "separation_of_duties": {
    "enabled": false
  },
  "assurance_mode": "warn",
  "passkey_enrollment_cooldown_hours": 24,
  "rules": [
    {
      "id": "service-mutation",
      "intent_ids": ["inspect-service"],
      "when": {
        "payload_field": "operation",
        "any_of": ["restart", "start", "stop"]
      },
      "requires_approval": true,
      "missing_requirements": ["approval_confirmation"]
    },
    {
      "id": "secret-grant-access",
      "intent_ids": ["secret:grant_access"],
      "requires_approval": true,
      "missing_requirements": ["dual_key_confirmation"],
      "charter_eligible": false,
      "min_assurance": "A3"
    },
    {
      "id": "auth-grant-authority",
      "intent_ids": ["auth:grant_authority"],
      "requires_approval": true,
      "missing_requirements": ["dual_key_confirmation"],
      "charter_eligible": false,
      "min_assurance": "A3"
    },
    {
      "id": "config-policy-update",
      "intent_ids": ["config:update"],
      "when": {
        "payload_field": "scope",
        "any_of": ["governance", "policy", "review_gate"]
      },
      "requires_approval": true,
      "missing_requirements": ["approval_confirmation"],
      "min_assurance": "A3"
    },
    {
      "id": "vault-direct-write",
      "intent_ids": ["vault:write"],
      "requires_approval": true,
      "missing_requirements": ["dual_key_confirmation"],
      "charter_eligible": false,
      "min_assurance": "A3"
    },
    {
      "id": "claude-browser-interactive",
      "intent_ids": ["claude:browser_interactive"],
      "requires_approval": true,
      "missing_requirements": ["approval_confirmation"]
    },
    {
      "id": "claude-document-generation",
      "intent_ids": ["claude:document_generation"],
      "requires_approval": true,
      "missing_requirements": ["approval_confirmation"]
    },
    {
      "id": "browser-extension-execute",
      "intent_ids": ["browser:extension_execute"],
      "requires_approval": true,
      "missing_requirements": ["approval_confirmation"]
    },
    {
      "id": "desktop-destructive-action",
      "intent_ids": ["desktop:destructive_action"],
      "requires_approval": true,
      "missing_requirements": ["approval_confirmation"]
    },
    {
      "id": "ingress-expose",
      "intent_ids": ["ingress:expose"],
      "requires_approval": true,
      "missing_requirements": ["approval_confirmation"]
    },
    {
      "id": "customer-outbound-send",
      "intent_ids": ["customer:outbound"],
      "requires_approval": true,
      "missing_requirements": ["approval_confirmation"]
    },
    {
      "id": "security-audit-deliver",
      "intent_ids": ["security-audit-service", "security-audit:deliver"],
      "requires_approval": true,
      "missing_requirements": ["approval_confirmation"]
    },
    {
      "id": "feature-expansion-release",
      "intent_ids": ["feature-expansion-delivery", "feature-expansion:release"],
      "requires_approval": true,
      "missing_requirements": ["approval_confirmation"]
    },
    {
      "id": "decision-rights-escalation",
      "when": {
        "payload_field": "decision_type",
        "any_of": [
          "operational_spend",
          "contract_signature",
          "headcount_expansion",
          "quote_issuance",
          "expense_reimbursement",
          "vendor_invoice_payment",
          "meeting_scheduling",
          "external_reply",
          "public_announcement",
          "access_grant",
          "internal_task_assignment",
          "internal_document_approval"
        ]
      },
      "requires_approval": true,
      "missing_requirements": ["approval_confirmation"]
    }
  ],
  "fallback_rules": [
    {
      "id": "fallback-dangerous-shell",
      "intent_id_pattern": "shell|command|exec|run_shell|bash",
      "payload_patterns": [
        {
          "fields": ["command", "cmd", "script"],
          "pattern": "(?:rm\\s+-rf|curl\\s+.*\\|\\s*(?:sh|bash|zsh|fish)|wget\\s+.*\\|\\s*(?:sh|bash|zsh|fish)|base64\\s+-(?:d|decode)|eval\\s|\\bexec\\s*\\()"
        }
      ],
      "missing_requirements": ["approval_confirmation"],
      "charter_eligible": false
    },
    {
      "id": "fallback-dangerous-egress",
      "intent_id_pattern": "egress|network|http|https|fetch|request",
      "payload_present_fields": ["url", "base_url"],
      "missing_requirements": ["approval_confirmation"],
      "charter_eligible": false
    },
    {
      "id": "fallback-dangerous-secret",
      "intent_id_pattern": "secret|vault:write|auth:grant|credential|token|password",
      "missing_requirements": ["dual_key_confirmation"],
      "charter_eligible": false
    },
    {
      "id": "fallback-dangerous-deploy",
      "intent_id_pattern": "deploy|release|publish|production|restart|stop|start|delete|destroy|remove",
      "payload_patterns": [
        {
          "fields": ["operation", "action"],
          "pattern": "(?:restart|stop|start|delete|destroy|remove|wipe|purge)"
        }
      ],
      "missing_requirements": ["approval_confirmation"],
      "charter_eligible": false
    }
  ],
  "defaults": {
    "requires_approval": false
  }
}
