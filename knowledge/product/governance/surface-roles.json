{
  "$schema": "../schemas/surface-roles.schema.json",
  "version": "1.0.0",
  "description": "UI サーフェスの役割定義。各サーフェスは1つの明確な役割を持ち、ヘッダに tagline_ja を表示する。surface-responsibility-model.md / docs/SURFACES.md と対応。writes は 'full'|'scoped'|'none'|'orchestrator' のいずれか。'orchestrator' は SO-03 で追加した語彙で、OrchestratorSession + mission-ownership work-item claim を経由してミッション所有者権限を持てるサーフェスを表す(multi-provider-coexecution-contract.md の「Surface orchestrator sessions」節を参照)。この時点ではどの既存ロールの値も変更しない — 語彙のみを追加し、各サーフェスの opt-in は今後の変更で行う。port と enabled はサーフェス manifest(surfaces/*.json。ランタイムが読む正本)と一致させる(tests/surface-registry-consistency.test.ts が検査)。chronos-mirror-v2 は転送アプリで、その tagline_key は移設先の運用コンソール(concierge /ops)が描画する tagline を指す。",
  "roles": [
    {
      "id": "concierge",
      "name_ja": "秘書室",
      "name_en": "Concierge",
      "role_ja": "CEO秘書",
      "tagline_ja": "CEO秘書 — 依頼・承認・成果・例外",
      "metaphor": "executive secretary",
      "dir": "presence/displays/concierge",
      "port": 3050,
      "writes": "scoped",
      "tagline_key": "surface:concierge_surface_tagline",
      "enabled": true
    },
    {
      "id": "presence-studio",
      "name_ja": "スタジオ",
      "name_en": "Presence Studio",
      "role_ja": "相棒",
      "tagline_ja": "相棒 — いっしょに作業するワークベンチ",
      "metaphor": "companion (Doraemon / R2-D2)",
      "dir": "presence/displays/presence-studio",
      "port": 3031,
      "writes": "full",
      "tagline_key": "surface:presence_studio_surface_tagline",
      "enabled": true
    },
    {
      "id": "chronos-mirror-v2",
      "name_ja": "旧運用画面(転送)",
      "name_en": "Chronos Mirror (redirect)",
      "role_ja": "互換リダイレクト",
      "tagline_ja": "運用コンソールは秘書室の /ops へ移りました。旧 URL を転送します。",
      "tagline_key": "surface:chronos_surface_tagline",
      "metaphor": "compatibility redirect",
      "dir": "presence/displays/chronos-mirror-v2",
      "port": 3000,
      "writes": "none",
      "enabled": true
    },
    {
      "id": "operator-surface",
      "name_ja": "監査モニタ",
      "name_en": "Operator Surface",
      "role_ja": "監査モニタ",
      "tagline_ja": "監査モニタ（読み取り専用）",
      "metaphor": "audit monitor",
      "dir": "presence/displays/operator-surface",
      "port": 3331,
      "writes": "none",
      "tagline_key": "surface:operator_surface_tagline",
      "enabled": false
    },
    {
      "id": "computer-surface",
      "name_ja": "手元ミラー",
      "name_en": "Computer Surface",
      "role_ja": "作業の手元ミラー",
      "tagline_ja": "作業の手元ミラー — ブラウザ/ターミナルの現在の手元",
      "metaphor": "hands mirror",
      "dir": "presence/displays/computer-surface",
      "port": 3040,
      "writes": "none",
      "tagline_key": "surface:computer_surface_tagline",
      "enabled": true
    },
    {
      "id": "customer-room",
      "name_ja": "お客様ルーム",
      "name_en": "Customer Room",
      "role_ja": "お客様向けの決定画面",
      "tagline_ja": "お客様への確認・ご決定のお願い",
      "metaphor": "customer decision room",
      "dir": "presence/displays/customer-room",
      "port": 3046,
      "writes": "scoped",
      "enabled": false
    }
  ]
}
