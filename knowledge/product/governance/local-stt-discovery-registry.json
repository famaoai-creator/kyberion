{
  "$schema": "../schemas/local-stt-discovery-registry.schema.json",
  "version": "1.0.0",
  "backends": [
    {
      "backend_id": "whisperkit_cli",
      "display_name": "WhisperKit CLI",
      "status": "active",
      "priority": 100,
      "platforms": ["darwin"],
      "source": "os-path",
      "verification": "executable",
      "probe": {
        "kind": "executable",
        "commands": ["whisperkit-cli", "argmax-cli"],
        "version_args": ["--version"]
      },
      "connection": {
        "stt_backend": "whisperkit_cli",
        "whisperkit_cli_path": "{{executable}}",
        "whisper_cli_path": "{{executable}}",
        "stt_source": "{{source}}",
        "stt_local_only": true
      },
      "detail": "WhisperKit CLI found through PATH; valid symlinked package-manager paths are supported."
    },
    {
      "backend_id": "mlx_whisper",
      "display_name": "Managed MLX Whisper",
      "status": "active",
      "priority": 90,
      "platforms": ["any"],
      "source": "managed-runtime",
      "verification": "python-module",
      "probe": {
        "kind": "managed_python_module",
        "commands": ["mlx_whisper"],
        "module": "mlx_whisper",
        "tool_id": "mlx_whisper"
      },
      "connection": {
        "stt_backend": "mlx_whisper",
        "whisper_python_bin": "{{python_bin}}",
        "stt_source": "{{source}}",
        "stt_local_only": true
      },
      "detail": "mlx_whisper is importable from the governed managed runtime."
    },
    {
      "backend_id": "mlx_whisper",
      "display_name": "MLX Whisper",
      "status": "active",
      "priority": 80,
      "platforms": ["any"],
      "source": "os-python",
      "verification": "python-module",
      "probe": {
        "kind": "python_module",
        "commands": ["python3", "python3.14", "python3.13", "python3.12", "python3.11", "python"],
        "module": "mlx_whisper"
      },
      "connection": {
        "stt_backend": "mlx_whisper",
        "whisper_python_bin": "{{python_bin}}",
        "stt_source": "{{source}}",
        "stt_local_only": true
      },
      "detail": "mlx_whisper is importable from an OS Python installation."
    },
    {
      "backend_id": "apple_speech_file",
      "display_name": "Apple Speech file bridge",
      "status": "active",
      "priority": 50,
      "platforms": ["darwin"],
      "source": "os-native",
      "verification": "native-script",
      "probe": {
        "kind": "native_script",
        "commands": ["swift"],
        "script_path": "satellites/voice-hub/native-stt.swift",
        "version_args": ["--version"]
      },
      "connection": {
        "stt_backend": "apple_speech_file",
        "apple_speech_available": true,
        "stt_source": "{{source}}",
        "stt_local_only": true
      },
      "detail": "Kyberion native Apple Speech file bridge is available; permissions and model readiness are checked at use time."
    }
  ]
}
