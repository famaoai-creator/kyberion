{
  "version": "1.0.0",
  "backends": [
    {
      "kind": "service_preset",
      "provider": "comfyui",
      "status": "active",
      "platforms": ["any"],
      "supports": {
        "artifact_formats": ["mp3", "flac"],
        "async": true
      },
      "service_id": "media-generation",
      "probe": {
        "kind": "service_runtime",
        "ref": "comfyui"
      },
      "cost_tier": "self_hosted",
      "data_policy": "local_only",
      "execution_locality": "local",
      "backend_id": "media-generation.comfyui.ace-step-music",
      "modality": "music",
      "display_name": "ComfyUI ACE-Step Vocal Music",
      "action": "generate_music",
      "fallback_backend_id": "media-generation.comfyui.music",
      "min_memory_gb": 12,
      "notes": "ACE-Step 1.5 turbo vocal music (UNETLoader+DualCLIP qwen). Supports tags/lyrics/bpm/duration/language/keyscale.",
      "accelerators": ["mps", "cuda", "cpu"]
    }
  ],
  "default_backend_ids": {
    "image": "media-generation.comfyui",
    "voice": "voice.local_say",
    "video": "video.hyperframes_cli",
    "music": "media-generation.comfyui.music"
  }
}
