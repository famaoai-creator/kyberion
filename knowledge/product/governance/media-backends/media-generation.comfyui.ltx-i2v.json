{
  "version": "1.0.0",
  "backends": [
    {
      "kind": "service_preset",
      "provider": "comfyui",
      "status": "active",
      "platforms": ["any"],
      "supports": {
        "artifact_formats": ["mp4"],
        "async": true
      },
      "service_id": "media-generation",
      "probe": {
        "kind": "service_runtime",
        "ref": "comfyui"
      },
      "cost_tier": "self_hosted",
      "data_policy": "local_only",
      "execution_locality": "local",
      "backend_id": "media-generation.comfyui.ltx-i2v",
      "modality": "video",
      "display_name": "ComfyUI LTX-Video 2B image-to-video",
      "action": "generate_video",
      "fallback_backend_id": "media-generation.comfyui.ltx-i2v-fp8",
      "min_memory_gb": 24,
      "notes": "LTX-Video 2B fp16 + t5xxl_fp16 (~18GB peak). Use first_frame_image + motion prompt; low-memory hosts use ltx-i2v-fp8."
    }
  ],
  "default_backend_ids": {
    "image": "media-generation.comfyui",
    "voice": "voice.local_say",
    "video": "video.hyperframes_cli",
    "music": "media-generation.comfyui.music"
  }
}
