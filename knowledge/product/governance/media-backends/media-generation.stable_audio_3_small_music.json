{
  "version": "1.0.0",
  "default_backend_ids": {
    "image": "media-generation.comfyui",
    "voice": "voice.local_say",
    "video": "video.hyperframes_cli",
    "music": "media-generation.comfyui.music"
  },
  "backends": [
    {
      "backend_id": "media-generation.stable_audio_3_small_music",
      "modality": "music",
      "display_name": "Local Stable Audio 3 Small-Music",
      "kind": "cli",
      "provider": "stable_audio_3",
      "probe_adapter_id": "tool_runtime",
      "runtime_id": "stable_audio_3",
      "status": "active",
      "platforms": ["any"],
      "supports": {
        "artifact_formats": ["wav"],
        "async": false
      },
      "command": "uvx",
      "args": ["--from", "git+https://github.com/Stability-AI/stable-audio-3.git", "stable-audio"],
      "cost_tier": "self_hosted",
      "data_policy": "local_only",
      "execution_locality": "local",
      "fallback_backend_id": "media-generation.musicgen_mlx",
      "notes": "Stable Audio 3 small-music via tool runtime (CPU/MPS friendly, up to ~120s). Hugging Face gated weights require HF_TOKEN. Tuned via KYBERION_STABLE_AUDIO_*. Install: uv tool install git+https://github.com/Stability-AI/stable-audio-3.git."
    }
  ]
}
