{
  "version": "1.0.0",
  "default_backend_ids": {
    "image": "media-generation.local_flux",
    "voice": "voice.local_say",
    "video": "video.hyperframes_cli",
    "music": "media-generation.acestep-cpp"
  },
  "backends": [
    {
      "backend_id": "media-generation.local_flux",
      "modality": "image",
      "display_name": "Local FLUX Image Generation",
      "kind": "cli",
      "provider": "mflux",
      "status": "active",
      "platforms": ["darwin"],
      "supports": {
        "artifact_formats": ["png", "jpg", "jpeg", "webp"],
        "async": false
      },
      "command": "uvx",
      "args": ["--from", "mflux", "mflux-generate"],
      "aliases": ["local_flux"],
      "probe": { "kind": "tool_runtime", "ref": "mflux" },
      "cost_tier": "self_hosted",
      "data_policy": "local_only",
      "execution_locality": "local",
      "fallback_backend_id": "media-generation.comfyui",
      "min_memory_gb": 14,
      "accelerators": ["mlx"],
      "notes": "Apple Silicon local FLUX generation via mflux (4-bit MLX). ~95s/image, peak ~14GB; verified local-media-generation-hardware-findings. Tuned via KYBERION_MFLUX_* env policy."
    }
  ]
}
