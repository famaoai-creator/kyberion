{
  "version": "1.0.0",
  "backends": [
    {
      "kind": "service_preset",
      "provider": "comfyui",
      "status": "active",
      "platforms": ["any"],
      "supports": {
        "artifact_formats": ["mp4"],
        "async": true
      },
      "service_id": "media-generation",
      "probe": {
        "kind": "service_runtime",
        "ref": "comfyui"
      },
      "cost_tier": "self_hosted",
      "data_policy": "local_only",
      "execution_locality": "local",
      "backend_id": "media-generation.comfyui.ltx-i2v-fp8",
      "modality": "video",
      "display_name": "ComfyUI LTX-Video 2B i2v (fp8)",
      "action": "generate_video",
      "fallback_backend_id": "video.hyperframes_cli",
      "min_memory_gb": 16,
      "notes": "GGUF q8 LTX-Video + t5xxl_fp8 text encoder. ~12GB peak on unified-memory hosts.",
      "accelerators": ["mps", "cuda"]
    }
  ],
  "default_backend_ids": {
    "image": "media-generation.comfyui",
    "voice": "voice.local_say",
    "video": "video.hyperframes_cli",
    "music": "media-generation.comfyui.music"
  }
}
