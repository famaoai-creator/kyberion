{
  "version": "1.0.0",
  "default_backend_ids": {
    "image": "media-generation.local_flux",
    "voice": "voice.local_say",
    "video": "video.hyperframes_cli",
    "music": "media-generation.acestep-cpp"
  },
  "backends": [
    {
      "accelerators": ["mlx"],
      "aliases": ["chatmusician_mlx", "media-generation.chatmusician_mlx"],
      "args": ["--from", "mlx-lm", "mlx_lm.generate"],
      "backend_id": "media-generation.chatmusician_mlx",
      "command": "uvx",
      "cost_tier": "self_hosted",
      "data_policy": "local_only",
      "display_name": "ChatMusician Composition (MLX)",
      "execution_locality": "local",
      "fallback_backend_id": "media-generation.musicgen_mlx",
      "kind": "cli",
      "modality": "music",
      "notes": "ChatMusician ABC composition via mlx-lm, rendered to WAV with abcmidi + fluid-synth and a configured .sf2 SoundFont (KYBERION_CHATMUSICIAN_SOUNDFONT). Full-length structured composition; instrumental render only. Weights follow the Llama 2 Community License. Tuned via KYBERION_CHATMUSICIAN_*.",
      "platforms": ["darwin"],
      "probe": {
        "kind": "tool_runtime",
        "ref": "chatmusician_mlx"
      },
      "provider": "chatmusician_mlx",
      "status": "active",
      "supports": {
        "artifact_formats": ["wav"],
        "async": false
      }
    }
  ]
}
