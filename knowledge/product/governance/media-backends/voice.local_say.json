{
  "version": "1.0.0",
  "default_backend_ids": {
    "image": "media-generation.local_flux",
    "voice": "voice.local_say",
    "video": "video.hyperframes_cli",
    "music": "media-generation.acestep-cpp"
  },
  "backends": [
    {
      "backend_id": "voice.local_say",
      "modality": "voice",
      "display_name": "Local System TTS",
