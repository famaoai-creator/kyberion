{
  "version": "1.0.0",
  "default_backend_ids": {
    "image": "media-generation.local_flux",
    "voice": "voice.local_say",
    "video": "video.hyperframes_cli",
    "music": "media-generation.acestep-cpp"
  },
  "backends": [
    {
      "aliases": ["musicgen_audiogen", "media-generation.musicgen_audiogen"],
      "args": ["--from", "mlx-audiogen", "mlx-audiogen"],
      "backend_id": "media-generation.musicgen_audiogen",
      "command": "uvx",
      "cost_tier": "self_hosted",
      "data_policy": "local_only",
      "display_name": "Local MusicGen Variants (MLX AudioGen)",
      "execution_locality": "local",
      "fallback_backend_id": "media-generation.musicgen_mlx",
      "kind": "cli",
      "modality": "music",
      "notes": "Apple Silicon MusicGen mono/stereo/melody variants via mlx-audiogen tool runtime. KYBERION_MUSAUDIOGEN_MODEL maps to a registry variant short name passed as --weights-dir (auto-downloaded); explicit KYBERION_MUSAUDIOGEN_WEIGHTS_DIR wins. Weights are CC BY-NC. Tuned via KYBERION_MUSAUDIOGEN_*. Install: uv tool install mlx-audiogen (or trial via uvx).",
      "platforms": ["darwin"],
      "probe": {
        "kind": "tool_runtime",
        "ref": "musicgen_audiogen"
      },
      "provider": "musicgen_audiogen",
      "status": "active",
      "supports": {
        "artifact_formats": ["wav"],
        "async": false
      }
    }
  ]
}
