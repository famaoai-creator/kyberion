{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "opencode-cli",
      "provider": "opencode",
      "module": "./reasoning/reasoning-cli-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text"]
      },
      "env_keys": ["OPENCODE_CLI", "OPENCODE_VERSION", "KYBERION_OPENCODE_CLI_BIN"],
      "cost_tier": "free",
      "transport": "cli",
      "data_egress": "external-api",
      "adapter": "provider-cli",
      "profile": {
        "streaming": false,
        "tool_calling": true,
        "native_subagent": false,
        "thinking_levels": {
          "low": "low",
          "medium": "medium",
          "high": "high"
        },
        "supports_strict_tools": false,
        "supports_grammar_tools": false,
        "utility_fit": ["judge", "classify", "summarize", "divergent"]
      },
      "model_vendor": "opencode",
      "endpoint": "https://opencode.ai",
      "egress_provider_id": "opencode",
      "model_env_keys": ["KYBERION_OPENCODE_CLI_MODEL"],
      "cli": {
        "binary": "opencode",
        "version_args": ["--version"],
        "help_args": ["--help"],
        "bin_env_key": "KYBERION_OPENCODE_CLI_BIN",
        "discovery": true,
        "sandbox": {
          "args": ["run", "--format", "json", "{permission_args}", "{prompt}"]
        },
        "install": {
          "npm_package": "opencode-ai",
          "brew_formula": "opencode",
          "hint": "npm install --prefix <managed-env> --no-save opencode-ai"
        },
        "capability_probe": {
          "binary_args": ["--version"],
          "auth_args": ["auth", "list"],
          "headless": true,
          "structured_output": true,
          "sandbox_flags": {
            "args": ["--help"],
            "expected_flags": ["--agent", "--format"]
          }
        },
        "permission_profiles": {
          "implementer": {
            "args": ["--agent", "build"],
            "notes": "OpenCode CLI implementer tier runs on the build agent with the full tool set."
          },
          "explorer": {
            "args": ["--agent", "plan"],
            "notes": "OpenCode CLI explorer tier runs on the read-only-leaning plan agent."
          },
          "planner": {
            "args": ["--agent", "plan"],
            "notes": "OpenCode CLI planner tier runs on the plan agent without --auto approval."
          }
        }
      }
    }
  ]
}
