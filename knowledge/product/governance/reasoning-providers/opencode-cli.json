{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "opencode-cli",
      "provider": "opencode",
      "module": "./reasoning-cli-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text"]
      },
      "env_keys": ["OPENCODE_CLI", "OPENCODE_VERSION", "KYBERION_OPENCODE_CLI_BIN"],
      "cost_tier": "free"
    }
  ]
}
