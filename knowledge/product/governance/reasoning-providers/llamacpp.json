{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "llamacpp",
      "provider": "llamacpp",
      "module": "./reasoning/reasoning-openai-compatible-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text"]
      },
      "env_keys": ["KYBERION_LLAMACPP_URL"],
      "secret_refs": [
        {
          "service_id": "llamacpp",
          "secret_key": "API_KEY",
          "env_keys": ["KYBERION_LLAMACPP_KEY"]
        },
        {
          "service_id": "local-llm",
          "secret_key": "API_KEY",
          "env_keys": ["KYBERION_LOCAL_LLM_KEY"]
        }
      ],
      "cost_tier": "free",
      "transport": "local-server",
      "data_egress": "local-only",
      "adapter": "openai-compatible",
      "openai_compatible_preset": "llamacpp",
      "profile": {
        "streaming": true,
        "tool_calling": true,
        "native_subagent": false,
        "thinking_levels": {},
        "supports_strict_tools": false,
        "supports_grammar_tools": false,
        "utility_fit": ["classify", "summarize"]
      },
      "model_env_keys": ["KYBERION_LLAMACPP_MODEL", "KYBERION_LOCAL_LLM_MODEL"]
    }
  ]
}
