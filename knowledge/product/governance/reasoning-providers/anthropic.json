{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "anthropic",
      "provider": "anthropic",
      "module": "./reasoning-api-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text", "image"]
      },
      "env_keys": ["ANTHROPIC_API_KEY"]
    }
  ]
}
