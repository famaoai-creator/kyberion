{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "anthropic",
      "provider": "anthropic",
      "module": "./reasoning/reasoning-api-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text", "image"]
      },
      "env_keys": ["ANTHROPIC_API_KEY"],
      "secret_refs": [
        { "service_id": "anthropic", "secret_key": "API_KEY", "env_keys": ["ANTHROPIC_API_KEY"] }
      ],
      "cost_tier": "metered",
      "transport": "api",
      "data_egress": "external-api",
      "adapter": "anthropic-api",
      "profile": {
        "streaming": false,
        "tool_calling": true,
        "native_subagent": false,
        "thinking_levels": {
          "low": "low",
          "medium": "medium",
          "high": "high"
        },
        "supports_strict_tools": false,
        "supports_grammar_tools": false,
        "utility_fit": ["judge", "classify", "summarize", "divergent"]
      },
      "model_vendor": "anthropic",
      "endpoint": "https://api.anthropic.com",
      "model_env_keys": ["KYBERION_ANTHROPIC_MODEL", "KYBERION_CLAUDE_MODEL"],
      "setup_hint": "Configure ANTHROPIC_API_KEY."
    }
  ]
}
