{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "devin-cli",
      "provider": "devin",
      "module": "./reasoning/reasoning-cli-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text"]
      },
      "env_keys": [
        "DEVIN_MODEL",
        "DEVIN_PERMISSION_MODE",
        "DEVIN_SANDBOX",
        "KYBERION_DEVIN_CLI_BIN"
      ],
      "cost_tier": "free",
      "transport": "cli",
      "data_egress": "external-api",
      "adapter": "provider-cli",
      "profile": {
        "streaming": false,
        "tool_calling": true,
        "native_subagent": false,
        "thinking_levels": {
          "low": "low",
          "medium": "medium",
          "high": "high"
        },
        "supports_strict_tools": false,
        "supports_grammar_tools": false,
        "utility_fit": ["judge", "classify", "summarize", "divergent"]
      },
      "model_vendor": "devin",
      "endpoint": "https://api.devin.ai",
      "egress_provider_id": "devin",
      "model_env_keys": ["KYBERION_DEVIN_CLI_MODEL"],
      "cli": {
        "binary": "devin",
        "version_args": ["--version"],
        "help_args": ["--help"],
        "bin_env_key": "KYBERION_DEVIN_CLI_BIN",
        "discovery": true,
        "sandbox": {
          "args": [
            "{permission_args}",
            "--respect-workspace-trust",
            "false",
            "-p",
            "--",
            "{prompt}"
          ]
        },
        "install": {
          "brew_formula": "devin-cli",
          "hint": "Install the official Devin CLI, then set KYBERION_DEVIN_CLI_BIN."
        },
        "capability_probe": {
          "binary_args": ["--version"],
          "auth_args": ["auth", "status"],
          "headless": true,
          "structured_output": true,
          "sandbox_flags": {
            "args": ["--help"],
            "expected_flags": ["--permission-mode", "--sandbox"]
          }
        },
        "permission_profiles": {
          "implementer": {
            "args": ["--permission-mode", "bypass"],
            "notes": "Devin CLI bypass mode auto-approves every tool call for implementer-tier write/exec work."
          },
          "explorer": {
            "args": ["--permission-mode", "normal"],
            "notes": "Devin CLI normal mode auto-approves read-only tools; write/exec approval prompts have no one to answer under `-p` and fail closed."
          },
          "planner": {
            "refused": "Devin CLI has no headless no-tools mode: the Plan/Ask agent modes are interactive-only (`/plan`, `/ask`), so a `-p` invocation cannot enforce the planner tier's no-execution invariant. Refusing delegation rather than granting an under-restricted approximation."
          }
        }
      },
      "runtime_instructions": [
        "Provider note: operate only inside the declared work-item scope; a denied tool call is a governance result, not a retryable error.",
        "Provider note: prefer governed facades and pipelines over ad-hoc edits, and return artifact paths plus the verifications actually run."
      ]
    }
  ]
}
