{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "gemini-cli",
      "provider": "gemini",
      "module": "./reasoning-cli-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text"]
      },
      "env_keys": ["GEMINI_CLI_BIN"]
    }
  ]
}
