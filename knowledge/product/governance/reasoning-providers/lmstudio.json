{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "lmstudio",
      "provider": "lmstudio",
      "module": "./reasoning/reasoning-openai-compatible-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text"]
      },
      "env_keys": ["KYBERION_LMSTUDIO_URL", "KYBERION_LM_STUDIO_URL"],
      "cost_tier": "free",
      "transport": "local-server",
      "data_egress": "local-only",
      "adapter": "openai-compatible",
      "openai_compatible_preset": "lmstudio",
      "profile": {
        "streaming": true,
        "tool_calling": true,
        "native_subagent": false,
        "thinking_levels": {},
        "supports_strict_tools": false,
        "supports_grammar_tools": false,
        "utility_fit": ["classify", "summarize"]
      },
      "model_env_keys": [
        "KYBERION_LMSTUDIO_MODEL",
        "KYBERION_LM_STUDIO_MODEL",
        "KYBERION_LOCAL_LLM_MODEL"
      ]
    }
  ]
}
