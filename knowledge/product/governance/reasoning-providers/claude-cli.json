{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "claude-cli",
      "provider": "claude",
      "module": "./reasoning/reasoning-cli-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text"]
      },
      "env_keys": ["CLAUDECODE"],
      "cost_tier": "free",
      "transport": "cli",
      "data_egress": "external-api",
      "adapter": "claude-cli",
      "profile": {
        "streaming": false,
        "tool_calling": true,
        "native_subagent": true,
        "thinking_levels": {
          "low": "low",
          "medium": "medium",
          "high": "high"
        },
        "supports_strict_tools": false,
        "supports_grammar_tools": false,
        "utility_fit": ["judge", "classify", "summarize", "divergent"]
      },
      "aliases": ["shell-claude-cli"],
      "model_vendor": "anthropic",
      "endpoint": "https://api.anthropic.com",
      "egress_provider_id": "claude",
      "cli": {
        "binary": "claude",
        "version_args": ["--version"],
        "help_args": ["--help"],
        "bin_env_key": "KYBERION_CLAUDE_CLI_BIN",
        "discovery": true,
        "model_flag": "--model",
        "sandbox": {
          "args": ["-p", "{prompt}", "{permission_args}"]
        },
        "install": {
          "npm_package": "@anthropic-ai/claude-code",
          "hint": "npm install --prefix <managed-env> --no-save @anthropic-ai/claude-code"
        },
        "capability_probe": {
          "binary_args": ["--version"],
          "auth_args": ["auth", "status"],
          "headless": true,
          "structured_output": true,
          "sandbox_flags": {
            "args": ["--help"],
            "expected_flags": ["--permission-mode"]
          },
          "auth_interpreter": "claude-auth-status",
          "placeholder_fallback": "claude-cli-shim"
        },
        "permission_profiles": {
          "implementer": {
            "args": ["--permission-mode", "bypassPermissions"],
            "notes": "Full read/write/exec tier: no tool restriction beyond what the CLI session already grants."
          },
          "explorer": {
            "args": [
              "--permission-mode",
              "default",
              "--allowedTools",
              "Read",
              "Glob",
              "Grep",
              "WebFetch",
              "--disallowedTools",
              "Write",
              "Edit",
              "NotebookEdit",
              "Bash",
              "KillShell"
            ],
            "notes": "Read-only: only Read/Glob/Grep/WebFetch allowed, Write/Edit/NotebookEdit/Bash/KillShell explicitly denied."
          },
          "planner": {
            "args": ["--permission-mode", "plan"],
            "notes": "plan mode produces a plan without executing any tool — matches \"no tool execution at all.\""
          }
        },
        "session_markers": [
          {
            "env": "CLAUDECODE"
          }
        ],
        "session_principal": "claude-code"
      },
      "runtime_instructions": [
        "Provider note: use the governed subagent/delegation boundary for child work; do not mutate mission-wide state directly.",
        "Provider note: a permission or tenant-scope denial is a terminal governance result, not a retryable prompt failure."
      ]
    }
  ]
}
