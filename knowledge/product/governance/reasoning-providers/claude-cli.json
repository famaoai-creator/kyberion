{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "claude-cli",
      "provider": "claude",
      "module": "./reasoning-cli-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text"]
      },
      "env_keys": ["CLAUDECODE"],
      "cost_tier": "free"
    }
  ]
}
