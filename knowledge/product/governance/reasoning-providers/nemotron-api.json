{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "nemotron-api",
      "provider": "nemotron",
      "module": "./reasoning-openai-compatible-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text"]
      },
      "env_keys": ["KYBERION_NEMOTRON_URL"],
      "cost_tier": "metered"
    }
  ]
}
