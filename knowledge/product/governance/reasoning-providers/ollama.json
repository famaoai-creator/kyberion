{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "ollama",
      "provider": "ollama",
      "module": "./reasoning/reasoning-openai-compatible-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": false,
        "input_modalities": ["text"]
      },
      "env_keys": ["KYBERION_OLLAMA_URL", "OLLAMA_HOST"],
      "secret_refs": [
        { "service_id": "ollama", "secret_key": "API_KEY", "env_keys": ["KYBERION_OLLAMA_KEY"] },
        {
          "service_id": "local-llm",
          "secret_key": "API_KEY",
          "env_keys": ["KYBERION_LOCAL_LLM_KEY"]
        }
      ],
      "cost_tier": "free",
      "transport": "local-server",
      "data_egress": "local-only",
      "adapter": "openai-compatible",
      "openai_compatible_preset": "ollama",
      "profile": {
        "streaming": true,
        "tool_calling": true,
        "native_subagent": false,
        "thinking_levels": {},
        "supports_strict_tools": false,
        "supports_grammar_tools": false,
        "utility_fit": ["classify", "summarize"]
      },
      "model_env_keys": ["KYBERION_OLLAMA_MODEL", "OLLAMA_MODEL", "KYBERION_LOCAL_LLM_MODEL"],
      "setup_hint": "Configure KYBERION_OLLAMA_URL and confirm the selected model is loaded."
    }
  ]
}
