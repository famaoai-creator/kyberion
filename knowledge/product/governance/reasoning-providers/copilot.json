{
  "version": "1.0.0",
  "providers": [
    {
      "mode": "copilot",
      "provider": "copilot",
      "module": "./reasoning/reasoning-cli-provider",
      "capabilities": {
        "reasoning": true,
        "structured_output": true,
        "abort": true,
        "session_continuity": true,
        "input_modalities": ["text"]
      },
      "env_keys": ["GH_TOKEN"],
      "cost_tier": "free",
      "transport": "cli",
      "data_egress": "external-api",
      "adapter": "provider-cli",
      "profile": {
        "streaming": false,
        "tool_calling": true,
        "native_subagent": false,
        "thinking_levels": {
          "low": "low",
          "medium": "medium",
          "high": "high"
        },
        "supports_strict_tools": false,
        "supports_grammar_tools": false,
        "utility_fit": ["judge", "classify", "summarize", "divergent"]
      },
      "aliases": ["copilot-acp"],
      "endpoint": "https://api.githubcopilot.com",
      "egress_provider_id": "copilot",
      "cli": {
        "binary": "gh",
        "version_args": ["copilot", "--", "--help"],
        "help_args": ["copilot", "--", "--help"],
        "bin_env_key": "KYBERION_COPILOT_CLI_BIN",
        "discovery": true,
        "capability_probe": {
          "binary_args": ["copilot", "--", "--help"],
          "auth_args": ["auth", "status"],
          "headless": true,
          "structured_output": true
        }
      }
    }
  ]
}
