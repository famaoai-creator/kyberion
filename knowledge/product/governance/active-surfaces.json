{
  "$schema": "../schemas/runtime-surface-manifest.schema.json",
  "version": 1,
  "surfaces": [
    {
      "id": "chronos-mirror-v2",
      "kind": "ui",
      "description": "Interactive Chronos control surface served as a workspace application",
      "command": "pnpm",
      "args": [
        "--dir",
        "presence/displays/chronos-mirror-v2",
        "start",
        "-H",
        "127.0.0.1",
        "-p",
        "3000"
      ],
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "workspace-app",
      "ownerType": "surface-runtime-manifest",
      "port": 3000,
      "healthPath": "/api/healthz",
      "enabled": true,
      "operatorNotesKey": "surface:surface_notes_chronos_mirror_v2",
      "bestForKey": "surface:surface_best_for_chronos_mirror_v2",
      "urlEnv": "CHRONOS_URL",
      "controlPlane": "chronos",
      "remediationCommand": "pnpm surfaces reconcile"
    },
    {
      "id": "computer-surface",
      "kind": "ui",
      "description": "Live computer interaction surface for governed browser and terminal sessions.",
      "command": "node",
      "args": ["dist/presence/displays/computer-surface/server.js"],
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "workspace-app",
      "ownerType": "surface-runtime-manifest",
      "port": 3040,
      "healthPath": "/health",
      "enabled": true,
      "operatorNotesKey": "surface:surface_notes_computer_surface",
      "bestForKey": "surface:surface_best_for_computer_surface"
    },
    {
      "id": "concierge",
      "kind": "ui",
      "description": "Concierge (秘書室) — CEO executive-secretary surface: intent inbox, approval queue, outcome feed, exception feed",
      "command": "pnpm",
      "args": ["--dir", "presence/displays/concierge", "start", "-H", "127.0.0.1", "-p", "3050"],
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "workspace-app",
      "ownerType": "surface-runtime-manifest",
      "port": 3050,
      "healthPath": "/api/summary",
      "enabled": true
    },
    {
      "id": "discord-bridge",
      "kind": "gateway",
      "description": "Discord Bot ingress gateway and surface-agent host",
      "command": "node",
      "args": ["dist/satellites/discord-bridge/src/index.js"],
      "env": {
        "MISSION_ID": "MSN-SYSTEM-SENSORY-HUB",
        "KYBERION_PERSONA": "sovereign",
        "MISSION_ROLE": "surface_runtime"
      },
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "enabled": false
    },
    {
      "id": "event-intake-surface",
      "kind": "service",
      "description": "Loopback-only HMAC-authenticated inbound event intake (POST /events/<source>) that wakes resident dots. Every source is disabled in event-intake-policy.json until an operator enables it and stores its secret. Operator-launched; not started by reconcile.",
      "command": "node",
      "args": ["dist/scripts/event_intake_surface.js"],
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "port": 8791,
      "healthPath": "/health",
      "ingress": {
        "allowed": true,
        "path_prefix": "/events",
        "port_env": "KYBERION_EVENT_INTAKE_PORT"
      },
      "enabled": false
    },
    {
      "id": "imessage-bridge",
      "kind": "service",
      "description": "Managed macOS Messages bridge for declared iMessage sending and governed runtime supervision",
      "command": "node",
      "args": ["dist/satellites/imessage-bridge/src/index.js"],
      "env": {
        "MISSION_ID": "MSN-SYSTEM-SENSORY-HUB",
        "KYBERION_PERSONA": "sovereign",
        "MISSION_ROLE": "surface_runtime"
      },
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "port": 3034,
      "healthPath": "/health",
      "enabled": false
    },
    {
      "id": "mcp-server-cowork",
      "kind": "gateway",
      "description": "Kyberion MCP Server facade — exposes Kyberion capabilities to Claude Cowork and other MCP clients via stdio transport.",
      "command": "node",
      "args": ["dist/scripts/mcp_server.js"],
      "env": {
        "KYBERION_PERSONA": "sovereign",
        "MISSION_ROLE": "mcp_server",
        "KYBERION_MCP_CALLER_ROLE": "cowork"
      },
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "enabled": true,
      "operatorNotesKey": "surface:surface_notes_mcp_server_cowork",
      "bestForKey": "surface:surface_best_for_mcp_server_cowork"
    },
    {
      "id": "nexus-daemon",
      "kind": "service",
      "description": "Background system nerve daemon for stimuli routing and terminal dispatch",
      "command": "node",
      "args": ["dist/presence/bridge/nexus-daemon.js"],
      "env": {
        "MISSION_ID": "MSN-SYSTEM-NERVE",
        "KYBERION_PERSONA": "sovereign",
        "MISSION_ROLE": "nexus_daemon"
      },
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "enabled": true
    },
    {
      "id": "oauth-callback-surface",
      "kind": "service",
      "description": "Loopback-only OAuth callback receiver that completes token exchange into Personal-tier connections.",
      "command": "node",
      "args": ["dist/scripts/oauth_callback_surface.js"],
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "port": 8787,
      "healthPath": "/health",
      "enabled": true,
      "operatorNotesKey": "surface:surface_notes_oauth_callback_surface",
      "bestForKey": "surface:surface_best_for_oauth_callback_surface"
    },
    {
      "id": "operator-surface",
      "kind": "ui",
      "description": "Read-only audit monitor (Minimum Operator Surface). Operator-launched; not started by reconcile.",
      "command": "pnpm",
      "args": ["--dir", "presence/displays/operator-surface", "start"],
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "workspace-app",
      "ownerType": "surface-runtime-manifest",
      "port": 3331,
      "healthPath": "/",
      "enabled": false
    },
    {
      "id": "personal-pads",
      "kind": "service",
      "description": "Personal capture pads (single localhost listener, default port 8160). Legacy standalone pads used 8137 and 8147-8154. Operator-launched; not started by reconcile.",
      "command": "pnpm",
      "args": ["pads"],
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "port": 8160,
      "healthPath": "/",
      "enabled": false
    },
    {
      "id": "presence-studio",
      "kind": "ui",
      "description": "Expressive realtime surface for subtitles, transcript, and voice-channel presence state.",
      "command": "node",
      "args": ["dist/presence/displays/presence-studio/server.js"],
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "workspace-app",
      "ownerType": "surface-runtime-manifest",
      "port": 3031,
      "healthPath": "/health",
      "enabled": true,
      "operatorNotesKey": "surface:surface_notes_presence_studio",
      "bestForKey": "surface:surface_best_for_presence_studio",
      "urlEnv": "PRESENCE_STUDIO_URL",
      "controlPlane": "presence",
      "remediationCommand": "pnpm surfaces reconcile"
    },
    {
      "id": "slack-bridge",
      "kind": "gateway",
      "description": "Slack Socket Mode ingress gateway and surface-agent host",
      "service_id": "slack",
      "preset_path": "knowledge/product/orchestration/service-presets/slack.json",
      "command": "node",
      "args": ["dist/satellites/slack-bridge/src/index.js"],
      "env": {
        "MISSION_ID": "MSN-SYSTEM-SENSORY-HUB",
        "KYBERION_PERSONA": "sovereign",
        "MISSION_ROLE": "slack_bridge"
      },
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "enabled": false,
      "operatorNotesKey": "surface:surface_notes_slack_bridge",
      "bestForKey": "surface:surface_best_for_slack_bridge"
    },
    {
      "id": "telegram-bridge",
      "kind": "gateway",
      "description": "Telegram ingress gateway and surface-agent host",
      "command": "node",
      "args": ["dist/satellites/telegram-bridge/src/index.js"],
      "env": {
        "MISSION_ID": "MSN-SYSTEM-SENSORY-HUB",
        "KYBERION_PERSONA": "sovereign",
        "MISSION_ROLE": "surface_runtime"
      },
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "port": 3035,
      "healthPath": "/health",
      "enabled": false
    },
    {
      "id": "terminal-bridge",
      "kind": "service",
      "description": "Background terminal bridge service for runtime sessions",
      "command": "node",
      "args": ["dist/presence/bridge/terminal/server.js"],
      "env": {
        "KYBERION_PERSONA": "sovereign",
        "MISSION_ROLE": "infrastructure_sentinel"
      },
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "enabled": true,
      "operatorNotesKey": "surface:surface_notes_terminal_bridge"
    },
    {
      "id": "terminal-hud",
      "kind": "service",
      "description": "Interactive full-screen terminal HUD (Ink TUI, no listening port). Operator-launched in a terminal; not started by reconcile.",
      "command": "node",
      "args": ["presence/displays/terminal-hud/dist/index.js"],
      "cwd": ".",
      "shutdownPolicy": "manual",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "enabled": false
    },
    {
      "id": "voice-hub",
      "kind": "service",
      "description": "Managed voice ingress service that emits governed voice stimuli and reflects them into the expressive surface.",
      "command": "node",
      "args": ["dist/satellites/voice-hub/server.js"],
      "env": {
        "KYBERION_PERSONA": "sovereign",
        "MISSION_ROLE": "surface_runtime"
      },
      "cwd": ".",
      "shutdownPolicy": "detached",
      "startupMode": "background",
      "ownerType": "surface-runtime-manifest",
      "port": 3032,
      "healthPath": "/health",
      "enabled": true,
      "operatorNotesKey": "surface:surface_notes_voice_hub",
      "bestForKey": "surface:surface_best_for_voice_hub",
      "urlEnv": "VOICE_HUB_URL"
    }
  ]
}
