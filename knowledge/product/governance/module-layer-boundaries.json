{
  "$schema": "../schemas/governance-catalog.schema.json",
  "version": 1,
  "layers": ["foundation", "contracts", "domain", "orchestration"],
  "facade_patterns": [
    "libs/core/index.ts",
    "libs/core/index-part-*.ts",
    "libs/core/channel-surface.ts",
    "libs/core/agent-runtime-supervisor.ts"
  ],
  "direction_exceptions": [
    {
      "source": "libs/core/secure-io.ts",
      "target": "libs/core/audit-chain.ts",
      "reason": "audit-chain must receive the secure persistence adapter during secure-io bootstrap"
    },
    {
      "source": "libs/core/secure-io.ts",
      "target": "libs/core/sandbox-policy.ts",
      "reason": "secure-io enforces the active provider sandbox before filesystem and network operations"
    },
    {
      "source": "libs/core/secure-io.ts",
      "target": "libs/core/tier-guard.ts",
      "reason": "secure-io enforces tenant and tier permissions at every governed filesystem boundary"
    }
  ],
  "patterns": [
    { "layer": "foundation", "pattern": "libs/core/foundation/**" },
    { "layer": "foundation", "pattern": "libs/core/secure-io.ts" },
    { "layer": "foundation", "pattern": "libs/core/fs-primitives.ts" },
    { "layer": "foundation", "pattern": "libs/core/path-resolver.ts" },
    { "layer": "foundation", "pattern": "libs/core/schema-loader.ts" },
    { "layer": "foundation", "pattern": "libs/core/logger.ts" },
    { "layer": "foundation", "pattern": "libs/core/governance-action-recorder.ts" },
    { "layer": "foundation", "pattern": "libs/core/sensitive-path-policy.ts" },
    { "layer": "foundation", "pattern": "libs/core/policy-engine.ts" },
    { "layer": "foundation", "pattern": "libs/core/src/lock-utils.ts" },
    { "layer": "contracts", "pattern": "libs/core/structured-output-contracts.ts" },
    { "layer": "contracts", "pattern": "libs/core/context-boundary.ts" },
    { "layer": "contracts", "pattern": "libs/core/worker-goal.ts" },
    { "layer": "contracts", "pattern": "libs/core/surface-authorization.ts" },
    { "layer": "domain", "pattern": "libs/core/mission-orchestration-events.ts" },
    { "layer": "domain", "pattern": "libs/core/mission-orchestration-journal.ts" },
    { "layer": "domain", "pattern": "libs/core/mission-orchestration-event-loader.ts" },
    { "layer": "domain", "pattern": "libs/core/mission-orchestration-evaluator.ts" },
    { "layer": "domain", "pattern": "libs/core/orchestrator-session.ts" },
    { "layer": "domain", "pattern": "libs/core/worker-context-compaction.ts" },
    { "layer": "domain", "pattern": "libs/core/worker-event-stream.ts" },
    { "layer": "domain", "pattern": "libs/core/worker-state-journal.ts" },
    { "layer": "domain", "pattern": "libs/core/intent-contract.ts" },
    { "layer": "domain", "pattern": "libs/core/intent-resolution-contract.ts" },
    { "layer": "domain", "pattern": "libs/core/report-contract.ts" },
    { "layer": "domain", "pattern": "libs/core/router-contract.ts" },
    { "layer": "domain", "pattern": "libs/core/video-composition-contract.ts" },
    { "layer": "domain", "pattern": "libs/core/video-content-brief-contract.ts" },
    { "layer": "contracts", "pattern": "libs/core/*-contract.ts" },
    { "layer": "contracts", "pattern": "libs/core/*-schema.ts" },
    { "layer": "contracts", "pattern": "libs/core/entity-scope.ts" },
    { "layer": "contracts", "pattern": "libs/core/vocabulary-keys.generated.ts" },
    { "layer": "contracts", "pattern": "libs/core/channel-surface-types.ts" },
    { "layer": "contracts", "pattern": "libs/core/worker-assignment-policy.ts" },
    { "layer": "domain", "pattern": "libs/core/intent-clarification-format.ts" },
    { "layer": "contracts", "pattern": "libs/core/intent-compilation-events.ts" },
    { "layer": "contracts", "pattern": "libs/core/intent-contract-types.ts" },
    { "layer": "contracts", "pattern": "libs/core/intent-delivery-decision.ts" },
    { "layer": "contracts", "pattern": "libs/core/intent-input-context.ts" },
    { "layer": "contracts", "pattern": "libs/core/intent-routing-decision.ts" },
    { "layer": "orchestration", "pattern": "libs/core/*orchestrat*.ts" },
    { "layer": "orchestration", "pattern": "libs/core/surface-runtime-conversation-data.ts" },
    { "layer": "orchestration", "pattern": "libs/core/*dispatcher*.ts" },
    { "layer": "orchestration", "pattern": "scripts/run_service_procedure.ts" },
    { "layer": "orchestration", "pattern": "scripts/run_mission_orchestration_event_worker.ts" },
    { "layer": "orchestration", "pattern": "scripts/background_review_mission_e2e.ts" },
    { "layer": "orchestration", "pattern": "scripts/browser_bridge_host.ts" },
    { "layer": "orchestration", "pattern": "scripts/kyberion_home.ts" },
    { "layer": "orchestration", "pattern": "scripts/cli.ts" },
    { "layer": "orchestration", "pattern": "scripts/kyberion.ts" },
    { "layer": "orchestration", "pattern": "scripts/bindings.ts" },
    { "layer": "orchestration", "pattern": "scripts/check_seam_multiplicity.ts" },
    { "layer": "orchestration", "pattern": "scripts/generate_capability_seams.ts" },
    { "layer": "orchestration", "pattern": "scripts/demos/*.ts" },
    { "layer": "orchestration", "pattern": "libs/core/*worker*.ts" }
  ],
  "default_layer": "domain"
}
