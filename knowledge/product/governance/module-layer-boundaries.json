{
  "$schema": "../schemas/module-layer-boundaries.schema.json",
  "version": 1,
  "layers": ["foundation", "contracts", "domain", "orchestration"],
  "facade_patterns": [
    "libs/core/index.ts",
    "libs/core/index-part-*.ts",
    "libs/core/surface/channel-surface.ts",
    "libs/core/agent/agent-runtime-supervisor.ts",
    "libs/core/*/index.ts",
    "libs/core/*/*/index.ts"
  ],
  "direction_exceptions": [
    {
      "source": "libs/core/secure-io.ts",
      "target": "libs/core/governance/audit-chain.ts",
      "reason": "audit-chain must receive the secure persistence adapter during secure-io bootstrap"
    },
    {
      "source": "libs/core/secure-io.ts",
      "target": "libs/core/shell/sandbox-policy.ts",
      "reason": "secure-io enforces the active provider sandbox before filesystem and network operations"
    },
    {
      "source": "libs/core/secure-io.ts",
      "target": "libs/core/tier-guard.ts",
      "reason": "secure-io enforces tenant and tier permissions at every governed filesystem boundary"
    },
    {
      "source": "libs/core/secure-io-path-guard.ts",
      "target": "libs/core/tier-guard.ts",
      "reason": "secure-io's permission guards (split out of secure-io.ts) check tier permissions on literal and canonical paths"
    },
    {
      "source": "libs/core/secure-io-path-guard.ts",
      "target": "libs/core/secret/vault-mount.ts",
      "reason": "the opened-file pin identifies a vault mount target (the only readable location outside the repository) without following its leaf"
    }
  ],
  "patterns": [
    { "layer": "foundation", "pattern": "libs/core/foundation/**" },
    { "layer": "foundation", "pattern": "libs/core/secure-io.ts" },
    { "layer": "foundation", "pattern": "libs/core/secure-io-path-guard.ts" },
    { "layer": "foundation", "pattern": "libs/core/fs-primitives.ts" },
    { "layer": "foundation", "pattern": "libs/core/path-resolver.ts" },
    { "layer": "foundation", "pattern": "libs/core/schema-loader.ts" },
    { "layer": "foundation", "pattern": "libs/core/logger.ts" },
    {
      "layer": "foundation",
      "pattern": "libs/core/governance/governance-action-recorder.ts"
    },
    { "layer": "foundation", "pattern": "libs/core/sensitive-path-policy.ts" },
    {
      "layer": "foundation",
      "pattern": "libs/core/governance/policy-engine.ts"
    },
    { "layer": "foundation", "pattern": "libs/core/foundation/lock-utils.ts" },
    {
      "layer": "contracts",
      "pattern": "libs/core/structured-output-contracts.ts"
    },
