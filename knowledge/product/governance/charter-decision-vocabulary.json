{
  "$schema": "../schemas/charter-decision-vocabulary.schema.json",
  "version": "1.0.0",
  "description": "Business decision types an accountability charter can delegate. Each entry states the facts the charter evaluates (external effect, reversibility, how an amount counts). Unlisted decision types keep the legacy approval path.",
  "decisions": [
    {
      "decision_type": "operational_spend",
      "label": { "ja": "業務上の支出", "en": "Operational spend" },
      "action_class": "payment",
      "reversible": false,
      "amount_semantics": "spend",
      "requires_delegation": false
    },
    {
      "decision_type": "contract_signature",
      "label": { "ja": "契約の締結", "en": "Contract signature" },
      "action_class": "sign_contract",
      "reversible": false,
      "amount_semantics": "spend",
      "requires_delegation": false
    },
    {
      "decision_type": "headcount_expansion",
      "label": { "ja": "採用(内定の提示)", "en": "Hiring (extending an offer)" },
      "action_class": "sign_contract",
      "reversible": false,
      "amount_semantics": "exposure",
      "reputational_class": "B",
      "default_recipients": 1,
      "requires_delegation": true
    },
    {
      "decision_type": "quote_issuance",
      "label": { "ja": "見積の提示", "en": "Issuing a quote" },
      "action_class": "sign_contract",
      "reversible": false,
      "amount_semantics": "exposure",
      "reputational_class": "B",
      "default_recipients": 1,
      "requires_delegation": true
    },
    {
      "decision_type": "expense_reimbursement",
      "label": { "ja": "経費の精算", "en": "Expense reimbursement" },
      "action_class": "payment",
      "reversible": false,
      "amount_semantics": "spend",
      "requires_delegation": true
    },
    {
      "decision_type": "vendor_invoice_payment",
      "label": { "ja": "請求書の支払い", "en": "Paying a vendor invoice" },
      "action_class": "payment",
      "reversible": false,
      "amount_semantics": "spend",
      "requires_delegation": true
    },
    {
      "decision_type": "meeting_scheduling",
      "label": { "ja": "社外との日程の確定", "en": "Confirming a meeting with an outside party" },
      "action_class": "send_message_external",
      "reversible": false,
      "amount_semantics": "none",
      "reputational_class": "A",
      "default_recipients": 1,
      "requires_delegation": true
    },
    {
      "decision_type": "external_reply",
      "label": { "ja": "社外への返信", "en": "Replying to an outside party" },
      "action_class": "send_message_external",
      "reversible": false,
      "amount_semantics": "none",
      "reputational_class": "B",
      "default_recipients": 1,
      "requires_delegation": true
    },
    {
      "decision_type": "public_announcement",
      "label": { "ja": "対外的な公開・発表", "en": "Public announcement" },
      "action_class": "publish_public",
      "reversible": false,
      "amount_semantics": "none",
      "reputational_class": "C",
      "requires_delegation": true
    },
    {
      "decision_type": "access_grant",
      "label": { "ja": "社内システムの権限付与", "en": "Granting system access" },
      "action_class": "credential_change",
      "reversible": true,
      "amount_semantics": "none",
      "reputational_class": "A",
      "systems": 1,
      "requires_delegation": true
    },
    {
      "decision_type": "internal_task_assignment",
      "label": { "ja": "社内の作業の割り振り", "en": "Assigning internal work" },
      "action_class": "internal_decision",
      "reversible": true,
      "amount_semantics": "none",
      "reputational_class": "A",
      "requires_delegation": true
    },
    {
      "decision_type": "internal_document_approval",
      "label": { "ja": "社内文書の承認", "en": "Approving an internal document" },
      "action_class": "internal_decision",
      "reversible": true,
      "amount_semantics": "none",
      "reputational_class": "A",
      "requires_delegation": true
    }
  ]
}
