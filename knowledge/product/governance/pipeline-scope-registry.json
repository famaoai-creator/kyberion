  "last_updated": "2026-10-18",
  "description": "Reviewed scope classification for every pipeline under pipelines/ (top level + browser/ + config/; fragments/ are parts, not pipelines). `audience` answers \"whose work is this for?\" and `placement` flags where the README scope rule says it should live. This is a triage/documentation aid only — the runtime never reads it, and no pipeline JSON is modified. Regenerate/refresh by hand when a pipeline is added, moved, or retired; the companion report is docs/developer/improvement-plans-2026-10/PIPELINE_VERIFICATION_INVENTORY_2026-10-17.ja.md.",
  "audiences": {
    "system": "Kyberion operating itself: health, self-repair, backup, mission/approval control, capability assimilation, audits, upgrade, soak/chaos, storage janitor, volatile-layer machinery.",
    "organization": "An organization's operating model and its deliverables: organization cadence, decision/accountability governance, project/SDLC flow, executive reporting.",
    "tenant": "Tenant- (customer-) scoped work: tenant ingest/drift and the tenant-scoped external-asset inventory procedure.",
    "personal": "One individual's assistant work: onboarding a person/profile, meetings, voice, personal rituals, personal web procedures.",
    "product": "Kyberion's own go-to-market output: demos, marketing content, narrated reports, media production."
  },
  "placements": {
    "canonical": "Belongs in pipelines/ (or browser//config/ for its class) under the README scope rule.",
    "should_be_template": "User-facing workflow: README scope rule points at knowledge/product/pipeline-templates/.",
    "should_be_tenant_scoped": "Tenant-specific: README scope rule points at knowledge/confidential/{tenant}/pipelines/.",
    "should_be_personal": "Personal: README scope rule points at knowledge/personal/pipelines/."
  },
