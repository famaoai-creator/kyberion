{
  "version": "1.0.0",
  "default_tool_id": "mflux",
  "tools": [
    {
      "tool_id": "adb",
      "display_name": "Android Debug Bridge",
      "ecosystem": "system",
      "status": "active",
      "platforms": ["any"],
      "supported_modes": ["trial", "approved_install", "installed", "pinned"],
      "trial_backend": {
        "kind": "system",
        "command": "adb",
        "args": ["version"],
        "description": "Probe adb availability without any install step."
      },
      "install_backend": {
        "kind": "brew",
        "command": "brew",
        "args": ["install", "--cask", "android-platform-tools"],
        "description": "Install Android SDK platform-tools through Homebrew on macOS."
      },
      "installed_backend": {
        "kind": "system",
        "command": "adb",
        "args": ["version"],
        "description": "Re-check the installed adb binary."
      },
      "managed_env_subpath": "tool-runtimes/adb",
      "notes": "Android SDK platform-tools entrypoint. Resolvers prefer KYBERION_ADB_BIN, then ANDROID_HOME / ANDROID_SDK_ROOT platform-tools."
    }
  ]
}
