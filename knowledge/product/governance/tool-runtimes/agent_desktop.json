{
  "version": "1.0.0",
  "default_tool_id": "mflux",
  "tools": [
    {
      "tool_id": "agent_desktop",
      "display_name": "Vercel Labs agent-desktop",
      "ecosystem": "system",
      "status": "active",
      "platforms": ["darwin", "linux", "win32"],
      "supported_modes": ["trial", "approved_install", "installed", "pinned"],
      "trial_backend": {
        "kind": "system",
        "command": "agent-desktop",
        "args": ["version"],
        "description": "Probe agent-desktop availability without starting a command host."
      },
      "install_backend": {
        "kind": "npm",
        "command": "npm",
        "args": ["install", "-g", "agent-desktop@1.0.2"],
        "description": "Fallback when no managed_binary artifact matches the host: install the upstream npm package, whose postinstall downloads the matching release tarball."
      },
      "installed_backend": {
        "kind": "system",
        "command": "agent-desktop",
        "args": ["version"],
        "description": "Re-check the installed agent-desktop binary."
      },
      "managed_env_subpath": "tool-runtimes/agent-desktop",
      "managed_binary": {
        "version": "1.0.2",
        "relative_path": "bin/agent-desktop",
        "archive": "tar.gz",
        "artifacts": {
          "darwin-arm64": {
            "url": "https://github.com/vercel-labs/agent-desktop/releases/download/v1.0.2/agent-desktop-v1.0.2-aarch64-apple-darwin.tar.gz",
            "sha256": "7bee385196d7b478de80cf05ca4304aaa38f0eba593b3406ad3c247c1773be19"
          },
          "darwin-x64": {
            "url": "https://github.com/vercel-labs/agent-desktop/releases/download/v1.0.2/agent-desktop-v1.0.2-x86_64-apple-darwin.tar.gz",
            "sha256": "8edda6df17eafc042395502a823dbb8415bc8ac14835a6731e4d8becc9cb4121"
          },
          "linux-arm64": {
            "url": "https://github.com/vercel-labs/agent-desktop/releases/download/v1.0.2/agent-desktop-v1.0.2-aarch64-unknown-linux-gnu.tar.gz",
            "sha256": "864cb782e0afc8bf0df19622016b24bdbd1a83fc7749f784ee82aa49a7f845eb"
          },
          "linux-x64": {
            "url": "https://github.com/vercel-labs/agent-desktop/releases/download/v1.0.2/agent-desktop-v1.0.2-x86_64-unknown-linux-gnu.tar.gz",
            "sha256": "ad661b7a3fd8f990a769243f4889a240ca0e2c8dab3ef5bddd6019086c71e0b4"
          },
          "win32-arm64": {
            "url": "https://github.com/vercel-labs/agent-desktop/releases/download/v1.0.2/agent-desktop-v1.0.2-aarch64-pc-windows-msvc.tar.gz",
            "sha256": "a0ecd6e17e60a0bcfbb45533a72f2d3a7a73508769588273ef08b0477d2b9687",
            "relative_path": "bin/agent-desktop.exe"
          },
          "win32-x64": {
            "url": "https://github.com/vercel-labs/agent-desktop/releases/download/v1.0.2/agent-desktop-v1.0.2-x86_64-pc-windows-msvc.tar.gz",
            "sha256": "2186c76e7df197c0e67365e45d36d869f74714c56bb8a73817e2a66f3e18e222",
            "relative_path": "bin/agent-desktop.exe"
          }
        }
      },
      "notes": "Apache-2.0 Rust CLI for accessibility-tree computer use (observe -> snapshot-qualified refs -> act). Invoked as an external binary only, never vendored; every call runs through libs/core/desktop-ax-bridge with an allowlisted subcommand set, per-mission AGENT_DESKTOP_SESSION, and AGENT_DESKTOP_HOME redirected to the governed runtime floor so refmaps/traces (screen content) never reach the knowledge tier. Preferred install: `pnpm tool:setup -- --tool agent_desktop --apply` downloads the checksum-pinned release tarball into the managed env and extracts bin/agent-desktop plus its platform helper (bin/agent-desktop-macos-helper on darwin, bin/agent-desktop-linux-clipboard-owner on linux). Override the binary with KYBERION_AGENT_DESKTOP_BIN."
    }
  ]
}
