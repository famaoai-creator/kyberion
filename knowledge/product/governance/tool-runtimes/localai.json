{
  "version": "1.0.0",
  "default_tool_id": "mflux",
  "tools": [
    {
      "tool_id": "localai",
      "display_name": "LocalAI Multi-Modal Engine",
      "ecosystem": "system",
      "status": "active",
      "platforms": ["any"],
      "supported_modes": ["trial", "approved_install", "installed", "pinned"],
      "trial_backend": {
        "kind": "system",
        "command": "local-ai",
        "args": ["--version"],
        "description": "Probe LocalAI binary availability."
      },
      "install_backend": {
        "kind": "brew",
        "command": "brew",
        "args": ["install", "local-ai"],
        "description": "Install LocalAI via Homebrew."
      },
      "installed_backend": {
        "kind": "system",
        "command": "local-ai",
        "args": [],
        "description": "Run LocalAI server process."
      },
      "managed_env_subpath": "tool-runtimes/localai",
      "notes": "LocalAI multi-modal OpenAI-compatible server."
    }
  ]
}
