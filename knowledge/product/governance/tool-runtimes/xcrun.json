{
  "version": "1.0.0",
  "default_tool_id": "mflux",
  "tools": [
    {
      "tool_id": "xcrun",
      "display_name": "Xcode Command Line Runner",
      "ecosystem": "system",
      "status": "active",
      "platforms": ["darwin"],
      "supported_modes": ["trial", "approved_install", "installed", "pinned"],
      "trial_backend": {
        "kind": "system",
        "command": "xcrun",
        "args": ["--version"],
        "description": "Probe xcrun availability without any install step."
      },
      "install_backend": {
        "kind": "system",
        "command": "xcode-select",
        "args": ["--install"],
        "description": "Install the Xcode command line tools via xcode-select."
      },
      "installed_backend": {
        "kind": "system",
        "command": "xcrun",
        "args": ["--version"],
        "description": "Re-check the installed xcrun binary."
      },
      "managed_env_subpath": "tool-runtimes/xcrun",
      "notes": "Darwin-only simctl entrypoint resolved through the xcode-select path."
    }
  ]
}
