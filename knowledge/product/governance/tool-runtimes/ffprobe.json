{
  "version": "1.0.0",
  "default_tool_id": "mflux",
  "tools": [
    {
      "tool_id": "ffprobe",
      "display_name": "FFprobe Media Probe",
      "ecosystem": "system",
      "status": "active",
      "platforms": ["any"],
      "supported_modes": ["trial", "approved_install", "installed", "pinned"],
      "trial_backend": {
        "kind": "system",
        "command": "ffprobe",
        "args": ["-version"],
        "description": "Probe FFprobe availability without any install step."
      },
      "install_backend": {
        "kind": "brew",
        "command": "brew",
        "args": ["install", "ffmpeg"],
        "description": "FFprobe ships with FFmpeg; install FFmpeg through Homebrew on macOS."
      },
      "install_backend_platform_overrides": {
        "win32": {
          "kind": "winget",
          "command": "winget",
          "args": [
            "install",
            "--id",
            "Gyan.FFmpeg",
            "--exact",
            "--source",
            "winget",
            "--accept-source-agreements",
            "--accept-package-agreements"
          ],
          "description": "FFprobe ships with FFmpeg; install FFmpeg through WinGet on Windows."
        }
      },
      "installed_backend": {
        "kind": "system",
        "command": "ffprobe",
        "args": ["-version"],
        "description": "Re-check the installed FFprobe binary."
      },
      "managed_env_subpath": "tool-runtimes/ffprobe",
      "notes": "Ships with the ffmpeg install; probe companion for capture and composition flows."
    }
  ]
}
