{
  "version": "1.0.0",
  "default_tool_id": "mflux",
  "tools": [
    {
      "tool_id": "vllm",
      "display_name": "vLLM High-Throughput Engine",
      "ecosystem": "python",
      "status": "active",
      "platforms": ["any"],
      "supported_modes": ["trial", "approved_install", "installed", "pinned"],
      "trial_backend": {
        "kind": "system",
        "command": "python3",
        "args": ["-c", "import vllm; print(\"ok\")"],
        "description": "Probe vLLM Python package availability."
      },
      "install_backend": {
        "kind": "uv",
        "command": "uv",
        "args": ["pip", "install", "vllm"],
        "description": "Install vLLM into the managed Python environment."
      },
      "installed_backend": {
        "kind": "uv",
        "command": "uv",
        "args": ["run", "python3", "-m", "vllm.entrypoints.openai.api_server"],
        "description": "Run vLLM OpenAI API server."
      },
      "managed_env_subpath": "tool-runtimes/vllm",
      "notes": "vLLM high-throughput LLM server runtime."
    }
  ]
}
