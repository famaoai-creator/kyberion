{
  "$schema": "../schemas/mission-classification-policy.schema.json",
  "version": "1.0.0",
  "defaults": {
    "mission_class": "code_change",
    "delivery_shape": "single_artifact",
    "risk_profile": "review_required",
    "stage": "intake"
  },
  "stage_progression": [
    "intake",
    "classification",
    "planning",
    "contract_authoring",
    "preflight",
    "execution",
    "verification",
    "delivery",
    "retrospective"
