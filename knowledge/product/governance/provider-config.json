{
  "$schema": "../schemas/provider-config.schema.json",
  "version": "1.0.0",
  "description": "Agent provider configuration. Defines default provider priority, default model IDs, lifecycle boot commands, and providers that must not be selected for agent-runtime execution. Gemini ACP is obsolete for personal OAuth environments; Gemini API and agy remain separate surfaces. Read by agent-provider-resolution.ts and agent-lifecycle.ts.",
  "default_priority": ["agy", "claude", "codex", "grok", "copilot"],
  "obsolete_agent_runtime_providers": ["gemini"],
  "default_models": {
    "gemini": "gemini-3.6-flash",
    "claude": "claude-opus-5",
    "agy": "Gemini 3.7 Flash (Medium)",
    "codex": "gpt-5.6-sol",
    "grok": "grok-4.6",
    "copilot": "auto",
    "cursor": "auto",
    "opencode": "opencode/muse-spark-1.3-contributor-free"
  },
  "runtime_defaults": {
    "anthropic-default": "claude-opus-5",
    "anthropic-fast": "claude-haiku-4-5-20251001",
    "gemini-default": "gemini-3.6-flash",
    "gemini-fast": "gemini-3.1-flash-lite",
    "openai-vision": "gpt-5.5",
    "codex-default": "gpt-5.6-sol",
    "copilot-default": "auto",
    "cursor-default": "auto",
    "opencode-default": "opencode/muse-spark-1.3-contributor-free"
  },
  "lifecycle": {
    "gemini": {
      "boot_command": "gemini",
      "boot_args": ["--acp", "-y"],
      "default_model": "gemini-3.6-flash"
    },
    "copilot": {
      "boot_command": "gh",
      "boot_args": ["copilot", "--", "--acp", "--allow-all"],
      "default_model": "auto"
    }
  }
}
