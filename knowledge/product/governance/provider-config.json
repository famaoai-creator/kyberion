{
  "version": "1.0.0",
  "description": "Agent provider configuration. Defines default provider priority, default model IDs, and lifecycle boot commands. Read by agent-provider-resolution.ts and agent-lifecycle.ts. Edit here to change provider order or upgrade model IDs without code changes.",
  "default_priority": ["agy", "gemini", "claude", "codex", "grok", "copilot"],
  "default_models": {
    "gemini": "gemini-3.6-flash",
    "claude": "claude-opus-4-8",
    "agy": "Gemini 3.6 Flash (Medium)",
    "codex": "gpt-5.6-sol",
    "grok": "grok-4.5",
    "copilot": "auto"
  },
  "runtime_defaults": {
    "anthropic-default": "claude-opus-4-8",
    "anthropic-fast": "claude-haiku-4-5-20251001",
    "gemini-default": "gemini-3.6-flash",
    "gemini-fast": "gemini-3.1-flash-lite",
    "openai-vision": "gpt-5.5",
    "codex-default": "gpt-5.6-sol",
    "copilot-default": "auto"
  },
  "lifecycle": {
    "gemini": {
      "boot_command": "gemini",
      "boot_args": ["--acp", "-y"],
      "default_model": "gemini-3.6-flash"
    },
    "copilot": {
      "boot_command": "gh",
      "boot_args": ["copilot", "--", "--acp", "--allow-all"],
      "default_model": "auto"
    }
  }
}
