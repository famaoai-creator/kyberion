{
  "role": "operational_learning_writer",
  "description": "Narrow internal store-writer for machine-generated organization learning proposals, bound to one organization and tenant execution scope.",
  "default_persona": "worker",
  "write_scopes": [
    "active/organizations/personal/shared/${KYBERION_ORGANIZATION_ID}/state/learning/",
    "active/organizations/personal/${KYBERION_TENANT}/${KYBERION_ORGANIZATION_ID}/state/learning/",
    "active/organizations/confidential/${KYBERION_TENANT}/${KYBERION_ORGANIZATION_ID}/state/learning/",
    "active/organizations/public/shared/${KYBERION_ORGANIZATION_ID}/state/learning/",
    "active/organizations/public/${KYBERION_TENANT}/${KYBERION_ORGANIZATION_ID}/state/learning/"
  ],
  "scope_classes": ["organization_operations"],
  "allowed_actuators": ["artifact-actuator"],
  "tier_access": ["personal", "confidential", "public"]
}
