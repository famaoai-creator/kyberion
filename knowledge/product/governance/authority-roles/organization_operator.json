{
  "role": "organization_operator",
  "description": "Tenant-scoped organization operator role assumed by organization management scripts and resident dots overseeing organization operations, services, and cadences.",
  "default_persona": "worker",
  "write_scopes": [
    "active/organizations/confidential/${KYBERION_TENANT}/",
    "active/organizations/public/${KYBERION_TENANT}/",
    "active/shared/runtime/",
    "active/shared/observability/",
    "active/shared/logs/traces/",
    "active/shared/logs/stances/${KYBERION_STANCE}/traces/"
  ],
  "scope_classes": ["organization_operating_model", "operations_runtime", "observability"],
  "allowed_actuators": ["process-actuator"],
  "tier_access": ["confidential", "public"],
  "permissions": {
    "allow_read": [
      "active/organizations/confidential/${KYBERION_TENANT}/",
      "active/organizations/public/${KYBERION_TENANT}/",
      "active/organizations/personal/shared/${KYBERION_ORGANIZATION_ID}/",
      "active/organizations/public/shared/${KYBERION_ORGANIZATION_ID}/",
      "knowledge/personal/tenants/${KYBERION_TENANT}.json",
      "knowledge/confidential/${KYBERION_TENANT}/",
      "knowledge/confidential/shared/",
      "active/shared/runtime/",
      "active/shared/observability/",
      "active/shared/logs/traces/",
      "active/shared/logs/stances/${KYBERION_STANCE}/traces/"
    ],
    "allow_write": [
      "active/organizations/confidential/${KYBERION_TENANT}/",
      "active/organizations/public/${KYBERION_TENANT}/",
      "active/organizations/personal/shared/${KYBERION_ORGANIZATION_ID}/",
      "active/organizations/public/shared/${KYBERION_ORGANIZATION_ID}/",
      "active/shared/runtime/",
      "active/shared/observability/",
      "active/shared/logs/traces/",
      "active/shared/logs/stances/${KYBERION_STANCE}/traces/"
    ]
  }
}
