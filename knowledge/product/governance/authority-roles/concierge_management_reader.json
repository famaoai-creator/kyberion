{
  "role": "concierge_management_reader",
  "description": "Read-only management projection and fresh owner-membership verification. Requires an exact request resource capability; no write operations or credential access.",
  "default_persona": "unknown",
  "write_scopes": [],
  "scope_classes": [],
  "allowed_actuators": [],
  "tier_access": ["personal", "confidential"],
  "permissions": {
    "allow_read": [
      "active/shared/runtime/dot/confidential/${KYBERION_TENANT}/",
      "active/shared/runtime/service-bindings/",
      "knowledge/personal/members/",
      "knowledge/personal/tenants/${KYBERION_TENANT}.json",
      "active/organizations/confidential/${KYBERION_TENANT}/",
      "active/organizations/public/${KYBERION_TENANT}/",
      "active/projects/confidential/${KYBERION_TENANT}/",
      "active/projects/public/${KYBERION_TENANT}/",
      "active/shared/runtime/projects/",
      "active/shared/runtime/surface-management/confidential/${KYBERION_TENANT}/"
    ],
    "allow_write": [],
    "narrow": {
      "deny": ["write", "mkdir"],
      "deny_reason": "[RESOURCE_SCOPE_REQUIRED] Management reader needs a read-only tenant capability",
      "require_scope": {
        "reason": "[RESOURCE_SCOPE_REQUIRED] Management reader needs a read-only tenant capability"
      }
    }
  }
}
