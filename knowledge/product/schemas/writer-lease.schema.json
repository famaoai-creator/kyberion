{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "writer-lease.schema.json",
  "title": "Fenced writer lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_id", "owner_id", "fence", "expires_at_ms"],
  "properties": {
    "resource_id": { "type": "string", "minLength": 1 },
    "owner_id": { "type": "string", "minLength": 1 },
    "fence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "expires_at_ms": { "type": "number", "minimum": 0 },
    "resource_kind": {
      "type": "string",
      "enum": ["work_item", "mission", "path", "device", "dot_slot"]
    },
    "acquired_at_ms": { "type": "number", "minimum": 0 },
    "renewed_at_ms": { "type": "number", "minimum": 0 },
    "attributes": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  }
}
