{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "gates"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scope", "owner", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "enum": ["pr", "full", "release"] },
          "executable": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "script": { "type": "string", "minLength": 1 },
          "timeout_ms": { "type": "integer", "minimum": 1 },
          "baseline": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          { "required": ["script"], "not": { "required": ["executable"] } },
          { "required": ["executable", "args"], "not": { "required": ["script"] } }
        ],
        "additionalProperties": false
      }
    },
    "workflow_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workflow", "script", "reason"],
        "properties": {
          "workflow": { "type": "string", "minLength": 1 },
          "script": { "type": "string", "pattern": "^check:[A-Za-z0-9_-]+$" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
