{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "approval-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "intent_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "payload_field": { "type": "string", "minLength": 1 },
              "any_of": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            }
          },
          "requires_approval": { "type": "boolean" },
          "missing_requirements": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "requires_approval", "missing_requirements"]
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "requires_approval": { "type": "boolean" } },
      "required": ["requires_approval"]
    }
  },
  "required": ["rules", "defaults"]
}
