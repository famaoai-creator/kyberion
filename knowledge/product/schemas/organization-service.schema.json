{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/organization-service.schema.json",
  "title": "Organization Service or Process Record",
  "type": "object",
  "required": [
    "version",
    "service_id",
    "organization_id",
    "domain_id",
    "name",
    "outcome",
    "owner_role",
    "consumers",
    "slo",
    "slis",
    "runbook_refs",
    "escalation_path",
    "dependencies",
    "tier",
    "status",
    "updated_at"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "service_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "organization_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "domain_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "owner_role": { "type": "string", "minLength": 1 },
    "consumers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "slo": {
      "type": "object",
      "required": ["target", "measurement_window"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "measurement_window": { "type": "string", "minLength": 1 },
        "objective": { "type": "number", "minimum": 0, "maximum": 1 },
        "unit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "slis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sli_id", "name", "source_ref", "freshness_seconds"],
        "properties": {
          "sli_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "minLength": 1 },
          "freshness_seconds": { "type": "integer", "minimum": 1 },
          "threshold": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "runbook_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "escalation_path": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "tier": { "type": "string", "enum": ["personal", "confidential", "public"] },
    "tenant_slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$",
      "not": { "enum": ["public", "confidential", "personal", "shared"] }
    },
    "status": { "type": "string", "enum": ["draft", "active", "degraded", "paused", "retired"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "required": ["tier"], "properties": { "tier": { "const": "confidential" } } },
      "then": { "required": ["tenant_slug"] }
    }
  ]
}
