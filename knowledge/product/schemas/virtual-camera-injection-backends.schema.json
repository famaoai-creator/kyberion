{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "virtual-camera-injection-backends.schema.json",
  "title": "Virtual Camera Injection Backend Registry",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "backend_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "priority": {
            "type": "integer"
          },
          "requires_device_path": {
            "type": "boolean"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1000
          },
          "command_args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "host_plan": {
            "type": "object",
            "properties": {
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "camera": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "backend_id",
          "platforms",
          "priority",
          "requires_device_path",
          "timeout_ms",
          "command_args"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "backends"],
  "additionalProperties": false
}
