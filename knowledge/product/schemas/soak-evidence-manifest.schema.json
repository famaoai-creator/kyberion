{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/soak-evidence-manifest.schema.json",
  "title": "Soak evidence manifest",
  "description": "Cumulative validation state for a live soak evidence directory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "started_at",
    "last_run_at",
    "run_count",
    "total_cycles",
    "window_days_equivalent",
    "last_validation"
  ],
  "properties": {
    "version": { "const": "1.0" },
    "started_at": { "type": "string", "format": "date-time" },
    "last_run_at": { "type": "string", "format": "date-time" },
    "run_count": { "type": "integer", "minimum": 1 },
    "total_cycles": { "type": "integer", "minimum": 0 },
    "window_days_equivalent": { "type": "number", "minimum": 0 },
    "last_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "regression_count", "issues"],
      "properties": {
        "ok": { "type": "boolean" },
        "regression_count": { "type": "integer", "minimum": 0 },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
