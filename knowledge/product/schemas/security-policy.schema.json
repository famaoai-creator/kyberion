{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "security-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "default_allow": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "volatile_face_policy": { "type": "object", "additionalProperties": true },
    "tenant_scope": { "type": "object", "additionalProperties": true },
    "tier_restrictions": { "type": "object", "additionalProperties": true },
    "persona_permissions": {
      "description": "Deprecated (S4 slice 4): the Execution Persona bundles are base Authority Roles (authority-roles/base_<persona>.json, projected into authority_role_permissions). Read only from an installation catalog that predates them, for one release.",
      "type": "object",
      "additionalProperties": true
    },
    "authority_role_permissions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "narrow": { "$ref": "#/$defs/narrow_declaration" }
        }
      }
    },
    "store_grants": {
      "description": "S4 (ADR concept-model-v2 D6): store grants that replaced store-only Authority Roles. Not roles: never assumable and never in the authority role registry. A store facade issues one with authority.ts withStoreGrant; while it is live its operations are exactly this declaration, bound to the issuance tenant/organization. The names are listed in libs/core/foundation/declared-store-grant.ts.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "allow_read": { "type": "array", "items": { "type": "string" } },
          "allow_write": { "type": "array", "items": { "type": "string" } },
          "deny_read": { "type": "array", "items": { "type": "string" } },
          "deny_read_descendants": { "type": "array", "items": { "type": "string" } },
          "narrow": { "$ref": "#/$defs/narrow_declaration" }
        }
      }
    },
    "authority_permissions": { "type": "object", "additionalProperties": true },
    "project_permissions": { "type": "object", "additionalProperties": true },
    "network_guardrails": { "type": "object", "additionalProperties": true },
    "a2a_policy": { "type": "object", "additionalProperties": true },
    "quality_requirements": { "type": "object", "additionalProperties": true }
  },
  "required": [
    "version",
    "default_allow",
    "volatile_face_policy",
    "tenant_scope",
    "tier_restrictions",
    "authority_role_permissions"
  ],
  "$defs": {
    "resource_operation": {
      "type": "string",
      "enum": ["read", "write", "append", "mkdir", "metadata"]
    },
    "deniable_operation": {
      "type": "string",
      "enum": ["read", "write", "mkdir", "metadata"]
    },
    "resource_access_custody": {
      "type": "string",
      "enum": ["system", "tenant", "person"]
    },
    "narrow_path_rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 }
      },
      "anyOf": [{ "required": ["path"] }, { "required": ["prefix"] }, { "required": ["pattern"] }]
    },
    "narrow_declaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deny": {
          "type": "array",
          "items": { "$ref": "#/$defs/deniable_operation" },
          "minItems": 1
        },
        "deny_reason": { "type": "string", "minLength": 1 },
        "only": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/deniable_operation" },
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/narrow_path_rule" },
            "minItems": 1
          }
        },
        "only_reason": { "type": "string", "minLength": 1 },
        "content_check": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "kind": { "const": "append_only_jsonl" },
              "id_field": { "type": "string", "minLength": 1 },
              "refusal_prefix": { "type": "string", "minLength": 1 }
            },
            "required": ["path", "kind", "id_field"]
          },
          "minItems": 1
        },
        "require_scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            },
            "custody": {
              "anyOf": [
                { "$ref": "#/$defs/resource_access_custody" },
                {
                  "type": "array",
                  "items": { "$ref": "#/$defs/resource_access_custody" },
                  "minItems": 1
                }
              ]
            },
            "exact": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "read_only": { "type": "boolean" },
                "read_path_pattern": { "type": "string", "minLength": 1 },
                "read_path_tenant_group": { "type": "integer", "minimum": 1 },
                "allow_product_knowledge_read": { "type": "boolean" }
              }
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "structural_mkdir": { "type": "boolean" }
      }
    }
  }
}
