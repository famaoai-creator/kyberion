{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/documentation-source-map.schema.json",
  "title": "Documentation source map",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "categories", "entrypoints"],
  "properties": {
    "manifest_version": { "const": 1 },
    "last_reviewed": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "canonical"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "canonical": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\\\/])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
          },
          "canonical_scope": { "type": "string", "minLength": 1 },
          "index": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\\\/])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
          },
          "supporting": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![\\\\/])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
            }
          },
          "historical": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![\\\\/])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
            }
          },
          "scoped_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scope", "path"],
              "properties": {
                "scope": { "type": "string", "minLength": 1 },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![\\\\/])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
                }
              }
            }
          }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![\\\\/])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
      }
    }
  }
}
