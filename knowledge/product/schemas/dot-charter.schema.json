{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/dot-charter.schema.json",
  "title": "Dot Charter",
  "description": "Standing charter for a resident agent ('dot'): a durable responsibility that persists across sessions. The charter declares what the dot cares about (goal), when it wakes (attention), what it may do alone (authority via an existing authority role + optional accountability charter), and how it reaches the accountable human (notification). It never grants authority — it references roles that already exist in security-policy.json.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stateProbe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "expect"],
          "properties": {
            "type": { "const": "file" },
            "path": { "type": "string", "minLength": 1 },
            "expect": { "enum": ["exists", "changed", "matches"] },
            "regex": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "service_id", "action"],
          "properties": {
            "type": { "const": "service_preset" },
            "service_id": { "type": "string", "minLength": 1 },
            "action": { "type": "string", "minLength": 1 },
            "params": { "type": "object" },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "json_path": { "type": "string" },
                "equals": {},
                "not_equals": {},
                "changed": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "keyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kr_id", "title", "metric", "target", "direction"],
      "properties": {
        "kr_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "metric": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "probe"],
              "properties": {
                "source": { "const": "probe" },
                "probe": { "$ref": "#/definitions/stateProbe" },
                "aggregate": { "enum": ["value", "count"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "path", "json_path"],
              "properties": {
                "source": { "const": "file" },
                "path": { "type": "string", "minLength": 1 },
                "json_path": { "type": "string", "minLength": 1 },
                "aggregate": { "enum": ["value", "count"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "signal"],
              "properties": {
                "source": { "const": "signal_ratio" },
                "signal": { "type": "string", "minLength": 1, "maxLength": 300 },
                "window_hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 720 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "metric"],
              "properties": {
                "source": { "const": "org_metric" },
                "metric": {
                  "enum": [
                    "overdue_operations",
                    "open_incidents",
                    "pending_decisions",
                    "unhealthy_services"
                  ]
                }
              }
            }
          ]
        },
        "target": { "type": "number" },
        "direction": { "enum": ["increase", "decrease", "maintain"] },
        "baseline": { "type": "number" },
        "unit": { "type": "string", "maxLength": 40 },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "every_s": { "type": "integer", "minimum": 60 },
        "settle_minutes": { "type": "integer", "minimum": 0, "maximum": 10080 }
      }
    }
  },
  "required": [
    "kind",
    "dot_id",
    "version",
    "title",
    "purpose",
    "status",
    "scope",
    "goal",
    "attention",
    "authority",
    "notification",
    "runtime"
  ],
  "properties": {
    "kind": { "const": "dot-charter" },
    "dot_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 2,
      "maxLength": 64
    },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "The standing responsibility this dot owns, in one or two sentences."
    },
    "status": { "enum": ["draft", "active", "paused", "retired"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier"],
      "properties": {
        "tier": { "enum": ["public", "confidential", "personal"] },
        "tenant_slug": { "type": "string" },
        "organization_id": { "type": "string" },
        "project_id": { "type": "string" }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "The durable goal text handed to the worker-goal-driver each wake cycle."
        },
        "success_signals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Observable conditions that mean the responsibility is healthy."
        },
        "signal_probes": {
          "type": "array",
          "maxItems": 20,
          "description": "Measurable form of success_signals: each signal is healthy while its probe matches. Measured by the resident sweep and shown in `dot status`, the digest, and the next wake prompt.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signal", "probe"],
            "properties": {
              "signal": { "type": "string", "minLength": 1, "maxLength": 300 },
              "probe": { "$ref": "#/definitions/stateProbe" },
              "every_s": { "type": "integer", "minimum": 60 }
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_turns_per_wake": { "type": "integer", "minimum": 1 },
            "wall_clock_ms_per_wake": { "type": "integer", "minimum": 1000 },
            "token_cap_per_day": { "type": "integer", "minimum": 1 }
          }
        },
        "key_results": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/definitions/keyResult" },
          "description": "Quantified key results (metric, target, direction) measured by the resident sweep; drives goal-gap prompts and outcome checks."
        },
        "outcome_settle_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080,
          "description": "Default minutes to wait after a delegated action completes before measuring its outcome (default 60)."
        }
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers"],
      "properties": {
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "cron"],
                "properties": {
                  "kind": { "const": "cron" },
                  "cron": { "type": "string", "minLength": 9 },
                  "timezone": { "type": "string" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "paths"],
                "properties": {
                  "kind": { "const": "watch" },
                  "paths": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "channels"],
                "properties": {
                  "kind": { "const": "wake" },
                  "channels": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "enum": ["slack", "telegram", "discord", "imessage", "surface", "inbox"]
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "probe"],
                "properties": {
                  "kind": { "const": "probe" },
                  "probe": { "$ref": "#/definitions/stateProbe" },
                  "every_s": { "type": "integer", "minimum": 10 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "sources"],
                "properties": {
                  "kind": { "const": "event" },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" }
                  },
                  "types": {
                    "type": "array",
                    "maxItems": 50,
                    "items": { "type": "string", "minLength": 1, "maxLength": 200 }
                  },
                  "match": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["json_path"],
                    "properties": {
                      "json_path": { "type": "string", "minLength": 1 },
                      "equals": {},
                      "in": { "type": "array", "maxItems": 50 }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_role"],
      "properties": {
        "authority_role": {
          "type": "string",
          "description": "Must be a role declared in security-policy.json authority_role_permissions."
        },
        "accountability_charter_ref": {
          "type": "string",
          "description": "Optional reference to a governance accountability-charter that bounds delegated authority."
        },
        "allowed_work_shapes": {
          "type": "array",
          "items": { "enum": ["mission", "task_session", "pipeline", "direct_reply"] },
          "description": "Work shapes the dot may dispatch. The dot itself never writes outside its authority role's scopes; substantive work is delegated as WorkItems."
        },
        "max_concurrent_delegations": { "type": "integer", "minimum": 1 },
        "allowed_pipelines": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 },
          "description": "Repo-relative pipeline files the dot executor may run for pipeline-shaped work. Empty/absent means no pipeline execution."
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_decision": {
          "enum": ["auto", "notify", "approve"],
          "description": "Floor for autonomous-ops-gate outcomes: an action scoring 'auto' may be raised to this level, never lowered."
        },
        "veto_window_minutes": { "type": "integer", "minimum": 0 },
        "decision_expiry_minutes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 10080,
          "description": "How long a proposal may wait on the operator before it expires and frees its delegation slot (default 1440). Expiry is not a rejection: it does not raise the learned floor."
        },
        "escalate_channel": {
          "enum": ["slack", "telegram", "discord", "imessage", "surface"],
          "description": "Channel used when the gate returns 'approve'."
        }
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliver_to"],
      "properties": {
        "deliver_to": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surface", "channel"],
          "properties": {
            "surface": { "enum": ["slack", "telegram", "discord", "imessage", "surface"] },
            "channel": { "type": "string", "minLength": 1, "maxLength": 500 },
            "thread_ts": { "type": "string", "maxLength": 500 },
            "template": { "type": "string", "minLength": 1, "maxLength": 8000 }
          }
        },
        "digest_cron": {
          "type": "string",
          "minLength": 9,
          "description": "Optional cron for a periodic digest of what the dot did, is waiting on, and needs."
        },
        "quiet_hours": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "timezone": { "type": "string" }
          }
        },
        "delivery_mode": {
          "enum": ["inbox", "live"],
          "description": "`inbox` (default) lands every notification, decision card, and digest in the local inbox; `live` routes them to deliver_to. Opting into live sends is an explicit charter edit."
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "responsibilities": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$", "maxLength": 100 },
          "description": "Exclusive responsibility keys. Activation is refused while another active dot holds the same key."
        },
        "accepts_handoffs_from": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "description": "dot_ids allowed to hand work to this dot; a handoff wakes this dot through the dot inbox."
        },
        "goal_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["objective_id"],
              "properties": {
                "organization_id": { "type": "string", "minLength": 1, "maxLength": 200 },
                "objective_id": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          ],
          "description": "Organization-level goal this dot contributes to: a free-text label, or a reference to an organization objective."
        },
        "owns": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": "Target patterns (path:<glob>, service:<id>, ...) this dot owns; the sole owner wins arbitration."
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Arbitration priority (default 50)."
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heartbeat_id"],
      "properties": {
        "heartbeat_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Daemon heartbeat id the resident runtime records under; watched by daemon-watchdog."
        },
        "reasoning_backend": {
          "type": "string",
          "description": "Optional reasoning-backend-policy allowed_modes entry; defaults to auto-discovery."
        },
        "max_idle_wake_ms": {
          "type": "integer",
          "minimum": 60000,
          "description": "Upper bound between wakes even when no trigger fires (self-check cadence)."
        },
        "cron_catch_up_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24,
          "description": "How far back missed cron runs are coalesced into one catch-up wake after downtime (default 6)."
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "max_bytes": { "type": "integer", "minimum": 1024, "maximum": 65536 }
      },
      "description": "Per-dot working memory (notes, open items, hypotheses)."
    },
    "followups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_pending": { "type": "integer", "minimum": 0, "maximum": 20 }
      },
      "description": "Self-scheduled follow-up wakes."
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial_level": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "max_level": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "min_level": { "enum": ["L0", "L1", "L2", "L3", "L4"] }
      },
      "description": "Autonomy ladder bounds (L0 shadow .. L4 autonomous)."
    }
  }
}
