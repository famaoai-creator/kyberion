{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tenant-registry-exceptions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_meta": { "type": "string", "minLength": 1 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["slug", "reason"]
      }
    }
  },
  "required": ["_meta", "exceptions"]
}
