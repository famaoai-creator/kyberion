{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project-standards.schema.json",
  "title": "Project traversal standards",
  "description": "Directories and extensions ignored by the governed repository file walker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ignore_dirs", "ignore_extensions"],
  "properties": {
    "$schema": { "type": "string" },
    "ignore_dirs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "ignore_extensions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9][A-Za-z0-9._-]*$" }
    }
  }
}
