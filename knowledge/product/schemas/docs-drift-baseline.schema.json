{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "docs-drift-baseline.schema.json",
  "title": "Docs drift baseline",
  "description": "Known exceptions for scripts/check_docs_drift.ts. Each entry needs a reason; stale entries fail the gate so the list only shrinks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["exceptions"],
  "properties": {
    "$schema": { "type": "string" },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "reason"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
