{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scheduler-ops-alert-days.schema.json",
  "title": "Scheduler operations alert day marker",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
