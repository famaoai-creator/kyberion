{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/organization-operation-run.schema.json",
  "title": "Organization Operation Run Evidence",
  "type": "object",
  "required": [
    "run_id",
    "operation_id",
    "organization_id",
    "tier",
    "status",
    "started_at",
    "recorded_at"
  ],
  "properties": {
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "operation_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "organization_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "tier": { "type": "string", "enum": ["personal", "confidential", "public"] },
    "tenant_slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$",
      "not": { "enum": ["public", "confidential", "personal", "shared"] }
    },
    "status": {
      "type": "string",
      "enum": ["started", "succeeded", "failed", "blocked", "cancelled"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "execution_ref": { "type": "string" },
    "result_summary": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "exception_refs": { "type": "array", "items": { "type": "string" } },
    "recorded_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "required": ["tier"], "properties": { "tier": { "const": "confidential" } } },
      "then": { "required": ["tenant_slug"] }
    }
  ]
}
