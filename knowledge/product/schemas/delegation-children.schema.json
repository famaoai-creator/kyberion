{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "delegation-children.schema.json",
  "title": "Persisted delegation child registry",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "provider": { "type": "string", "minLength": 1 },
      "pid": { "type": ["number", "null"] },
      "startedAt": { "type": "string", "minLength": 1 },
      "deadlineAt": { "type": "string", "minLength": 1 },
      "budgetMs": { "type": "number" },
      "pidStartedAt": { "type": "string", "minLength": 1 }
    },
    "required": ["id", "provider", "startedAt", "deadlineAt", "budgetMs"]
  }
}
