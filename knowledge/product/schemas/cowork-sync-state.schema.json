{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cowork-sync-state.schema.json",
  "title": "Persisted Cowork knowledge sync state",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "ingested": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "supplied": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "last_sync_at": { "type": "string", "format": "date-time" }
  },
  "required": ["ingested", "supplied", "last_sync_at"]
}
