{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "health-thresholds.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "regression_multiplier": { "type": "number" },
    "red_regressions": { "type": "number" },
    "red_demoted_providers": { "type": "number" },
    "rss_growth_warning_ratio": { "type": "number" },
    "rss_growth_red_ratio": { "type": "number" },
    "restart_warning_count": { "type": "number" },
    "restart_red_count": { "type": "number" },
    "trend_window_ms": { "type": "number" }
  },
  "required": [
    "version",
    "regression_multiplier",
    "red_regressions",
    "red_demoted_providers",
    "rss_growth_warning_ratio",
    "rss_growth_red_ratio",
    "restart_warning_count",
    "restart_red_count",
    "trend_window_ms"
  ]
}
