{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meeting-join-driver-modules.schema.json",
  "title": "Meeting Join Driver Module Registry",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "driver_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "module": {
            "type": "string",
            "pattern": "^@(agent|actuator)/[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*$"
          },
          "fallback_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["driver_id", "module"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "drivers"],
  "additionalProperties": false
}
