{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knowledge-ranking-weight-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "scope": { "$ref": "#/$defs/tenantScope" },
    "approval_required": { "const": true },
    "status": { "enum": ["proposed", "insufficient_data"] },
    "sample": { "$ref": "#/$defs/sample" },
    "current_weights": { "$ref": "#/$defs/weights" },
    "proposed_weights": { "$ref": "#/$defs/weights" },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "output_path": { "type": "string", "minLength": 1 }
  },
  "required": [
    "generated_at",
    "scope",
    "approval_required",
    "status",
    "sample",
    "current_weights",
    "proposed_weights",
    "rationale"
  ],
  "$defs": {
    "tenantScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": { "const": "confidential" },
        "tenant_slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" }
      },
      "required": ["tier", "tenant_slug"]
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "type": "number", "minimum": 0, "maximum": 100 },
        "authority": { "type": "number", "minimum": 0, "maximum": 100 },
        "recency": { "type": "number", "minimum": 0, "maximum": 100 },
        "proximity": { "type": "number", "minimum": 0, "maximum": 100 },
        "usage_yield": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_count": { "type": "integer", "minimum": 0 },
        "feedback_events": { "type": "integer", "minimum": 0 },
        "used_events": { "type": "integer", "minimum": 0 },
        "not_used_events": { "type": "integer", "minimum": 0 },
        "usage_yield": {
          "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
        }
      },
      "required": [
        "document_count",
        "feedback_events",
        "used_events",
        "not_used_events",
        "usage_yield"
      ]
    }
  }
}
