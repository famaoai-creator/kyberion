{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/resource-usage.schema.json",
  "title": "Resource Usage Ledger Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "usage_id",
    "timestamp",
    "resource_kind",
    "quantity",
    "unit",
    "cost_usd",
    "status",
    "source"
  ],
  "properties": {
    "type": { "const": "resource_usage" },
    "usage_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "resource_kind": {
      "type": "string",
      "enum": ["llm", "api", "compute", "saas", "human_time", "other"]
    },
    "actor_id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "minLength": 1 },
    "customer_id": { "type": "string", "minLength": 1 },
    "cost_center": { "type": "string", "minLength": 1 },
    "quantity": { "type": "number", "minimum": 0 },
    "unit": { "type": "string", "minLength": 1 },
    "unit_cost_usd": { "type": "number", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "status": { "type": "string", "enum": ["actual", "estimated", "committed"] },
    "source": { "type": "string", "minLength": 1 },
    "scope_invalid": {
      "const": true,
      "description": "The producer's scope could not be placed: the row keeps its tier (unknown tier fails closed to confidential) and its own valid tenant, else the bound tenant or the shared segment; a tenant-less public row is a system row (libs/core/metrics.ts PartitionedMetricsLedger.append)."
    },
    "cause": {
      "type": "string",
      "enum": [
        "assistant",
        "tool",
        "hook",
        "compaction",
        "branch_summary",
        "deferred_fetch",
        "judge",
        "subagent",
        "repair",
        "adjustment"
      ]
    },
    "scope": {
      "type": "object",
      "required": ["scope_kind", "tier"],
      "properties": {
        "scope_kind": {
          "type": "string",
          "enum": ["system", "tenant", "organization", "project", "mission", "task", "session"]
        },
        "tier": { "type": "string", "enum": ["personal", "confidential", "public"] },
        "tenant_slug": { "type": "string" },
        "organization_id": { "type": "string" },
        "project_id": { "type": "string" },
        "mission_id": { "type": "string" },
        "task_id": { "type": "string" },
        "session_id": { "type": "string" },
        "nhi_id": { "type": "string" },
        "work_shape": { "type": "string" }
      },
      "additionalProperties": true
    },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
