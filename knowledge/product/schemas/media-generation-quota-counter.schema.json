{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/media-generation-quota-counter.schema.json",
  "title": "Media Generation Quota Counter",
  "description": "Tenant and UTC-day bound persisted generation quota usage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_slug", "date", "units", "updated_at"],
  "properties": {
    "tenant_slug": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "units": { "type": "number", "minimum": 0 },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
