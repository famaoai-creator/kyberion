{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "standing-mandates.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "external_effect_patterns", "mandates"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "default_expiry_days": { "type": "integer", "minimum": 1 },
    "external_effect_patterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "mandates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "work_type_patterns",
          "allowed_path_globs",
          "max_risk_level",
          "expires_at"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "work_type_patterns": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "allowed_path_globs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "max_risk_level": { "type": "integer", "minimum": 0, "maximum": 5 },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
