{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate-ai-assessment.schema.json",
  "title": "Gate AI assessment",
  "description": "AI evaluation of a phase gate, consumed as judgment input by the human governance body (会議体). The assessment recommends a verdict with a confidence score; the human decision recorded in gate-decision-record.json remains the authority and is bound to this assessment via ai_assessment_sha256. Mirrors libs/core/mission/gate-ai-assessment.ts GateAiAssessmentSchema.",
  "type": "object",
  "required": ["kind", "gate_id", "assessed_at", "recommended_verdict", "confidence", "criteria"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "gate-ai-assessment" },
    "version": { "type": "string" },
    "mission_id": { "type": "string", "minLength": 1 },
    "gate_id": {
      "type": "string",
      "minLength": 1,
      "description": "gate_id from gate-profile-registry.json (e.g. gate-release-readiness) or a mission_gate_id from the mission workflow catalog."
    },
    "governance_body": {
      "type": "string",
      "minLength": 1,
      "description": "governance-bodies/ registry id of the review body this assessment feeds."
    },
    "assessed_at": { "type": "string", "minLength": 1 },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": { "type": "string" },
        "model_tier": { "type": "string" },
        "agent": { "type": "string" }
      }
    },
    "recommended_verdict": {
      "type": "string",
      "enum": ["go", "conditional_go", "no_go", "hold"],
      "description": "Advisory verdict. Not authority — the human governance body decides."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Assessor's confidence in the recommendation. Below the gate policy minimum the review body cannot convene (human override possible)."
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "status"],
        "additionalProperties": false,
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["met", "partial", "unmet", "unknown"] },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      },
      "description": "Per exit-criterion evaluation — one entry per gate exit_criteria / entry criterion evaluated."
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "status"],
        "additionalProperties": false,
        "properties": {
          "artifact": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["present", "missing", "insufficient"] },
          "ref": { "type": "string" }
        }
      }
    },
    "evaluated_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "description": "sha256 binding to the evidence the assessor read. A changed input invalidates the assessment."
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition"],
        "additionalProperties": false,
        "properties": {
          "condition": { "type": "string", "minLength": 1 },
          "owner": { "type": "string" },
          "due": { "type": "string" }
        }
      },
      "description": "Required when recommended_verdict is conditional_go."
    },
    "notes": { "type": "string" }
  }
}
