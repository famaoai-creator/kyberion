{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cli-commands.schema.json",
  "title": "Kyberion CLI command registry",
  "description": "The governed command-to-entrypoint map used by the kyberion CLI router.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "commands", "entrypoints"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entrypoint" }
    },
    "script_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scriptCommand" }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "noun", "verb", "entry", "audience"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string" },
        "noun": { "type": "string", "minLength": 1 },
        "verb": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "enum": ["user", "operator", "dev"] }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module", "commands"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "scriptCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "noun", "verb", "audience"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "command": { "type": "string", "minLength": 1 },
        "noun": { "type": "string", "minLength": 1 },
        "verb": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "enum": ["user", "operator", "dev"] }
      },
      "oneOf": [{ "required": ["script"] }, { "required": ["module"] }]
    }
  }
}
