{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cli-commands.schema.json",
  "title": "Kyberion CLI command registry",
  "description": "The governed command-to-entrypoint map used by the kyberion CLI router.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "commands", "entrypoints"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entrypoint" }
    },
    "script_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scriptCommand" }
    },
    "deprecated_script_aliases": {
      "description": "Renamed package scripts kept as warning aliases; excluded from the package-script ratchet.",
      "type": "array",
      "items": { "$ref": "#/$defs/deprecatedScriptAlias" }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "noun", "verb", "entry", "audience", "description", "group"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string" },
        "noun": { "type": "string", "minLength": 1 },
        "verb": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "enum": ["user", "operator", "dev"] },
        "description": { "$ref": "#/$defs/descriptionKey" },
        "group": { "$ref": "#/$defs/group" },
        "caution": { "$ref": "#/$defs/cautionKey" }
      }
    },
    "descriptionKey": {
      "description": "Vocabulary key (cli namespace) with the en/ja one-line summary shown by kyberion --help.",
      "type": "string",
      "pattern": "^cli_cmd_[a-z0-9_]+$"
    },
    "cautionKey": {
      "description": "Vocabulary key (cli namespace) for a caution line shown under the summary.",
      "type": "string",
      "pattern": "^cli_caution_[a-z0-9_]+$"
    },
    "group": {
      "description": "Task grouping for kyberion --help; dev is hidden unless --all.",
      "type": "string",
      "enum": ["start", "inspect", "operate", "dev"]
    },
    "deprecatedScriptAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "replaced_by"],
      "properties": {
        "script": { "type": "string", "minLength": 1 },
        "replaced_by": { "type": "string", "minLength": 1 }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module", "commands"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "scriptCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "noun", "verb", "audience", "description", "group"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "command": { "type": "string", "minLength": 1 },
        "noun": { "type": "string", "minLength": 1 },
        "verb": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "enum": ["user", "operator", "dev"] },
        "description": { "$ref": "#/$defs/descriptionKey" },
        "group": { "$ref": "#/$defs/group" },
        "caution": { "$ref": "#/$defs/cautionKey" },
        "interactive": {
          "description": "Needs the operator terminal (stdin/TTY); the router runs it with inherited stdio and no timeout.",
          "type": "boolean"
        },
        "long_running": {
          "description": "May run for minutes or indefinitely; the router streams output with no timeout.",
          "type": "boolean"
        },
        "native_help": {
          "description": "The target handles --help/-h itself before any side effect; otherwise the router answers --help from this registry.",
          "type": "boolean"
        },
        "same_target_as": {
          "description": "Governed command id this '<noun> default' entry shares a name with because it is the same target.",
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [{ "required": ["script"] }, { "required": ["module"] }]
    }
  }
}
