{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kyberion Pipeline ADF",
  "type": "object",
  "required": ["steps"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["pipeline"]
    },
    "id": { "type": "string" },
    "pipeline_id": { "type": "string" },
    "name": {
      "type": "string"
    },
    "version": { "type": "string" },
    "description": {
      "type": "string"
    },
    "labels": {},
    "expected_outcome": {},
    "parameters": {},
    "variables": {},
    "inputs": {},
    "fallback_pipeline": { "type": "string" },
    "knowledge_scope": {},
    "env": { "type": "object" },
    "session_id": { "type": "string" },
    "context": {
      "type": "object"
    },
    "options": {
      "type": "object",
      "properties": {
        "max_steps": {
          "type": "number"
        },
        "timeout_ms": {
          "type": "number"
        },
        "max_concurrency": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    },
    "schedule": {
      "type": "object",
      "required": ["cron"],
      "properties": {
        "id": { "type": "string" },
        "cron": { "type": "string", "minLength": 9 },
        "timezone": { "type": "string" },
        "enabled": { "type": "boolean" },
        "deliver_to": {
          "type": "object",
          "required": ["surface", "channel"],
          "properties": {
            "surface": { "type": "string", "enum": ["slack", "telegram", "discord", "imessage"] },
            "channel": { "type": "string", "minLength": 1, "maxLength": 500 },
            "thread_ts": { "type": "string", "maxLength": 500 },
            "template": { "type": "string", "minLength": 1, "maxLength": 8000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "comment": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["capture", "transform", "apply", "control"]
        },
        "role": {
          "type": "string",
          "enum": ["source", "transform", "sink", "gate"]
        },
        "op": { "type": "string", "minLength": 1 },
        "effort": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "budget": {
          "type": "object",
          "properties": {
            "cost_cap_tokens": { "type": "number", "minimum": 1 },
            "max_prompt_chars": { "type": "number", "minimum": 1 },
            "max_response_chars": { "type": "number", "minimum": 1 },
            "max_combined_chars": { "type": "number", "minimum": 1 },
            "approval_required": { "type": "boolean" },
            "approval_ref": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "reasoning": {
          "type": "object",
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "mode": { "type": "string", "minLength": 1 },
            "profile": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "model_tier": { "type": "string", "enum": ["fast", "standard", "deep"] },
            "permission_mode": { "type": "string", "enum": ["readonly", "edit", "full"] },
            "capability_profile": { "type": "string", "minLength": 1 },
            "tags": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "promotion": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "after_failures": { "type": "integer", "minimum": 1 },
                  "after_iterations": { "type": "integer", "minimum": 1 },
                  "provider": { "type": "string", "minLength": 1 },
                  "mode": { "type": "string", "minLength": 1 },
                  "profile": { "type": "string", "minLength": 1 },
                  "model": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false,
                "minProperties": 2
              }
            }
          },
          "additionalProperties": false
        },
        "facets": {
          "type": "object",
          "properties": {
            "persona": { "type": "string", "minLength": 1 },
            "policies": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "instructions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "output_contract": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "report": {
          "oneOf": [
            {
              "type": "object",
              "required": ["schema_ref"],
              "properties": {
                "schema_ref": { "type": "string", "minLength": 1 },
                "use_judge": { "type": "boolean" },
                "order": { "type": "integer", "minimum": 0 },
                "export_as": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["schema_ref"],
                "properties": {
                  "schema_ref": { "type": "string", "minLength": 1 },
                  "use_judge": { "type": "boolean" },
                  "order": { "type": "integer", "minimum": 0 },
                  "export_as": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            }
          ]
        },
        "params": { "type": "object" },
        "produces": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "required": ["channel"],
              "properties": {
                "channel": { "type": "string", "minLength": 1 },
                "type": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        },
        "consumes": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "on_error": {
          "type": "object",
          "required": ["strategy"],
          "properties": {
            "strategy": { "type": "string", "enum": ["skip", "abort", "fallback"] },
            "fallback": {
              "type": "array",
              "items": { "$ref": "#/definitions/step" }
            },
            "ref": { "type": "string" },
            "bind": { "type": "object" },
            "remediation": { "type": "string" }
          },
          "additionalProperties": false
        },
        "hooks": {
          "type": "object",
          "properties": {
            "before": { "$ref": "#/definitions/hookList" },
            "after": { "$ref": "#/definitions/hookList" }
          },
          "additionalProperties": false
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "resource_claims": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "when": {
          "type": "object",
          "properties": {
            "from": { "type": "string" },
            "operator": { "type": "string" },
            "value": {},
            "conditions": { "type": "array" },
            "label": { "type": "string" },
            "field": { "type": "string" },
            "eq": {},
            "in": { "type": "array" },
            "matches": { "type": "string" }
          },
          "additionalProperties": false
        },
        "merge": { "type": "string", "enum": ["collect", "namespace", "last"] }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": { "enum": ["judge_route", "core:judge_route"] }
            }
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": { "$ref": "#/definitions/judgeRouteParams" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": { "enum": ["await_decision", "core:await_decision"] }
            }
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": { "$ref": "#/definitions/awaitDecisionParams" }
            }
          }
        }
      ]
    },
    "hookList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["actuator_op", "http", "command"] },
          "label": { "type": "string" },
          "on_reject": { "type": "string", "enum": ["abort", "skip", "warn"] },
          "op": { "type": "string" },
          "params": { "type": "object" },
          "url": { "type": "string" },
          "method": { "type": "string", "enum": ["GET", "POST"] },
          "body": { "type": "object" },
          "headers": { "type": "object" },
          "cmd": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "judgeRouteParams": {
      "type": "object",
      "required": ["routes"],
      "properties": {
        "judge": {
          "type": "object",
          "properties": {
            "role": { "type": "string" },
            "persona": { "type": "string" },
            "schema_ref": { "type": "string" },
            "prompt": { "type": "string" },
            "instruction_ref": { "type": "string" },
            "inputs": {}
          },
          "additionalProperties": false
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["next"],
            "properties": {
              "when": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "field": { "type": "string" },
                  "eq": {},
                  "in": { "type": "array" },
                  "matches": { "type": "string" }
                },
                "additionalProperties": false
              },
              "next": { "type": "string", "minLength": 1 },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "on_no_match": { "enum": ["abort", "complete", "continue"] },
        "max_route_hops": { "type": "integer", "minimum": 1 },
        "fixture": { "type": "boolean" },
        "verdict": { "type": "object" },
        "export_as": { "type": "string", "minLength": 1 },
        "verdict_as": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "awaitDecisionParams": {
      "type": "object",
      "required": ["approval"],
      "properties": {
        "approval": {
          "type": "object",
          "required": ["summary"],
          "properties": {
            "kind": { "type": "string" },
            "title": { "type": "string" },
            "summary": { "type": "string", "minLength": 1 },
            "details": { "type": "string" },
            "options": { "type": "array" },
            "decision_rights_ref": { "type": "string" },
            "severity": { "enum": ["low", "medium", "high"] }
          },
          "additionalProperties": true
        },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "timeout": { "type": "integer", "minimum": 1 },
        "on_timeout": { "enum": ["abort", "deny", "escalate"] },
        "non_interactive": { "enum": ["deny", "allow"] },
        "storage_channel": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "thread_ts": { "type": "string" },
        "export_as": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "patternProperties": {
    "^_": {}
  },
  "additionalProperties": false
}
