{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mission-workitem-dispatch-manifest.schema.json",
  "title": "Mission Work Item Dispatch Manifest",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {
    "not": { "enum": ["__proto__", "constructor", "prototype"] }
  },
  "properties": {
    "mission_id": { "type": "string", "minLength": 1 },
    "mission_type": { "type": "string", "minLength": 1 },
    "tier": { "type": "string", "enum": ["personal", "confidential", "public"] },
    "tenant_slug": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "mode": { "type": "string", "enum": ["auto", "agent", "subagent"] },
    "final_status": { "type": "string", "enum": ["review", "done", "blocked"] },
    "work_item_count": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "not": { "enum": ["__proto__", "constructor", "prototype"] }
        },
        "additionalProperties": true
      }
    },
    "manifest_path": { "type": "string", "minLength": 1 },
    "event_path": { "type": "string", "minLength": 1 }
  },
  "required": ["mission_id", "records"]
}
