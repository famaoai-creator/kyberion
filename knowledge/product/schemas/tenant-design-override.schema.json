{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/tenant-design-override.schema.json",
  "title": "Tenant Design Override",
  "description": "Confidential tenant branding and design references. Provider-specific design payloads remain extensible.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1 },
    "brand_name": { "type": "string", "minLength": 1 },
    "matchers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "design_system_id": { "type": "string", "minLength": 1 },
    "layout_template_id": { "type": "string", "minLength": 1 },
    "layout_template_catalog": { "type": "string", "minLength": 1 },
    "theme_pack_path": { "type": "string", "minLength": 1 },
    "theme": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "object" }]
    },
    "branding": { "type": "object" },
    "extracted_theme": { "type": "object" }
  }
}
