{
  "$id": "https://kyberion.internal/schemas/mcp-tool-catalog.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP tool catalog",
  "description": "Governed MCP tool visibility, bands, skill transfer, and bounded actuator invoke allowlist.",
  "type": "object",
  "required": ["pipeline_run_allowlist"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "default_tier_visibility": { "$ref": "#/$defs/tiers" },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    },
    "pipeline_run_allowlist": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "actuator_invoke_allowlist": {
      "type": "array",
      "items": { "$ref": "#/$defs/actuatorInvokeEntry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tier": { "enum": ["public", "confidential", "personal"] },
    "tiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/tier" }
    },
    "band": { "enum": ["discover", "act", "govern"] },
    "tool": {
      "type": "object",
      "required": ["name", "allowed_tiers", "allowed_caller_roles"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "category": { "type": "string", "minLength": 1 },
        "band": { "$ref": "#/$defs/band" },
        "risk_class": { "enum": ["low", "medium", "high", "critical"] },
        "requires_approval": { "type": "boolean" },
        "allowed_tiers": { "$ref": "#/$defs/tiers" },
        "allowed_caller_roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "related_actuators": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "actuatorInvokeEntry": {
      "type": "object",
      "required": ["actuator", "op"],
      "additionalProperties": false,
      "properties": {
        "actuator": { "type": "string", "minLength": 1 },
        "op": { "type": "string", "minLength": 1 },
        "risk_class": { "enum": ["low", "medium", "high", "critical"] },
        "requires_approval": { "type": "boolean" },
        "execution": { "enum": ["dry_run", "service_preset", "actuator_cli"] },
        "notes": { "type": "string" }
      }
    }
  }
}
