{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "work-inventory-calibration.schema.json",
  "title": "Work Inventory Calibration (work-inventory-calibration.v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "weights", "method_automatable", "updated_at", "history"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "work-inventory-calibration.v1" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_slug": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency", "effort", "automatable_ratio", "confidence", "risk_penalty"],
      "properties": {
        "frequency": { "type": "number" },
        "effort": { "type": "number" },
        "automatable_ratio": { "type": "number" },
        "confidence": { "type": "number" },
        "risk_penalty": { "type": "number" }
      }
    },
    "method_automatable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "program", "ai_reasoning", "computer_operation", "human"],
      "properties": {
        "api": { "type": "number", "minimum": 0, "maximum": 1 },
        "program": { "type": "number", "minimum": 0, "maximum": 1 },
        "ai_reasoning": { "type": "number", "minimum": 0, "maximum": 1 },
        "computer_operation": { "type": "number", "minimum": 0, "maximum": 1 },
        "human": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "history": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "reason", "changes"],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": { "type": "number", "minimum": 0, "maximum": 1 },
                "to": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
