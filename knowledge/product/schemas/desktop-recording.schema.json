{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/desktop-recording.schema.json",
  "title": "Desktop Procedure Recording (substrate: desktop)",
  "description": "Human demonstration recording. Execution is approval-gated through the existing OS automation bridge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recording_id",
    "source",
    "created_at",
    "target",
    "steps",
    "risk_summary",
    "recording_hash",
    "policy_version",
    "review"
  ],
  "properties": {
    "schema_version": { "const": "desktop-recording.v1" },
    "recording_id": { "type": "string", "minLength": 1 },
    "source": { "const": "desktop-capture" },
    "created_at": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "platform"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "platform": { "enum": ["darwin", "win32", "linux"] },
        "app": { "type": "string", "minLength": 1 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "op", "summary", "risk_class", "evidence"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "op": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "risk_class": { "enum": ["read", "low", "high"] },
          "selector": { "type": "object", "additionalProperties": true },
          "params": { "type": "object", "additionalProperties": true },
          "native_op": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}:[a-z0-9][a-z0-9_:-]{1,119}$"
          },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "frame_ref": { "type": "string" },
          "needs_semantic_resolution": { "type": "boolean" },
          "variable": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "classification"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
              "classification": { "enum": ["user_input", "secret_ref"] }
            }
          }
        }
      }
    },
    "risk_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_manual_review", "approval_required_count"],
      "properties": {
        "requires_manual_review": { "type": "boolean" },
        "approval_required_count": { "type": "integer", "minimum": 0 }
      }
    },
    "intent_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recording_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policy_version": { "type": "string", "minLength": 1 },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "reviewed_at": { "type": "string" },
        "reviewer": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_source", "status"],
      "properties": {
        "event_source": { "enum": ["native-cg-event-tap", "state-observation-only"] },
        "status": { "enum": ["active", "unavailable"] },
        "reason": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screen_recording": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["succeeded", "unavailable"] },
            "recording_ref": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "frame_count": { "type": "integer", "minimum": 1 },
            "fps": { "type": "number", "exclusiveMinimum": 0 },
            "reason": { "type": "string" }
          }
        }
      }
    }
  }
}
