{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cowork-health-cache.schema.json",
  "title": "Cowork health baseline cache",
  "type": "object",
  "additionalProperties": false,
  "required": ["computed_at", "ttl_ms", "value"],
  "properties": {
    "computed_at": { "type": "string", "format": "date-time" },
    "ttl_ms": { "type": "integer", "minimum": 0 },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthy", "checks", "degraded_components", "warnings"],
      "properties": {
        "healthy": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        },
        "degraded_components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    }
  }
}
