{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-role-outcome.schema.json",
  "title": "Agent role outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "task_id", "team_role", "assignee", "final_status", "recorded_at"],
  "properties": {
    "mission_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "team_role": { "type": "string", "minLength": 1 },
    "assignee": { "type": "string", "minLength": 1 },
    "final_status": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "minLength": 1 }
  }
}
