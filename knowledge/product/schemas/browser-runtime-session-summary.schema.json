{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/browser-runtime-session-summary.schema.json",
  "title": "Browser Runtime Session Summary",
  "description": "Persisted browser runtime session metadata projected by Presence Studio.",
  "type": "object",
  "additionalProperties": true,
  "required": ["session_id"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "active_tab_id": { "type": "string" },
    "cdp_url": { "type": "string" },
    "updated_at": { "type": "string" },
    "lease_status": { "type": "string" },
    "lease_expires_at": { "type": "string" },
    "retained": { "type": "boolean" },
    "tabs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["tab_id"],
        "properties": {
          "tab_id": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "title": { "type": "string" },
          "active": { "type": "boolean" }
        }
      }
    }
  }
}
