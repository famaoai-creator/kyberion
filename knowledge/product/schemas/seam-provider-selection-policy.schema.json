{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "seam-provider-selection-policy.schema.json",
  "title": "Seam provider selection policy",
  "description": "Per-seam selection policy (one file per seam under knowledge/product/governance/seam-provider-selection/): traits and purposes used to rank providers that offer the same function with different capabilities. Hard capability filtering is done by the seam's caller.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "seams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/definitions/seamPolicy"
      }
    }
  },
  "required": ["version", "seams"],
  "definitions": {
    "traitScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "seamPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seam_id": {
          "type": "string",
          "minLength": 1
        },
        "default_provider": {
          "type": "string",
          "minLength": 1
        },
        "traits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "providers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/providerProfile"
          }
        },
        "purposes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/purpose"
          }
        },
        "fallback_purpose": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Purpose used to rank eligible providers when no purpose is given and the default provider cannot run the task."
        }
      },
      "required": ["seam_id", "default_provider", "traits", "providers", "purposes"]
    },
    "providerProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/traitScore"
          }
        },
        "trait_basis": {
          "type": "object",
          "additionalProperties": {
            "enum": ["measured", "declared"]
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["traits", "trait_basis"]
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      },
      "required": ["description", "weights"]
    }
  }
}
