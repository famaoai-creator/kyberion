{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local Operator Service Connections",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "services"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serviceId",
          "label",
          "secretKey",
          "authOperation",
          "setupUrl",
          "scopeNotice",
          "probe"
        ],
        "properties": {
          "serviceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "secretKey": {
            "enum": ["ACCESS_TOKEN", "API_KEY", "BOT_TOKEN", "TOKEN"],
            "description": "Which catalog accessToken suffix holds the credential; the resolved env/document name is still verified against the endpoint's credential_suffixes."
          },
          "authOperation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "setupUrl": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 500
          },
          "scopeNotice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["baseUrl", "path", "method", "successRules"],
            "properties": {
              "baseUrl": {
                "type": "string",
                "pattern": "^https://([a-zA-Z0-9.-]|\\{\\{[a-z][a-z0-9_]{0,63}\\}\\})+(?:/[a-zA-Z0-9._/-]+)?$",
                "maxLength": 250,
                "description": "Request base URL; {{field}} placeholders resolve from pinned params or declared connectionFields only."
              },
              "path": {
                "type": "string",
                "pattern": "^$|^([a-zA-Z0-9._/@-]|\\{\\{accessToken\\}\\})+$",
                "maxLength": 150,
                "description": "Static request path; {{accessToken}} is the only permitted placeholder and resolves from the admitted service binding, never from request input."
              },
              "method": {
                "enum": ["GET", "POST"]
              },
              "params": {
                "type": "object",
                "description": "Pinned template defaults used only to resolve placeholders in the preset base_url/path (e.g. a provider's canonical hostname). Substituted into the admitted preset snapshot before execution; never sent as request data.",
                "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
                },
                "maxProperties": 4
              },
              "payload": {
                "type": "object",
                "description": "Pinned static request body for POST probes; must deep-equal the preset operation's resolved payload_template."
              },
              "connectionFields": {
                "type": "array",
                "description": "Non-secret connection document keys (host, domain, subdomain, space) allowed into base_url/path template resolution. Secret keys are never read as template values.",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "not": {
                    "enum": [
                      "access_token",
                      "bot_token",
                      "token",
                      "api_key",
                      "refresh_token",
                      "client_secret",
                      "app_token",
                      "developer_token"
                    ]
                  }
                },
                "maxItems": 4,
                "uniqueItems": true
              },
              "successRules": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field", "kind"],
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z0-9_]{0,63}(\\.[a-z][a-zA-Z0-9_]{0,63}){0,3}$",
                      "description": "Top-level or dotted response field path (up to 4 segments deep)."
                    },
                    "kind": {
                      "enum": [
                        "positive_integer",
                        "non_empty_string",
                        "non_empty_array",
                        "present",
                        "true"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
