{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local Operator Service Connections",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "services"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serviceId",
          "label",
          "secretKey",
          "authOperation",
          "setupUrl",
          "scopeNotice",
          "probe"
        ],
        "properties": {
          "serviceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "secretKey": {
            "const": "ACCESS_TOKEN"
          },
          "authOperation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "setupUrl": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 500
          },
          "scopeNotice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["baseUrl", "path", "method", "successRules"],
            "properties": {
              "baseUrl": {
                "type": "string",
                "pattern": "^https://[a-zA-Z0-9.-]+(?:/[a-zA-Z0-9._/-]+)?$",
                "maxLength": 250
              },
              "path": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9._/-]+$",
                "maxLength": 150
              },
              "method": {
                "enum": ["GET", "POST"]
              },
              "successRules": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field", "kind"],
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    },
                    "kind": {
                      "enum": ["positive_integer", "non_empty_string", "true"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
