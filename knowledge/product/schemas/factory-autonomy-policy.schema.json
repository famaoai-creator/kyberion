{
  "$id": "https://kyberion.internal/schemas/factory-autonomy-policy.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Factory autonomy policy",
  "description": "Opt-in per-tenant graduation policy for autonomous software factory shadow actions.",
  "type": "object",
  "required": ["version", "tenants"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tenants": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/tenant_policy" }
    }
  },
  "$defs": {
    "tenant_policy": {
      "type": "object",
      "required": ["enabled", "graduated_actions"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "graduated_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "mission_start_mandate",
              "ci_autofix_attempt",
              "main_sync_clean",
              "conflict_mechanical",
              "pr_merge_low",
              "pr_merge_medium",
              "auto_revert_on_main_failure"
            ]
          }
        },
        "max_parallel_missions": { "type": "integer", "minimum": 1, "maximum": 8 },
        "default_branch_prefix": { "type": "string", "pattern": "^agent/factory-$" },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    }
  }
}
