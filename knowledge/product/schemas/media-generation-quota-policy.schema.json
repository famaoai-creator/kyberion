{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/media-generation-quota-policy.schema.json",
  "title": "Media Generation Quota Policy",
  "type": "object",
  "required": ["version", "max_units_per_day", "warn_ratio", "operation_units"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "max_units_per_day": { "type": "number", "exclusiveMinimum": 0 },
    "warn_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "operation_units": {
      "type": "object",
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "tenant_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "max_units_per_day": { "type": "number", "exclusiveMinimum": 0 },
          "warn_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "operation_units": {
            "type": "object",
            "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
