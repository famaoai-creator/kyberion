{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mission class playbooks",
  "description": "Per mission class: how an AI agent should proceed (autonomy posture, stage-by-stage practice and know-how, quality bar, pitfalls, escalation, metrics).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "principles", "postures", "labels", "playbooks"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "postures": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "playbooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/playbook"
      }
    },
    "labels": {
      "type": "object",
      "required": ["ja", "en"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading_suffix",
          "posture",
          "ai_does",
          "human_decides",
          "never_ai",
          "evidence",
          "pitfalls",
          "escalate_when"
        ],
        "properties": {
          "heading_suffix": {
            "type": "string",
            "minLength": 1
          },
          "posture": {
            "type": "string",
            "minLength": 1
          },
          "ai_does": {
            "type": "string",
            "minLength": 1
          },
          "human_decides": {
            "type": "string",
            "minLength": 1
          },
          "never_ai": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "pitfalls": {
            "type": "string",
            "minLength": 1
          },
          "escalate_when": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "playbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_id",
        "title_ja",
        "title_en",
        "serves",
        "autonomy",
        "approach",
        "quality_bar",
        "pitfalls",
        "escalate_when",
        "metrics"
      ],
      "properties": {
        "class_id": {
          "type": "string",
          "enum": [
            "product_delivery",
            "code_change",
            "research_and_absorption",
            "content_and_media",
            "operations_and_release",
            "environment_and_recovery",
            "decision_support",
            "customer_engagement",
            "platform_onboarding",
            "finance_and_accounting",
            "people_and_talent",
            "legal_and_compliance",
            "strategy_and_governance",
            "procurement_and_supply"
          ]
        },
        "title_ja": {
          "type": "string",
          "minLength": 1
        },
        "title_en": {
          "type": "string",
          "minLength": 1
        },
        "serves": {
          "type": "string",
          "minLength": 1
        },
        "autonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["posture", "ai_does", "human_decides", "never_ai"],
          "properties": {
            "posture": {
              "type": "string",
              "minLength": 1
            },
            "ai_does": {
              "$ref": "#/definitions/nonEmptyStrings"
            },
            "human_decides": {
              "$ref": "#/definitions/nonEmptyStrings"
            },
            "never_ai": {
              "$ref": "#/definitions/nonEmptyStrings"
            }
          }
        },
        "approach": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "practice", "know_how", "evidence"],
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "intake",
                  "classification",
                  "planning",
                  "contract_authoring",
                  "preflight",
                  "execution",
                  "verification",
                  "delivery",
                  "retrospective"
                ]
              },
              "practice": {
                "type": "string",
                "minLength": 1
              },
              "know_how": {
                "$ref": "#/definitions/nonEmptyStrings"
              },
              "evidence": {
                "$ref": "#/definitions/nonEmptyStrings"
              }
            }
          }
        },
        "quality_bar": {
          "$ref": "#/definitions/nonEmptyStrings"
        },
        "pitfalls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trap", "countermeasure"],
            "properties": {
              "trap": {
                "type": "string",
                "minLength": 1
              },
              "countermeasure": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "escalate_when": {
          "$ref": "#/definitions/nonEmptyStrings"
        },
        "metrics": {
          "$ref": "#/definitions/nonEmptyStrings"
        }
      }
    }
  }
}
