{
  "type": "object",
  "required": [
    "version",
    "mode_aliases",
    "allowed_modes",
    "auto_select_env_priority",
    "cli_preference_rules",
    "provider_fallback_order",
    "default_mode"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string"
    },
    "route_policy_ref": {
      "type": "string"
    },
    "mode_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "allowed_modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "auto_select_env_priority": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["env", "mode"],
        "properties": {
          "env": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "cli_preference_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mode", "provider"],
        "properties": {
          "env_any": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env_equals": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "provider": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "provider_fallback_order": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "mode"],
        "properties": {
          "provider": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "default_mode": {
      "type": "string"
    },
    "prompted_tool_calling": {
      "description": "Opt-in per text-only CLI mode: expose generateWithTools through the prompted tool-calling protocol (the CLI's own tools stay disabled; Kyberion executes and audits every call). Absent mode = off.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "claude-cli",
          "claude-agent",
          "codex-cli",
          "gemini-cli",
          "agy-cli",
          "grok-cli",
          "copilot",
          "cursor-cli",
          "opencode-cli",
          "devin-cli"
        ]
      },
      "additionalProperties": { "type": "boolean" }
    },
    "openrouter": {
      "type": "object",
      "required": ["default_profile", "default_cost_policy", "required_parameters"],
      "properties": {
        "default_profile": {
          "enum": ["free-router", "free-pinned", "explicit"]
        },
        "default_cost_policy": {
          "enum": ["free-only", "paid-allowed"]
        },
        "required_parameters": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "tenant_overrides": {
      "$ref": "#/definitions/policy_overrides"
    },
    "organization_overrides": {
      "$ref": "#/definitions/policy_overrides"
    },
    "project_overrides": {
      "$ref": "#/definitions/policy_overrides"
    }
  },
  "definitions": {
    "policy_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "allowed_modes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "default_mode": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
