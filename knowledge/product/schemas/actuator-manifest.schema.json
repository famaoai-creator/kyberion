{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Actuator Capability Manifest",
  "type": "object",
  "required": ["actuator_id", "version", "capabilities"],
  "properties": {
    "actuator_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "contract_schema": {
      "type": "string"
    },
    "resilience_tier": {
      "type": "string",
      "description": "High-level resilience posture for the actuator, e.g. adaptive_retry."
    },
    "recovery_policy": {
      "type": "object",
      "description": "Retry and fallback contract used when the actuator encounters transient failure.",
      "properties": {
        "fallback_strategy": {
          "type": "string"
        },
        "retry": {
          "type": "object",
          "properties": {
            "maxRetries": {
              "type": "number"
            },
            "initialDelayMs": {
              "type": "number"
            },
            "maxDelayMs": {
              "type": "number"
            },
            "factor": {
              "type": "number"
            },
            "jitter": {
              "type": "boolean"
            }
          }
        },
        "retryable_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry_profile": {
          "type": "string",
          "minLength": 1,
          "description": "Actuator profile in the canonical retry-policy catalog."
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op", "platforms"],
        "properties": {
          "op": {
            "type": "string"
          },
          "schema_ref": {
            "type": "string"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["darwin", "linux", "win32"]
            }
          },
          "requirements": {
            "type": "object",
            "properties": {
              "bin": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lib": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "prerequisites": {
            "type": "object",
            "description": "Runtime prerequisites used by capability probes to decide whether this op is usable on the current host.",
            "properties": {
              "binaries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["darwin", "linux", "win32"]
                }
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "install": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "implemented": {
            "type": "boolean",
            "description": "Set false when the op is declared but not implemented yet (AC-01/AC-06). Probes report available:false with reason not_implemented."
          },
          "effect": {
            "type": "string",
            "enum": ["read", "write", "egress", "none"],
            "description": "SC-02: declared side-effect class of the op. read = observation only; write = local mutation; egress = data leaves the trust boundary; none = pure control. Undeclared defaults to write (fail-safe)."
          },
          "effect_from": {
            "type": "string",
            "description": "Input path (e.g. \"method\" or \"params.method\") whose value refines the declared effect. GET/list/read verbs downgrade egress-capable calls to read; everything else keeps the declared effect."
          },
          "resource_ref_from": {
            "type": "string",
            "description": "Input path identifying the governed resource ref for introduction/observation stages (e.g. \"params.path\", \"target.url\")."
          },
          "egress_destination_from": {
            "type": "string",
            "description": "Input path holding the URL or host the op sends to. The egress guard classifies that destination through the egress policy; a caller-supplied audience is never trusted."
          },
          "step_ops": {
            "type": "object",
            "description": "Per-step declarations for ops this capability dispatches internally (for example system:write_file or browser:goto). A step inherits the capability's declarations and overrides what it states.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "effect": { "type": "string", "enum": ["read", "write", "egress", "none"] },
                "effect_from": { "type": "string" },
                "resource_ref_from": { "type": "string" },
                "egress_destination_from": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
