{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "frontmatter-exclusions.schema.json",
  "title": "Knowledge Frontmatter Exclusions",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "purpose", "last_reviewed", "excluded_paths"],
  "properties": {
    "$schema": { "type": "string" },
    "manifest_version": { "type": "integer", "minimum": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "last_reviewed": { "type": "string", "minLength": 1 },
    "excluded_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
