{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "analysis-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "algorithms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cooccurrence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pipeline_dir": { "type": "string", "minLength": 1 },
            "capability_dir": { "type": "string", "minLength": 1 },
            "threshold": { "type": "number", "minimum": 0 }
          },
          "required": ["pipeline_dir", "capability_dir", "threshold"]
        },
        "ranking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index_path": { "type": "string", "minLength": 1 },
            "weights": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "number", "minimum": 0 }
            }
          },
          "required": ["index_path", "weights"]
        },
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "knowledge_dir": { "type": "string", "minLength": 1 },
            "output_path": { "type": "string", "minLength": 1 },
            "mermaid_theme": { "type": "string", "minLength": 1 }
          },
          "required": ["knowledge_dir", "output_path", "mermaid_theme"]
        }
      },
      "required": ["cooccurrence", "ranking", "graph"]
    },
    "auto_update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "related_capabilities": { "type": "boolean" },
        "related_knowledge": { "type": "boolean" }
      },
      "required": ["related_capabilities", "related_knowledge"]
    }
  },
  "required": ["version", "name", "description", "algorithms", "auto_update"]
}
