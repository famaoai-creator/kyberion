{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "customer-decision-template.schema.json",
  "title": "Customer Decision Template",
  "description": "CD-03 / HR-01: a hearing template — the objective the tenant sets and the customer decision entries (question, background, options with impact text, organization default) for one engagement phase. Every text slot takes exactly one of two forms: a user-facing-vocabulary key (`*_key`, customer_decision:*), the form product templates use, or inline localized text (`{ja?, en?}`), the form tenant templates under knowledge/confidential/<tenant>/decisions/_templates/ use, since a tenant cannot add vocabulary keys. Impact texts are generic guidance, never concrete prices. Concept: knowledge/product/architecture/hearing-model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "template_id", "phase", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "template_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,80}$" },
    "phase": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,80}$" },
    "title_key": { "$ref": "#/definitions/vocabulary_key" },
    "title": { "$ref": "#/definitions/localized_text" },
    "objective": { "$ref": "#/definitions/objective" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "item", "key", "kind", "requires_customer"],
        "properties": {
          "entry_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,80}$" },
          "item": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._#:@+-]{0,120}$" },
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
          "kind": { "enum": ["choice", "approval", "ranking", "hearing"] },
          "question_key": { "$ref": "#/definitions/vocabulary_key" },
          "question": { "$ref": "#/definitions/localized_text" },
          "background_key": { "$ref": "#/definitions/vocabulary_key" },
          "background": { "$ref": "#/definitions/localized_text" },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": {
                "value": {},
                "label_key": { "$ref": "#/definitions/vocabulary_key" },
                "label": { "$ref": "#/definitions/localized_text" },
                "impact_keys": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cost", "schedule", "scope"],
                  "properties": {
                    "cost": { "$ref": "#/definitions/vocabulary_key" },
                    "schedule": { "$ref": "#/definitions/vocabulary_key" },
                    "scope": { "$ref": "#/definitions/vocabulary_key" }
                  }
                },
                "impact": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cost", "schedule", "scope"],
                  "properties": {
                    "cost": { "$ref": "#/definitions/localized_text" },
                    "schedule": { "$ref": "#/definitions/localized_text" },
                    "scope": { "$ref": "#/definitions/localized_text" }
                  }
                }
              },
              "allOf": [
                { "oneOf": [{ "required": ["label_key"] }, { "required": ["label"] }] },
                { "oneOf": [{ "required": ["impact_keys"] }, { "required": ["impact"] }] }
              ]
            }
          },
          "org_default": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "source"],
            "properties": {
              "value": {},
              "source": { "type": "string", "minLength": 1 }
            }
          },
          "requires_customer": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "requires_customer": { "const": true } },
              "required": ["requires_customer"]
            },
            "then": { "not": { "required": ["org_default"] } }
          },
          { "oneOf": [{ "required": ["question_key"] }, { "required": ["question"] }] },
          { "oneOf": [{ "required": ["background_key"] }, { "required": ["background"] }] }
        ]
      }
    }
  },
  "allOf": [{ "oneOf": [{ "required": ["title_key"] }, { "required": ["title"] }] }],
  "definitions": {
    "vocabulary_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$",
      "description": "A user-facing-vocabulary key (domain:key)."
    },
    "localized_text": {
      "type": "object",
      "description": "Inline text per agenda locale (tenant templates). At least one locale; an agenda drafted in a locale the text lacks is refused, never shown in another language.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ja": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "en": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "objective": {
      "type": "object",
      "description": "HR-01: the hearing goal the tenant sets: what the hearing must establish and how the tenant judges it done. Copied onto the agenda, where it is shown to the customer and is part of the content hash.",
      "additionalProperties": false,
      "properties": {
        "statement_key": { "$ref": "#/definitions/vocabulary_key" },
        "statement": { "$ref": "#/definitions/localized_text" },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/vocabulary_key" },
              { "$ref": "#/definitions/localized_text" }
            ]
          }
        }
      },
      "oneOf": [{ "required": ["statement_key"] }, { "required": ["statement"] }]
    }
  }
}
