{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/desktop-pipeline.schema.json",
  "title": "Desktop Procedure Pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "procedure_id",
    "executor",
    "recording_ref",
    "recording_hash",
    "steps"
  ],
  "properties": {
    "schema_version": { "const": "desktop-pipeline.v1" },
    "procedure_id": { "type": "string", "minLength": 1 },
    "executor": { "const": "system" },
    "recording_ref": { "type": "string", "minLength": 1 },
    "recording_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "op", "risk_class"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "op": { "type": "string", "pattern": "^system:[a-z0-9_:-]+$" },
          "native_op": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_:-]{1,119}$" },
          "risk_class": { "enum": ["read", "low", "high"] },
          "selector": { "type": "object", "additionalProperties": true },
          "params": { "type": "object", "additionalProperties": true },
          "variable": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "classification"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
              "classification": { "enum": ["user_input", "secret_ref"] }
            }
          }
        }
      }
    }
  }
}
