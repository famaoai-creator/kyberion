{
  "$id": "https://kyberion.example/schemas/publication-approval.schema.json",
  "title": "Marketing publication approval",
  "type": "object",
  "required": [
    "approval_id",
    "mission_id",
    "approved_artifacts",
    "destination",
    "title",
    "description",
    "approved_by",
    "approval_decisions",
    "approved_at",
    "expires_at",
    "risk_level",
    "review_ids",
    "shared_approval"
  ],
  "properties": {
    "approval_id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "minLength": 1 },
    "approved_artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "destination": {
      "type": "object",
      "required": ["service", "account", "visibility"],
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "account": { "type": "string", "minLength": 1 },
        "visibility": { "type": "string", "minLength": 1 },
        "publish_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "cta_url": { "type": "string", "format": "uri" },
    "approved_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "approval_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["approved_by", "decided_by_type", "authenticated", "approved_at"],
        "properties": {
          "approved_by": { "type": "string", "minLength": 1 },
          "decided_by_type": { "const": "human" },
          "authenticated": { "const": true },
          "approved_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "approved_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "risk_level": { "type": "integer", "minimum": 0, "maximum": 4 },
    "review_ids": { "type": "array", "items": { "type": "string" } },
    "shared_approval": {
      "type": "object",
      "required": ["storage_channel", "request_id", "payload_hash", "effect_binding"],
      "properties": {
        "storage_channel": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "format": "uuid" },
        "payload_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "effect_binding": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
