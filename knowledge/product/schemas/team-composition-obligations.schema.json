{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Team composition obligations",
  "description": "Governed catalog that derives the obligatory part of a mission team roster from the mission classification, and declares which roles are staffed from mission creation.",
  "type": "object",
  "required": ["version", "always_staffed_roles", "obligations"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "always_staffed_roles": {
      "description": "Structural roles staffed at mission creation. Every other roster role starts on standby and is staffed on demand.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "when", "require_roles", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "when": {
            "description": "Every declared facet must match (AND); within one facet any listed value matches (OR). An empty object matches every mission.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mission_class": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "delivery_shape": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "risk_profile": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "stage": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "tier": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "enum": ["personal", "confidential", "public"] }
              }
            }
          },
          "require_roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
