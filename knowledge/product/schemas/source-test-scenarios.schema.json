{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/source-test-scenarios.schema.json",
  "title": "Source-derived Test Scenario Pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "pipeline_id", "version", "description", "context", "steps"],
  "properties": {
    "action": { "const": "pipeline" },
    "pipeline_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "source_root", "deferred"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "source_root": { "type": "string", "minLength": 1 },
        "deferred": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason", "mode"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["approval_required", "manual_only"] }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "op", "produces", "params"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "op": { "const": "code:run_tests" },
          "produces": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "type"],
            "properties": {
              "channel": { "type": "string", "minLength": 1 },
              "type": { "const": "TestExecutionResult" }
            }
          },
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["test_path", "framework", "export_as"],
            "properties": {
              "test_path": { "type": "string", "minLength": 1 },
              "framework": { "type": "string", "minLength": 1 },
              "export_as": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
