{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/test-plan.schema.json",
  "title": "Test Plan",
  "description": "Governed SDLC test plan generated from requirements and optional design input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project_name", "generated_at", "app_id", "cases"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "project_name": { "type": "string", "minLength": 1 },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string", "format": "date-time" },
    "generated_by": { "type": "string" },
    "app_id": { "type": "string", "minLength": 1 },
    "coverage_strategy": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "title", "objective", "steps", "expected"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "expected": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["must", "should", "could"] },
          "type": {
            "type": "string",
            "enum": ["unit", "integration", "e2e", "acceptance", "performance", "security"]
          },
          "covers_requirements": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
