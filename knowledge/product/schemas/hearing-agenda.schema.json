{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.org/schemas/hearing-agenda.schema.json",
  "title": "HearingAgenda",
  "description": "Governed hearing and deliverable review agenda authored by Kyberion orchestration for customer avatar surfaces.",
  "type": "object",
  "required": ["version", "session_id", "title", "deliverable", "agendas"],
  "properties": {
    "version": { "type": "string", "enum": ["1.0.0"] },
    "session_id": { "type": "string" },
    "title": { "type": "string" },
    "tenant_slug": { "type": "string" },
    "project_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "target_persona": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "deliverable": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": { "type": "string", "enum": ["interactive_app", "document", "figma", "prototype"] },
        "url": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "agendas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "question"],
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "desc": { "type": "string" },
          "target_tab": { "type": "string" },
          "spotlight_selector": { "type": "string" },
          "question": { "type": "string" },
          "emotion": {
            "type": "string",
            "enum": ["neutral", "smile", "shy", "surprise", "halfLidded", "angry", "sad", "wink"]
          },
          "chips": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
