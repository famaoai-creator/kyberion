{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/organization-work-resolution.schema.json",
  "title": "Organization Work Resolution",
  "type": "object",
  "required": [
    "kind",
    "utterance",
    "organization_id",
    "work_shape",
    "management_unit",
    "confidence",
    "authority_class",
    "human_decision",
    "reasons",
    "next_questions",
    "dry_run"
  ],
  "properties": {
    "kind": { "const": "organization_work_resolution" },
    "utterance": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "tenant_slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
    "tier": { "type": "string", "enum": ["personal", "confidential", "public"] },
    "work_shape": {
      "type": "string",
      "enum": [
        "solution_project",
        "service_operation",
        "routine_operation",
        "incident_response",
        "governance_cadence",
        "improvement_experiment"
      ]
    },
    "management_unit": {
      "type": "string",
      "enum": [
        "project",
        "service",
        "operation",
        "incident",
        "cadence",
        "experiment",
        "task_session"
      ]
    },
    "context_refs": {
      "type": "object",
      "properties": {
        "domain_id": { "type": "string" },
        "service_id": { "type": "string" },
        "operation_id": { "type": "string" },
        "project_id": { "type": "string" },
        "incident_id": { "type": "string" },
        "cadence_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "selected_intent_id": { "type": "string" },
    "selected_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "proposed_parent": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["project", "service", "operation", "incident", "cadence", "experiment"]
        },
        "id": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "authority_class": { "type": "string", "enum": ["low", "normal", "high", "approval_required"] },
    "human_decision": {
      "type": "string",
      "enum": ["pending", "accepted", "corrected", "rejected"]
    },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "next_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "dry_run": { "const": true }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "required": ["tier"], "properties": { "tier": { "const": "confidential" } } },
      "then": { "required": ["tenant_slug"] }
    }
  ]
}
