{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intent resolution evaluation corpus",
  "description": "Labelled utterances for evaluating which standard intent the resolver selects. dev cases are tuned against; holdout cases measure generalization and are only added, never tuned to once measured. expect_no_intent marks ordinary requests that must not be absorbed by any catalog intent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "split", "utterance"],
        "properties": {
          "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "split": { "type": "string", "enum": ["dev", "holdout"] },
          "utterance": { "type": "string", "minLength": 1 },
          "expected_intent_id": { "type": "string", "minLength": 1 },
          "expect_no_intent": { "type": "boolean" }
        },
        "oneOf": [{ "required": ["expected_intent_id"] }, { "required": ["expect_no_intent"] }]
      }
    }
  }
}
