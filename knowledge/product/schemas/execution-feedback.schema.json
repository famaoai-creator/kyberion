{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/execution-feedback.schema.json",
  "title": "Execution Feedback Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": { "const": "1.0.0" },
    "entries": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "schema_version",
          "feedback_id",
          "scenario_id",
          "intent_id",
          "outcome",
          "source",
          "recorded_at"
        ],
        "properties": {
          "kind": { "const": "execution-feedback" },
          "schema_version": { "const": "1.0.0" },
          "feedback_id": { "type": "string", "minLength": 1 },
          "scenario_id": { "type": "string", "minLength": 1 },
          "intent_id": { "type": "string", "minLength": 1 },
          "correlation_id": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "object",
            "required": ["tier"],
            "properties": {
              "tier": { "type": "string", "enum": ["personal", "confidential", "public"] },
              "tenant_slug": { "type": "string", "minLength": 1 },
              "organization_id": { "type": "string" },
              "project_id": { "type": "string" },
              "mission_id": { "type": "string" },
              "task_id": { "type": "string" },
              "session_id": { "type": "string" },
              "owner_nhi": { "type": "string" },
              "allowed_audience": { "type": "array", "items": { "type": "string" } },
              "promotion_policy": { "type": "string" },
              "provenance_refs": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          },
          "outcome": { "enum": ["satisfied", "partially_satisfied", "dissatisfied"] },
          "comment": { "type": "string", "maxLength": 2000 },
          "correction": { "type": "string", "maxLength": 2000 },
          "source": { "enum": ["user", "operator"] },
          "recorded_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
