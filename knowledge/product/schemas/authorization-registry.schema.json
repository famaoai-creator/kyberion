{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.dev/schemas/authorization-registry.schema.json",
  "title": "Authorization Registry Overlay",
  "description": "Non-code operation authorization declarations. Keys in `operations` are exact operation ids; keys in `prefixes` are operation-id prefixes ending in ':'. Two hardening rules apply to every data entry: (1) the code table always wins at lookup, so data can add coverage but never weaken a reviewed declaration; (2) data layers may not declare `local_only` or `authority.kind === 'free'` at all — bypassing admission requires a reviewed code entry, never a data file.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "pattern": "^[a-z0-9_]+(:[a-z0-9_.-]+)+$"
      },
      "patternProperties": {
        "^[a-z0-9_]+(:[a-z0-9_.-]+)+$": {
          "$ref": "#/definitions/entry"
        }
      }
    },
    "prefixes": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "pattern": "^[a-z0-9_]+(:[a-z0-9_*.-]+)*:$"
      },
      "patternProperties": {
        "^[a-z0-9_]+(:[a-z0-9_*.-]+)*:$": {
          "$ref": "#/definitions/entry"
        }
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectClass", "authority"],
      "properties": {
        "effectClass": {
          "type": "string",
          "description": "Closed taxonomy. 'local_only' is deliberately absent: a data declaration that lets an operation bypass every boundary would weaken the deny-by-default posture, so local-ness may only come from a reviewed code entry.",
          "enum": [
            "external_mutation",
            "external_read",
            "internal_decision",
            "knowledge_write",
            "credential_use",
            "system_control"
          ]
        },
        "authority": {
          "type": "object",
          "description": "'free' is deliberately absent — see effectClass description.",
          "oneOf": [
            {
              "required": ["kind", "boundary"],
              "properties": {
                "kind": {
                  "const": "admission"
                },
                "boundary": {
                  "type": "string",
                  "enum": ["external", "internal"]
                }
              },
              "additionalProperties": false
            },
            {
              "required": ["kind"],
              "properties": {
                "kind": {
                  "const": "approval"
                },
                "assurance": {
                  "type": "string",
                  "enum": ["A1", "A2", "A3"]
                },
                "dualKey": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "required": ["kind", "scope"],
              "properties": {
                "kind": {
                  "const": "binding"
                },
                "scope": {
                  "type": "string",
                  "enum": ["tenant", "task"]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "delegable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields", "reputational_class"],
          "properties": {
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "optionalFields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reputational_class": {
              "type": "string",
              "enum": ["A", "B"]
            }
          }
        },
        "actionClass": {
          "type": "string",
          "minLength": 1
        },
        "protectedPaths": {
          "type": "array",
          "description": "Reviewed effect paths whose values must carry host-attested origins (operation-protection).",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 0
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "approvalDomain": {
          "type": "string",
          "description": "Approval domain (storage partition) this subject's human approvals belong to; must be a domain declared in libs/core/foundation/approval-domains.ts.",
          "minLength": 1
        }
      }
    }
  }
}
