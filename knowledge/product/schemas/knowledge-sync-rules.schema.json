{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knowledge-sync-rules.schema.json",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "security": {
      "type": "object",
      "properties": {
        "pii_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "id": { "type": "string" },
              "regex": { "type": "string" },
              "description": { "type": "string" },
              "severity": { "type": "string" },
              "action": { "type": "string" },
              "validator": { "type": "string" }
            },
            "required": ["regex"],
            "additionalProperties": true
          }
        }
      },
      "required": ["pii_patterns"],
      "additionalProperties": true
    }
  },
  "required": ["security"],
  "additionalProperties": true
}
