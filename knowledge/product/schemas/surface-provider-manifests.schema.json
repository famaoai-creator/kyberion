{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "surface-provider-manifests.schema.json",
  "title": "Surface Provider Manifests",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slack",
        "chronos",
        "presence",
        "imessage",
        "discord",
        "telegram",
        "cowork",
        "cli",
        "terminal"
      ],
      "properties": {
        "slack": {
          "$ref": "#/$defs/providerManifest"
        },
        "chronos": {
          "$ref": "#/$defs/providerManifest"
        },
        "presence": {
          "$ref": "#/$defs/providerManifest"
        },
        "imessage": {
          "$ref": "#/$defs/providerManifest"
        },
        "discord": {
          "$ref": "#/$defs/providerManifest"
        },
        "telegram": {
          "$ref": "#/$defs/providerManifest"
        },
        "cowork": {
          "$ref": "#/$defs/coworkProviderManifest"
        },
        "cli": {
          "$ref": "#/$defs/providerManifest"
        },
        "terminal": {
          "$ref": "#/$defs/providerManifest"
        }
      }
    },
    "channel_adapters": {
      "type": "object",
      "description": "Channel adapter registry (RS-06): the single source for which channels exist, their markup dialect and escaping rules, operator-notification delivery, presence dispatch, message shape and mission-event stream. Non-local entries must name a registered surface provider.",
      "additionalProperties": {
        "$ref": "#/$defs/channelAdapter"
      }
    }
  },
  "$defs": {
    "textMatchRule": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["contains", "regex", "equals", "starts_with", "ends_with"]
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "receiverRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiver", "patterns"],
      "properties": {
        "id": {
          "type": "string"
        },
        "receiver": {
          "type": "string",
          "enum": ["chronos-mirror", "nerve-agent"]
        },
        "patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textMatchRule"
          }
        }
      }
    },
    "compiledFlowRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiver"],
      "properties": {
        "id": {
          "type": "string"
        },
        "receiver": {
          "type": "string",
          "enum": ["chronos-mirror", "nerve-agent"]
        },
        "execution_shapes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conversation_agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "routingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_routing", "compiled_flow_rules"],
      "properties": {
        "text_routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["greeting_patterns", "receiver_rules"],
          "properties": {
            "greeting_patterns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/textMatchRule"
              }
            },
            "receiver_rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/receiverRule"
              }
            }
          }
        },
        "compiled_flow_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compiledFlowRule"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reply", "edit", "react", "notify", "asyncRequest", "responding"],
      "properties": {
        "reply": {
          "type": "boolean"
        },
        "edit": {
          "type": "boolean"
        },
        "react": {
          "type": "boolean"
        },
        "notify": {
          "type": "boolean"
        },
        "asyncRequest": {
          "type": "boolean"
        },
        "responding": {
          "type": "boolean"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directReply", "supportsOutbox", "supportsNotifications"],
      "properties": {
        "directReply": {
          "type": "string",
          "enum": ["outbox", "notification", "none"]
        },
        "supportsOutbox": {
          "type": "boolean"
        },
        "supportsNotifications": {
          "type": "boolean"
        }
      }
    },
    "scopePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_scope",
        "scope_mode",
        "allowed_tiers",
        "requires_channel_binding_for_customer_mode",
        "principal_resolution",
        "write_authority",
        "nhi_binding",
        "approval_classes",
        "data_residency"
      ],
      "properties": {
        "process_scope": {
          "type": "string",
          "enum": ["system", "tenant-service"]
        },
        "scope_mode": {
          "type": "string",
          "enum": ["system", "server-bound-tenant", "viewer-derived", "request-derived"]
        },
        "allowed_tiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public", "confidential", "personal"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requires_channel_binding_for_customer_mode": {
          "type": "boolean"
        },
        "principal_resolution": {
          "type": "string",
          "minLength": 1
        },
        "write_authority": {
          "type": "string",
          "minLength": 1
        },
        "nhi_binding": {
          "type": "string",
          "minLength": 1
        },
        "approval_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "data_residency": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intentRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_label"],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "patterns"],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "patterns": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/textMatchRule"
                }
              }
            }
          }
        },
        "default_label": {
          "type": "string"
        }
      }
    },
    "mcpBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "server_script"],
      "properties": {
        "transport": {
          "type": "string",
          "enum": ["stdio"]
        },
        "server_script": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "coworkProviderManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "agentId",
        "channel",
        "interactionMode",
        "capabilities",
        "delivery",
        "mcp"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["cowork"]
        },
        "displayName": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "interactionMode": {
          "type": "string",
          "enum": ["threaded", "session", "live"]
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "delivery": {
          "$ref": "#/$defs/delivery"
        },
        "scope_policy": {
          "$ref": "#/$defs/scopePolicy"
        },
        "mcp": {
          "$ref": "#/$defs/mcpBinding"
        },
        "intent_rules": {
          "$ref": "#/$defs/intentRules"
        }
      }
    },
    "providerManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "agentId",
        "channel",
        "interactionMode",
        "capabilities",
        "delivery",
        "routing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "slack",
            "chronos",
            "presence",
            "imessage",
            "discord",
            "telegram",
            "cli",
            "terminal"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "interactionMode": {
          "type": "string",
          "enum": ["threaded", "session", "live"]
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "delivery": {
          "$ref": "#/$defs/delivery"
        },
        "scope_policy": {
          "$ref": "#/$defs/scopePolicy"
        },
        "routing": {
          "$ref": "#/$defs/routingPolicy"
        },
        "intent_rules": {
          "$ref": "#/$defs/intentRules"
        },
        "surface_rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "execution_mode": {
              "type": "object",
              "additionalProperties": false,
              "required": ["feasibility_patterns", "durable_task_patterns"],
              "properties": {
                "feasibility_patterns": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/textMatchRule"
                  }
                },
                "durable_task_patterns": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/textMatchRule"
                  }
                }
              }
            },
            "delegation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lightweight_patterns"],
              "properties": {
                "lightweight_patterns": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/textMatchRule"
                  }
                }
              }
            }
          }
        }
      }
    },
    "channelAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markup", "human_chat"],
      "properties": {
        "surface_provider": {
          "type": "string",
          "minLength": 1
        },
        "local": {
          "type": "boolean",
          "description": "Local channel with no remote bridge (e.g. the deliverable inbox)."
        },
        "markup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dialect"],
          "properties": {
            "dialect": {
              "type": "string",
              "enum": ["plain", "slack-mrkdwn", "telegram-markdown-legacy", "discord-markdown"]
            },
            "entity_escapes": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "backslash_escape_chars": {
              "type": "string",
              "minLength": 1
            },
            "mention_guards": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "operator_notification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delivery"],
          "properties": {
            "delivery": {
              "type": "string",
              "enum": ["surface-outbox", "imessage-direct", "local-inbox"]
            },
            "default_target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "presence_dispatch": {
          "type": "string",
          "enum": ["slack-webclient", "satellite-outbox"]
        },
        "human_chat": {
          "type": "boolean",
          "description": "A human operator converses on this channel (used to attribute interventions)."
        },
        "message_shape": {
          "type": "string",
          "enum": ["generic", "slack-thread", "chronos-session"]
        },
        "mission_event_stream": {
          "type": "string",
          "enum": ["shared", "slack", "chronos"]
        }
      }
    }
  }
}
