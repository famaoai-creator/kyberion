{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service Harness Registry",
  "description": "Generated summary registry for side-effect-free service discovery and planning.",
  "type": "object",
  "required": ["version", "kind", "services"],
  "properties": {
    "version": { "const": "1.0.0" },
    "kind": { "const": "service-harness-registry" },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["action", "kind", "risk", "approval_required", "idempotency"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "kind": { "enum": ["capture", "apply"] },
        "risk": { "enum": ["read", "write", "destructive"] },
        "approval_required": { "type": "boolean" },
        "idempotency": { "enum": ["not_applicable", "recommended", "required"] }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["service_id", "display_name", "operation_count", "detail_ref", "operations"],
      "properties": {
        "service_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "auth_strategy": { "type": "string" },
        "operation_count": { "type": "integer", "minimum": 0 },
        "detail_ref": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        }
      },
      "additionalProperties": false
    }
  }
}
