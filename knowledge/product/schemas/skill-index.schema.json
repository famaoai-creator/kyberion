{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill-index.schema.json",
  "title": "Generated skill index",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "t", "s"],
  "properties": {
    "$schema": { "type": "string" },
    "v": { "type": "string", "minLength": 1 },
    "t": { "type": "integer", "minimum": 0 },
    "u": { "type": "string", "minLength": 1 },
    "s": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "path", "d", "s", "version", "capability_count"],
        "properties": {
          "n": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "d": { "type": "string" },
          "s": { "type": "string", "enum": ["implemented"] },
          "version": { "type": "string", "minLength": 1 },
          "capability_count": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
