{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "intent-coverage-matrix.schema.json",
  "title": "Documentation-only intent coverage matrix",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "documentation_only": { "const": true },
    "version": { "type": "string", "minLength": 1 },
    "generated_manually": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "coverage_levels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "intent_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["implemented", "partial", "missing"] },
          "entry_path": { "type": "string", "minLength": 1 },
          "execution_shape": { "type": "string", "minLength": 1 },
          "outcome_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "execution_path": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "gaps": { "type": "array", "items": { "type": "string" } }
        },
        "required": [
          "intent_id",
          "status",
          "entry_path",
          "execution_shape",
          "outcome_ids",
          "execution_path",
          "gaps"
        ]
      }
    },
    "cross_cutting_gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "next_priorities": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "required": [
    "$schema",
    "documentation_only",
    "version",
    "generated_manually",
    "notes",
    "coverage_levels",
    "intents",
    "cross_cutting_gaps",
    "next_priorities"
  ]
}
