{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/concept-registry.schema.json",
  "title": "Kyberion concept registry",
  "type": "object",
  "required": ["manifest_version", "terms"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "manifest_version": { "const": 1 },
    "last_reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "purpose": { "type": "string" },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "term", "category", "definition", "glossary_anchor", "canonical_doc"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "term": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "category": {
            "enum": ["unit_of_work", "scope", "identity", "surface", "execution", "governance"]
          },
          "definition": { "type": "string", "minLength": 1 },
          "glossary_anchor": { "type": "string", "minLength": 1 },
          "canonical_doc": { "type": "string", "minLength": 1 },
          "owner_modules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "not_to_confuse_with": { "type": "array", "items": { "type": "string" } },
          "senses": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["qualifier", "glossary_anchor", "definition"],
              "additionalProperties": false,
              "properties": {
                "qualifier": { "type": "string", "minLength": 1 },
                "glossary_anchor": { "type": "string", "minLength": 1 },
                "definition": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
