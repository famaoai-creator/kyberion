{
  "$id": "https://kyberion.internal/schemas/governance-catalog-contracts.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Governance catalog contracts",
  "type": "object",
  "required": ["$schema", "version", "catalogs"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "description": { "type": "string" },
    "catalogs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1,
        "uniqueItems": true
      }
    }
  },
  "additionalProperties": false
}
