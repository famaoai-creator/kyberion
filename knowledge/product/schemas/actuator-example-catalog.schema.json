{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Actuator Example Catalog",
  "type": "object",
  "required": ["actuator", "examples"],
  "properties": {
    "actuator": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "path", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^libs/actuators/[a-z0-9][a-z0-9-]*/examples/.+\\.json$"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
