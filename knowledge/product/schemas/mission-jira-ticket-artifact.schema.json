{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mission-jira-ticket-artifact.schema.json",
  "title": "Mission Jira Ticket Artifact",
  "type": "object",
  "additionalProperties": true,
  "propertyNames": {
    "not": { "enum": ["__proto__", "constructor", "prototype"] }
  },
  "properties": {
    "id": { "type": ["string", "number"] },
    "key": { "type": "string", "minLength": 1 },
    "self": { "type": "string", "minLength": 1 },
    "fields": {
      "type": "object",
      "additionalProperties": true,
      "propertyNames": {
        "not": { "enum": ["__proto__", "constructor", "prototype"] }
      }
    },
    "comments": { "type": "array" },
    "updated_at": { "type": "string" }
  },
  "required": ["fields"]
}
