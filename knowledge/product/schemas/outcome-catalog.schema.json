{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/outcome-catalog.schema.json",
  "title": "Outcome Catalog",
  "type": "object",
  "required": ["outcomes"],
  "properties": {
    "version": { "type": ["string", "number"] },
    "outcomes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "description", "deliverable_kind", "downloadable", "previewable"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "deliverable_kind": { "$ref": "./artifact-kind.schema.json" },
          "downloadable": { "type": "boolean" },
          "previewable": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
