{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kyberion Computer Interaction Contract v0.1",
  "description": "Provider-independent contract for governed computer-use style observation and action loops.",
  "type": "object",
  "required": ["version", "kind", "action"],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1"
    },
    "kind": {
      "type": "string",
      "const": "computer_interaction"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executor": {
          "type": "string",
          "enum": ["browser", "terminal", "system"]
        },
        "surface_id": {
          "type": "string"
        },
        "runtime_id": {
          "type": "string"
        },
        "tab_id": {
          "type": "string"
        },
        "terminal_session_id": {
          "type": "string"
        },
        "display_id": {
          "type": "string"
        },
        "application": {
          "type": "string"
        },
        "focus_target_id": {
          "type": "string"
        },
        "focus_target_match_policy": {
          "type": "string",
          "enum": ["strict", "prefix", "contains"]
        },
        "domain": {
          "type": "string"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["screen", "dom_snapshot", "ax_tree", "console", "network", "mixed"]
        },
        "include_screenshot": {
          "type": "boolean"
        },
        "include_refs": {
          "type": "boolean"
        },
        "include_console": {
          "type": "boolean"
        },
        "include_network": {
          "type": "boolean"
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "scale": {
              "type": "number",
              "minimum": 0.1
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "snapshot",
            "screenshot",
            "open_tab",
            "select_tab",
            "left_click",
            "double_click",
            "right_click",
            "mouse_move",
            "activate_application",
            "detect_focused_input",
            "remember_focused_target",
            "type_into_focused_input",
            "submit_focused_input",
            "list_known_app_capabilities",
            "list_terminal_targets",
            "list_tabs",
            "activate_tab_by_title",
            "activate_tab_by_url",
            "close_tab_by_title",
            "close_tab_by_url",
            "reveal_path",
            "open_path",
            "empty_trash",
            "left_mouse_down",
            "left_mouse_up",
            "drag",
            "scroll",
            "type",
            "key",
            "voice_input_toggle",
            "wait",
            "llm_assist",
            "ax_runtime_status",
            "ax_snapshot",
            "ax_find",
            "ax_list_windows",
            "ax_list_apps",
            "ax_list_displays",
            "ax_list_surfaces",
            "ax_list_notifications",
            "ax_click",
            "ax_type",
            "ax_press",
            "ax_scroll",
            "ax_scroll_to",
            "ax_set_value",
            "ax_select",
            "ax_clear",
            "ax_focus",
            "ax_toggle",
            "ax_check",
            "ax_uncheck",
            "ax_expand",
            "ax_collapse",
            "ax_right_click",
            "ax_get",
            "ax_is",
            "ax_session_end",
            "ax_session_gc",
            "click_ref",
            "fill_ref",
            "fill_secret_ref",
            "press_ref",
            "wait_for_ref",
            "extract_text_ref",
            "capture_console",
            "capture_network",
            "spawn_terminal",
            "poll_terminal",
            "write_terminal",
            "kill_terminal",
            "list_terminal_sessions",
            "shell_command"
          ]
        },
        "coordinate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": ["x", "y"]
        },
        "target_mark": {
          "type": "string",
          "pattern": "^mark:[0-9]{1,4}$",
          "description": "Set-of-Marks target from vision mark_elements; resolved to a coordinate only when coordinate is absent."
        },
        "mark_session_id": {
          "type": "string",
          "description": "Session whose marks resolve target_mark (defaults to session_id)."
        },
        "marks_id": {
          "type": "string",
          "description": "Refuse the click unless the session's current marks carry this id."
        },
        "to_coordinate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": ["x", "y"]
        },
        "button": {
          "type": "string",
          "enum": ["left", "right", "middle"]
        },
        "text": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ordered key sequence for write_terminal; takes precedence over key."
        },
        "dictation_keycode": {
          "type": "integer",
          "minimum": 1
        },
        "ref": {
          "type": "string"
        },
        "qualified_ref": {
          "type": "string",
          "pattern": "^@[A-Za-z0-9_-]+:e[0-9]+$",
          "description": "Snapshot-qualified element ref (@<snapshot_id>:e<N>) for AX-style desktop surfaces. Valid only against the live snapshot map that allocated it; a bare or cross-snapshot ref must fail closed, never be reminted against a fresh observation."
        },
        "native_id": {
          "type": "string",
          "description": "Durable platform element identifier (AXIdentifier, AutomationId, accessible-id) used to corroborate ref resolution or re-identify an element with role/name evidence."
        },
        "selector": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "dom_path": {
          "type": "string"
        },
        "secret_ref": {
          "type": "string"
        },
        "exact": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "application": {
          "type": "string"
        },
        "window_id": {
          "type": "string",
          "description": "AX surface window scoping (agent-desktop --window-id); obtained from ax_list_windows."
        },
        "value": {
          "type": "string",
          "description": "Value payload for ax_set_value / ax_select."
        },
        "direction": {
          "type": "string",
          "enum": ["up", "down", "left", "right"],
          "description": "Scroll direction for ax_scroll."
        },
        "property": {
          "type": "string",
          "description": "Property/state selector for ax_get (text|value|title|bounds|role|states) and ax_is (visible|enabled|checked|focused|expanded|selected)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Result cap for ax_list_notifications."
        },
        "surface": {
          "type": "string",
          "description": "AX surface scope for ax_snapshot/ax_find (window, menubar, sheet, popover, alert, notification-center, dock, spotlight, ...)."
        },
        "wait_for": {
          "type": "string",
          "description": "Server-side poll selector (role:text) — ax_snapshot/ax_find return once a match appears."
        },
        "wait_for_gone": {
          "type": "string",
          "description": "Server-side poll selector (role:text) — return once no match remains."
        },
        "title": {
          "type": "string"
        },
        "approval_request_id": {
          "type": "string"
        },
        "focus_target_id": {
          "type": "string"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "task_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "allowed_origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "browser_options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headless": {
              "type": "boolean"
            },
            "browser_channel": {
              "type": "string",
              "enum": ["chromium", "chrome"]
            },
            "viewport": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "observation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "input_strategy": {
          "type": "string",
          "enum": ["keystroke", "paste"]
        },
        "shell": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0
        },
        "scroll_delta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Modifier keys for key/press actions (cmd, ctrl, alt, shift, option, command)"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": {
                "const": "llm_assist"
              }
            }
          },
          "then": {
            "required": ["goal"]
          }
        }
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "reason": {
          "type": "string"
        },
        "requires_approval": {
          "type": "boolean"
        },
        "approval_scope": {
          "type": "string",
          "enum": ["none", "operator", "sovereign", "workflow"]
        }
      }
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "error", "blocked"]
        },
        "code": {
          "type": "string",
          "description": "Machine-readable result or error code (e.g. STALE_REF, AMBIGUOUS_TARGET, SNAPSHOT_NOT_FOUND, ELEMENT_NOT_FOUND)."
        },
        "disposition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "delivery": {
              "type": "string",
              "enum": [
                "unknown",
                "not_delivered",
                "delivery_uncertain",
                "delivered_unverified",
                "delivered_verified"
              ]
            },
            "retry": {
              "type": "string",
              "enum": ["unknown", "safe", "unsafe"],
              "description": "Derived from delivery: only not_delivered is safe to repeat."
            }
          },
          "description": "Delivery evidence for the attempted action. Retry or substitute only when retry is safe; no unconditional success flags."
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "requires_fresh_observation": {
              "type": "boolean"
            }
          },
          "description": "Recovery hint carried on errors; select a strategy only when disposition.retry is safe."
        },
        "complete": {
          "type": "boolean",
          "description": "For observation results: true only when the observation covered the whole target tree. A budget-exhausted observation reports false with the partial tree rather than an error."
        },
        "truncated": {
          "type": "boolean",
          "description": "true when the returned observation was cut by its observation budget; per-node markers identify cut branches."
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["known", "absent", "unknown"]
          },
          "description": "Per-field read status for observed properties. absent answers 'does not exist' and satisfies completeness checks; unknown is a failed or untrusted read and must not."
        },
        "message": {
          "type": "string"
        },
        "screenshot_path": {
          "type": "string"
        },
        "snapshot_path": {
          "type": "string"
        },
        "console_excerpt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network_excerpt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
