{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-performance-index.schema.json",
  "title": "Agent role performance index",
  "type": "object",
  "additionalProperties": false,
  "required": ["by_agent_role"],
  "properties": {
    "by_agent_role": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          { "not": { "enum": ["__proto__", "constructor", "prototype"] } },
          { "pattern": "^.+\\|.+$" }
        ]
      },
      "additionalProperties": { "$ref": "#/definitions/performance" }
    }
  },
  "definitions": {
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "success", "review", "blocked", "success_rate"],
      "properties": {
        "samples": { "type": "integer", "minimum": 0 },
        "success": { "type": "integer", "minimum": 0 },
        "review": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
