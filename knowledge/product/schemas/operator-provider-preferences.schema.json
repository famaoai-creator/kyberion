{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/operator-provider-preferences.schema.json",
  "title": "Operator Provider Preferences",
  "description": "Persisted provider priority and model preferences from Browser Onboarding.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string" },
    "priority": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1 }
    },
    "default_models": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "updated_at": { "type": "string" },
    "source": { "type": "string" }
  }
}
