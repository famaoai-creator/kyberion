{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ingest-quota-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "max_files_per_day": { "type": "number", "exclusiveMinimum": 0 },
    "max_bytes_per_day": { "type": "number", "exclusiveMinimum": 0 },
    "warn_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "tenant_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max_files_per_day": { "type": "number" },
          "max_bytes_per_day": { "type": "number" },
          "warn_ratio": { "type": "number" }
        }
      }
    }
  },
  "required": [
    "version",
    "max_files_per_day",
    "max_bytes_per_day",
    "warn_ratio",
    "tenant_overrides"
  ]
}
