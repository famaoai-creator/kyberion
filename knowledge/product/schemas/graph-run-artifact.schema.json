{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/graph-run-artifact.schema.json",
  "title": "Graph run artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated_at", "nodes", "edges"],
  "properties": {
    "version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "artifact_path": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "duration_ms"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "running", "success", "failed", "skipped"] },
        "duration_ms": { "type": "number", "minimum": 0 },
        "timeout_ms": { "type": "number", "minimum": 0 },
        "output_hash": { "type": "string", "minLength": 1 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["control", "data", "when"] },
        "channel": { "type": "string", "minLength": 1 }
      }
    }
  }
}
