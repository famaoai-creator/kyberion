{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecosystem-blueprint.schema.json",
  "title": "Documentation-only ecosystem blueprint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "documentation_only": { "const": true },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directories": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 }
            },
            "required": ["source", "target", "type"]
          }
        },
        "initial_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "content": { "type": "string" }
            },
            "required": ["path", "content"]
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "optional": { "type": "boolean" }
            },
            "required": ["name", "command", "args"]
          }
        }
      },
      "required": ["directories", "links", "initial_files", "commands"]
    }
  },
  "required": ["$schema", "documentation_only", "name", "version", "infrastructure"]
}
