{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adhoc-pipeline-run-ledger.schema.json",
  "title": "Ad-hoc pipeline run promotion ledger",
  "type": "array",
  "maxItems": 200,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["path", "count", "last_at"],
    "properties": {
      "path": { "type": "string", "minLength": 1 },
      "count": { "type": "integer", "minimum": 1 },
      "last_at": { "type": "string", "minLength": 1 }
    }
  }
}
