{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/daemon-heartbeat.schema.json",
  "title": "Daemon heartbeat",
  "description": "Persisted liveness record emitted by a long-lived Kyberion daemon.",
  "type": "object",
  "required": ["daemon_id", "pid", "status", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "daemon_id": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["starting", "running", "stopping", "error"]
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
