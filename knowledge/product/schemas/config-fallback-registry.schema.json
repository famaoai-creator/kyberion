{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "config-fallback-registry.schema.json",
  "title": "Configuration fallback registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": { "const": "1.0.0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_path",
          "first_seen",
          "last_seen",
          "occurrence_count",
          "last_error",
          "reason",
          "resolved"
        ],
        "properties": {
          "knowledge_path": { "type": "string", "minLength": 1 },
          "first_seen": { "type": "string", "minLength": 1 },
          "last_seen": { "type": "string", "minLength": 1 },
          "occurrence_count": { "type": "integer", "minimum": 1 },
          "last_error": { "type": "string" },
          "reason": { "type": "string", "enum": ["file_not_found", "parse_error", "unknown"] },
          "defaults_snapshot": {},
          "resolved": { "type": "boolean" },
          "resolved_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
