{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/track-creation-policy.schema.json",
  "title": "Track Creation Policy",
  "description": "Governed track types and lifecycle models used by intent-to-track provisioning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "description", "track_types", "lifecycle_models"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "track_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/track_type" }
    },
    "lifecycle_models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/lifecycle_model" }
    }
  },
  "definitions": {
    "track_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "typical_lifecycle", "gate_profile"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "typical_lifecycle": { "type": "string", "minLength": 1 },
        "gate_profile": { "type": "string", "minLength": 1 },
        "entry_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exit_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "recommended_pipeline": { "type": "string", "minLength": 1 },
        "mission_class": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["personal", "confidential", "public"] },
        "note": { "type": "string" }
      }
    },
    "lifecycle_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phases", "gates_per_phase"],
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "gates_per_phase": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
