{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sdlc-gate-catalog.schema.json",
  "title": "Deprecated documentation-only SDLC gate catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "documentation_only": { "const": true },
    "concept": { "const": "sdlc-gate-catalog" },
    "version": { "type": "string", "minLength": 1 },
    "deprecated": { "const": true },
    "superseded_by": { "type": "string", "minLength": 1 },
    "note": { "type": "string", "minLength": 1 },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "phase": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "required_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "exit_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["gate_id", "phase", "scope", "purpose", "required_artifacts", "exit_criteria"]
      }
    }
  },
  "required": [
    "$schema",
    "documentation_only",
    "concept",
    "version",
    "deprecated",
    "superseded_by",
    "note",
    "gates"
  ]
}
