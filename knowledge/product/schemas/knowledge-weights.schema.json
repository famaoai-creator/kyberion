{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knowledge-weights.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "defaults": { "$ref": "#/definitions/weights" },
    "tenant_overrides": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/weights" }
    }
  },
  "required": ["version", "defaults", "tenant_overrides"],
  "definitions": {
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "type": "number", "minimum": 0, "maximum": 100 },
        "authority": { "type": "number", "minimum": 0, "maximum": 100 },
        "recency": { "type": "number", "minimum": 0, "maximum": 100 },
        "proximity": { "type": "number", "minimum": 0, "maximum": 100 },
        "usage_yield": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
