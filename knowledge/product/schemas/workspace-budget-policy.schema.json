{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workspace-budget-policy.schema.json",
  "title": "Workspace disk budget policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "disk_cap_bytes": { "type": "number", "minimum": 0 },
    "min_free_bytes": { "type": "number", "minimum": 0 },
    "orphan_ttl_hours": { "type": "number", "minimum": 0 }
  },
  "required": ["version", "disk_cap_bytes", "min_free_bytes", "orphan_ttl_hours"]
}
