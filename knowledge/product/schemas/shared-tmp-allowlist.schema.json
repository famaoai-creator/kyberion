{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shared-tmp-allowlist.schema.json",
  "title": "Documentation-only shared temporary path allowlist",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "documentation_only": { "const": true },
    "$comment": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "plan": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 0 },
          "classification": { "enum": ["legit-tmp", "migrate-candidate"] },
          "note": { "type": "string", "minLength": 1 }
        },
        "required": ["file", "count", "classification", "note"]
      }
    }
  },
  "required": ["$schema", "documentation_only", "$comment", "version", "plan", "entries"]
}
