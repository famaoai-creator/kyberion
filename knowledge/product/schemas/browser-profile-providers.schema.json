{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "browser-profile-providers.schema.json",
  "title": "Browser Profile Provider Registry",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "module": {
            "type": "string",
            "pattern": "^@(agent|actuator)/[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*$"
          },
          "fallback_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["provider_id", "module"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "providers"],
  "additionalProperties": false
}
