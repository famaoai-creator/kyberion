{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/unclassified-error-registry.schema.json",
  "title": "Unclassified error registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": { "const": "1.0.0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message_excerpt",
          "first_seen",
          "last_seen",
          "occurrence_count",
          "reconciled"
        ],
        "properties": {
          "message_excerpt": { "type": "string", "minLength": 1, "maxLength": 200 },
          "code": { "type": "string", "minLength": 1 },
          "first_seen": { "type": "string", "format": "date-time" },
          "last_seen": { "type": "string", "format": "date-time" },
          "occurrence_count": { "type": "integer", "minimum": 1 },
          "reconciled": { "type": "boolean" },
          "reconciled_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
