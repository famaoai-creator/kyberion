{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "customer-decision-consumer-lock.schema.json",
  "title": "Customer Decision Consumer Lock",
  "description": "What one mission task consumed at its start (CD-09): every effective decision of the case's open agendas, pinned at the task boundary and reconciled at task completion and after each customer response. It also keeps the customer-judgment questions the task raised (layer task_proposal, CD-09 実装中の判断を顧客に回す) until the operator collects them into an agenda. Stored at knowledge/confidential/<tenant>/decisions/<case>/consumers/<consumer>.json under the narrow customer_decision_consumer_store role (exact per-case capability); it holds customer values, so it never leaves the case's tier and tenant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "case_id",
    "consumer",
    "mission_id",
    "task_id",
    "status",
    "locked_at",
    "decisions"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["1.0.0"] },
    "case_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$" },
    "tenant_slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
      "description": "The mission's project (relationships.project.project_id): the typed context of a rework WorkItem filed for this consumer."
    },
    "consumer": {
      "type": "string",
      "pattern": "^mission-[A-Za-z0-9][A-Za-z0-9_-]{0,100}\\.[A-Za-z0-9][A-Za-z0-9._-]{0,120}$"
    },
    "mission_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "type": "string", "enum": ["in_progress", "completed"] },
    "locked_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": "string", "minLength": 1 },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "key", "layer"],
        "properties": {
          "agenda_id": { "type": "string", "pattern": "^agd-[A-Za-z0-9][A-Za-z0-9_-]{3,80}$" },
          "entry_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$" },
          "item": { "type": "string", "minLength": 1, "maxLength": 200 },
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
          "decision_id": { "type": "string", "pattern": "^D-[0-9]{4,}$" },
          "value": {},
          "layer": {
            "type": "string",
            "enum": ["customer", "ours", "org_default", "none", "task_proposal"]
          },
          "proposal": { "$ref": "#/definitions/proposal" }
        },
        "allOf": [
          {
            "$comment": "A task_proposal entry carries its proposal; no other entry does.",
            "if": { "properties": { "layer": { "const": "task_proposal" } } },
            "then": { "required": ["proposal"] },
            "else": { "not": { "required": ["proposal"] } }
          }
        ]
      }
    },
    "hold": {
      "description": "The task waits for the customer (a requires_customer task proposal): its WorkItem is blocked with blocked_reason awaiting_customer_decision. resolved_at is set once every held proposal has a confirmed customer decision; the task then re-runs through mission resume, which re-pins the lock.",
      "type": "object",
      "additionalProperties": false,
      "required": ["at"],
      "properties": {
        "work_item_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "at": { "type": "string", "minLength": 1 },
        "resolved_at": { "type": "string", "minLength": 1 }
      }
    },
    "last_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "checked", "stale_count"],
      "properties": {
        "at": { "type": "string", "minLength": 1 },
        "checked": { "type": "integer", "minimum": 0 },
        "stale_count": { "type": "integer", "minimum": 0 }
      }
    },
    "superseded": {
      "description": "The task was replaced by another task of the same mission (mission_controller supersede-task, a human-approved mission_gate decision). Set once by the owner-bound consumer store, in a write that adds only this field; the lock is frozen afterwards. Every boundary skips a superseded lock (no hold, no release, no rework, no re-ask).",
      "type": "object",
      "additionalProperties": false,
      "required": ["by_consumer", "by_task_id", "at", "approval_request_id"],
      "properties": {
        "by_consumer": {
          "type": "string",
          "pattern": "^mission-[A-Za-z0-9][A-Za-z0-9_-]{0,100}\\.[A-Za-z0-9][A-Za-z0-9._-]{0,120}$"
        },
        "by_task_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "at": { "type": "string", "minLength": 1 },
        "approval_request_id": {
          "description": "The authenticated human mission_gate approval (channel mission-task-supersede) that authorized the supersede. A mark is honoured only after the mission side verifies this approval; the guard requires it to be present.",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "rework": {
      "description": "Rework WorkItems filed for this consumer. `refs` name the current decisions the stale result must move to (ledger ids, or <agenda>/<entry>:<layer> where the layer has no ledger record), so the completion check and the response sweep file one item for one switch.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_item_id", "refs", "at"],
        "properties": {
          "work_item_id": { "type": "string", "pattern": "^WI-CDR-[A-F0-9]{16}$" },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "at": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "proposal": {
      "description": "CD-09: a customer-judgment question the task raised (TaskDecisionProposal). The proposed value is the entry's value; a requires_customer proposal has none. collected_at is set when the operator collected it into an agenda (the entry's agenda_id / entry_id name that agenda entry). previous_links are the earlier links of a re-asked proposal (customer-decision draft --from-tasks --reask: its agenda was closed, withdrawn or gone with no confirmed answer), oldest first, append-only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "question", "requires_customer", "proposed_at"],
      "properties": {
        "proposal_id": { "type": "string", "pattern": "^tp-[a-f0-9]{16}$" },
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "requires_customer": { "type": "boolean" },
        "options": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": {},
              "label": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "topic": { "type": "string", "minLength": 1, "maxLength": 60 },
        "proposed_at": { "type": "string", "minLength": 1 },
        "collected_at": { "type": "string", "minLength": 1 },
        "resolved": { "$ref": "#/definitions/resolution" },
        "previous_links": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/definitions/previous_link" }
        }
      }
    },
    "previous_link": {
      "description": "One earlier agenda link of a re-asked task proposal and who re-asked it when.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agenda_id", "entry_id", "collected_at", "relinked_at", "relinked_by"],
      "properties": {
        "agenda_id": { "type": "string", "pattern": "^agd-[A-Za-z0-9][A-Za-z0-9_-]{3,80}$" },
        "entry_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$" },
        "collected_at": { "type": "string", "minLength": 1 },
        "resolved": { "$ref": "#/definitions/resolution" },
        "relinked_at": { "type": "string", "minLength": 1 },
        "relinked_by": { "type": "string", "pattern": "^user:[a-z][a-z0-9-]{1,30}$" }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "at"],
      "properties": {
        "decision_id": { "type": "string", "pattern": "^D-[0-9]{4,}$" },
        "at": { "type": "string", "minLength": 1 }
      }
    }
  }
}
