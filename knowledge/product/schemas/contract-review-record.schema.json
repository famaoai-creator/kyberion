{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract review record",
  "description": "Human review decision bound to one customer deal contract version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "deal_id", "version", "verdict", "reviewer", "notes", "reviewed_at"],
  "properties": {
    "kind": { "const": "contract-review-record" },
    "deal_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "verdict": { "enum": ["approve", "reject"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "reviewed_at": { "type": "string", "format": "date-time" }
  }
}
