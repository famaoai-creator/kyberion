{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knowledge-scope-health-history.schema.json",
  "title": "Knowledge scope health history",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "legacy_unscoped_file_count"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "legacy_unscoped_file_count": { "type": "integer", "minimum": 0 }
  }
}
