{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Media Document Layout Catalog",
  "type": "object",
  "required": ["documents"],
  "properties": {
    "documents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["default_template", "templates"],
        "properties": {
          "default_template": { "type": "string", "minLength": 1 },
          "templates": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "object" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
