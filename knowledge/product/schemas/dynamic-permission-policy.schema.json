{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/dynamic-permission-policy.schema.json",
  "title": "Dynamic Permission Policy",
  "description": "Time-bounded contextual grants for the dynamic permission guard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policies"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "version": { "type": "string", "minLength": 1 },
    "policies": {
      "type": "array",
      "items": { "$ref": "#/definitions/policy" }
    }
  },
  "definitions": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "grant"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intent", "lookback_ms"],
          "properties": {
            "intent": { "type": "string", "minLength": 1 },
            "keyword": { "type": "string", "minLength": 1 },
            "lookback_ms": { "type": "integer", "minimum": 1 }
          }
        },
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "allow_paths"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "allow_paths": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
