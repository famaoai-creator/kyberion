{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "accepted-pipeline-bindings.schema.json",
  "title": "Accepted pipeline bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bindings"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/binding" }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier"],
      "properties": {
        "tier": { "type": "string", "enum": ["public", "confidential", "personal"] },
        "tenant_slug": { "type": "string", "minLength": 1 },
        "organization_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_sha256", "completed_at", "evidence_digest"],
      "properties": {
        "pipeline_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "completed_at": { "type": "string", "format": "date-time" },
        "evidence_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "pipeline_ref",
        "intent_ids",
        "scope",
        "successful_run_evidence",
        "approval_request_id",
        "accepted_at",
        "status"
      ],
      "properties": {
        "binding_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "pipeline_ref": { "type": "string", "pattern": "^pipelines/[a-z0-9][a-z0-9._-]*\\.json$" },
        "intent_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "scope": { "$ref": "#/$defs/scope" },
        "successful_run_evidence": { "$ref": "#/$defs/evidence" },
        "approval_request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "accepted_at": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "enum": ["candidate", "active", "deprecated", "revoked"]
        }
      }
    }
  }
}
