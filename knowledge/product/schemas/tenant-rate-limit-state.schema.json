{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/tenant-rate-limit-state.schema.json",
  "title": "Tenant Rate Limit State",
  "type": "object",
  "required": ["tenants"],
  "additionalProperties": false,
  "properties": {
    "tenants": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["tokens", "updated_at"],
        "additionalProperties": false,
        "properties": {
          "tokens": { "type": "number", "minimum": 0 },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
