{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/manual-driver-descriptor.schema.json",
  "title": "Manual driver bridge descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "agent_id",
    "owner_id",
    "scope",
    "status",
    "updated_at",
    "expires_at",
    "action"
  ],
  "properties": {
    "version": { "const": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "owner_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "object", "additionalProperties": true },
    "status": { "const": "online" },
    "updated_at": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "minLength": 1 },
    "action": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/action" }]
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "kind", "title", "status"],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "append_entry",
            "stream_assistant",
            "execute_tool",
            "hook",
            "sleep",
            "apply_pending_write",
            "consume_queue_item"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "operation_id": { "type": "string" },
        "requires_approval": { "type": "boolean" },
        "status": { "type": "string", "enum": ["ready", "awaiting_approval", "blocked"] },
        "approval": { "$ref": "#/$defs/approval" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["approved", "pending", "denied"] },
        "request_id": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
