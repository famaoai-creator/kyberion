{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autonomous-ops-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "decision_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_max_score": {
          "type": "number",
          "minimum": 0
        },
        "notify_max_score": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["auto_max_score", "notify_max_score"]
    },
    "axis_weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "number",
          "minimum": 0
        },
        "reversibility": {
          "type": "number",
          "minimum": 0
        },
        "sensitivity": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["scope", "reversibility", "sensitivity", "confidence"]
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/action"
      }
    },
    "tenant_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/actionOverride"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "high_risk_paths": {
      "type": "array",
      "description": "Repo-relative globs ('*' within a segment, '**' across segments). A change touching any of them forces approve.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "never_auto": {
      "type": "array",
      "description": "Action classes that always require a human decision, regardless of scores.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "active_hours": {
      "type": "object",
      "additionalProperties": false,
      "description": "Operator active hours; veto windows only count inside them.",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["start", "end", "timezone"]
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Resident-dot graduated autonomy (L0-L4). L0 is true shadow: proposals are recorded only (no decision card, no WorkItem). Promotion always needs a human approval; demotion is automatic.",
      "properties": {
        "description": {
          "type": "string",
          "description": "Operator-facing note on how this autonomy section is applied."
        },
        "relaxable_actions": {
          "type": "array",
          "description": "Actions an L4 dot may relax from notify to auto even though notify is the policy gate's own decision — the single permitted exception to 'never below the policy gate' (l4_notify_to_auto, enforced in dot-dispatch dotNotifyToAutoExceptionApplies). Only when the action is reversible (axis < 2), touches no high-risk path, has no never_auto / axis_max / budget escalation, the policy decision is exactly notify (never approve), no charter or hard floor is notify or stricter, and the dot's outcome success stays at or above promotion.min_outcome_success.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_decisions": {
              "type": "integer",
              "minimum": 1
            },
            "min_agreement": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "min_outcome_success": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_incidents_30d": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["min_decisions", "min_agreement", "min_outcome_success", "max_incidents_30d"]
        },
        "demotion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_regressed_outcomes": {
              "type": "integer",
              "minimum": 1
            },
            "on_rejection_streak": {
              "type": "integer",
              "minimum": 1
            },
            "on_incident": {
              "type": "boolean"
            }
          },
          "required": ["on_regressed_outcomes", "on_rejection_streak", "on_incident"]
        }
      },
      "required": ["relaxable_actions", "promotion", "demotion"]
    }
  },
  "required": ["version", "decision_thresholds", "axis_weights", "actions"],
  "$defs": {
    "axisScores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "reversibility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "sensitivity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": ["scope", "reversibility", "sensitivity", "confidence"]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "axis_scores": {
          "$ref": "#/$defs/axisScores"
        },
        "budget_cap_tokens": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "action_class": {
          "type": "string",
          "minLength": 1,
          "description": "Class matched against never_auto (e.g. pr_merge, secret_mutation)."
        },
        "veto_window_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ci_green", "tests_green", "cross_provider_review"]
          },
          "uniqueItems": true
        },
        "shadow": {
          "type": "boolean",
          "description": "Shadow mode: the gate computes the tier but never allows execution."
        }
      },
      "required": ["title", "description", "axis_scores"]
    },
    "actionOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "axis_scores": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "reversibility": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "sensitivity": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "budget_cap_tokens": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
