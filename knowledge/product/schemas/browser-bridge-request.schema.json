{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kyberion://schemas/browser-bridge-request.v1",
  "title": "Kyberion Browser Bridge Request v1",
  "description": "One Kyberion -> Chrome extension request in the pull mailbox (libs/shared-vision/src/browser-bridge-mailbox.ts). The extension pulls requests through the native host (poll_requests) and answers with respond_request. Requests never carry an executable instruction: observe_tab asks the user for consent to read the active tab, local_infer runs an on-device model whose result stays non-executable, notify is display-only and never carries page data. Stored one file per request under active/shared/runtime/browser-bridge-mailbox/<tier>/<tenant|shared>/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "request_id",
    "request_kind",
    "created_at",
    "expires_at",
    "requested_by",
    "scope",
    "payload",
    "status"
  ],
  "properties": {
    "kind": { "const": "browser-bridge-request.v1" },
    "request_id": {
      "type": "string",
      "pattern": "^BBR-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "request_kind": { "enum": ["observe_tab", "local_infer", "notify", "control_step"] },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id"],
      "properties": {
        "actor_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mission_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier"],
      "properties": {
        "tier": { "enum": ["personal", "confidential", "public"] },
        "tenant_slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" }
      },
      "if": { "properties": { "tier": { "const": "confidential" } } },
      "then": { "required": ["tenant_slug"] }
    },
    "payload": { "type": "object" },
    "status": {
      "enum": ["pending", "delivered", "completed", "declined", "failed", "expired"]
    },
    "delivered_at": { "type": "string", "format": "date-time" },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "responded_at"],
      "properties": {
        "status": { "enum": ["completed", "declined", "failed", "expired"] },
        "result": { "type": "object" },
        "error": { "type": "string", "maxLength": 1000 },
        "responded_at": { "type": "string", "format": "date-time" },
        "origin": { "type": "string", "maxLength": 2048 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "request_kind": { "const": "observe_tab" } } },
      "then": { "properties": { "payload": { "$ref": "#/definitions/observe_tab_payload" } } }
    },
    {
      "description": "A tenant-scoped observe_tab (any tier with scope.tenant_slug, i.e. a <tier>/<tenant> partition) must bind the observation to named origins: the native host is a single-operator channel and the operator's open tab may belong to any tenant.",
      "if": {
        "type": "object",
        "required": ["request_kind", "scope"],
        "properties": {
          "request_kind": { "const": "observe_tab" },
          "scope": {
            "type": "object",
            "required": ["tenant_slug"]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["allowed_origins"],
            "properties": { "allowed_origins": { "type": "array", "minItems": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "request_kind": { "const": "local_infer" } } },
      "then": { "properties": { "payload": { "$ref": "#/definitions/local_infer_payload" } } }
    },
    {
      "if": { "properties": { "request_kind": { "const": "notify" } } },
      "then": { "properties": { "payload": { "$ref": "#/definitions/notify_payload" } } }
    },
    {
      "description": "control_step carries one schema-bounded operation under a minted browser-control session (libs/shared-vision/src/browser-control-sessions.ts). The session binds the canonical origin; the host re-admits every step and the extension re-validates before executing. Steps never contain arbitrary JavaScript — op names are fixed vocabulary.",
      "if": { "properties": { "request_kind": { "const": "control_step" } } },
      "then": { "properties": { "payload": { "$ref": "#/definitions/control_step_payload" } } }
    }
  ],
  "definitions": {
    "observe_tab_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "mode"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1, "maxLength": 300 },
        "allowed_origins": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https?://[^/\\s]+$", "maxLength": 300 }
        },
        "mode": { "enum": ["text", "structure"] }
      }
    },
    "local_infer_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "input"],
      "properties": {
        "task": {
          "enum": [
            "summarize",
            "classify",
            "extract",
            "translate",
            "detect_language",
            "proofread",
            "rewrite",
            "write"
          ]
        },
        "input": { "type": "string", "minLength": 1, "maxLength": 30000 },
        "options": { "type": "object" }
      }
    },
    "notify_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "title", "body"],
      "properties": {
        "level": { "enum": ["info", "progress", "approval_pending"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": { "type": "string", "maxLength": 1000 },
        "approval_request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "mission_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["done", "total"],
          "properties": {
            "done": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "control_step_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "lease_id", "origin", "step"],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^BCS-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "lease_id": {
          "type": "string",
          "pattern": "^LCS-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "origin": {
          "type": "string",
          "pattern": "^https?://[^/\\s]+$",
          "maxLength": 300
        },
        "step": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step_id", "op"],
          "properties": {
            "step_id": { "type": "string", "minLength": 1, "maxLength": 80 },
            "op": {
              "enum": [
                "snapshot",
                "screenshot",
                "extract_text_ref",
                "list_tabs",
                "open_tab",
                "select_tab",
                "navigate",
                "click_ref",
                "click_if_present",
                "fill_ref",
                "select_ref",
                "press_ref",
                "wait_for_ref",
                "submit_form",
                "upload_file",
                "download_file",
                "delete",
                "purchase",
                "credential_submit",
                "settings_change"
              ]
            },
            "ref": { "type": "string", "maxLength": 80 },
            "role": { "type": "string", "maxLength": 80 },
            "name": { "type": "string", "maxLength": 300 },
            "text": { "type": "string", "maxLength": 4000 },
            "value": { "type": "string", "maxLength": 4000 },
            "key": { "type": "string", "maxLength": 80 },
            "url": { "type": "string", "maxLength": 2048 },
            "checked": { "type": "boolean" },
            "wait_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
            "timeout_ms": { "type": "integer", "minimum": 0, "maximum": 120000 },
            "tab_id": { "type": "integer" },
            "label": { "type": "string", "maxLength": 200 },
            "secret_name": {
              "type": "string",
              "maxLength": 60,
              "description": "When set on extract_text_ref, the extracted text is returned in result.secret_values and moved to the control secrets side-channel instead of the persisted response."
            }
          }
        }
      }
    }
  }
}
