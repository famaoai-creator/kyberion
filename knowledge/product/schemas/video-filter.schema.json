{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Provider-neutral live video filter request",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "filter_id", "type", "settings"],
  "properties": {
    "source_id": { "$ref": "#/$defs/id" },
    "filter_id": { "$ref": "#/$defs/id" },
    "type": { "enum": ["color_correction", "chroma_key", "crop"] },
    "enabled": { "type": "boolean", "default": true },
    "settings": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "color_correction" } } },
      "then": { "properties": { "settings": { "$ref": "#/$defs/colorCorrection" } } }
    },
    {
      "if": { "properties": { "type": { "const": "chroma_key" } } },
      "then": { "properties": { "settings": { "$ref": "#/$defs/chromaKey" } } }
    },
    {
      "if": { "properties": { "type": { "const": "crop" } } },
      "then": { "properties": { "settings": { "$ref": "#/$defs/crop" } } }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*[\\u0000-\\u001f])(?=.*\\S).+$"
    },
    "colorCorrection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Contract tuning ranges do not imply identical pixel algorithms across providers.",
      "properties": {
        "gamma": { "type": "number", "minimum": -3, "maximum": 3 },
        "contrast": { "type": "number", "minimum": -4, "maximum": 4 },
        "brightness": { "type": "number", "minimum": -1, "maximum": 1 },
        "saturation": { "type": "number", "minimum": -1, "maximum": 5 },
        "hue_degrees": { "type": "number", "minimum": -180, "maximum": 180 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "chromaKey": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "required": ["color"], "properties": { "color": { "const": "custom" } } },
          "then": { "required": ["custom_color"] }
        },
        {
          "if": { "required": ["custom_color"] },
          "then": { "required": ["color"], "properties": { "color": { "const": "custom" } } }
        }
      ],
      "properties": {
        "color": { "enum": ["green", "blue", "magenta", "custom"] },
        "custom_color": {
          "type": "string",
          "pattern": "^#[A-Fa-f0-9]{6}$",
          "description": "Conventional RGB color. Providers translate their native packed color representation."
        },
        "similarity": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "smoothness": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "spill": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "required": ["left"] },
              { "required": ["right"] },
              { "required": ["top"] },
              { "required": ["bottom"] },
              { "required": ["width"] },
              { "required": ["height"] }
            ]
          },
          "then": { "required": ["relative"] }
        },
        {
          "if": { "required": ["relative"], "properties": { "relative": { "const": true } } },
          "then": { "not": { "anyOf": [{ "required": ["width"] }, { "required": ["height"] }] } }
        },
        {
          "if": { "required": ["relative"], "properties": { "relative": { "const": false } } },
          "then": {
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "not": { "anyOf": [{ "required": ["right"] }, { "required": ["bottom"] }] }
          }
        }
      ],
      "properties": {
        "relative": { "type": "boolean" },
        "left": { "$ref": "#/$defs/edge" },
        "right": { "$ref": "#/$defs/edge" },
        "top": { "$ref": "#/$defs/edge" },
        "bottom": { "$ref": "#/$defs/edge" },
        "width": { "type": "integer", "minimum": 0, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 0, "maximum": 8192 }
      }
    },
    "edge": { "type": "integer", "minimum": -8192, "maximum": 8192 }
  }
}
