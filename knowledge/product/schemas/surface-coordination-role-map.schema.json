{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Surface Coordination Role Map Schema",
  "type": "object",
  "required": ["version", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["surface", "role"],
        "additionalProperties": false,
        "properties": {
          "surface": { "type": "string", "minLength": 1 },
          "role": {
            "description": "A GovernedArtifactRole (libs/core/artifact-store.ts GOVERNED_ARTIFACT_ROLES).",
            "type": "string",
            "enum": [
              "slack_bridge",
              "chronos_gateway",
              "surface_runtime",
              "mission_controller",
              "infrastructure_sentinel",
              "sovereign_concierge"
            ]
          },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
