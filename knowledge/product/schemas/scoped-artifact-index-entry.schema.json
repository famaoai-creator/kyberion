{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scoped-artifact-index-entry.schema.json",
  "title": "Scoped Artifact Index Entry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "artifact_class": {
      "enum": ["evidence", "report", "export", "cache", "tmp", "log", "state"]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\/].*"
    },
    "scope": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 5,
      "additionalProperties": false,
      "properties": {
        "tenant": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "mission": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "session": { "type": "string", "minLength": 1 }
      }
    },
    "scope_kind": { "enum": ["task", "mission", "project", "session", "tenant"] },
    "written_at": { "type": "string", "format": "date-time" }
  },
  "required": ["name", "artifact_class", "path", "scope", "scope_kind", "written_at"]
}
