{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ingest-document-parser-modules.schema.json",
  "title": "Ingest Document Parser Modules",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "parsers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "not": {
              "enum": ["docx", "pdf", "xlsx", "pptx", "html", "slack_thread", "markdown", "text"]
            }
          },
          "module": {
            "type": "string",
            "pattern": "^@actuator/[a-z0-9][a-z0-9._-]*$"
          }
        },
        "required": ["format", "module"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "parsers"],
  "additionalProperties": false
}
