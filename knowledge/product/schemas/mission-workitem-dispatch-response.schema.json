{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mission work-item dispatch response",
  "description": "Persisted work-item dispatch response envelope used for scoped context-pack seeding.",
  "type": "object",
  "properties": {
    "task_result": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["path", "kind"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
