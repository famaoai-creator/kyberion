{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "marketing-review.schema.json",
  "title": "Marketing artifact review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "review_id": { "type": "string", "minLength": 1 },
    "artifact_path": { "type": "string", "minLength": 1 },
    "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewer_role": { "type": "string", "minLength": 1 },
    "verdict": { "type": "string", "enum": ["approved", "changes_requested", "rejected"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["blocking", "suggestion"] },
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "required_action": { "type": "string" },
          "location": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "required": ["severity", "category", "description"]
      }
    }
  },
  "required": [
    "review_id",
    "artifact_path",
    "artifact_sha256",
    "reviewer_role",
    "verdict",
    "findings"
  ]
}
