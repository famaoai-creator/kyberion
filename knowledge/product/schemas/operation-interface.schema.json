{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reviewed standalone operation interface",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "description", "capabilities"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "schema_ref"],
        "properties": {
          "op": {
            "type": "string",
            "minLength": 1,
            "maxLength": 192,
            "pattern": "^[a-z][a-z0-9_-]*(?::[A-Za-z0-9_-]+)+$"
          },
          "schema_ref": {
            "type": "string",
            "pattern": "^knowledge/product/schemas/[A-Za-z0-9/._-]+\\.json$"
          }
        }
      }
    }
  }
}
