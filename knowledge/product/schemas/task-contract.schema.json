{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mission Task Contract",
  "type": "object",
  "required": ["task_id", "mission_id", "owner_agent_id", "status", "requested_role", "objective"],
  "properties": {
    "task_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "owner_agent_id": { "type": "string" },
    "worker_agent_id": { "type": "string" },
    "owner_resource_id": { "type": "string" },
    "worker_resource_id": { "type": "string" },
    "responsible_actor_id": { "type": "string" },
    "accountable_owner_id": { "type": "string" },
    "resource": { "$ref": "#/definitions/workforce_resource_ref" },
    "requested_role": {
      "type": "string",
      "enum": ["owner", "worker", "observer"]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "claimed",
        "in_progress",
        "submitted",
        "accepted",
        "rejected",
        "cancelled"
      ]
    },
    "objective": { "type": "string" },
    "inputs": { "type": "object" },
    "expected_outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "write_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "correlation_id": { "type": "string" },
    "delegation_chain": {
      "type": "array",
      "description": "NI-03: root-first delegation chain (internal analogue of the RFC 8693 nested act claim). chain[0] is the originating principal (user/orchestrator); each hop appends one link. Optional/additive — chain-less contracts remain valid.",
      "items": { "$ref": "#/definitions/delegation_link" }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "delegation_link": {
      "type": "object",
      "required": ["actor", "granted_scope", "granted_at"],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical nhi_id (kyberion://agent/<org>/<slug>), 'user:<id>', or a legacy actor string."
        },
        "team_role": { "type": "string" },
        "granted_scope": {
          "type": "object",
          "description": "What this link grants. Absent fields = unrestricted at this link; every non-root link must be a subset of its parent (child <= parent, fail-closed).",
          "properties": {
            "capability_tier": {
              "type": "string",
              "enum": ["implementer", "explorer", "planner"],
              "description": "KD-05 capability tier. Privilege order (what a tier can DO): implementer > explorer > planner."
            },
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "write_scopes": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "granted_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "workforce_resource_ref": {
      "type": "object",
      "required": [
        "resource_id",
        "resource_type",
        "display_name",
        "authority_roles",
        "capabilities",
        "availability",
        "cost_profile",
        "status",
        "accountable_human_id"
      ],
      "properties": {
        "resource_id": { "type": "string", "minLength": 1 },
        "resource_type": { "type": "string", "enum": ["human", "agent", "service"] },
        "display_name": { "type": "string", "minLength": 1 },
        "authority_roles": { "type": "array", "items": { "type": "string" } },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "availability": { "type": "object", "additionalProperties": true },
        "cost_profile": { "type": "object", "additionalProperties": true },
        "status": { "type": "string", "enum": ["active", "suspended", "revoked"] },
        "accountable_human_id": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "model_id": { "type": ["string", "null"] },
        "runtime_identity": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "resource_type": { "enum": ["agent", "service"] } }
          },
          "then": {
            "properties": {
              "accountable_human_id": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "resource_type": { "const": "agent" } }
          },
          "then": {
            "properties": {
              "runtime_identity": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "string",
                    "pattern": "^kyberion://agent/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
                  }
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
