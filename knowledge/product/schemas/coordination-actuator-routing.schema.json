{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "coordination-actuator-routing.schema.json",
  "title": "Coordination Actuator Routing",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "default_kind", "coordination_kinds", "execution_overrides"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "default_kind": { "type": "string", "minLength": 1 },
    "coordination_kinds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/route" }
    },
    "execution_overrides": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          { "$ref": "#/$defs/route" },
          {
            "type": "object",
            "required": ["deliverables"],
            "properties": {
              "deliverables": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_actuators", "support_components"],
      "properties": {
        "target_actuators": { "$ref": "#/$defs/idList" },
        "support_components": { "$ref": "#/$defs/idList" },
        "deliverables": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
