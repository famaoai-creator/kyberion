{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orchestration-config.schema.json",
  "title": "Documentation-only orchestration configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "documentation_only": { "const": true },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability_category": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["personal", "confidential", "public"] }
      },
      "required": ["capability_category", "namespace", "tier"]
    },
    "scaffolding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template_dir": { "type": "string", "minLength": 1 },
        "required_files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["template_dir", "required_files"]
    },
    "pipelines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 }
      },
      "required": ["dir", "timeout_ms"]
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "allowed_categories": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["registry", "allowed_categories"]
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "skill": { "type": "string", "minLength": 1 },
                "args": { "type": "string" }
              },
              "required": ["id", "skill", "args"]
            }
          }
        },
        "required": ["name", "id", "steps"]
      }
    }
  },
  "required": [
    "$schema",
    "documentation_only",
    "version",
    "name",
    "defaults",
    "scaffolding",
    "pipelines",
    "plugins",
    "jobs"
  ]
}
