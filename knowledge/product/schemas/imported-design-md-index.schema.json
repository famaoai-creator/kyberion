{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Imported DESIGN.md Index",
  "type": "object",
  "required": ["generated_at", "source_repo", "source_dir", "count", "systems"],
  "properties": {
    "generated_at": { "type": "string", "minLength": 1 },
    "source_repo": { "type": "string", "minLength": 1 },
    "source_dir": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "design_system_id",
          "theme_id",
          "slug",
          "name",
          "category",
          "description",
          "source_path",
          "keywords"
        ],
        "properties": {
          "design_system_id": { "type": "string", "minLength": 1 },
          "theme_id": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "keywords": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
