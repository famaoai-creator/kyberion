{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.dev/schemas/visual-review-rubric.schema.json",
  "title": "Visual Review Rubric",
  "description": "Governed criteria and iteration policy for rendered-artifact visual review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["criteria", "banned_patterns", "iteration"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "_meta": { "type": "string" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "severity", "weight", "prompt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["error", "warning"] },
          "weight": { "type": "number" },
          "prompt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "banned_patterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_rounds", "stop_when_no_errors"],
      "properties": {
        "_meta": { "type": "string" },
        "max_rounds": { "type": "integer", "minimum": 1 },
        "stop_when_no_errors": { "type": "boolean" }
      }
    }
  }
}
