{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runtime-health-sample.schema.json",
  "title": "Runtime health sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "process_name", "rss_mb", "heap_used_mb"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "process_name": { "type": "string", "minLength": 1 },
    "rss_mb": { "type": "number", "minimum": 0 },
    "heap_used_mb": { "type": "number", "minimum": 0 },
    "restarts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
