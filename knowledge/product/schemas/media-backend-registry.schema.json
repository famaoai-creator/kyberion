{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "media-backend-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "default_backend_ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "minLength": 1 },
        "video": { "type": "string", "minLength": 1 },
        "music": { "type": "string", "minLength": 1 }
      },
      "required": ["image", "voice", "video", "music"]
    },
    "backends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "backend_id": { "type": "string", "minLength": 1 },
          "modality": { "type": "string", "enum": ["image", "voice", "video", "music"] },
          "display_name": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["service_preset", "api", "cli", "local", "agent_tool"]
          },
          "provider": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["active", "shadow", "disabled"] },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["any", "darwin", "linux", "win32"] }
          },
          "supports": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact_formats": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "async": { "type": "boolean" },
              "playback": { "type": "boolean" },
              "mux_audio": { "type": "boolean" }
            }
          },
          "service_id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "description": "Legacy backend ids that resolve to this record (governed alias table; see media-backend-registry.ts).",
            "items": { "type": "string", "minLength": 1 }
          },
          "probe": {
            "type": "object",
            "description": "Governed availability-probe dispatch descriptor. The registry resolver dispatches on kind instead of branching on provider literals.",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["service_runtime", "tool_runtime", "native_bridge", "registry"]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "description": "Runtime id probed in the target registry (service_id or tool_id). Omitted for native_bridge/registry kinds."
              }
            },
            "required": ["kind"]
          },
          "api_key_env": { "type": "string", "minLength": 1 },
          "endpoint_env": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "args": {
            "type": "array",
            "items": { "type": "string" }
          },
          "video_render": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "argument_template": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "preload_script": { "type": "string", "minLength": 1 }
            },
            "required": ["argument_template"]
          },
          "fallback_backend_id": { "type": "string", "minLength": 1 },
          "cost_tier": {
            "type": "string",
            "enum": ["free", "paid", "self_hosted", "environment"]
          },
          "data_policy": {
            "type": "string",
            "enum": ["training_eligible", "zero_retention", "local_only"]
          },
          "execution_locality": {
            "type": "string",
            "enum": ["local", "remote", "hybrid"]
          },
          "notes": { "type": "string" }
        },
        "required": [
          "backend_id",
          "modality",
          "display_name",
          "kind",
          "provider",
          "status",
          "platforms",
          "supports"
        ]
      }
    }
  },
  "required": ["version", "default_backend_ids", "backends"]
}
