{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operations"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "operations": { "type": "array", "items": { "$ref": "#/definitions/mapping" } }
  },
  "definitions": {
    "path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": { "enum": ["__proto__", "prototype", "constructor"] }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "decision_type",
        "required_paths",
        "risk_level",
        "max_ttl_seconds"
      ],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "decision_type": { "type": "string", "minLength": 1 },
        "amount_path": { "$ref": "#/definitions/path" },
        "currency_path": { "$ref": "#/definitions/path" },
        "recipient_path": { "$ref": "#/definitions/path" },
        "required_paths": { "type": "array", "items": { "$ref": "#/definitions/path" } },
        "risk_level": { "enum": ["low", "medium", "high", "critical"] },
        "max_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "information_flow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["purpose", "recipient_class", "categories"],
          "properties": {
            "purpose": { "type": "string", "minLength": 1 },
            "recipient_class": {
              "enum": [
                "bound_customer",
                "known_counterparty",
                "approved_vendor",
                "public",
                "unknown"
              ]
            },
            "categories": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["routine_business", "personal_data", "sensitive_business", "unknown"]
              }
            },
            "attachment_count_path": { "$ref": "#/definitions/path" }
          }
        }
      }
    }
  }
}
