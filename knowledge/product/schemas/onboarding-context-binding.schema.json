{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/onboarding-context-binding.schema.json",
  "title": "Onboarding Context Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "customer_slug",
    "tenant_slug",
    "organization_id",
    "tier",
    "owner_id",
    "status",
    "default_service_ids",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": { "const": "1.0.0" },
    "kind": { "const": "onboarding_context_binding" },
    "customer_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "tenant_slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
    "organization_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "organization_name": { "type": "string", "minLength": 1 },
    "tier": { "type": "string", "enum": ["personal", "confidential", "public"] },
    "owner_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "confirmed", "active", "blocked"] },
    "default_project_id": { "type": "string", "minLength": 1 },
    "default_service_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "tier": { "const": "confidential" } }, "required": ["tier"] },
      "then": { "required": ["tenant_slug"] }
    }
  ]
}
