{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ingestion-rules.schema.json",
  "title": "Documentation-only ingestion rules",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "documentation_only": { "const": true },
    "action": { "const": "ingest" },
    "pipelines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 }
        },
        "required": ["type", "target"]
      }
    }
  },
  "required": ["$schema", "documentation_only", "action", "pipelines"]
}
