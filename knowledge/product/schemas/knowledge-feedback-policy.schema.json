{
  "$id": "https://kyberion.internal/schemas/knowledge-feedback-policy.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knowledge feedback policy",
  "description": "Governed bounds for per-scope knowledge usage aggregates.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "defaults": { "$ref": "#/$defs/caps" },
    "tenant_overrides": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/caps" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "caps": {
      "type": "object",
      "properties": {
        "max_usage_entries": { "type": "integer", "minimum": 1 },
        "max_usage_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
