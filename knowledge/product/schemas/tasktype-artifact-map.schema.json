{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/tasktype-artifact-map.schema.json",
  "title": "Task Type Artifact Map",
  "description": "Canonical task_type -> artifact-kind mapping. Single source of truth for resolveTaskTypeArtifact() in libs/core/outcome-contract.ts. Extend mappings here when a new task type gains a governed artifact; the TS fallback mirrors these values.",
  "type": "object",
  "required": ["version", "mappings", "fallback"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": ["string", "number"] },
    "mappings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "storage_class"],
        "properties": {
          "kind": { "$ref": "./artifact-kind.schema.json" },
          "storage_class": {
            "type": "string",
            "enum": ["repo", "artifact_store", "vault", "tmp", "external_ref"]
          }
        },
        "additionalProperties": false
      }
    },
    "fallback": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "./artifact-kind.schema.json" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
