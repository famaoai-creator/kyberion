{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/intent-resolution-packet.schema.json",
  "title": "Intent Resolution Packet",
  "type": "object",
  "required": ["kind", "utterance", "candidates"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "intent_resolution_packet"
    },
    "utterance": {
      "type": "string",
      "minLength": 1
    },
    "selected_intent_id": {
      "type": "string"
    },
    "selected_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "selected_resolution": {
      "type": "object",
      "properties": {
        "shape": { "type": "string" },
        "task_kind": { "type": "string" },
        "result_shape": { "type": "string" }
      },
      "additionalProperties": false
    },
    "selected_parameters": {
      "type": "object",
      "properties": {
        "platform_id": { "type": "string" },
        "target_platform": { "type": "string" },
        "service_name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "contextual_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_text",
        "locale",
        "action",
        "object",
        "subject",
        "source_binding",
        "missing",
        "assumptions",
        "confidence"
      ],
      "properties": {
        "kind": { "type": "string", "const": "contextual_intent_frame" },
        "source_text": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "enum": ["ja-JP", "en-US"] },
        "action": { "type": "string", "enum": ["read", "change", "unknown"] },
        "object": {
          "type": "string",
          "enum": ["calendar_events", "calendar_schedule", "unknown"]
        },
        "subject": {
          "type": "string",
          "enum": ["operator_self", "team", "unknown"]
        },
        "date_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "today",
                "tomorrow",
                "this_week",
                "next_week",
                "this_month",
                "next_month",
                "custom"
              ]
            },
            "normalized": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "timezone": { "type": "string" },
                "start_iso": { "type": "string" },
                "end_iso": { "type": "string" }
              }
            }
          }
        },
        "source_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidates", "confidence"],
          "properties": {
            "candidates": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "operator_default_calendar",
                  "google_calendar",
                  "outlook_calendar",
                  "browser_calendar"
                ]
              }
            },
            "selected": {
              "type": "string",
              "enum": [
                "operator_default_calendar",
                "google_calendar",
                "outlook_calendar",
                "browser_calendar"
              ]
            },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "missing": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence_breakdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": { "type": "number", "minimum": 0, "maximum": 1 },
            "object": { "type": "number", "minimum": 0, "maximum": 1 },
            "subject": { "type": "number", "minimum": 0, "maximum": 1 },
            "date_range": { "type": "number", "minimum": 0, "maximum": 1 },
            "source_binding": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intent_id", "confidence", "reasons", "source"],
        "properties": {
          "intent_id": { "type": "string" },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string",
            "enum": ["catalog", "heuristic", "legacy"]
          },
          "matched_keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "resolution": {
            "type": "object",
            "properties": {
              "shape": { "type": "string" },
              "task_kind": { "type": "string" },
              "result_shape": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "bundle_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bundle_id",
          "status",
          "kind",
          "summary",
          "required_actuators",
          "intents",
          "references"
        ],
        "properties": {
          "bundle_id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["active", "experimental", "conceptual", "deprecated"]
          },
          "kind": {
            "type": "string",
            "enum": ["actuator-pipeline-bundle", "capability-bundle"]
          },
          "summary": { "type": "string" },
          "required_actuators": {
            "type": "array",
            "items": { "type": "string" }
          },
          "intents": {
            "type": "array",
            "items": { "type": "string" }
          },
          "references": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
