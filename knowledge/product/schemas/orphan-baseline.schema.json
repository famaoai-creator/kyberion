{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orphan-baseline.schema.json",
  "title": "Orphan ratchet baseline",
  "description": "Known orphans (OW-07) the orphan ratchet tolerates, one reasoned entry each. The list may only shrink.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "libs_core_modules", "scripts", "pipelines", "actuator_ops"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "libs_core_modules": { "$ref": "#/$defs/entries" },
    "scripts": { "$ref": "#/$defs/entries" },
    "pipelines": { "$ref": "#/$defs/entries" },
    "actuator_ops": { "$ref": "#/$defs/entries" }
  },
  "$defs": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
