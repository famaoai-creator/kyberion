{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decision-lock.schema.json",
  "title": "Decision Ledger Lock",
  "description": "Frozen view of the decided records an implementation was checked against. Committed into the implementation repository and re-checked in its CI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "case_id", "generated_at", "status", "decisions"],
  "properties": {
    "version": { "type": "string", "enum": ["1.0.0"] },
    "case_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "impl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit"],
      "properties": {
        "repo": { "type": "string" },
        "commit": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "status": { "type": "string", "enum": ["green", "red"] },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "item", "key", "level", "basis"],
        "properties": {
          "id": { "type": "string" },
          "item": { "type": "string" },
          "key": { "type": "string" },
          "level": { "type": "string" },
          "value": {},
          "basis": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "version"],
              "properties": { "ref": { "type": "string" }, "version": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
