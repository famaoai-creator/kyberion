{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decision-observed.schema.json",
  "title": "Decision Ledger Observed Set",
  "description": "What an observer extracted from one implementation revision, keyed by decision key. Machine-written; never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "impl", "observed_at", "observations"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$" },
    "impl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "observed_at": { "type": "string" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value", "ref"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
          "value": {},
          "ref": { "type": "string", "minLength": 1 },
          "quote": { "type": "string" },
          "stale": { "type": "boolean" }
        }
      }
    }
  }
}
