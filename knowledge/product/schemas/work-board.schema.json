{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/work-board.schema.json",
  "title": "Work Board",
  "type": "object",
  "required": ["board_id", "name", "type", "filters", "sort_by", "created_at", "updated_at"],
  "properties": {
    "board_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["project", "personal", "peer", "review", "external"]
    },
    "description": { "type": "string" },
    "filters": {
      "type": "object",
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "tenant_slugs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "organization_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "project_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source": {
          "oneOf": [
            { "enum": ["local", "github", "jira", "peer"] },
            {
              "type": "array",
              "items": { "enum": ["local", "github", "jira", "peer"] }
            }
          ]
        },
        "status": {
          "oneOf": [
            {
              "enum": ["backlog", "ready", "in_progress", "blocked", "review", "done", "archived"]
            },
            {
              "type": "array",
              "items": {
                "enum": ["backlog", "ready", "in_progress", "blocked", "review", "done", "archived"]
              }
            }
          ]
        },
        "assignee_peer_id": { "type": "string", "minLength": 1 },
        "assignee_user_id": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "text": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sort_by": {
      "type": "string",
      "enum": ["priority", "updated_at", "created_at", "status"]
    },
    "lanes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
