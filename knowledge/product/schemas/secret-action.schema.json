{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Secret Actuator Request",
  "type": "object",
  "required": ["action", "params"],
  "properties": {
    "action": { "enum": ["get", "set", "delete", "list"] },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "description": "Keychain / vault service id (e.g. gemini)."
        },
        "account": {
          "type": "string",
          "minLength": 1,
          "description": "Keychain account / secret key snake form (e.g. api_key)."
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Secret value. Prefer kyberion secret introduce / Concierge — never pass via playground --params."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action": { "enum": ["get", "set", "delete"] } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["service", "account"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "action": { "const": "set" } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["service", "account", "value"]
          }
        }
      }
    }
  ]
}
