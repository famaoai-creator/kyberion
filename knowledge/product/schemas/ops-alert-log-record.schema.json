{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ops-alert-log-record.schema.json",
  "title": "Operations Alert Log Record",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "suppressed": { "type": "boolean" },
        "severity": { "enum": ["info", "warning", "critical"] },
        "title": { "type": "string", "minLength": 1 },
        "context": { "type": "object" },
        "recommendation": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "type": "string" } },
        "dedupe_key": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 }
      },
      "required": [
        "id",
        "timestamp",
        "suppressed",
        "severity",
        "title",
        "context",
        "recommendation"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ts": { "type": "string", "format": "date-time" },
        "kind": { "const": "operator_notification_undelivered" },
        "event": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "correlation_id": { "type": "string", "minLength": 1 },
        "alert_id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "critical"] },
        "context": { "type": "object" },
        "recommendation": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["ts", "kind", "event", "title", "reason"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ts": { "type": "string", "format": "date-time" },
        "kind": { "const": "ops_alert_ack" },
        "before": { "type": "string", "format": "date-time" },
        "acked_count": { "type": "integer", "minimum": 0 }
      },
      "required": ["ts", "kind", "before", "acked_count"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ts": { "type": "string", "format": "date-time" },
        "kind": { "const": "ops_alert_redelivery" },
        "ref": { "type": "string", "minLength": 1 },
        "channel": { "const": "webhook" },
        "delivered": { "type": "boolean" },
        "error": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "required": ["ts", "kind", "ref", "channel", "delivered"]
    }
  ]
}
