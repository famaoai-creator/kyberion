{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knowledge-scope-check.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "max_direct_tenant_env_reads": { "type": "integer", "minimum": 0 },
    "legacy_quarantine_ttl_days": { "type": "integer", "minimum": 0 },
    "confidential_scope_allowlist": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "scoped_runtime_writer_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "version",
    "description",
    "max_direct_tenant_env_reads",
    "legacy_quarantine_ttl_days",
    "confidential_scope_allowlist",
    "scoped_runtime_writer_files"
  ]
}
