{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reasoning-provider-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "minLength": 1 },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reasoning": { "type": "boolean" },
              "structured_output": { "type": "boolean" },
              "abort": { "type": "boolean" },
              "session_continuity": { "type": "boolean" },
              "input_modalities": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["text", "image", "audio"] },
                "contains": { "const": "text" }
              }
            },
            "required": [
              "reasoning",
              "structured_output",
              "abort",
              "session_continuity",
              "input_modalities"
            ]
          },
          "env_keys": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["mode", "provider", "module", "capabilities", "env_keys"]
      }
    }
  },
  "required": ["providers"]
}
