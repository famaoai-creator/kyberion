{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ui-component-registry.schema.json",
  "title": "UI Component Registry",
  "description": "Business-flow components the front-desk host assembles (A2UI COMPONENT HOST PLAN §2.2). One entry = one flow or view; labels are front_desk vocabulary keys; operations reference headless operation ids.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "title_key",
          "summary_key",
          "host",
          "menu",
          "required_role",
          "operations"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,60}$" },
          "kind": { "type": "string", "enum": ["flow", "view"] },
          "status": { "type": "string", "enum": ["a2ui", "page", "planned"] },
          "title_key": { "type": "string", "pattern": "^front_desk:[a-z0-9_]+$" },
          "summary_key": { "type": "string", "pattern": "^front_desk:[a-z0-9_]+$" },
          "host": { "type": "string", "enum": ["presence-studio", "concierge"] },
          "entry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "a2ui_path": { "type": "string", "pattern": "^/api/" },
              "page_path": { "type": "string", "pattern": "^/" },
              "page_surface": { "type": "string", "enum": ["presence-studio", "concierge"] },
              "input": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operation_id", "placeholder_key"],
                "properties": {
                  "operation_id": { "type": "string", "minLength": 1 },
                  "placeholder_key": { "type": "string", "pattern": "^front_desk:[a-z0-9_]+$" }
                }
              }
            }
          },
          "menu": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group", "order"],
            "properties": {
              "group": {
                "type": "string",
                "enum": ["home", "ask", "decide", "progress", "settings"]
              },
              "order": { "type": "integer", "minimum": 0 }
            }
          },
          "required_role": { "type": "string", "enum": ["viewer", "approver", "owner"] },
          "operations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
