{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "video-ingest-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "allowed_hosts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "max_duration_sec": { "type": "number", "exclusiveMinimum": 0 },
    "max_bytes": { "type": "integer", "exclusiveMinimum": 0 },
    "require_approval_for_remote": { "type": "boolean" },
    "default_max_keyframes": { "type": "integer", "minimum": 0 },
    "keyframe_interval_sec": { "type": "number", "exclusiveMinimum": 0 },
    "scene_threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "download_format": { "type": "string", "minLength": 1 }
  },
  "required": [
    "version",
    "allowed_hosts",
    "max_duration_sec",
    "max_bytes",
    "require_approval_for_remote",
    "default_max_keyframes",
    "keyframe_interval_sec",
    "scene_threshold",
    "download_format"
  ]
}
