{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "protocol-service-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": ["protocol-gateway", "control-plane-worker", "artifact-review-port"]
          },
          "process_scope": { "enum": ["system", "tenant-service"] },
          "request_scope_mode": { "type": "string", "minLength": 1 },
          "health": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "binding": { "type": "string", "minLength": 1 },
          "approval": { "type": "string", "minLength": 1 },
          "principal_resolution": { "type": "string", "minLength": 1 },
          "write_authority": { "type": "string", "minLength": 1 },
          "nhi_binding": { "type": "string", "minLength": 1 },
          "approval_classes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "data_residency": { "type": "string", "minLength": 1 },
          "data_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "lifecycle_actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "lifecycle_owner": { "enum": ["surface_runtime", "service"] },
          "lifecycle_compatibility": { "type": "string", "minLength": 1 }
        },
        "required": [
          "id",
          "classification",
          "process_scope",
          "request_scope_mode",
          "health",
          "owner",
          "binding",
          "approval",
          "principal_resolution",
          "write_authority",
          "nhi_binding",
          "approval_classes",
          "data_residency",
          "data_paths",
          "lifecycle_actions"
        ]
      }
    }
  },
  "required": ["version", "description", "entries"]
}
