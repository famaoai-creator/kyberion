{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "permission-presets.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "presets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sandbox_mode": { "type": "string", "minLength": 1 },
          "approval_policy": { "type": "string", "minLength": 1 },
          "capability_profile": { "type": "string", "minLength": 1 }
        },
        "required": ["sandbox_mode", "approval_policy", "capability_profile"]
      }
    }
  },
  "required": ["version", "presets"]
}
