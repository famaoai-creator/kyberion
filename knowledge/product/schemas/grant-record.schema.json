{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/grant-record.schema.json",
  "title": "Standing Grant Record (grant-record.v1)",
  "description": "A scoped, time-bounded standing grant (PG-03). Stored at active/shared/runtime/grants/<tier>/<tenant|shared>/<grant_id>.json. Revocation keeps the record and adds `revoked`. Semantic rules (expiry within the capability's max_ttl_days, required scope keys, external_io => basis.approval_request_id) are enforced in code on create and on load.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_id",
    "capability",
    "scope",
    "purpose",
    "granted_by",
    "granted_at",
    "expires_at",
    "audit_event_id"
  ],
  "properties": {
    "schema_version": {
      "const": "grant-record.v1"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^GRT-[0-9]{8}-[a-f0-9]{12}$"
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "credential_provider": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "credential_ref": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[A-Z][A-Z0-9_]{0,63}$"
            },
            "tenant_slug": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,30}$"
            },
            "meeting_series_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "meeting_urls": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "service_allocation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "binding_id",
                "owner_ref",
                "service_id",
                "secret_refs",
                "allowed_actions",
                "target"
              ],
              "properties": {
                "binding_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "owner_ref": {
                  "type": "string",
                  "pattern": "^user:[a-z][a-z0-9-]*$"
                },
                "service_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "secret_refs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                  }
                },
                "allowed_actions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  }
                },
                "project_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "mission_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "task_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner_ref",
            "nhi_id",
            "binding_id",
            "service_id",
            "target",
            "secret_refs",
            "allowed_actions",
            "generation",
            "project_id",
            "mission_id",
            "task_id"
          ],
          "properties": {
            "binding_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "owner_ref": {
              "type": "string",
              "pattern": "^user:[a-z][a-z0-9-]*$"
            },
            "service_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "secret_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
              }
            },
            "allowed_actions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            },
            "project_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "mission_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "task_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "nhi_id": {
              "type": "string",
              "pattern": "^kyberion://agent/_/_/[a-z][a-z0-9-]*$"
            },
            "generation": {
              "type": "string",
              "format": "uuid"
            },
            "runtime_use": {
              "const": "selected-read-api-v1",
              "description": "Explicit new runtime opt-in. Absent legacy grants remain management-only."
            }
          }
        }
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "granted_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "role", "assurance"],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": ["operator", "member_self", "sovereign"]
        },
        "assurance": {
          "type": "string",
          "enum": ["A0", "A1", "A2", "A3"]
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_request_id", "approval_channel"],
      "properties": {
        "approval_request_id": {
          "type": "string",
          "minLength": 1
        },
        "approval_channel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "by", "audit_event_id"],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "by_kind": {
          "type": "string",
          "enum": ["human", "agent"]
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "audit_event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audit_event_id": {
      "type": "string",
      "minLength": 1
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "const": "person"
        },
        "ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["custody"]
      },
      "then": {
        "properties": {
          "capability": {
            "const": "credential.personal_use"
          },
          "scope": {
            "required": ["owner_ref"],
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "capability": {
            "not": {
              "const": "credential.personal_use"
            }
          },
          "scope": {
            "not": {
              "required": ["owner_ref"]
            },
            "type": "object"
          }
        }
      }
    }
  ]
}
