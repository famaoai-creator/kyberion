{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "maintenance-schedule.schema.json",
  "title": "Documentation-only maintenance schedule",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "documentation_only": { "const": true },
    "schedule": { "type": "string", "minLength": 1 },
    "policy_path": { "type": "string", "minLength": 1 },
    "default_tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "scope": { "type": "string", "minLength": 1 }
  },
  "required": ["$schema", "documentation_only", "schedule", "policy_path", "default_tasks", "scope"]
}
