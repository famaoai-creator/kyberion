{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "surfaces"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "description", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["gateway", "ui", "service"] },
          "description": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "args": {
            "type": "array",
            "items": { "type": "string" }
          },
          "cwd": { "type": "string" },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "shutdownPolicy": { "type": "string", "enum": ["manual", "idle", "detached"] },
          "startupMode": { "type": "string", "enum": ["background", "workspace-app"] },
          "ownerType": { "type": "string" },
          "port": { "type": "integer", "minimum": 1 },
          "healthPath": { "type": "string" },
          "service_id": { "type": "string" },
          "preset_path": { "type": "string" },
          "enabled": { "type": "boolean" },
          "urlEnv": { "type": "string", "minLength": 1 },
          "controlPlane": { "type": "string", "enum": ["presence", "chronos"] },
          "remediationCommand": { "type": "string", "minLength": 1 },
          "operatorNotesKey": { "type": "string", "minLength": 1 },
          "bestForKey": { "type": "string", "minLength": 1 },
          "ingress": {
            "type": "object",
            "description": "Public ingress opt-in. Only a surface with allowed=true can be exposed by `pnpm kyberion ingress up`; path_prefix is the only public path published.",
            "required": ["allowed"],
            "properties": {
              "allowed": { "type": "boolean" },
              "path_prefix": {
                "type": "string",
                "pattern": "^/(?:[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*)?$"
              },
              "port_env": {
                "type": "string",
                "description": "Registered env var that can move the surface's listener; `ingress up` refuses when it is set to a different port than `port`.",
                "pattern": "^KYBERION_[A-Z0-9_]+$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
