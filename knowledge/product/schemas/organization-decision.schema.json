{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/organization-decision.schema.json",
  "title": "Organization Governance Decision",
  "type": "object",
  "required": [
    "version",
    "decision_id",
    "organization_id",
    "cadence_id",
    "title",
    "status",
    "decision_owner",
    "due_at",
    "options",
    "follow_up_refs",
    "tier",
    "updated_at"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "organization_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "cadence_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "decision_type": {
      "type": "string",
      "enum": [
        "approval",
        "policy_change",
        "slo_change",
        "automation_boundary",
        "prioritization",
        "review"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "pending_approval", "approved", "rejected", "deferred", "implemented"]
    },
    "requested_by": { "type": "string" },
    "decision_owner": { "type": "string", "minLength": 1 },
    "due_at": { "type": "string", "format": "date-time" },
    "options": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "chosen_option": { "type": "string" },
    "rationale": { "type": "string" },
    "approval_refs": { "type": "array", "items": { "type": "string" } },
    "follow_up_refs": { "type": "array", "items": { "type": "string" } },
    "tier": { "type": "string", "enum": ["personal", "confidential", "public"] },
    "tenant_slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
    "updated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "required": ["tier"], "properties": { "tier": { "const": "confidential" } } },
      "then": { "required": ["tenant_slug"] }
    }
  ]
}
