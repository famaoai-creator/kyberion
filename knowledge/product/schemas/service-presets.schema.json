{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service Preset",
  "description": "Canonical operation template for a single service endpoint.",
  "type": "object",
  "required": ["operations"],
  "properties": {
    "service_id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "auth_strategy": { "type": "string" },
    "setup_hint": { "type": "string" },
    "allow_unsafe_cli": { "type": "boolean" },
    "allow_local_network": { "type": "boolean" },
    "fallback_strategy": { "type": "string" },
    "operations": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/operation" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "parameter": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "type": { "enum": ["string", "number", "integer", "boolean", "object", "array"] },
        "default": {},
        "description": { "type": "string" },
        "enum": { "type": "array" }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["result_present", "non_empty", "field_present", "field_equals"] },
        "path": { "type": "string" },
        "expected": {}
      },
      "additionalProperties": false
    },
    "alternative": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["api", "cli", "mcp", "oauth", "sdk", "auto"] },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string" },
        "base_url": { "type": "string" },
        "url": { "type": "string" },
        "command": { "type": "string" },
        "args": { "type": "array" },
        "env": { "type": "object", "additionalProperties": {} },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "payload_template": {},
        "output_mapping": { "type": "object", "additionalProperties": { "type": "string" } },
        "allow_local_network": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "operation": {
      "type": "object",
      "properties": {
        "type": { "enum": ["api", "cli", "mcp", "oauth", "sdk", "auto"] },
        "kind": { "enum": ["capture", "apply"] },
        "risk": { "enum": ["read", "write", "destructive"] },
        "approval_required": { "type": "boolean" },
        "idempotency": { "enum": ["not_applicable", "recommended", "required"] },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string" },
        "command": { "type": "string" },
        "description": { "type": "string" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameter" }
        },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/alternative" },
          "minItems": 1
        },
        "verification": { "$ref": "#/$defs/verification" },
        "output_mapping": { "type": "object", "additionalProperties": { "type": "string" } },
        "payload_template": {}
      },
      "additionalProperties": true
    }
  }
}
