{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "customer-decision-agenda.schema.json",
  "title": "Customer Decision Agenda",
  "description": "A decision agenda (CD-01): the bundle of decision requests sent to a customer in one invitation. Stored at knowledge/confidential/<tenant>/decisions/<case>/agendas/<agenda_id>.json on top of the SSOD decision ledger, which holds the decision values. See libs/core/customer-decision/model.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "agenda_id",
    "tenant_slug",
    "case_id",
    "customer",
    "title",
    "phase",
    "revision",
    "locale",
    "entries",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["1.0.0"] },
    "agenda_id": { "type": "string", "pattern": "^agd-[A-Za-z0-9][A-Za-z0-9_-]{3,80}$" },
    "tenant_slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
    "case_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$" },
    "customer": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,60}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "from": {
      "description": "Who the request is from, as the customer sees it (e.g. the vendor's trade name or the account team). Part of the content hash when present.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "phase": { "type": "string", "minLength": 1, "maxLength": 120 },
    "revision": { "type": "integer", "minimum": 1 },
    "locale": { "type": "string", "enum": ["ja", "en"] },
    "deal_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "entries": { "type": "array", "items": { "$ref": "#/definitions/entry" } },
    "status": {
      "type": "string",
      "enum": ["draft", "pending_approval", "approved", "sent", "closed", "withdrawn"]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash", "approved_at", "approved_by"],
      "properties": {
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "request_id": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "minLength": 1 },
        "approved_by": { "type": "string", "minLength": 1 }
      }
    },
    "in_force": {
      "description": "Our decisions in force: the pins of the last approval. Kept when the agenda is edited (which removes `approval`), so those approved ledger records stay in force until the edit is re-approved.",
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash", "approved_at", "pinned_ids"],
      "properties": {
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "approved_at": { "type": "string", "minLength": 1 },
        "pinned_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^D-[0-9]{4,}$" },
          "uniqueItems": true
        }
      }
    },
    "operator_confirmations": {
      "description": "CD-08: the operator's confirmation of a customer decision on a requires_customer (money / contract) entry. Outside the content hash; one ledger decision id per confirmation, so a later customer decision needs its own.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "decision_id", "by", "at"],
        "properties": {
          "entry_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$" },
          "decision_id": { "type": "string", "pattern": "^D-[0-9]{4,}$" },
          "by": { "type": "string", "pattern": "^user:[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "at": { "type": "string", "minLength": 1 },
          "request_id": {
            "description": "The approval request (operation customer_decision:operator_confirm) that authorized the confirmation.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "milestones_passed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "bolt_mission_id": {
      "description": "CD-10: the mission (bolt) this agenda reviews (customer-decision bolt-review). Outside the content hash. The next mission of the case passes the bolt-after:<id> milestone when it starts.",
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "bolt_routing": {
      "description": "CD-10: where the customer's bolt-review answers went (request_changes: a backlog WorkItem; reject: an operator notification). Ids only, outside the content hash.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "ref", "outcome", "at"],
        "properties": {
          "entry_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$" },
          "ref": {
            "description": "The ledger decision id, or the receipt id of a change request.",
            "type": "string",
            "pattern": "^(D-[0-9]{4,}|rcp-[A-Za-z0-9][A-Za-z0-9_-]{3,80})$"
          },
          "outcome": { "type": "string", "enum": ["request_changes", "reject"] },
          "work_item_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "notified_at": { "type": "string", "minLength": 1 },
          "inbox_entry_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "at": { "type": "string", "minLength": 1 }
        }
      }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["approved", "sent"] } },
        "required": ["status"]
      },
      "then": { "required": ["approval"] }
    }
  ],
  "definitions": {
    "layer": { "type": "string", "enum": ["customer", "ours", "org_default"] },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "item", "key", "kind", "question", "requires_customer"],
      "properties": {
        "entry_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$" },
        "item": { "type": "string", "minLength": 1, "maxLength": 200 },
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
        "kind": { "type": "string", "enum": ["choice", "approval", "ranking", "hearing"] },
        "question": { "type": "string", "minLength": 1 },
        "background": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": {},
              "label": { "type": "string", "minLength": 1 },
              "impact": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cost": { "type": "string" },
                  "schedule": { "type": "string" },
                  "scope": { "type": "string" },
                  "rework": { "type": "string" }
                }
              }
            }
          }
        },
        "layers": {
          "description": "Layer order for this entry. The customer's decision is always the top layer: an explicit order contains \"customer\" (checked here) and starts with it (checked by the facade, customer-decision draft / generate / submit).",
          "type": "array",
          "items": { "$ref": "#/definitions/layer" },
          "contains": { "const": "customer" },
          "minItems": 1,
          "uniqueItems": true
        },
        "our_decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": {},
            "rationale": { "type": "string" },
            "decision_id": { "type": "string", "pattern": "^D-[0-9]{4,}$" }
          }
        },
        "org_default": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "source"],
          "properties": {
            "value": {},
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "requires_customer": { "type": "boolean" },
        "override_until": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "at"],
              "properties": {
                "kind": { "const": "date" },
                "at": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "milestone"],
              "properties": {
                "kind": { "const": "milestone" },
                "milestone": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "attachments": {
          "description": "CD-10: images shown with the entry (bytes in the case under attachments/<id>.<ext>). In the content hash.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "media_type", "bytes"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "media_type": { "type": "string", "enum": ["image/png", "image/jpeg", "image/webp"] },
              "bytes": { "type": "integer", "minimum": 1, "maximum": 524288 }
            }
          }
        },
        "links": {
          "description": "CD-10: external links shown with the entry (public https URLs only; the facade refuses internal hosts). In the content hash.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "url": { "type": "string", "pattern": "^https://", "maxLength": 2000 }
            }
          }
        }
      },
      "allOf": [
        {
          "$comment": "requires_customer entries carry no lower layers: work waits for the customer.",
          "if": {
            "properties": { "requires_customer": { "const": true } },
            "required": ["requires_customer"]
          },
          "then": {
            "not": { "anyOf": [{ "required": ["our_decision"] }, { "required": ["org_default"] }] }
          }
        }
      ]
    }
  }
}
