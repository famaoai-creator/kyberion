{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "customer-decision-brief-input.schema.json",
  "title": "Customer Decision Brief Input",
  "description": "CD-08: a projection of one agenda's effective decisions that feeds the MO-11 alignment brief (scope and open items). Stored at <case dir>/brief-input.json. See libs/core/customer-decision/reflect.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "case_id",
    "agenda_id",
    "content_hash",
    "generated_at",
    "decisions",
    "open_items"
  ],
  "properties": {
    "version": { "type": "string", "enum": ["1.0.0"] },
    "case_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$" },
    "agenda_id": { "type": "string", "pattern": "^agd-[A-Za-z0-9][A-Za-z0-9_-]{3,80}$" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "item", "key", "question", "status", "layer"],
        "properties": {
          "entry_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$" },
          "item": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "value": {},
          "status": {
            "type": "string",
            "enum": ["confirmed", "provisional", "awaiting_customer", "undecided"]
          },
          "layer": { "type": "string", "enum": ["customer", "ours", "org_default", "none"] },
          "decision_id": { "type": "string", "pattern": "^D-[0-9]{4,}$" }
        }
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "question", "status"],
        "properties": {
          "entry_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$" },
          "question": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["awaiting_customer", "undecided"] }
        }
      }
    }
  }
}
