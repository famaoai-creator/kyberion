{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tool-runtime-state.schema.json",
  "title": "Persisted tool runtime state",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "1.0.0" },
    "tool_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["trial", "approved_install", "installed", "pinned"]
    },
    "backend_kind": {
      "type": "string",
      "enum": ["uvx", "uv", "pipx", "npx", "npm", "pnpm", "brew", "winget", "system"]
    },
    "command": { "type": "string", "minLength": 1 },
    "args": { "type": "array", "items": { "type": "string" } },
    "managed_env_path": { "type": "string", "minLength": 1 },
    "installed_at": { "type": "string", "format": "date-time" },
    "pinned_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "required": ["action"]
    }
  },
  "required": [
    "version",
    "tool_id",
    "status",
    "backend_kind",
    "command",
    "args",
    "managed_env_path"
  ]
}
