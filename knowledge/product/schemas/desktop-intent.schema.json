{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/desktop-intent.schema.json",
  "title": "Desktop Intent Reconstruction",
  "type": "object",
  "required": [
    "schema_version",
    "intent",
    "steps",
    "source_recording_id",
    "generated_at",
    "review"
  ],
  "properties": {
    "schema_version": { "const": "desktop-intent.v1" },
    "intent": { "type": "string", "minLength": 1 },
    "source_recording_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "detail", "evidence", "confidence", "op"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "op": { "type": "string" },
          "native_op": { "type": "string" },
          "repeat": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "reviewer": { "type": "string" },
        "reviewed_at": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
