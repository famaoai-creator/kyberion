{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hearing-scenarios.schema.json",
  "title": "Hearing Scenario Catalog",
  "description": "WI-08: data-driven hearing scenarios for the presence-studio /ask?mode=hearing flow — presence/displays/presence-studio/hearing.ts's WEB_APP_HEARING_SCENARIO and libs/core/hearing-scenario-catalog.ts both read this catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scenarios"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label_key", "description_key", "requirements", "canvas", "handoff"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$"
          },
          "label_key": {
            "type": "string",
            "minLength": 1,
            "description": "A front_desk:* vocabulary key — never raw display text."
          },
          "description_key": {
            "type": "string",
            "minLength": 1,
            "description": "A front_desk:* vocabulary key — never raw display text."
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label_key"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$"
                },
                "label_key": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A front_desk:* vocabulary key — never raw display text."
                },
                "aliases": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "canvas": {
            "type": "string",
            "enum": ["web_app_preview", "work_inventory_table"]
          },
          "handoff": {
            "type": "string",
            "enum": ["mission", "work_inventory"]
          }
        }
      }
    }
  }
}
