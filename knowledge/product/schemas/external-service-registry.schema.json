{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kyberion.local/schemas/external-service-registry.schema.json",
  "title": "External Service Registry",
  "type": "object",
  "required": ["version", "services"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "notes": { "type": "array", "items": { "type": "string" } },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "service_id",
          "topic",
          "url",
          "registered_at",
          "success_count",
          "failure_count"
        ],
        "additionalProperties": false,
        "properties": {
          "service_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
          "topic": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "registered_at": { "type": "string", "format": "date-time" },
          "last_success_at": { "type": "string", "format": "date-time" },
          "success_count": { "type": "integer", "minimum": 0 },
          "failure_count": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
