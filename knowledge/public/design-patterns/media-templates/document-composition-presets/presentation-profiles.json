    "generic-deck": {
      "artifact_family": "presentation",
      "document_type": "presentation",
      "narrative_pattern_id": "generic-deck",
      "recommended_theme": "kyberion-standard",
      "sections": [
        {
          "section_id": "cover",
          "title": "{{title}}",
          "objective": "{{core_message}}",
          "media_kind": "hero",
          "layout_key": "cover-statement",
          "visual": "hero statement"
        }
      ],
      "prompt_guide": [
        "Section-driven deck: each payload.sections entry becomes one slide (heading -> title, body/bullets -> content).",
        "Layout is chosen per-section by the slide pattern pack; callouts prefer callout layouts.",
        "Keep one message per slide; aim for short bullets over dense paragraphs."
      ]
    },
    "consulting-strategy": {
      "artifact_family": "presentation",
      "document_type": "presentation",
      "design_system_id": "consulting-strategy",
      "narrative_pattern_id": "generic-deck",
      "recommended_theme": "deloitte-consulting",
      "sections": [
        {
          "section_id": "cover",
          "title": "{{title}}",
          "objective": "{{core_message}}",
          "media_kind": "hero",
          "layout_key": "cover-statement",
          "visual": "hero statement"
        }
      ],
      "prompt_guide": [
        "Deloitte-style consulting narrative: challenge -> approach -> framework -> recommendation -> next steps.",
        "Action titles: each slide heading states the takeaway, not the topic (e.g. '3つの課題が成長を阻害' not '課題一覧').",
        "Restrained palette — monochrome + single green accent; use accent only for the key callout/number.",
        "Prefer structured components: matrix for options, pyramid/pyramid for hierarchy, process for the approach, roadmap for next steps, kpi_table for the case.",
        "One message per slide; short bullets; dense paragraphs belong in appendix."
      ]
    }
  }
}
