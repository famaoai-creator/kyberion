          "media_kind": "evidence",
          "layout_key": "evidence-callout",
          "visual": "pain points / baseline"
        },
        {
          "section_id": "target-outcome",
          "title": "Target Outcome",
          "objective": "Show the future-state result and customer or operator gain",
          "media_kind": "journey",
          "layout_key": "two-column-story",
          "visual": "future-state journey"
        },
        {
          "section_id": "solution-shape",
