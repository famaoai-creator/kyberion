      "document_type": "proposal",
      "narrative_pattern_id": "problem-solution-executive",
      "recommended_theme": "kyberion-standard",
      "recommended_layout_template_id": "executive-neutral",
      "sections": [
        {
          "section_id": "cover",
          "title": "{{title}}",
          "objective": "{{core_message}}",
          "media_kind": "hero",
          "layout_key": "cover-statement",
          "visual": "hero statement"
        },
        {
