          "objective": "Explain how risk, compliance, and operations stay governed",
          "media_kind": "controls",
          "layout_key": "risk-controls",
          "visual": "control model"
        },
        {
          "section_id": "delivery-plan",
          "title": "Delivery Plan",
          "objective": "Break delivery into phases, milestones, and measurable wins",
          "media_kind": "timeline",
          "layout_key": "timeline-roadmap",
          "visual": "roadmap / milestones"
        },
        {
          "section_id": "decision",
          "title": "Decision and Next Steps",
          "objective": "{{closing_cta}}",
          "media_kind": "cta",
          "layout_key": "decision-cta",
          "visual": "decision / next action"
        }
