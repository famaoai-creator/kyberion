{
  "action": "pipeline",
  "name": "Agent Provider Availability Check",
  "version": "2.1.0",
  "description": "Checks availability and version of all LLM agent providers dynamically using core:foreach.",
  "context": {
    "providers": [
      {
        "name": "Gemini",
        "command": "gemini",
        "version_args": ["--version"],
        "ping_args": ["-p", "Reply with only the word PONG"],
        "capability_marker": "--acp"
      },
      {
        "name": "Claude",
        "command": "claude",
        "version_args": ["--version"],
        "ping_args": ["-p", "Reply with only the word PONG", "--output-format", "text"],
        "capability_marker": "stream-json"
      },
      {
        "name": "GitHub Copilot",
        "command": "gh",
        "version_args": ["copilot", "--", "--version"],
        "ping_args": ["copilot", "--", "-p", "Reply with only the word PONG", "--allow-all"],
        "capability_marker": "--acp",
        "capability_args": ["copilot", "--", "--help"]
      },
      {
        "name": "Codex",
        "command": "codex",
        "fallback_command": "npx",
        "fallback_args": ["codex", "--version"]
      }
    ]
  },
  "steps": [
    {
      "role": "sink",
      "op": "system:log",
      "params": {
        "message": "🔍 Checking Agent Provider Availability..."
      }
    },
    {
      "id": "provider-preflight",
      "role": "gate",
      "op": "core:include",
      "comment": "C1: full provider/codex/ACP preflight lives in the fragment; caller context `providers` supplies the loop items.",
      "params": {
        "fragment": "fragments/provider-preflight.json"
      }
    },
    {
      "role": "sink",
      "op": "system:log",
      "params": {
        "message": "\n=== Agent Manifest Definitions ==="
      }
    },
    {
      "role": "source",
      "op": "system:shell",
      "produces": {
        "channel": "manifest_count",
        "type": "ShellResult"
      },
      "params": {
        "cmd": "ls knowledge/product/agents/*.agent.md 2>/dev/null | wc -l | tr -d ' '"
      }
    },
    {
      "role": "source",
      "op": "system:shell",
      "produces": {
        "channel": "manifest_list",
        "type": "ShellResult"
      },
      "params": {
        "cmd": "ls knowledge/product/agents/*.agent.md 2>/dev/null | xargs -I{} basename {} .agent.md | tr '\\n' ', '"
      }
    },
    {
      "role": "sink",
      "op": "system:log",
      "consumes": ["manifest_count", "manifest_list"],
      "params": {
        "message": "  Manifests: {{manifest_count}} ({{manifest_list}})"
      }
    },
    {
      "role": "sink",
      "op": "system:log",
      "params": {
        "message": "\n✅ Agent Provider Check Complete."
      }
    }
  ]
}
