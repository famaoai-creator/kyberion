{
  "action": "pipeline",
  "name": "Trial Narrated Report",
  "version": "1.1.0",
  "description": "End-to-end narrated executive report: voice narration + video composition with strict ADF preflight.",
  "context": {
    "audio_path": "active/shared/tmp/narration.aiff",
    "video_output_path": "active/shared/tmp/narrated-report.mp4",
    "video_bundle_dir": "active/shared/tmp/video-composition/executive-summary",
    "mission_evidence_dir": "active/shared/tmp/video-composition",
    "video_slug": "executive-summary"
  },
  "steps": [
    {
      "id": "check_voice_actuator_build",
      "role": "source",
      "op": "system:probe",
      "produces": { "channel": "voice_build", "type": "ProbeResult" },
      "params": { "dir": "dist/libs/actuators/voice-actuator/src", "kind": "dir" }
    },
    {
      "id": "check_video_actuator_build",
      "role": "source",
      "op": "system:probe",
      "produces": { "channel": "video_build", "type": "ProbeResult" },
      "params": { "dir": "dist/libs/actuators/video-composition-actuator/src", "kind": "dir" }
    },
    {
      "id": "preflight_tools",
      "role": "gate",
      "op": "core:include",
      "comment": "C2: say/espeak/ffmpeg/ffprobe preflight plus voice-action and render-policy authoring now live in the fragment; caller templates ({{input.narration_text}}) resolve at runtime.",
      "params": {
        "fragment": "fragments/narrated-report-preflight.json"
      }
    },
    {
      "id": "generate_audio",
      "role": "source",
      "op": "voice:generate_voice",
      "produces": { "channel": "audio_gen_result", "type": "VoiceGenerationResult" },
      "params": {
        "request_id": "trial-narrated-report-audio",
        "text": "{{input.narration_text}}",
        "profile_ref": { "profile_id": "operator-ja-default" },
        "engine": { "engine_id": "local_say" },
        "rendering": {
          "language": "ja",
          "chunking": {
            "max_chunk_chars": 4000,
            "crossfade_ms": 50,
            "preserve_paralinguistic_tags": true
          }
        },
        "delivery": {
          "mode": "artifact",
          "format": "aiff",
          "artifact_path": "{{audio_path}}",
          "emit_progress_packets": true
        },
        "routing": { "personal_voice_mode": "allow_fallback" }
      }
    },
    {
      "id": "validate_audio_output",
      "role": "gate",
      "op": "core:include",
      "comment": "C2: audio presence + ffprobe stream validation now live in the fragment (typed audio validation op, no shell chain). Emits audio_check as before.",
      "params": {
        "fragment": "fragments/narrated-report-artifact-validate.json"
      }
    },
    {
      "id": "generate_video",
      "role": "source",
      "op": "video-composition:create_narrated_intro_movie",
      "produces": { "channel": "video_gen_result", "type": "VideoCompositionResult" },
      "params": {
        "narrated_video_brief": {
          "title": "Trial Narrated Report",
          "story": "{{input.narration_text}}",
          "language": "ja",
          "narration_artifact_ref": "{{audio_path}}",
          "output": {
            "format": "mp4",
            "target_path": "{{video_output_path}}",
            "bundle_dir": "{{video_bundle_dir}}",
            "await_completion": true,
            "duration_sec": 10,
            "fps": 15
          }
        }
      }
    },
    {
      "id": "validate_video_output",
      "role": "source",
      "op": "video-composition:validate_narrated_video_artifact",
      "produces": { "channel": "video_check", "type": "VideoValidationResult" },
      "params": {
        "narration_path": "{{audio_path}}",
        "video_output_path": "{{video_output_path}}",
        "video_bundle_dir": "{{video_bundle_dir}}",
        "mission_evidence_dir": "{{mission_evidence_dir}}",
        "video_slug": "{{video_slug}}"
      }
    },
    {
      "id": "final_log",
      "role": "sink",
      "op": "system:log",
      "consumes": ["audio_gen_result", "video_gen_result", "video_check"],
      "params": {
        "message": "✅ Trial Narrated Report complete. Audio: {{audio_gen_result}} Video: {{video_gen_result}}"
      }
    }
  ]
}
