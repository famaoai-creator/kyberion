{
  "action": "pipeline",
  "name": "decision-digest",
  "version": "1.0.0",
  "description": "Morning and evening operator digest: decisions waiting on the operator, veto windows about to proceed, what agents did on their own, and missions that have gone quiet. Sent through the decision_digest notification route.",
  "_refs": {
    "plan": "docs/developer/improvement-plans-2026-09/AUTONOMOUS_OPERATION_MOBILE_DECISION_PLAN_2026-09-27.ja.md",
    "cli": "node dist/scripts/approval_inbox.js digest --send"
  },
  "schedule": {
    "id": "decision-digest-twice-daily",
    "cron": "50 8,18 * * *",
    "timezone": "Asia/Tokyo",
    "enabled": true
  },
  "steps": [
    {
      "id": "digest",
      "role": "source",
      "op": "core:decision_digest",
      "params": {
        "hours": 12,
        "send": true,
        "export_as": "decision_digest"
      },
      "produces": {
        "channel": "decision_digest",
        "type": "DecisionDigest",
        "sensitive": true
      }
    }
  ]
}
