{
  "action": "pipeline",
  "name": "accountability-report-daily",
  "version": "1.0.0",
  "description": "Daily accountability report for every accountability charter in force: what ran inside it, what was held for a decision, budget use, standing tripwires and charters near expiry. Does nothing while no charter is in force.",
  "_refs": {
    "plan": "docs/developer/improvement-plans-2026-09/ACCOUNTABILITY_CHARTER_PLAN_2026-09-30.ja.md",
    "cli": "node dist/scripts/approval_inbox.js charter --send"
  },
  "schedule": {
    "id": "accountability-report-daily",
    "cron": "0 8 * * *",
    "timezone": "Asia/Tokyo",
    "enabled": true
  },
  "steps": [
    {
      "id": "report",
      "role": "source",
      "op": "core:accountability_report",
      "params": {
        "hours": 24,
        "send": true,
        "export_as": "accountability_report"
      },
      "produces": {
        "channel": "accountability_report",
        "type": "AccountabilityReport",
        "sensitive": true
      }
    }
  ]
}
