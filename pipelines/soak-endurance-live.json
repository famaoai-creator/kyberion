{
  "action": "pipeline",
  "name": "soak-endurance-live",
  "version": "1.0.0",
  "description": "Daily live soak evidence pulse for OP-04. Persists cumulative runtime-health evidence under active/shared/runtime/health/soak and fails closed on regressions.",
  "_refs": {
    "plan": "docs/developer/improvement-plans-2026-07/OP-04_HEALTH_DEGRADATION_MONITORING.ja.md",
    "implementation": "scripts/soak_endurance.ts"
  },
  "schedule": {
    "id": "soak-endurance-live-daily",
    "cron": "30 5 * * *",
    "timezone": "Asia/Tokyo",
    "enabled": false
  },
  "steps": [
    {
      "id": "run_live_soak_pulse",
      "role": "source",
      "op": "core:run_soak_endurance",
      "produces": {
        "channel": "soak_endurance_live_result",
        "type": "Json"
      },
      "params": { "cycles": 1, "mode": "live" }
    }
  ]
}
