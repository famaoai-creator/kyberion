{
  "pipeline_id": "monitor-service-health",
  "version": "3.1.0",
  "description": "Dynamically verify the response health of all active ecosystem services.",
  "action": "pipeline",
  "steps": [
    {
      "id": "get-surfaces",
      "role": "source",
      "op": "process:list-surfaces",
      "produces": {
        "channel": "ecosystem_surfaces",
        "type": "SurfaceList"
      },
      "params": {}
    },
    {
      "id": "log-summary",
      "role": "sink",
      "op": "system:log",
      "consumes": "ecosystem_surfaces",
      "params": {
        "message": "📡 [MONITOR] Auditing {{ecosystem_surfaces.length}} registered surfaces..."
      }
    },
    {
      "id": "partition-health",
      "role": "transform",
      "op": "system:partition_surface_health",
      "consumes": "ecosystem_surfaces",
      "produces": {
        "channel": "surface_health",
        "type": "SurfaceHealthPartition"
      },
      "params": {
        "surfaces": "{{ecosystem_surfaces}}"
      }
    },
    {
      "id": "log-health",
      "role": "sink",
      "op": "system:log",
      "consumes": "surface_health",
      "params": {
        "message": "Surface health: {{surface_health}}"
      }
    },
    {
      "id": "check-recent-errors",
      "role": "source",
      "op": "system:collect_surface_errors",
      "comment": "Declarative log harvesting (replaces `grep -r ERROR ... | tail`). ERROR classification moved into the reasoning instruction below; an empty collection means no artifacts matched, not success.",
      "produces": {
        "channel": "recent_service_errors",
        "type": "LogText"
      },
      "params": {}
    },
    {
      "id": "analyze-reliability",
      "role": "transform",
      "op": "reasoning:analyze",
      "consumes": ["ecosystem_surfaces", "recent_service_errors"],
      "produces": {
        "channel": "reliability_report",
        "type": "ReliabilityReport"
      },
      "params": {
        "instruction": "Evaluate ecosystem reliability using surface statuses and the last 15 ERROR lines from surface logs. Identify enabled-but-stopped zombie services and frequent errors. Propose recovery actions.",
        "context": ["{{ecosystem_surfaces}}", "{{recent_service_errors}}"]
      }
    },
    {
      "id": "log-reliability-report",
      "role": "sink",
      "op": "system:log",
      "consumes": "reliability_report",
      "params": {
        "message": "📊 [RELIABILITY_REPORT]\n{{reliability_report}}"
      }
    }
  ]
}
