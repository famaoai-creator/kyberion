{
  "action": "pipeline",
  "name": "Full System Health and Report",
  "version": "2.0.0",
  "description": "Comprehensive health check and report generation.",
  "_migration_note": "v2: Typed Flow format (role/produces/consumes). v1 used export_as without roles.",
  "steps": [
    {
      "role": "sink",
      "op": "system:log",
      "params": { "message": "🏥 Starting Full System Health Audit..." }
    },
    {
      "role": "source",
      "op": "core:run_pipeline",
      "produces": { "channel": "vital_results", "type": "PipelineResult" },
      "params": { "input": "pipelines/vital-check.json" }
    },
    {
      "role": "source",
      "op": "core:run_pipeline",
      "produces": { "channel": "diag_results", "type": "PipelineResult" },
      "params": { "input": "pipelines/system-diagnostics.json" }
    },
    {
      "role": "source",
      "op": "core:run_pipeline",
      "produces": { "channel": "prod_results", "type": "PipelineResult" },
      "params": { "input": "knowledge/product/pipeline-templates/dev-productivity-audit.json" }
    },
    {
      "role": "sink",
      "op": "system:write_file",
      "consumes": ["vital_results", "diag_results", "prod_results"],
      "params": {
        "path": "active/shared/tmp/HEALTH_REPORT.md",
        "content": "# Kyberion System Health Report\n\nGenerated on: {{run_utc_now}}\n\n## Vital Check\n```json\n{{vital_results}}\n```\n\n## Diagnostics\n```json\n{{diag_results}}\n```\n\n## Productivity Audit\n```json\n{{prod_results}}\n```\n"
      }
    },
    {
      "role": "sink",
      "op": "system:log",
      "params": { "message": "✅ Full health report generated: active/shared/tmp/HEALTH_REPORT.md" }
    }
  ]
}
