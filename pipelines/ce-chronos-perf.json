{
  "pipeline_id": "ce-chronos-perf",
  "name": "CE Chronos performance baseline",
  "version": "1.0.0",
  "action": "pipeline",
  "description": "Weekly browser-dependent CE-08 FPS and JS heap evidence for Chronos.",
  "schedule": {
    "id": "ce-chronos-perf",
    "cron": "30 3 * * 1",
    "timezone": "Asia/Tokyo",
    "enabled": true
  },
  "context": { "mission_id": "MSN-CE-ADOPTION-20260802" },
  "steps": [
    {
      "id": "measure",
      "role": "source",
      "op": "system:shell",
      "produces": { "channel": "performance_report", "type": "ShellResult" },
      "params": { "cmd": "pnpm kyberion check chronos-perf" }
    },
    {
      "id": "report",
      "role": "sink",
      "op": "system:log",
      "consumes": "performance_report",
      "params": { "message": "CE-08 Chronos performance baseline recorded." }
    }
  ]
}
