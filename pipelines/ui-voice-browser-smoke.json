{
  "action": "pipeline",
  "name": "UI Voice Browser Smoke",
  "version": "1.0.0",
  "description": "End-to-end smoke test: launches presence-studio, runs voice-hello pipeline, verifies browser session, and checks meeting consent gate.",
  "steps": [
    {
      "role": "sink",
      "op": "system:log",
      "params": { "message": "🔬 UI Voice Browser Smoke — starting..." }
    },
    {
      "id": "start_presence_studio",
      "role": "source",
      "op": "process:spawn",
      "produces": { "channel": "studio_pid", "type": "ManagedProcessResult" },
      "params": {
        "resourceId": "surface:presence-studio",
        "command": "node",
        "args": ["presence/displays/presence-studio/server.ts"],
        "kind": "service",
        "ownerId": "ui-voice-browser-smoke",
        "ownerType": "pipeline",
        "shutdownPolicy": "process"
      }
    },
    {
      "id": "run_voice_hello",
      "role": "source",
      "op": "core:include",
      "produces": { "channel": "voice_result", "type": "PipelineResult" },
      "params": { "fragment": "pipelines/voice-hello.json", "export_as": "voice_result" }
    },
    {
      "id": "verify_session",
      "role": "source",
      "op": "core:include",
      "produces": { "channel": "session_result", "type": "PipelineResult" },
      "params": { "fragment": "pipelines/verify-session.json", "export_as": "session_result" }
    },
    {
      "id": "check_meeting_consent",
      "role": "source",
      "op": "meeting:check_consent",
      "produces": { "channel": "consent_result", "type": "VoiceConsentCheckResult" },
      "params": {}
    },
    {
      "id": "final_log",
      "role": "sink",
      "op": "system:log",
      "consumes": ["voice_result", "session_result", "consent_result"],
      "params": {
        "message": "✅ Smoke complete. Voice={{voice_result.status}} Session={{session_result.status}} Consent={{consent_result.status}}"
      }
    }
  ]
}
