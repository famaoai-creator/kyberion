{
  "action": "pipeline",
  "name": "emergency-rollback-fragment",
  "version": "2.0.0",
  "description": "Rolls back the current workspace to the last committed state and cleans up temporary files.",
  "_migration_note": "v2: Typed Flow format (role/produces/consumes). v1 used type without roles.",
  "steps": [
    {
      "id": "git_reset",
      "role": "sink",
      "op": "system:shell",
      "params": {
        "cmd": "git restore --source=HEAD --worktree --staged -- :/"
      }
    },
    {
      "id": "git_clean",
      "role": "sink",
      "op": "system:shell",
      "params": {
        "cmd": "find active/shared/tmp -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +"
      }
    },
    {
      "id": "cleanup_tmp",
      "role": "sink",
      "op": "system:shell",
      "params": {
        "cmd": "rm -rf active/shared/tmp/*"
      }
    },
    {
      "id": "log_rollback",
      "role": "sink",
      "op": "system:log",
      "params": {
        "message": "Emergency Rollback executed successfully. Workspace restored to HEAD."
      }
    }
  ]
}
