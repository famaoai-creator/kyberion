{
  "action": "pipeline",
  "name": "mission-bootstrap-fragment",
  "version": "2.0.0",
  "description": "Standardizes the creation of a new Kyberion mission, initializing the evidence directory and Git repository.",
  "_migration_note": "v2: Typed Flow format (role/produces/consumes). v1 used type + export_as.",
  "context": {
    "tier": "confidential",
    "tenant_id": "default",
    "mission_type": "development",
    "vision_ref": "vision_001",
    "persona": "ecosystem_architect"
  },
  "steps": [
    {
      "id": "create_mission",
      "role": "source",
      "op": "core:run_mission_create",
      "produces": { "channel": "bootstrap_result", "type": "Json" },
      "params": {
        "tier": "{{tier}}",
        "tenant_id": "{{tenant_id}}",
        "mission_type": "{{mission_type}}",
        "vision_ref": "{{vision_ref}}",
        "persona": "{{persona}}"
      }
    },
    {
      "id": "log_mission_id",
      "role": "sink",
      "op": "system:log",
      "consumes": "bootstrap_result",
      "params": { "message": "Mission bootstrapped successfully: {{bootstrap_result}}" }
    }
  ]
}
