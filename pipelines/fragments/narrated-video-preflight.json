{
  "action": "pipeline",
  "name": "narrated-video-preflight-fragment",
  "version": "1.0.0",
  "description": "Reusable fragment: verify the governed voice runtime and video-composition catalog before starting a narrated video production pipeline.",
  "steps": [
    {
      "id": "voice_preflight",
      "role": "source",
      "op": "voice:health",
      "produces": { "channel": "preflight_result", "type": "VoiceHealthResult" },
      "params": {}
    },
    {
      "id": "video_preflight",
      "role": "source",
      "op": "video-composition:list_video_composition_templates",
      "produces": {
        "channel": "video_preflight_result",
        "type": "VideoCompositionTemplatesResult"
      },
      "params": {}
    }
  ]
}
