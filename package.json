{
  "name": "kyberion",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "bin": {
    "kyberion": "dist/scripts/kyberion.js"
  },
  "type": "module",
  "imports": {
    "#ajv-build-free": "./libs/core/foundation/ajv-build-free.mjs",
    "#capability-discovery-contract": "./scripts/capability-discovery-contract.mjs",
    "#capability-discovery-manifest-scan": "./scripts/capability-discovery-manifest-scan.mjs",
    "#binary-availability": "./libs/core/binary-availability.mjs",
    "#repository-path-boundary": "./libs/core/repository-path-boundary.mjs"
  },
  "description": "Monorepo for Kyberion Ecosystem",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "libs/core",
    "libs/shared-*",
    "libs/actuators/*",
    "satellites/*",
    "presence/displays/*",
    "presence/bridge/*"
  ],
  "scripts": {
    "agent-runtime:supervisor": "node scripts/run_built.mjs dist/scripts/run_agent_runtime_supervisor.js",
    "agents:generate": "node --import ./scripts/ts-loader.mjs scripts/generate_subagent_definitions.ts",
    "agy:sdk-setup": "node --import ./scripts/ts-loader.mjs scripts/agy_sdk_setup.ts",
    "ai-test": "node scripts/run_built.mjs dist/scripts/run_ai_audit.js",
    "audit:verify": "node --import ./scripts/ts-loader.mjs scripts/audit_verify.ts",
    "automation:blueprint": "node --import ./scripts/ts-loader.mjs scripts/automation_blueprint.ts",
    "background-review": "node --import ./scripts/ts-loader.mjs scripts/background_review.ts",
    "backup": "node --import ./scripts/ts-loader.mjs scripts/backup.ts",
    "bindings": "node --import ./scripts/ts-loader.mjs scripts/bindings.ts",
    "build": "node --import ./scripts/ts-loader.mjs scripts/clean_entrypoint.ts && pnpm run build:packages && pnpm run build:repo && node dist/scripts/generate_knowledge_index.js --manifest-only --quiet && pnpm run build:ui && node dist/scripts/check_source_shadows.js",
    "build:actuators": "pnpm run build:repo",
    "build:bundle": "node scripts/bundle_entrypoints.mjs",
    "build:packages": "tsc -b tsconfig.packages.json && node scripts/write_core_dist_scope.mjs --run",
    "build:repo": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc -b tsconfig.json && node scripts/write_core_dist_scope.mjs --run && pnpm run build:bundle",
    "build:ui": "pnpm --dir presence/displays/chronos-mirror-v2 build && pnpm --dir presence/displays/concierge build",
    "capabilities": "node scripts/capability_discovery_entry.mjs",
    "channels:list": "node scripts/run_built.mjs dist/scripts/channel_directory.js",
    "check": "node --import ./scripts/ts-loader.mjs scripts/run_checks.ts",
    "check:apple-fm": "node --import ./scripts/ts-loader.mjs scripts/check_apple_fm.ts",
    "check:commit-subject": "node --import ./scripts/ts-loader.mjs scripts/check_commit_subject.ts",
    "check:contract-semver": "node scripts/run_built.mjs dist/scripts/check_contract_semver.js",
    "check:dep-cycles": "node --import ./scripts/ts-loader.mjs scripts/check_dependency_cycles.ts",
    "check:pr-title": "node --import ./scripts/ts-loader.mjs scripts/check_pr_title.ts",
    "chronos:dev": "pnpm --filter @presence/chronos-mirror-v2 dev",
    "ci": "pnpm run validate && pnpm exec vitest run",
    "config-mission": "node --import ./scripts/ts-loader.mjs scripts/run_with_env.ts KYBERION_PERSONA=worker SYSTEM_ROLE=system_configurator node scripts/run_built.mjs dist/scripts/config_mission.js",
    "config:report": "node --import ./scripts/ts-loader.mjs scripts/env_config_report.ts",
    "control": "node scripts/run_built.mjs dist/scripts/control_plane_cli.js",
    "cost:report": "node --import ./scripts/ts-loader.mjs scripts/cost_report.ts",
    "daemon:watchdog": "node --import ./scripts/ts-loader.mjs scripts/daemon_watchdog.ts",
    "dashboard": "node scripts/run_built.mjs dist/scripts/sovereign_dashboard.js",
    "deps:check": "node scripts/run_built.mjs dist/scripts/dependency_resolver.js",
    "doctor": "node scripts/run_built.mjs dist/scripts/run_doctor.js",
    "egress:report": "node --import ./scripts/ts-loader.mjs scripts/egress_warn_report.ts",
    "email:workflow": "node --import ./scripts/ts-loader.mjs scripts/email-workflow.ts",
    "env:bootstrap": "node scripts/run_built.mjs dist/scripts/bootstrap_environment.js",
    "examples": "node scripts/run_built.mjs dist/scripts/example_discovery.js",
    "format": "prettier --write .",
    "generate:cli-reference": "node --import ./scripts/ts-loader.mjs scripts/generate_cli_reference.ts",
    "generate:env-registry": "node --import ./scripts/ts-loader.mjs scripts/generate_env_registry.ts",
    "generate:knowledge-index": "node --import ./scripts/ts-loader.mjs scripts/generate_knowledge_index.ts",
    "generate:op-registry": "node --import ./scripts/ts-loader.mjs scripts/generate_op_registry.ts",
    "generate:pii-rules": "node --import ./scripts/ts-loader.mjs scripts/generate_pii_rules.ts",
    "generate:pseudo-locale": "node --import ./scripts/ts-loader.mjs scripts/generate_pseudo_locale.ts",
    "generate:types": "node scripts/run_built.mjs dist/scripts/generate_types.js",
    "generate:vocabulary-types": "node --import ./scripts/ts-loader.mjs scripts/generate_vocabulary_types.ts",
    "generation:schedule": "node scripts/run_built.mjs dist/scripts/run_generation_schedule.js",
    "history:search": "node --import ./scripts/ts-loader.mjs scripts/history_search.ts",
    "i18n:report": "node --import ./scripts/ts-loader.mjs scripts/report_i18n_translation_coverage.ts",
    "intent:run": "node scripts/run_built.mjs dist/scripts/run_intent.js",
    "intent:trace": "node --import ./scripts/ts-loader.mjs scripts/intent.ts",
    "knowledge": "node --import ./scripts/ts-loader.mjs scripts/knowledge.ts",
    "knowledge:cowork-sync": "node scripts/run_built.mjs dist/scripts/cowork_knowledge_bridge.js",
    "knowledge:feedback": "node --import ./scripts/ts-loader.mjs scripts/knowledge_feedback.ts",
    "knowledge:ingest": "node scripts/run_built.mjs dist/scripts/ingest.js",
    "knowledge:scope-reconcile": "node --import ./scripts/ts-loader.mjs scripts/reconcile_knowledge_scopes.ts",
    "knowledge:sync": "node scripts/run_built.mjs dist/scripts/run_pipeline.js --input pipelines/knowledge-sync.json",
    "kyberion": "node scripts/kyberion_cli_entry.mjs",
    "license:audit": "node scripts/run_built.mjs dist/scripts/license_audit.js",
    "lint": "eslint . --max-warnings 0",
    "manifests:sign": "node --import ./scripts/ts-loader.mjs scripts/sign_environment_manifests.ts",
    "mcp:server": "node scripts/run_built.mjs dist/scripts/mcp_server.js",
    "meeting:consent": "node scripts/run_built.mjs dist/scripts/voice_consent.js",
    "meeting:participate": "node scripts/run_built.mjs dist/scripts/meeting_participate.js",
    "meeting:preflight": "node --import ./scripts/ts-loader.mjs scripts/meeting_preflight.ts",
    "meeting:run": "node scripts/run_built.mjs dist/scripts/meeting_orchestrator.js",
    "mesh-hub:inspect": "node --import ./scripts/ts-loader.mjs scripts/mesh_hub_inspect.ts",
    "migration": "node --import ./scripts/ts-loader.mjs scripts/run_migrations.ts",
    "minutes:record": "node --import ./scripts/ts-loader.mjs scripts/minutes_record.ts",
    "mission": "node scripts/run_built.mjs dist/scripts/mission_controller.bundle.js",
    "mission:orchestrator": "node scripts/run_built.mjs dist/scripts/run_mission_orchestration_event_worker.js",
    "namespace:migrate-physical": "node --import ./scripts/ts-loader.mjs scripts/migrate_physical_namespaces.ts",
    "nhi": "node --import ./scripts/ts-loader.mjs scripts/nhi.ts",
    "office": "node --import ./scripts/ts-loader.mjs scripts/virtual_office.ts",
    "onboarding": "node --import ./scripts/ts-loader.mjs scripts/onboarding.ts",
    "onboarding:context": "node --import ./scripts/ts-loader.mjs scripts/onboarding_context.ts",
    "ops:alerts": "node --import ./scripts/ts-loader.mjs scripts/ops_alerts.ts",
    "organization": "node --import ./scripts/ts-loader.mjs scripts/organization.ts",
    "pads": "node --import ./scripts/ts-loader.mjs scripts/personal-pads/server.ts",
    "peer:conversation": "node --import ./scripts/ts-loader.mjs scripts/peer_conversation.ts",
    "peer:conversation-server": "node --import ./scripts/ts-loader.mjs scripts/peer_conversation_server.ts",
    "peer:migrate-tenant-runtime": "node --import ./scripts/ts-loader.mjs scripts/migrate_peer_tenant_runtime.ts",
    "peer:register": "node --import ./scripts/ts-loader.mjs scripts/peer_network_register.ts",
    "peer:runtime-recovery": "node --import ./scripts/ts-loader.mjs scripts/peer_runtime_recovery.ts",
    "pipeline": "node scripts/run_built.mjs dist/scripts/run_pipeline.bundle.js",
    "pipeline:promote": "node --import ./scripts/ts-loader.mjs scripts/pipeline_promote.ts",
    "playground": "pnpm exec tsx scripts/actuator_playground.ts",
    "plugin:install": "node --import ./scripts/ts-loader.mjs scripts/plugin_install.ts",
    "prepare": "husky",
    "project": "node scripts/run_built.mjs dist/scripts/project_controller.js",
    "project-os:init": "node scripts/run_built.mjs dist/scripts/generate_project_os.js",
    "provider-capabilities:scan": "node scripts/run_built.mjs dist/scripts/scan_provider_cli_capabilities.js",
    "provider-cli:setup": "node --import ./scripts/ts-loader.mjs scripts/managed_env_setup.ts",
    "reasoning:config": "node scripts/run_built.mjs dist/scripts/reasoning_config.js",
    "reasoning:setup": "node scripts/run_built.mjs dist/scripts/reasoning_setup.js",
    "release:notes": "node scripts/run_built.mjs dist/scripts/extract_changelog_section.js",
    "release:source-archive": "node --import ./scripts/ts-loader.mjs scripts/source_archive.ts",
    "scenario": "node --import ./scripts/ts-loader.mjs scripts/scenario_runner.ts",
    "scheduler": "node scripts/run_built.mjs dist/scripts/chronos_daemon.bundle.js",
    "scope": "node --import ./scripts/ts-loader.mjs scripts/scope.ts",
    "secrets:encrypt": "node --import ./scripts/ts-loader.mjs scripts/encrypt_connection_documents.ts",
    "security:ledger": "node scripts/run_built.mjs dist/scripts/security-ledger.js",
    "service:preflight": "node scripts/run_built.mjs dist/scripts/service_preflight.js",
    "service:setup": "node scripts/run_built.mjs dist/scripts/services_setup.js",
    "stance:create": "node --import ./scripts/ts-loader.mjs scripts/customer_create.ts",
    "stance:list": "node --import ./scripts/ts-loader.mjs scripts/customer_list.ts",
    "stance:migrate-from-personal": "node --import ./scripts/ts-loader.mjs scripts/customer_migrate_from_personal.ts",
    "stance:switch": "node --import ./scripts/ts-loader.mjs scripts/customer_switch.ts",
    "surfaces": "node --import ./scripts/ts-loader.mjs scripts/run_with_env.ts KYBERION_PERSONA=worker SYSTEM_ROLE=surface_runtime node scripts/run_built.mjs dist/scripts/surface_runtime.bundle.js",
    "system:upgrade": "node --import ./scripts/ts-loader.mjs scripts/system_upgrade.ts",
    "task:init": "node --import ./scripts/ts-loader.mjs scripts/task_init.ts",
    "task:list": "node --import ./scripts/ts-loader.mjs scripts/task_list.ts",
    "task:run": "node --import ./scripts/ts-loader.mjs scripts/task_run.ts",
    "telegram:bridge": "node scripts/run_built.mjs dist/satellites/telegram-bridge/src/index.js",
    "tenant": "node --import ./scripts/ts-loader.mjs scripts/tenant.ts",
    "tenant:activation": "node --import ./scripts/ts-loader.mjs scripts/tenant_activation.ts",
    "tenant:watch-drift": "node scripts/run_built.mjs dist/scripts/watch_tenant_drift.js",
    "test": "node --import ./scripts/ts-loader.mjs scripts/test_suite.ts",
    "test:unit": "node --import ./scripts/ts-loader.mjs scripts/test_suite.ts --suite unit",
    "test:watch": "pnpm vitest watch libs/core/",
    "tool:setup": "node --import ./scripts/ts-loader.mjs scripts/tool_runtime_setup.ts",
    "tui": "node --import ./scripts/ts-loader.mjs scripts/tui.ts",
    "typecheck": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc --noEmit --incremental false",
    "validate": "pnpm run build && pnpm run typecheck && pnpm run check -- --scope full",
    "validation-bundle:export": "node scripts/run_built.mjs dist/scripts/export_validation_bundle.js",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:unit",
    "voice:conversation-config": "node scripts/run_built.mjs dist/scripts/realtime_voice_config.js",
    "voice:route": "node scripts/run_built.mjs dist/scripts/voice_route_cli.js",
    "voice:upgrade": "node scripts/run_built.mjs dist/scripts/voice_upgrade.js",
    "work": "node --import ./scripts/ts-loader.mjs scripts/work_coordination.ts",
    "work:inventory": "node --import ./scripts/ts-loader.mjs scripts/work_inventory.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "knowledge/**/*.{md,json}": [
      "pnpm exec tsx scripts/generate_knowledge_index.ts",
      "git add knowledge/_index.md"
    ]
  },
  "dependencies": {
    "@actuator/meeting-browser-driver": "workspace:*",
    "@actuator/service": "workspace:*",
    "@actuator/system": "workspace:*",
    "@agent/core": "workspace:*",
    "@agent/shared-media": "workspace:*",
    "@agent/shared-nerve": "workspace:*",
    "@agent/shared-network": "workspace:*",
    "@agent/shared-vision": "workspace:*",
    "@agentclientprotocol/sdk": "^1.6.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@anthropic-ai/claude-code": "^2.1.286",
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openai/codex": "^0.153.4",
    "@presence/terminal-hud": "workspace:*",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.2.0",
    "@types/express": "^5.0.6",
    "@types/html-to-docx": "^1.8.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.2",
    "@xmldom/xmldom": "0.9.12",
    "adm-zip": "^0.6.1",
    "ajv": "8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.20.0",
    "chalk": "^6.0.1",
    "chokidar": "^5.0.0",
    "claude-code": "^1.0.0",
    "discord.js": "^14.27.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "gif-encoder-2": "^1.0.5",
    "googleapis": "^182.0.0",
    "html-to-docx": "^1.8.0",
    "jimp": "^1.6.1",
    "js-yaml": "^5.4.2",
    "jszip": "^3.10.2",
    "marked": "^18.0.14",
    "node-pty": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^25.12.0",
    "tesseract.js": "^7.0.0",
    "web-push": "3.6.7",
    "ws": "^8.22.0",
    "yargs": "^18.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^5.0.3",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "hyperframes": "^0.8.147",
    "json-schema-to-typescript": "^16.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
