{
  "name": "kyberion",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "bin": {
    "kyberion": "dist/scripts/kyberion.js"
  },
  "type": "module",
  "description": "Monorepo for Kyberion Ecosystem",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "libs/core",
    "libs/shared-*",
    "libs/actuators/*",
    "satellites/*",
    "presence/displays/*",
    "presence/bridge/*"
  ],
  "scripts": {
    "test": "node --import ./scripts/ts-loader.mjs scripts/test_suite.ts",
    "test:unit": "node --import ./scripts/ts-loader.mjs scripts/test_suite.ts --suite unit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "build": "node --import ./scripts/ts-loader.mjs scripts/clean_entrypoint.ts && pnpm run build:packages && pnpm run build:actuators && pnpm --filter @presence/terminal-hud run build && pnpm run build:repo && pnpm run build:ui",
    "build:packages": "pnpm --filter @agent/core run build && pnpm --filter @agent/shared-media run build && pnpm --filter @agent/shared-nerve run build && pnpm --filter @agent/shared-network run build && pnpm --filter @agent/shared-vision run build",
    "build:actuators": "tsc -p tsconfig.actuators.json",
    "build:repo": "tsc",
    "build:ui": "pnpm --dir presence/displays/chronos-mirror-v2 build && pnpm --dir presence/displays/concierge build",
    "generate:op-registry": "node --import ./scripts/ts-loader.mjs scripts/generate_op_registry.ts",
    "generate:vocabulary-types": "node --import ./scripts/ts-loader.mjs scripts/generate_vocabulary_types.ts",
    "generate:pseudo-locale": "node --import ./scripts/ts-loader.mjs scripts/generate_pseudo_locale.ts",
    "generate:env-registry": "node --import ./scripts/ts-loader.mjs scripts/generate_env_registry.ts",
    "config:report": "node --import ./scripts/ts-loader.mjs scripts/env_config_report.ts",
    "agents:generate": "node --import ./scripts/ts-loader.mjs scripts/generate_subagent_definitions.ts",
    "check:apple-fm": "node --import ./scripts/ts-loader.mjs scripts/check_apple_fm.ts",
    "report:i18n-coverage": "node --import ./scripts/ts-loader.mjs scripts/report_i18n_translation_coverage.ts",
    "tenant": "node --import ./scripts/ts-loader.mjs scripts/tenant.ts",
    "tenant:activation": "node --import ./scripts/ts-loader.mjs scripts/tenant_activation.ts",
    "migrate:physical-namespaces": "node --import ./scripts/ts-loader.mjs scripts/migrate_physical_namespaces.ts",
    "migrate:peer-tenant-runtime": "node --import ./scripts/ts-loader.mjs scripts/migrate_peer_tenant_runtime.ts",
    "peer:runtime-recovery": "node --import ./scripts/ts-loader.mjs scripts/peer_runtime_recovery.ts",
    "organization": "node --import ./scripts/ts-loader.mjs scripts/organization.ts",
    "knowledge": "node --import ./scripts/ts-loader.mjs scripts/knowledge.ts",
    "knowledge-feedback": "node --import ./scripts/ts-loader.mjs scripts/knowledge_feedback.ts",
    "knowledge:scope-reconcile": "node --import ./scripts/ts-loader.mjs scripts/reconcile_knowledge_scopes.ts",
    "scope": "node --import ./scripts/ts-loader.mjs scripts/scope.ts",
    "bindings": "node --import ./scripts/ts-loader.mjs scripts/bindings.ts",
    "check": "node --import ./scripts/ts-loader.mjs scripts/run_checks.ts",
    "knowledge:sync": "node dist/scripts/run_pipeline.js --input pipelines/knowledge-sync.json",
    "check:contract-semver": "node dist/scripts/check_contract_semver.js",
    "check:pr-title": "node --import ./scripts/ts-loader.mjs scripts/check_pr_title.ts",
    "check:commit-subject": "node --import ./scripts/ts-loader.mjs scripts/check_commit_subject.ts",
    "task:list": "node --import ./scripts/ts-loader.mjs scripts/task_list.ts",
    "task:init": "node --import ./scripts/ts-loader.mjs scripts/task_init.ts",
    "task:run": "node --import ./scripts/ts-loader.mjs scripts/task_run.ts",
    "intent": "node --import ./scripts/ts-loader.mjs scripts/intent.ts",
    "onboard": "node --import ./scripts/ts-loader.mjs scripts/onboarding.ts",
    "onboarding:context": "node --import ./scripts/ts-loader.mjs scripts/onboarding_context.ts",
    "minutes:record": "node --import ./scripts/ts-loader.mjs scripts/minutes_record.ts",
    "license:audit": "node dist/scripts/license_audit.js",
    "voice:upgrade": "node dist/scripts/voice_upgrade.js",
    "generate:pii-rules": "node --import ./scripts/ts-loader.mjs scripts/generate_pii_rules.ts",
    "meeting:preflight": "node --import ./scripts/ts-loader.mjs scripts/meeting_preflight.ts",
    "dev:watch": "pnpm vitest watch libs/core/",
    "watch:tenant-drift": "node dist/scripts/watch_tenant_drift.js",
    "pipeline:promote": "node --import ./scripts/ts-loader.mjs scripts/pipeline_promote.ts",
    "manifests:sign": "node --import ./scripts/ts-loader.mjs scripts/sign_environment_manifests.ts",
    "secrets:encrypt": "node --import ./scripts/ts-loader.mjs scripts/encrypt_connection_documents.ts",
    "cost:report": "node --import ./scripts/ts-loader.mjs scripts/cost_report.ts",
    "egress:report": "node --import ./scripts/ts-loader.mjs scripts/egress_warn_report.ts",
    "daemon:watchdog": "node --import ./scripts/ts-loader.mjs scripts/daemon_watchdog.ts",
    "audit:verify": "node --import ./scripts/ts-loader.mjs scripts/audit_verify.ts",
    "ai-test": "node dist/scripts/run_ai_audit.js",
    "generate:knowledge-index": "node --import ./scripts/ts-loader.mjs scripts/generate_knowledge_index.ts",
    "history:search": "node --import ./scripts/ts-loader.mjs scripts/history_search.ts",
    "plugin:install": "node --import ./scripts/ts-loader.mjs scripts/plugin_install.ts",
    "background-review": "node --import ./scripts/ts-loader.mjs scripts/background_review.ts",
    "automation:blueprint": "node --import ./scripts/ts-loader.mjs scripts/automation_blueprint.ts",
    "mesh-hub:inspect": "node --import ./scripts/ts-loader.mjs scripts/mesh_hub_inspect.ts",
    "export:validation-bundle": "node dist/scripts/export_validation_bundle.js",
    "meeting:run": "node dist/scripts/meeting_orchestrator.js",
    "meeting:participate": "node dist/scripts/meeting_participate.js",
    "env:bootstrap": "node dist/scripts/bootstrap_environment.js",
    "meeting:consent": "node dist/scripts/voice_consent.js",
    "voice:route": "node dist/scripts/voice_route_cli.js",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run build && pnpm run typecheck && pnpm run check -- --scope full",
    "doctor": "node dist/scripts/run_doctor.js",
    "kyberion:doctor": "node --import ./scripts/ts-loader.mjs scripts/run_doctor.ts",
    "office": "node --import ./scripts/ts-loader.mjs scripts/virtual_office.ts",
    "tui": "node --import ./scripts/ts-loader.mjs scripts/tui.ts",
    "deps:check": "node dist/scripts/dependency_resolver.js",
    "service:preflight": "node dist/scripts/service_preflight.js",
    "kyberion": "node scripts/kyberion_cli_entry.mjs",
    "email:workflow": "node --import ./scripts/ts-loader.mjs scripts/email-workflow.ts",
    "mission": "node dist/scripts/mission_controller.js",
    "project": "node dist/scripts/project_controller.js",
    "agent-runtime:supervisor": "node dist/scripts/run_agent_runtime_supervisor.js",
    "peer:conversation-server": "node --import ./scripts/ts-loader.mjs scripts/peer_conversation_server.ts",
    "peer:register": "node --import ./scripts/ts-loader.mjs scripts/peer_network_register.ts",
    "peer:conversation": "node --import ./scripts/ts-loader.mjs scripts/peer_conversation.ts",
    "work": "node --import ./scripts/ts-loader.mjs scripts/work_coordination.ts",
    "mission:orchestrator": "node dist/scripts/run_mission_orchestration_event_worker.js",
    "ingest": "node dist/scripts/ingest.js",
    "dashboard": "node dist/scripts/sovereign_dashboard.js",
    "control": "node dist/scripts/control_plane_cli.js",
    "surfaces": "node --import ./scripts/ts-loader.mjs scripts/run_with_env.ts KYBERION_PERSONA=worker SYSTEM_ROLE=surface_runtime node dist/scripts/surface_runtime.js",
    "config-mission": "node --import ./scripts/ts-loader.mjs scripts/run_with_env.ts KYBERION_PERSONA=worker SYSTEM_ROLE=system_configurator node dist/scripts/config_mission.js",
    "services:setup": "node dist/scripts/services_setup.js",
    "channels:list": "node dist/scripts/channel_directory.js",
    "generation:schedule": "node dist/scripts/run_generation_schedule.js",
    "chronos": "node dist/scripts/chronos_daemon.js",
    "ops:alerts": "node --import ./scripts/ts-loader.mjs scripts/ops_alerts.ts",
    "agy:sdk:setup": "node --import ./scripts/ts-loader.mjs scripts/agy_sdk_setup.ts",
    "reasoning:setup": "node dist/scripts/reasoning_setup.js",
    "reasoning:config": "node dist/scripts/reasoning_config.js",
    "customer:create": "node --import ./scripts/ts-loader.mjs scripts/customer_create.ts",
    "customer:list": "node --import ./scripts/ts-loader.mjs scripts/customer_list.ts",
    "customer:migrate-from-personal": "node --import ./scripts/ts-loader.mjs scripts/customer_migrate_from_personal.ts",
    "customer:switch": "node --import ./scripts/ts-loader.mjs scripts/customer_switch.ts",
    "backup": "node --import ./scripts/ts-loader.mjs scripts/backup.ts",
    "telegram:bridge": "node dist/satellites/telegram-bridge/src/index.js",
    "chronos:dev": "pnpm --filter @presence/chronos-mirror-v2 dev",
    "capabilities": "node scripts/capability_discovery_entry.mjs",
    "kyberion:list": "node scripts/capability_discovery_entry.mjs",
    "provider-capabilities:scan": "node dist/scripts/scan_provider_cli_capabilities.js",
    "examples": "node dist/scripts/example_discovery.js",
    "system:upgrade": "node --import ./scripts/ts-loader.mjs scripts/system_upgrade.ts",
    "pipeline": "node dist/scripts/run_pipeline.js",
    "intent:run": "node dist/scripts/run_intent.js",
    "release:notes": "node dist/scripts/extract_changelog_section.js",
    "release:source-archive": "node --import ./scripts/ts-loader.mjs scripts/source_archive.ts",
    "migration": "node --import ./scripts/ts-loader.mjs scripts/run_migrations.ts",
    "dev": "pnpm run typecheck && pnpm run lint && pnpm run test:unit",
    "ci": "pnpm run validate && pnpm exec vitest run",
    "generate:types": "node dist/scripts/generate_types.js",
    "project-os:init": "node dist/scripts/generate_project_os.js",
    "prepare": "husky",
    "mcp:server": "node dist/scripts/mcp_server.js",
    "knowledge:cowork-sync": "node dist/scripts/cowork_knowledge_bridge.js"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "knowledge/**/*.{md,json}": [
      "pnpm exec tsx scripts/generate_knowledge_index.ts",
      "git add knowledge/_index.md knowledge/_integrity-manifest.json"
    ]
  },
  "dependencies": {
    "@actuator/system": "workspace:*",
    "@agent/core": "workspace:*",
    "@agent/shared-media": "workspace:*",
    "@agent/shared-nerve": "workspace:*",
    "@agent/shared-network": "workspace:*",
    "@agent/shared-vision": "workspace:*",
    "@agentclientprotocol/sdk": "^1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/claude-code": "^2.1.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex": "^0.146.0",
    "@presence/terminal-hud": "workspace:*",
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/html-to-docx": "^1.8.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "@xmldom/xmldom": "0.9.10",
    "adm-zip": "^0.6.0",
    "ajv": "8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.18.1",
    "chalk": "6.0.0",
    "chokidar": "^5.0.0",
    "claude-code": "^1.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "gif-encoder-2": "^1.0.5",
    "googleapis": "^173.0.0",
    "html-to-docx": "^1.8.0",
    "jimp": "^1.6.1",
    "js-yaml": "^5.2.2",
    "jschardet": "^3.1.4",
    "jszip": "^3.10.1",
    "languagedetect": "^2.0.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "node-pty": "^1.1.0",
    "papaparse": "^5.5.4",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^25.4.0",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.1",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "fast-check": "4.9.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "hyperframes": "^0.7.82",
    "json-schema-to-typescript": "^15.0.4",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
